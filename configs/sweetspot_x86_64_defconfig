# Sweetspot - PC x86 a 64 bit (immagine per chiavetta USB, BIOS e UEFI)
BR2_x86_64=y
BR2_x86_x86_64=y
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN=y
# Toolchain "bleeding-edge": glibc recente (i programmi compilati inclusi
# in Lyrion chiedono almeno la 2.38) e intestazioni del kernel recenti.
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN_X86_64_GLIBC_BLEEDING_EDGE=y
# Conversione dei caratteri (UTF-16) per la cartella di rete dell'archivio
BR2_TOOLCHAIN_GLIBC_GCONV_LIBS_COPY=y
BR2_TOOLCHAIN_GLIBC_GCONV_LIBS_LIST="UTF-16 UTF-32 UNICODE"
BR2_CCACHE=y

# Sistema
BR2_TARGET_GENERIC_HOSTNAME="sweetspot"
BR2_TARGET_GENERIC_ISSUE="Sweetspot"
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_EUDEV=y
BR2_TARGET_GENERIC_GETTY_PORT="tty2"
BR2_SYSTEM_DHCP=""
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_SWEETSPOT_PATH)/board/sweetspot/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_SWEETSPOT_PATH)/board/sweetspot/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_SWEETSPOT_PATH)/board/sweetspot/post-image.sh"

# Kernel LTS con PREEMPT_RT
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.18.55"
BR2_LINUX_KERNEL_USE_DEFCONFIG=y
BR2_LINUX_KERNEL_DEFCONFIG="x86_64"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_SWEETSPOT_PATH)/board/sweetspot/common/linux.fragment"
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
BR2_LINUX_KERNEL_NEEDS_HOST_LIBELF=y

# BusyBox con le applet usate dagli script
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_SWEETSPOT_PATH)/board/sweetspot/common/busybox.fragment"
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y

# Audio
BR2_PACKAGE_ALSA_UTILS=y
BR2_PACKAGE_ALSA_UTILS_AMIXER=y
BR2_PACKAGE_ALSA_UTILS_APLAY=y

# Server musicale: Lyrion Music Server (lo stesso motore di Daphile) con i
# suoi plugin e l'interfaccia Material, sulla stessa macchina del player.
BR2_PACKAGE_LMS=y
BR2_PACKAGE_LMS_MATERIAL=y
BR2_ROOTFS_USERS_TABLES="$(BR2_EXTERNAL_SWEETSPOT_PATH)/board/sweetspot/users.txt"
# Copia sicura dei database della libreria sulla chiavetta
BR2_PACKAGE_SQLITE=y
# Lettura delle risposte di Lyrion (JSON) negli script
BR2_PACKAGE_JQ=y

# Player: Squeezelite, con tutti i formati decodificati sul player (FLAC,
# ALAC, AAC, MP3, Ogg, WMA, DSD) e ricampionamento facoltativo (spento di
# serie: il percorso resta bit-perfect).
BR2_PACKAGE_SQUEEZELITE=y
BR2_PACKAGE_SQUEEZELITE_FFMPEG=y
BR2_PACKAGE_SQUEEZELITE_DSD=y
BR2_PACKAGE_SQUEEZELITE_RESAMPLE=y
BR2_PACKAGE_FAAD2=y

# Musica da cartelle condivise in rete (SMB)
BR2_PACKAGE_CIFS_UTILS=y
# Archivio musicale condiviso in rete (server SMB del kernel)
BR2_PACKAGE_KSMBD_TOOLS=y

# Copia dei CD: lettura sicura, FLAC, titoli e copertine da MusicBrainz,
# verifica AccurateRip
BR2_PACKAGE_LIBCDIO_PARANOIA=y
BR2_PACKAGE_FLAC=y
BR2_PACKAGE_LIBCURL=y
BR2_PACKAGE_LIBCURL_CURL=y
BR2_PACKAGE_SWEETSPOT_TOOLS=y

# Certificati per i servizi in streaming, le radio e i plugin
BR2_PACKAGE_CA_CERTIFICATES=y

# Firmware: schede di rete Realtek e Wi-Fi Intel
BR2_PACKAGE_LINUX_FIRMWARE=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_8169=y
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_7260=y
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_7265D=y
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_8265=y
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_9XXX=y
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_6E=y
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_7=y

# Installazione sul disco interno: partizione di sistema (FAT32) e
# archivio musicale (ext4)
BR2_PACKAGE_DOSFSTOOLS=y
BR2_PACKAGE_DOSFSTOOLS_MKFS_FAT=y
BR2_PACKAGE_DOSFSTOOLS_FSCK_FAT=y
BR2_PACKAGE_E2FSPROGS=y

# Strumenti di sistema e diagnostica
BR2_PACKAGE_RT_TESTS=y
BR2_PACKAGE_HDPARM=y
BR2_PACKAGE_KMOD=y
BR2_PACKAGE_KMOD_TOOLS=y
BR2_PACKAGE_LIBQRENCODE=y
BR2_PACKAGE_LIBQRENCODE_TOOLS=y

# Rete
BR2_PACKAGE_AVAHI=y
BR2_PACKAGE_AVAHI_DAEMON=y
BR2_PACKAGE_DROPBEAR=y
BR2_PACKAGE_ETHTOOL=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_NL80211=y

# Sistema in RAM: tutto in un initramfs compresso
BR2_TARGET_ROOTFS_CPIO=y
BR2_TARGET_ROOTFS_CPIO_ZSTD=y
# BR2_TARGET_ROOTFS_TAR is not set

# GRUB per BIOS e per UEFI a 64 e 32 bit. grub-early.cfg viene incorporato
# nel bootloader: niente commenti al suo interno, il parser iniziale di GRUB
# li tratta come comandi e salta le righe successive.
BR2_TARGET_GRUB2=y
BR2_TARGET_GRUB2_I386_PC=y
BR2_TARGET_GRUB2_I386_EFI=y
BR2_TARGET_GRUB2_X86_64_EFI=y
BR2_TARGET_GRUB2_BUILTIN_MODULES_PC="boot linux fat part_msdos part_gpt normal biosdisk search search_label search_fs_uuid configfile test echo loadenv probe"
BR2_TARGET_GRUB2_BUILTIN_CONFIG_PC="$(BR2_EXTERNAL_SWEETSPOT_PATH)/board/sweetspot/x86/grub-early.cfg"
BR2_TARGET_GRUB2_BUILTIN_MODULES_EFI="boot linux fat part_msdos part_gpt normal search search_label search_fs_uuid configfile test echo loadenv probe efi_gop efi_uga"
BR2_TARGET_GRUB2_BUILTIN_CONFIG_EFI="$(BR2_EXTERNAL_SWEETSPOT_PATH)/board/sweetspot/x86/grub-early.cfg"

# Strumenti per creare l'immagine
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_MTOOLS=y
