# Sweetspot - applet BusyBox aggiuntive usate dagli script di sistema.
CONFIG_TASKSET=y
CONFIG_FEATURE_TASKSET_FANCY=y
CONFIG_FEATURE_TASKSET_CPULIST=y
CONFIG_FINDFS=y
CONFIG_FEATURE_MOUNT_LABEL=y
CONFIG_HTTPD=y
CONFIG_FEATURE_HTTPD_CGI=y
CONFIG_CHPASSWD=y
CONFIG_TIMEOUT=y
CONFIG_STAT=y
CONFIG_PGREP=y
CONFIG_NTPD=y
