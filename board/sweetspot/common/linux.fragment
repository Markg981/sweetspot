# SPDX-License-Identifier: GPL-3.0-or-later
#
# Sweetspot - frammento di configurazione del kernel comune a tutte le
# schede. Si applica sopra la configurazione di base della scheda, insieme
# al frammento della scheda (x86/linux.fragment, rpi/linux.fragment).
#
# Obiettivi: kernel real-time, core isolabili, niente swap,
# sistema interamente in RAM, uscita USB Audio bit-perfect con DSD nativo.

# --- Identificazione -------------------------------------------------------
CONFIG_LOCALVERSION="-sweetspot"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# --- Real-time e isolamento dei core ---------------------------------------
CONFIG_EXPERT=y
# CONFIG_PREEMPT is not set
# CONFIG_PREEMPT_VOLUNTARY is not set
CONFIG_PREEMPT_RT=y
CONFIG_HZ_1000=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_NO_HZ_FULL=y
CONFIG_CPU_ISOLATION=y
CONFIG_RCU_NOCB_CPU=y

# --- cgroup v2: rallentare i lavori di fondo durante l'ascolto -------------
# sweetspot-ascolto limita la CPU (cpu.max, cpu.weight) di scanner e copie
# invece di congelarli. Niente RT_GROUP_SCHED: con quello il controller cpu
# non e' attivabile con processi real-time nel gruppo radice.
CONFIG_CGROUPS=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
# CONFIG_RT_GROUP_SCHED is not set
CONFIG_CGROUP_PIDS=y

# --- Nessuno swap, nessuna ibernazione -------------------------------------
# CONFIG_SWAP is not set
# CONFIG_HIBERNATION is not set

# --- Frequenza e stati di risparmio della CPU ------------------------------
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_STAT=y
CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_CPU_FREQ_GOV_USERSPACE=y
CONFIG_CPU_IDLE=y

# --- Avvio da initramfs (sistema in RAM) -----------------------------------
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_RD_ZSTD=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# --- Audio: USB Audio nel kernel -------------------------------------------
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_VERBOSE_PROCFS=y
CONFIG_SND_USB=y
CONFIG_SND_USB_AUDIO=y
# CONFIG_SND_USB_UA101 is not set
# CONFIG_SND_USB_CAIAQ is not set
# CONFIG_SND_USB_6FIRE is not set
# CONFIG_SND_USB_HIFACE is not set

# --- USB e chiavetta (o scheda SD) di avvio --------------------------------
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_IOCHARSET="iso8859-1"
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y

# --- Dischi con la musica (sempre in sola lettura) e cartelle di rete -----
CONFIG_EXT4_FS=y
CONFIG_EXFAT_FS=m
CONFIG_NTFS3_FS=m
CONFIG_HFSPLUS_FS=m
CONFIG_CIFS=m
# Archivio musicale condiviso in rete (server SMB del kernel, ksmbd)
CONFIG_SMB_SERVER=m
# Cartelle di rete NFS (client del kernel, NFSv3 e NFSv4)
CONFIG_NFS_FS=m
CONFIG_NFS_V3=m
CONFIG_NFS_V4=m

# --- Adattatori di rete USB ------------------------------------------------
CONFIG_USB_USBNET=m
CONFIG_USB_RTL8152=m
CONFIG_USB_NET_AX88179_178A=m
CONFIG_USB_NET_CDC_NCM=m
CONFIG_USB_NET_CDCETHER=m

# --- Wi-Fi (ripiego, spento se non configurato) ----------------------------
CONFIG_RFKILL=y
CONFIG_CFG80211=m
CONFIG_MAC80211=m

# --- Meno attivita' di fondo ----------------------------------------------
# CONFIG_DEBUG_INFO is not set
# CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT is not set
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_KVM is not set
# CONFIG_XEN is not set

# Watchdog: un blocco totale fa ripartire il computer (sweetspot-watchdog);
# dopo un aggiornamento riparte cosi' la versione precedente. softdog
# copre i computer senza watchdog hardware.
CONFIG_WATCHDOG=y
CONFIG_WATCHDOG_CORE=y
CONFIG_WATCHDOG_SYSFS=y
# CONFIG_WATCHDOG_NOWAYOUT is not set
CONFIG_SOFT_WATCHDOG=m

# --- Bluetooth come sorgente (A2DP): moduli, caricati solo se attivato -----
# bluez e bluez-alsa parlano con il kernel con socket Bluetooth e con le
# funzioni di cifratura (AF_ALG) per l'abbinamento. Il dongle USB (x86) usa
# btusb; il Bluetooth integrato del Raspberry Pi usa la UART (hci_uart).
CONFIG_BT=m
CONFIG_BT_BREDR=y
CONFIG_BT_RFCOMM=m
# CONFIG_BT_LE is not set
CONFIG_BT_HCIBTUSB=m
CONFIG_BT_HCIBTUSB_BCM=y
CONFIG_BT_HCIBTUSB_RTL=y
CONFIG_BT_HCIBTUSB_MTK=y
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_SERDEV=y
CONFIG_BT_HCIUART_BCM=y
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y
CONFIG_CRYPTO_USER_API_AEAD=y
CONFIG_CRYPTO_CMAC=y
CONFIG_CRYPTO_ECB=y
CONFIG_CRYPTO_AES=y

# --- Diagnostica: pstore / ramoops -------------------------------------------
# Dopo un panic o un blocco il log del kernel e la console restano in una
# memoria che sopravvive al riavvio; sweetspot-diario li copia sulla chiavetta
# all'avvio. Su Raspberry Pi la regione e' riservata da dtoverlay=ramoops
# (rpi/config.txt), su x86 si usa efi-pstore (x86/linux.fragment).
CONFIG_PSTORE=y
CONFIG_PSTORE_DEFLATE_COMPRESS=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_RAM=y
