# SPDX-License-Identifier: GPL-3.0-or-later
#
# Sweetspot - frammento di configurazione del kernel.
# Si applica sopra x86_64_defconfig (kernel LTS 6.18).
#
# Obiettivi: kernel real-time, core isolabili, niente swap,
# sistema interamente in RAM, uscita USB Audio bit-perfect con DSD nativo.

# --- Identificazione -------------------------------------------------------
CONFIG_LOCALVERSION="-sweetspot"
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# --- Real-time e isolamento dei core ---------------------------------------
CONFIG_EXPERT=y
CONFIG_PREEMPT_RT=y
CONFIG_HZ_1000=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_NO_HZ_FULL=y
CONFIG_CPU_ISOLATION=y
CONFIG_RCU_NOCB_CPU=y

# --- Nessuno swap, nessuna ibernazione -------------------------------------
# CONFIG_SWAP is not set
# CONFIG_HIBERNATION is not set

# --- Frequenza e stati di risparmio della CPU ------------------------------
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_STAT=y
CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_CPU_FREQ_GOV_USERSPACE=y
CONFIG_X86_INTEL_PSTATE=y
CONFIG_X86_ACPI_CPUFREQ=y
CONFIG_X86_AMD_PSTATE=y
CONFIG_CPU_IDLE=y
CONFIG_INTEL_IDLE=y
CONFIG_SENSORS_CORETEMP=m
CONFIG_SENSORS_K10TEMP=m

# --- Avvio da initramfs (sistema in RAM) -----------------------------------
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_RD_ZSTD=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# --- Audio: solo USB Audio, uscita integrata disponibile come modulo ------
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_VERBOSE_PROCFS=y
CONFIG_SND_USB=y
CONFIG_SND_USB_AUDIO=y
CONFIG_SND_HDA_INTEL=m
# CONFIG_SND_USB_UA101 is not set
# CONFIG_SND_USB_CAIAQ is not set
# CONFIG_SND_USB_6FIRE is not set
# CONFIG_SND_USB_HIFACE is not set

# --- USB: controller di ogni epoca, chiavetta di avvio ---------------------
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_UHCI_HCD=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_IOCHARSET="iso8859-1"
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y

# --- Dischi con la musica (sempre in sola lettura) e cartelle di rete -----
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_ATA_PIIX=y
CONFIG_BLK_DEV_NVME=y
CONFIG_EXT4_FS=y
CONFIG_EXFAT_FS=m
CONFIG_NTFS3_FS=m
CONFIG_HFSPLUS_FS=m
CONFIG_CIFS=m
# Archivio musicale condiviso in rete (server SMB del kernel, ksmbd)
CONFIG_SMB_SERVER=m
CONFIG_NFS_FS=m

# --- Rete cablata (anche adattatori USB) -----------------------------------
CONFIG_R8169=m
CONFIG_E1000E=m
CONFIG_IGB=m
CONFIG_IGC=m
CONFIG_TIGON3=m
CONFIG_ATL1C=m
CONFIG_ALX=m
CONFIG_USB_USBNET=m
CONFIG_USB_RTL8152=m
CONFIG_USB_NET_AX88179_178A=m
CONFIG_USB_NET_CDC_NCM=m
CONFIG_USB_NET_CDCETHER=m

# --- Wi-Fi (ripiego, spento se non configurato) ----------------------------
CONFIG_RFKILL=y
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_IWLWIFI=m
CONFIG_IWLDVM=m
CONFIG_IWLMVM=m
CONFIG_IWLMLD=m
CONFIG_ATH9K=m
CONFIG_MT7921E=m

# --- Schermo: console di base, spegnimento del pannello --------------------
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
# i915 non e' compatibile con PREEMPT_RT: lo schermo resta sul framebuffer
# di base (simpledrm) e la retroilluminazione si spegne via ACPI, dove c'e'.
CONFIG_ACPI_VIDEO=m
# Nouveau serve solo a spegnere la GPU NVIDIA dei portatili Optimus.
CONFIG_DRM_NOUVEAU=m
CONFIG_BACKLIGHT_CLASS_DEVICE=y

# --- Meno attivita' di fondo ----------------------------------------------
# CONFIG_DEBUG_INFO is not set
# CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT is not set
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_KVM is not set
# CONFIG_XEN is not set
