#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Sweetspot - esegue le azioni delle pagine di impostazione.
# Accetta solo richieste POST con il gettone della pagina.

. "${SWEETSPOT_LIB:-/usr/lib/sweetspot}/web.sh"

done_to() { redirect "/cgi-bin/$1?msg=$(urlenc "$2")"; exit 0; }

# Esito di sweetspot-config: 0 salvato, 2 solo fino al riavvio.
saved_msg() { # codice testo
	case "$1" in
		0) printf '%s' "$2" ;;
		2) printf '%s' "Chiavetta non trovata: le modifiche valgono solo fino al riavvio." ;;
		*) printf '%s' "Valori non validi: niente è stato cambiato." ;;
	esac
}

# Campi dei moduli, riempiti da read_form.
F_t="" F_a="" F_server="" F_cartella="" F_utente="" F_password="" F_n="" F_nome=""
F_modalita="" F_profilo="" F_dsd="" F_volume="" F_ricampionamento="" F_filtro="" F_altri_dac="" F_dac=""
F_frequenza_max="" F_buffer="" F_periodi="" F_pausa_frequenza="" F_pausa_dsd=""
F_wifi_nome="" F_wifi_scelta="" F_wifi_password="" F_ip_modo="" F_ip_fisso="" F_gateway="" F_dns=""
F_nome_rete="" F_risparmio="" F_ascolto="" F_ssh="" F_ssh_password="" F_ottimizzazioni=""
F_web_password="" F_web_libero=""
F_condiviso="" F_album="" F_artista="" F_anno="" F_scheda="" F_overlay="" F_disco="" F_archivio="" F_conferma="" F_file=""
F_sinistro="" F_destro="" F_modo="" F_esito=""
F_bt_attivo="" F_bt_nome="" F_bt_minuti="" F_bt_mac=""

if [ "$REQUEST_METHOD" != POST ]; then
	redirect /cgi-bin/audio
	exit 0
fi
read_form
if [ -z "$F_t" ] || [ "$F_t" != "$(token)" ]; then
	done_to audio "Richiesta non valida: ricarica la pagina e riprova."
fi

# Cartella delle pagine (bozze dei filtri, stato della prova DoP): di solito la
# crea root all'avvio con il proprietario "web"; qui solo se manca.
mkdir -p "$WEBDIR/correzione" 2>/dev/null

# numero VALORE MIN MAX
in_range() {
	case "$1" in ''|*[!0-9]*) return 1 ;; esac
	[ "$1" -ge "$2" ] && [ "$1" -le "$3" ]
}

is_ipv4() {
	local IFS=. x
	case "$1" in *[!0-9.]*|'') return 1 ;; esac
	set -- $1
	[ $# -eq 4 ] || return 1
	for x in "$@"; do in_range "$x" 0 255 || return 1; done
}

is_cidr() {
	is_ipv4 "${1%/*}" || return 1
	case "$1" in */*) in_range "${1#*/}" 1 32 ;; *) return 1 ;; esac
}

# Riavvio del player in sottofondo: la pagina risponde subito.
restart_player() {
	if [ -x "$SWEETSPOT_PRIV" ]; then
		"$SWEETSPOT_PRIV" @player
	else
		setsid /etc/init.d/S60sweetspot-player restart > /dev/null 2>&1 < /dev/null &
	fi
}

# Riavvio, spegnimento e applicazione della scheda I2S dopo 2 secondi, in
# sottofondo: la pagina risponde prima. Con l'helper li lancia root; senza
# (test) direttamente.
reboot_later() {
	if [ -x "$SWEETSPOT_PRIV" ]; then
		"$SWEETSPOT_PRIV" @riavvia
	else
		( sleep 2; setsid sweetspot-riavvia ) > /dev/null 2>&1 &
	fi
}

poweroff_later() {
	if [ -x "$SWEETSPOT_PRIV" ]; then
		"$SWEETSPOT_PRIV" @spegni
	else
		( sleep 2; poweroff ) > /dev/null 2>&1 &
	fi
}

autotune_later() {
	if [ -x "$SWEETSPOT_PRIV" ]; then
		"$SWEETSPOT_PRIV" @autotune
	else
		( sleep 2; setsid sweetspot-autotune --applica ) > /dev/null 2>&1 &
	fi
}

# Aggiunge o toglie un nome dalla lista ESCLUDI_DISCHI.
set_excluded() { # nome aggiungi|togli
	local cur out e want
	want=$(lower "$1")
	cur=$(conf ESCLUDI_DISCHI | tr ',' '\n')
	out=$(printf '%s\n' "$cur" | while IFS= read -r e; do
		[ -n "$e" ] && [ "$(lower "$e")" != "$want" ] && printf '%s\n' "$e"
	done)
	[ "$2" = aggiungi ] && out=$(printf '%s\n%s\n' "$out" "$1")
	out=$(printf '%s\n' "$out" | grep . | tr '\n' ',' | sed 's/,$//')
	if [ -n "$out" ]; then
		priv sweetspot-config imposta ESCLUDI_DISCHI "$out"
	else
		priv sweetspot-config rimuovi ESCLUDI_DISCHI
	fi
}

case "$F_a" in
	# --- Audio -------------------------------------------------------------------
	audio)
		case "$F_volume" in fisso|dac|software|dsp) ;; *) F_volume=fisso ;; esac
		case "$F_dsd" in auto|nativo|dop|no) ;; *) F_dsd=auto ;; esac
		case "$F_altri_dac" in si|no) ;; *) F_altri_dac=no ;; esac
		# DAC principale: auto, un identificativo USB, oppure il valore gia'
		# scritto a mano in sweetspot.txt (non si tocca).
		F_dac=$(lower "$F_dac")
		case "$F_dac" in
			''|auto) F_dac=auto ;;
			[0-9a-f][0-9a-f][0-9a-f][0-9a-f]:[0-9a-f][0-9a-f][0-9a-f][0-9a-f]) ;;
			*) [ "$F_dac" = "$(lower "$(conf DAC auto)")" ] || done_to audio "DAC principale non valido." ;;
		esac
		case "$F_ricampionamento" in no|sincrono|asincrono) ;; *) F_ricampionamento=no ;; esac
		case "$F_filtro" in lineare|intermedio|minimo) ;; *) F_filtro=lineare ;; esac
		in_range "$F_frequenza_max" 0 1536000 || done_to audio "Frequenza massima non valida: scrivi 0 oppure un valore in Hz, es. 192000."
		in_range "$F_buffer" 20 499 || done_to audio "Il buffer ALSA va da 20 a 499 millisecondi."
		in_range "$F_periodi" 2 16 || done_to audio "I periodi ALSA vanno da 2 a 16."
		in_range "$F_pausa_frequenza" 0 5000 || done_to audio "La pausa al cambio di frequenza va da 0 a 5000 millisecondi."
		in_range "$F_pausa_dsd" 0 5000 || done_to audio "La pausa tra DSD e PCM va da 0 a 5000 millisecondi."
		priv sweetspot-config imposta VOLUME "$F_volume" DSD "$F_dsd" RICAMPIONAMENTO "$F_ricampionamento" \
			FILTRO "$F_filtro" FREQUENZA_MAX "$F_frequenza_max" BUFFER_ALSA_MS "$F_buffer" \
			PERIODI_ALSA "$F_periodi" PAUSA_FREQUENZA_MS "$F_pausa_frequenza" PAUSA_DSD_MS "$F_pausa_dsd" \
			ALTRI_DAC "$F_altri_dac" DAC "$F_dac"
		rc=$?
		[ $rc -eq 1 ] && done_to audio "$(saved_msg 1)"
		restart_player
		done_to audio "$(saved_msg $rc "Impostazioni salvate: il player si sta riavviando.")" ;;

	# Prova DoP guidata: genera il tono DSD64 in DoP e lo fa suonare a Lyrion.
	prova_dop)
		card=$(dac_find)
		[ -n "$card" ] || done_to audio "Nessun DAC collegato: la prova DoP richiede il DAC acceso."
		blocker=$(dop_test_blocker "$card")
		[ -z "$blocker" ] || done_to audio "Prova DoP non disponibile: $blocker."
		mac=$(cat "$RUN/player.mac" 2>/dev/null)
		[ -n "$mac" ] || done_to audio "Il player non è ancora avviato: riprova tra qualche secondo."
		dir=${SWEETSPOT_PROVA_DOP_DIR:-/tmp/sweetspot-prova-dop}
		mkdir -p "$dir" && chmod 755 "$dir" &&
			sweetspot-prova-dop "$dir/prova-dop.wav" 6 && chmod 644 "$dir/prova-dop.wav" ||
			done_to audio "Impossibile preparare il file di prova DoP."
		# "playlist preview" mette da parte la coda di ascolto e suona il
		# tono; "cmd:stop" (all'esito) la rimette com'era, senza farla
		# ripartire. "playlist play" l'avrebbe cancellata.
		lms_json "$mac" playlist preview "url:file://$dir/prova-dop.wav" "title:Prova DoP" > /dev/null ||
			done_to audio "Lyrion non ha avviato la prova DoP: riprova tra qualche secondo."
		touch "$WEBDIR/prova-dop.avviata"
		log "audio: prova DoP avviata"
		done_to audio "Prova DoP avviata: guarda il display del DAC e ascolta, poi indica qui sotto com'è andata." ;;

	prova_dop_esito)
		rm -f "$WEBDIR/prova-dop.avviata"
		# La coda di ascolto torna com'era (ferma).
		mac=$(cat "$RUN/player.mac" 2>/dev/null)
		[ -n "$mac" ] && lms_json "$mac" playlist preview cmd:stop > /dev/null
		case "$F_esito" in
			si)
				priv sweetspot-config imposta DSD dop
				rc=$?
				[ $rc -eq 1 ] && done_to audio "$(saved_msg 1)"
				log "audio: prova DoP riuscita, DSD tramite DoP"
				restart_player
				done_to audio "$(saved_msg $rc "DSD tramite DoP: il player si sta riavviando.")" ;;
			*)
				log "audio: prova DoP non riuscita, DSD convertito in PCM"
				done_to audio "Nessuna modifica: i file DSD restano convertiti in PCM da Squeezelite." ;;
		esac ;;

	# --- Musica ------------------------------------------------------------------
	aggiorna)
		priv sweetspot-lms aggiorna
		done_to musica "Aggiornamento della libreria avviato." ;;

	ricostruisci)
		priv sweetspot-lms ricostruisci
		done_to musica "Ricostruzione della libreria avviata: con molti brani richiede alcuni minuti." ;;

	aggiungi_condivisione)
		server=$(printf '%s' "$F_server" | tr -d ' \\/' )
		dir=$(printf '%s' "$F_cartella" | tr '\\' '/' | sed 's#^/*##; s#/*$##')
		case "$server" in
			''|*[!A-Za-z0-9._-]*) done_to musica "Indirizzo non valido: scrivi solo l'indirizzo, per esempio 192.168.1.10." ;;
		esac
		if [ -z "$dir" ] || ! valid_value "$dir" || ! valid_value "$F_utente" || ! valid_value "$F_password"; then
			done_to musica "Dati non validi."
		fi
		case "$dir$F_utente" in *'"'*|*'$'*|*'`'*) done_to musica "La cartella e l'utente non possono contenere virgolette o simboli \$ \`." ;; esac
		n=""
		for i in 1 2 3 4 5 6 7 8 9; do
			[ -z "$(conf "CONDIVISIONE_$i")" ] && { n=$i; break; }
		done
		[ -n "$n" ] || done_to musica "Hai già 9 cartelle di rete: rimuovine una."
		if [ -n "$F_utente" ]; then
			priv sweetspot-config imposta "CONDIVISIONE_$n" "//$server/$dir" \
				"CONDIVISIONE_${n}_UTENTE" "$F_utente" "CONDIVISIONE_${n}_PASSWORD" "$F_password"
		else
			priv sweetspot-config imposta "CONDIVISIONE_$n" "//$server/$dir"
		fi
		res=$(priv sweetspot-rete prova "$n")
		if [ "$res" = OK ]; then
			# (sweetspot-rete prova ha gia' messo la cartella nell'elenco)
			priv sweetspot-lms aggiorna
			done_to musica "Cartella aggiunta: la libreria si sta aggiornando."
		fi
		priv sweetspot-config rimuovi "CONDIVISIONE_$n" "CONDIVISIONE_${n}_UTENTE" "CONDIVISIONE_${n}_PASSWORD"
		done_to musica "Cartella non aggiunta: $res." ;;

	rimuovi_condivisione)
		case "$F_n" in [1-9]) ;; *) done_to musica "Richiesta non valida." ;; esac
		priv sweetspot-rete smonta-una "$F_n"
		priv sweetspot-config rimuovi "CONDIVISIONE_$F_n" "CONDIVISIONE_${F_n}_UTENTE" "CONDIVISIONE_${F_n}_PASSWORD"
		priv sweetspot-lms aggiorna
		done_to musica "Cartella rimossa dalla libreria." ;;

	escludi_disco)
		name=$(safe_name "$F_nome")
		[ -n "$name" ] || done_to musica "Richiesta non valida."
		set_excluded "$name" aggiungi
		priv sweetspot-dischi smonta "$name"
		priv sweetspot-lms aggiorna
		done_to musica "Disco escluso dalla libreria." ;;

	includi_disco)
		name=$(safe_name "$F_nome")
		[ -n "$name" ] || done_to musica "Richiesta non valida."
		set_excluded "$name" togli
		priv sweetspot-dischi monta
		priv sweetspot-lms aggiorna
		done_to musica "Disco aggiunto alla libreria." ;;

	# --- Archivio -----------------------------------------------------------------
	archivio_scegli)
		name=$(safe_name "$F_nome")
		[ -n "$name" ] || done_to archivio "Richiesta non valida."
		identity=$(awk -F'|' -v n="$name" '$1 == n {print $7; exit}' "$RUN/dischi.list" 2>/dev/null)
		case "$identity" in UUID=?*|PARTUUID=?*) ;; *) done_to archivio "Identità del disco non disponibile: ricollega il disco e riprova." ;; esac
		priv sweetspot-config imposta ARCHIVIO "$identity"
		rc=$?
		[ "$rc" -eq 0 ] || done_to archivio "$(saved_msg "$rc")"
		# Si rimonta il disco in scrittura.
		priv sweetspot-dischi smonta "$name"
		priv sweetspot-dischi monta
		priv sweetspot-nas riavvia
		priv sweetspot-lms aggiorna
		[ -n "$(priv sweetspot-dischi archivio)" ] || done_to archivio "Il disco non si può usare in scrittura: controlla che non sia protetto o danneggiato."
		done_to archivio "Archivio pronto: $name." ;;

	# Archivio nello spazio libero del disco da cui parte Sweetspot.
	archivio_spazio)
		out=$(priv sweetspot-spazio crea) || done_to archivio "Non si può: $out."
		done_to archivio "Creazione dell'archivio avviata: richiede da qualche secondo a qualche minuto." ;;

	archivio_togli)
		a=$(priv sweetspot-dischi archivio)
		[ -n "$a" ] || done_to archivio "Nessun archivio."
		priv sweetspot-copia annulla
		priv sweetspot-nas ferma
		priv sweetspot-config rimuovi ARCHIVIO
		priv sweetspot-dischi smonta "${a##*/}"
		priv sweetspot-dischi monta
		priv sweetspot-lms aggiorna
		done_to archivio "Il disco è tornato in sola lettura." ;;

	archivio_rete)
		case "$F_condiviso" in si|no) ;; *) F_condiviso=no ;; esac
		valid_value "$F_password" || done_to archivio "Password non valida."
		if [ -n "$F_password" ]; then
			priv sweetspot-config imposta ARCHIVIO_CONDIVISO "$F_condiviso" ARCHIVIO_PASSWORD "$F_password"
		else
			priv sweetspot-config imposta ARCHIVIO_CONDIVISO "$F_condiviso"
		fi
		rc=$?
		priv sweetspot-nas riavvia
		if [ "$F_condiviso" = si ]; then
			done_to archivio "$(saved_msg $rc "Cartella di rete Musica attiva.")"
		fi
		done_to archivio "$(saved_msg $rc "Cartella di rete spenta.")" ;;

	copia_avvia)
		valid_value "$F_cartella" || done_to archivio "Richiesta non valida."
		if err=$(priv sweetspot-copia avvia "$F_cartella"); then
			done_to archivio "Copia avviata."
		fi
		done_to archivio "Copia non avviata: $err." ;;

	copia_annulla)
		priv sweetspot-copia annulla
		done_to archivio "Copia annullata." ;;

	archivio_elimina)
		valid_value "$F_cartella" || done_to archivio "Richiesta non valida."
		if err=$(priv sweetspot-copia elimina "$F_cartella"); then
			done_to archivio "Cartella tolta dall'archivio."
		fi
		done_to archivio "Non tolta: $err." ;;

	# --- CD ----------------------------------------------------------------------
	cd_leggi)
		if err=$(priv sweetspot-cd leggi); then
			done_to archivio "CD letto."
		fi
		done_to archivio "CD non letto: $err." ;;

	cd_copia)
		valid_value "$F_album" && valid_value "$F_artista" || done_to archivio "Dati non validi."
		case "$F_anno" in ''|[12][0-9][0-9][0-9]) ;; *) done_to archivio "Anno non valido." ;; esac
		if err=$(priv sweetspot-cd copia "$F_album" "$F_artista" "$F_anno"); then
			done_to archivio "Copia del CD avviata."
		fi
		done_to archivio "Copia non avviata: $err." ;;

	cd_annulla)
		priv sweetspot-cd annulla
		done_to archivio "Copia del CD annullata." ;;

	cd_espelli)
		priv sweetspot-cd espelli
		done_to archivio "CD espulso." ;;

	# --- Plugin -------------------------------------------------------------------
	plugin_installa)
		case "$F_nome" in ''|*[!A-Za-z0-9_]*) done_to plugin "Richiesta non valida." ;; esac
		if err=$(priv sweetspot-lms plugin installa "$F_nome"); then
			done_to plugin "Plugin in arrivo: a scaricamento finito riavvia Lyrion per attivarlo."
		fi
		done_to plugin "Plugin non installato: ${err:-errore sconosciuto}. Sweetspot è collegato a Internet?" ;;

	plugin_rimuovi)
		case "$F_nome" in ''|*[!A-Za-z0-9_]*) done_to plugin "Richiesta non valida." ;; esac
		[ "$F_nome" = MaterialSkin ] && done_to plugin "L'interfaccia Material non si può togliere da qui."
		if err=$(priv sweetspot-lms plugin rimuovi "$F_nome"); then
			done_to plugin "Il plugin viene tolto al riavvio di Lyrion."
		fi
		done_to plugin "Plugin non rimosso: ${err:-errore sconosciuto}." ;;

	riavvia_lyrion)
		priv sweetspot-lms riavvia
		done_to plugin "Lyrion si sta riavviando: tra circa un minuto i plugin sono attivi." ;;

	# --- Rete --------------------------------------------------------------------
	rete)
		valid_value "$F_wifi_nome" && valid_value "$F_wifi_password" || done_to rete "Dati non validi."
		case "$F_risparmio" in si|no) ;; *) F_risparmio=no ;; esac
		F_nome_rete=$(lower "$F_nome_rete")
		case "$F_nome_rete" in
			'') F_nome_rete=sweetspot ;;
			-*|*-|*[!a-z0-9-]*) done_to rete "Nome in rete non valido: solo lettere minuscole, cifre e trattini." ;;
		esac
		[ ${#F_nome_rete} -le 32 ] || done_to rete "Nome in rete troppo lungo (al massimo 32 caratteri)."
		set -- WIFI_NOME "$F_wifi_nome" NOME_RETE "$F_nome_rete" RISPARMIO_RETE "$F_risparmio"
		[ -n "$F_wifi_password" ] && set -- "$@" WIFI_PASSWORD "$F_wifi_password"
		if [ "$F_ip_modo" = fisso ]; then
			is_cidr "$F_ip_fisso" || done_to rete "Indirizzo fisso non valido: scrivilo con la maschera, es. 192.168.1.50/24."
			is_ipv4 "$F_gateway" || done_to rete "Indirizzo del router non valido, es. 192.168.1.1."
			[ -z "$F_dns" ] || is_ipv4 "$F_dns" || done_to rete "Indirizzo DNS non valido."
			set -- "$@" IP_FISSO "$F_ip_fisso" GATEWAY "$F_gateway"
			if [ -n "$F_dns" ]; then set -- "$@" DNS "$F_dns"; else priv sweetspot-config rimuovi DNS; fi
		else
			priv sweetspot-config rimuovi IP_FISSO GATEWAY DNS
		fi
		priv sweetspot-config imposta "$@"
		rc=$?
		done_to rete "$(saved_msg $rc "Impostazioni di rete salvate: valgono dal prossimo avvio.")" ;;

	# Primo avvio: rete scelta dal telefono collegato all'hotspot. Si salva e
	# sweetspot-hotspot spegne l'hotspot e prova la rete (poi riparte se fallisce).
	wifi_connetti)
		[ -s "$RUN/hotspot.attivo" ] || done_to rete "L'hotspot non � acceso."
		[ -n "$F_wifi_nome" ] || F_wifi_nome=$F_wifi_scelta
		[ -n "$F_wifi_nome" ] || done_to rete "Scegli una rete o scrivine il nome."
		valid_value "$F_wifi_nome" && valid_value "$F_wifi_password" || done_to rete "Dati non validi."
		[ -z "$F_wifi_password" ] || { [ ${#F_wifi_password} -ge 8 ] && [ ${#F_wifi_password} -le 63 ]; } || done_to rete "La password Wi-Fi ha da 8 a 63 caratteri."
		priv sweetspot-config imposta WIFI_NOME "$F_wifi_nome" WIFI_PASSWORD "$F_wifi_password"
		rc=$?
		[ $rc -eq 0 ] || [ $rc -eq 2 ] || done_to rete "$(saved_msg $rc)"
		priv sweetspot-hotspot richiesta || done_to rete "L'hotspot non risponde: riprova fra qualche secondo."
		done_to rete "Mi collego a $F_wifi_nome: l'hotspot si spegne. Ricollega il telefono alla tua rete e apri http://$(cat "$PROC/sys/kernel/hostname" 2>/dev/null).local/ (se non si collega, entro circa un minuto l'hotspot Sweetspot riparte)." ;;
	wifi_scansiona)
		[ -s "$RUN/hotspot.attivo" ] || done_to rete "L'hotspot non � acceso."
		priv sweetspot-hotspot scansiona
		done_to rete "Elenco delle reti aggiornato." ;;

	# Scheda DAC I2S del Raspberry Pi: la carica il firmware all'avvio, quindi
	# autotune scrive l'overlay e riavvia (una volta).
	scheda_i2s)
		[ "$(boot_type)" = rpi ] || done_to audio "Solo per il Raspberry Pi."
		ov=${F_overlay:-$F_scheda}
		case "$ov" in *[!a-z0-9-]*) done_to audio "Nome dell'overlay non valido: solo lettere minuscole, cifre e trattini." ;; esac
		[ "${#ov}" -le 60 ] || done_to audio "Nome dell'overlay troppo lungo."
		[ "$ov" = "$(conf SCHEDA_I2S)" ] && done_to audio "La scheda è già questa."
		if [ -n "$ov" ]; then priv sweetspot-config imposta SCHEDA_I2S "$ov"; else priv sweetspot-config rimuovi SCHEDA_I2S; fi
		rc=$?
		[ $rc -eq 0 ] || done_to audio "$(saved_msg $rc)"
		autotune_later
		done_to stato "Scheda salvata: il Raspberry Pi si riavvia per caricarla (circa un minuto)." ;;
	# --- Bluetooth: il telefono suona su Sweetspot ----------------------------
	bluetooth_imposta)
		case "$F_bt_attivo" in si|no) ;; *) F_bt_attivo=no ;; esac
		nome=$(safe_name "$F_bt_nome")
		priv sweetspot-config imposta BLUETOOTH "$F_bt_attivo"
		rc=$?
		[ $rc -eq 1 ] && done_to bluetooth "$(saved_msg 1)"
		if [ -n "$nome" ]; then priv sweetspot-config imposta BLUETOOTH_NOME "$nome"; else priv sweetspot-config rimuovi BLUETOOTH_NOME; fi
		priv sweetspot-bluetooth applica
		if [ "$F_bt_attivo" = si ]; then
			done_to bluetooth "$(saved_msg $rc "Bluetooth acceso: apri l'abbinamento per aggiungere il telefono.")"
		else
			done_to bluetooth "$(saved_msg $rc "Bluetooth spento.")"
		fi ;;

	bluetooth_abbina)
		in_range "$F_bt_minuti" 1 9 || F_bt_minuti=2
		priv sweetspot-bluetooth abbina "$F_bt_minuti" || done_to bluetooth "Non si puo': accendi prima il Bluetooth e attendi qualche secondo."
		done_to bluetooth "Abbinamento aperto per $F_bt_minuti minuti: cerca Sweetspot nelle impostazioni Bluetooth del telefono." ;;

	bluetooth_chiudi)
		priv sweetspot-bluetooth chiudi
		done_to bluetooth "Abbinamento chiuso." ;;

	bluetooth_rimuovi)
		priv sweetspot-bluetooth rimuovi "$F_bt_mac" || done_to bluetooth "Dispositivo non valido."
		done_to bluetooth "Dispositivo rimosso." ;;


	# --- Sistema -----------------------------------------------------------------
	sistema)
		nome=$(safe_name "$F_nome")
		[ -n "$nome" ] || nome=Sweetspot
		case "$F_modalita" in completa|player) ;; *) F_modalita=completa ;; esac
		case "$F_profilo" in bilanciato|silenzio|prestazioni) ;; *) F_profilo=bilanciato ;; esac
		# Ascolto puro = lavori sospesi + precarico in RAM con dischi fermi.
		case "$F_ascolto" in
			puro) F_ascolto=si; precarico=si ;;
			no) precarico=no ;;
			*) F_ascolto=si; precarico=no ;;
		esac
		case "$F_ssh" in si|no) ;; *) F_ssh=no ;; esac
		case "$F_ottimizzazioni" in si|no) ;; *) F_ottimizzazioni=si ;; esac
		case "$F_server" in *[!A-Za-z0-9.:_-]*) done_to sistema "Indirizzo del server non valido." ;; esac
		valid_value "$F_ssh_password" || done_to sistema "Password non valida."
		old_mode=$(mode)
		old_name=$(conf NOME_PLAYER Sweetspot)
		set -- NOME_PLAYER "$nome" MODALITA "$F_modalita" PROFILO "$F_profilo" MODALITA_ASCOLTO "$F_ascolto" \
			PRECARICO "$precarico" SSH "$F_ssh" OTTIMIZZAZIONI "$F_ottimizzazioni"
		[ -n "$F_ssh_password" ] && set -- "$@" SSH_PASSWORD "$F_ssh_password"
		# Password delle pagine: si salva solo l'impronta MD5-crypt.
		valid_value "$F_web_password" || done_to sistema "Password non valida."
		if [ -n "$F_web_password" ]; then
			h=$(priv sweetspot-accesso hash "$F_web_password") || done_to sistema "Password non salvata."
			set -- "$@" PASSWORD_WEB "$h"
		elif [ "$F_web_libero" = si ]; then
			priv sweetspot-config rimuovi PASSWORD_WEB
		fi
		if [ -n "$F_server" ]; then set -- "$@" SERVER "$F_server"; else priv sweetspot-config rimuovi SERVER; fi
		priv sweetspot-config imposta "$@"
		rc=$?
		[ $rc -eq 1 ] && done_to sistema "$(saved_msg 1)"
		priv sweetspot-accesso applica
		# Password nuova o tolta: le sessioni aperte non valgono piu'. Chi l'ha
		# cambiata resta dentro con una sessione nuova.
		if [ -n "$F_web_password" ]; then
			rm -f "$SESSION_DIR"/* 2>/dev/null
			# shellcheck disable=SC2034
			REDIRECT_COOKIE=$(session_new) || REDIRECT_COOKIE=""
		elif [ "$F_web_libero" = si ]; then
			rm -f "$SESSION_DIR"/* 2>/dev/null
		fi
		# Il nome nuovo vale subito, in Lyrion e nel player.
		if [ "$nome" != "$old_name" ] && [ "$old_mode" = completa ]; then
			mac=$(cat "$RUN/player.mac" 2>/dev/null)
			[ -n "$mac" ] && lms_json "$mac" name "$nome" > /dev/null
		fi
		if [ "$F_modalita" != "$old_mode" ]; then
			done_to sistema "$(saved_msg $rc "Impostazioni salvate. La nuova modalità vale dal prossimo avvio: riavvia Sweetspot.")"
		fi
		done_to sistema "$(saved_msg $rc "Impostazioni salvate.")" ;;

	# --- Correzione ambientale -------------------------------------------------------
	correzione_salva)
		case "$F_modo" in si|confronto|no) ;; *) F_modo=no ;; esac
		d=$WEBDIR/correzione
		mkdir -p "$d"
		printf '%s\n' "$F_sinistro" > "$d/nuovo-sinistro.txt"
		printf '%s\n' "$F_destro" > "$d/nuovo-destro.txt"
		: > "$d/bozza.errori"
		for side in sinistro destro; do
			if [ -n "$(tr -d ' \t\r\n' < "$d/nuovo-$side.txt")" ]; then
				priv sweetspot-dsp leggi "$d/nuovo-$side.txt" | grep '^errore|' | sed "s/^/$side|/" >> "$d/bozza.errori"
				[ "$side" = sinistro ] && ! priv sweetspot-dsp leggi "$d/nuovo-$side.txt" | grep -qv '^errore|' &&
					echo "sinistro|errore|-|nessun filtro attivo trovato nel testo" >> "$d/bozza.errori"
			else
				: > "$d/nuovo-$side.txt"
			fi
		done
		if [ ! -s "$d/nuovo-sinistro.txt" ] && [ -s "$d/nuovo-destro.txt" ]; then
			echo "sinistro|errore|-|incolla i filtri del sinistro (il destro da solo non basta)" >> "$d/bozza.errori"
		fi
		if [ -s "$d/bozza.errori" ]; then
			mv "$d/nuovo-sinistro.txt" "$d/bozza-sinistro.txt"
			mv "$d/nuovo-destro.txt" "$d/bozza-destro.txt"
			done_to correzione "Filtri non salvati: ci sono righe da correggere."
		fi
		rm -f "$d/bozza-sinistro.txt" "$d/bozza-destro.txt" "$d/bozza.errori"
		priv sweetspot-dsp salva "$d/nuovo-sinistro.txt" "$d/nuovo-destro.txt"
		rc=$?
		rm -f "$d/nuovo-sinistro.txt" "$d/nuovo-destro.txt"
		[ ! -s "$RUN/correzione/sinistro.txt" ] && F_modo=no
		priv sweetspot-config imposta CORREZIONE "$F_modo"
		rc2=$?
		[ $rc -eq 0 ] && rc=$rc2
		restart_player
		case "$F_modo" in
			si) done_to correzione "$(saved_msg $rc "Filtri salvati e correzione accesa: il player si riavvia.")" ;;
			confronto) done_to correzione "$(saved_msg $rc "Filtri salvati; correzione esclusa a pari volume.")" ;;
			*) done_to correzione "$(saved_msg $rc "Filtri salvati; correzione spenta (bit-perfect).")" ;;
		esac ;;

	correzione_modo)
		case "$F_modo" in si|confronto|no) ;; *) done_to correzione "Scelta non valida." ;; esac
		priv sweetspot-config imposta CORREZIONE "$F_modo"
		rc=$?
		restart_player
		case "$F_modo" in
			si) done_to correzione "$(saved_msg $rc "Correzione accesa: la musica riparte tra qualche secondo.")" ;;
			confronto) done_to correzione "$(saved_msg $rc "Correzione esclusa a pari volume: confronta con quella accesa.")" ;;
			*) done_to correzione "$(saved_msg $rc "Correzione spenta: il percorso è di nuovo bit-perfect.")" ;;
		esac ;;

	# --- Aggiornamenti e installazione ------------------------------------------------
	aggiorna_cerca)
		out=$(priv sweetspot-aggiorna cerca)
		case "$out" in
			errore=*) done_to sistema "Ricerca non riuscita: ${out#errore=}." ;;
		esac
		v=$(printf '%s\n' "$out" | sed -n 's/^versione=//p')
		if [ "$v" = "$(cut -d' ' -f1 /etc/sweetspot-version 2>/dev/null)" ]; then
			done_to sistema "Hai già l'ultima versione ($v)."
		fi
		done_to sistema "È disponibile Sweetspot $v." ;;

	aggiorna_scarica)
		out=$(priv sweetspot-aggiorna scarica) || done_to sistema "Aggiornamento non avviato: $out."
		done_to sistema "Aggiornamento avviato: Sweetspot continua a suonare, la nuova versione si usa dopo il riavvio." ;;

	aggiorna_file)
		out=$(priv sweetspot-aggiorna file "$F_file") || done_to sistema "Aggiornamento non avviato: $out."
		done_to sistema "Aggiornamento dal disco avviato." ;;

	aggiorna_annulla)
		priv sweetspot-aggiorna annulla
		done_to sistema "Aggiornamento annullato: resta la versione attuale." ;;

	aggiorna_altra)
		out=$(priv sweetspot-aggiorna altra) || done_to sistema "Non si può: $out."
		reboot_later
		done_to stato "Riavvio con l'altra versione: la pagina tornerà disponibile tra circa un minuto." ;;

	aggiorna_predefinita)
		priv sweetspot-aggiorna predefinita > /dev/null
		done_to sistema "Questa versione è ora quella che parte all'accensione." ;;

	installa)
		[ "$F_conferma" = si ] || done_to sistema "Per installare conferma che il disco verrà cancellato."
		[ "$F_archivio" = si ] || F_archivio=no
		out=$(priv sweetspot-installa avvia "$F_disco" "$F_archivio") || done_to sistema "Installazione non avviata: $out."
		done_to sistema "Installazione avviata: richiede qualche minuto." ;;

	ripristina)
		[ "$F_conferma" = si ] || done_to sistema "Per ripristinare conferma che tutte le impostazioni torneranno quelle iniziali."
		priv sweetspot-config ripristina
		rc=$?
		[ $rc -eq 1 ] && done_to sistema "Ripristino non riuscito."
		# Senza chiavetta un riavvio riporterebbe le impostazioni di prima.
		[ $rc -eq 2 ] && done_to sistema "Chiavetta non trovata: le impostazioni iniziali valgono solo fino al riavvio."
		priv sweetspot-accesso applica
		reboot_later
		done_to stato "Impostazioni iniziali ripristinate: Sweetspot si riavvia (circa un minuto)." ;;

	riavvia)
		reboot_later
		done_to stato "Riavvio in corso: la pagina tornerà disponibile tra circa un minuto." ;;

	spegni)
		poweroff_later
		done_to stato "Spegnimento in corso. Puoi staccare la corrente quando il computer si è spento." ;;

	*) done_to audio "Azione sconosciuta." ;;
esac
