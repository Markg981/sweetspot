#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# Sweetspot - pagina "Sistema": nome, modalità, processore, accesso remoto,
# riavvio e spegnimento.

. "${SWEETSPOT_LIB:-/usr/lib/sweetspot}/web.sh"

page_start "Sistema" sistema

cpu_layout

# Dove sono adesso le copertine (lo scrive sweetspot-lms all'avvio).
artwork_status() {
	local pos dir cap used motivo
	IFS='|' read -r pos dir cap used motivo < "$RUN/lms.artwork.stato" 2>/dev/null || { echo "Copertine: posizione non ancora nota (Lyrion non è partito)."; return; }
	case "$pos" in
		disco) echo "Copertine su disco ($dir): ${used:-0} MB usati su un tetto di ${cap} MB." ;;
		ram) echo "Copertine in RAM: tetto di ${cap} MB di memoria, ${used:-0} MB usati.${motivo:+ Ripiego in RAM: $motivo.}" ;;
		*) echo "Copertine in RAM senza tetto.${motivo:+ $motivo.}" ;;
	esac
}
echo '<h2>Questo computer</h2><div class="card">'
info_row "" "$(cpu_model)" "$(( $(mem_total_kb) / 1024 )) MB di RAM - classe $(machine_class)"
iso=$(cat "$SYS/devices/system/cpu/isolated" 2>/dev/null)
if [ -n "$iso" ]; then
	info_row OK "Core dedicati all'audio" "riproduzione sul core $LAYOUT_AUDIO, interruzioni USB sul core $LAYOUT_IRQ; il resto del sistema sui core $(join_list "$LAYOUT_HK")"
else
	info_row "" "Core dedicati all'audio" "nessuno (avvio sicuro o processore con un solo core): la riproduzione ha comunque la priorità real-time"
fi
echo '</div>'

m=$(mode)
echo '<h2>Impostazioni</h2><div class="card formcard">'
form_start sistema
cat <<HTML
<label for="nome">Nome del player <span>(come compare nell'app e in Lyrion)</span></label>
<input id="nome" name="nome" maxlength="40" value="$(esc "$(conf NOME_PLAYER Sweetspot)")">

<label for="modo">Modalità</label>
<select id="modo" name="modalita">
$(option completa "Completa: libreria, plugin e interfaccia su questo Sweetspot (come Daphile)" "$m")
$(option player "Solo player: per un Lyrion Music Server su un altro computer" "$m")
</select>
<label for="srv">Server Lyrion <span>(solo player; vuoto = lo cerca da solo)</span></label>
<input id="srv" name="server" autocapitalize="off" autocorrect="off" value="$(esc "$(conf SERVER)")">

<label for="prof">Funzionamento del processore</label>
<select id="prof" name="profilo">
$(option bilanciato "Bilanciato: frequenza fissa intermedia, non dinamica (consigliato)" "$(conf PROFILO bilanciato)")
$(option silenzio "Silenzio: frequenza fissa al minimo, meno consumo e calore" "$(conf PROFILO bilanciato)")
$(option prestazioni "Prestazioni: frequenza fissa alla nominale" "$(conf PROFILO bilanciato)")
$(option dinamico "Dinamico: frequenza che segue il carico, stati di riposo profondi (core audio esclusi)" "$(conf PROFILO bilanciato)")
</select>

<label for="asc">Modalità ascolto <span>(vale subito)</span></label>
<select id="asc" name="ascolto">
$(option puro "Ascolto puro: brani della coda in RAM, dischi fermi, lavori di fondo sospesi (consigliato)" "$(listening_choice)")
$(option si "Lavori di fondo sospesi mentre la musica suona, brani letti dal disco" "$(listening_choice)")
$(option no "Spenta: i lavori di fondo continuano anche durante la musica" "$(listening_choice)")
</select>

<label for="upnp">Renderer UPnP/DLNA <span>(vale subito)</span></label>
<select id="upnp" name="renderer_upnp">
$(option no "Spento" "$(conf RENDERER_UPNP no)")
$(option si "Acceso: BubbleUPnP, JPlay, mconnect e le altre app UPnP/DLNA vedono Sweetspot come diffusore" "$(conf RENDERER_UPNP no)")
</select>
<p class="sub">L'audio passa da Lyrion e dal player, come la musica della libreria: nessun altro programma apre il DAC. Solo con la modalità completa.</p>

<label for="dlna">Media server UPnP/DLNA <span>(vale subito)</span></label>
<select id="dlna" name="server_upnp">
$(option no "Spento" "$(conf SERVER_UPNP no)")
$(option si "Acceso: streamer e DAC di rete (es. Gustard, con BubbleUPnP o mconnect) leggono la libreria" "$(conf SERVER_UPNP no)")
</select>
<p class="sub">I file partono senza conversioni: DSF e DFF arrivano al renderer in DSD, alla frequenza del file, se il renderer li accetta. I file aggiunti alle cartelle di rete da altri computer compaiono dopo aver spento e riacceso il server. Solo con la modalità completa.</p>

<label for="cop">Cache delle copertine <span>(vale dal prossimo avvio)</span></label>
<select id="cop" name="cache_copertine">
$(option auto "Automatica: sull'archivio musicale se c'è, altrimenti in RAM" "$(conf CACHE_COPERTINE auto)")
$(option ram "RAM: con un tetto di memoria, si perde a ogni avvio, i dischi non si svegliano" "$(conf CACHE_COPERTINE auto)")
$(option archivio "Archivio musicale: resta tra un avvio e l'altro" "$(conf CACHE_COPERTINE auto)")
$(option disco "Un altro disco o SSD scrivibile (scelto qui sotto)" "$(conf CACHE_COPERTINE auto)")
</select>
<label for="copd">Disco per le copertine <span>(solo con "Un altro disco")</span></label>
<input id="copd" name="cache_copertine_disco" autocapitalize="off" autocorrect="off" value="$(esc "$(conf CACHE_COPERTINE_DISCO)")" list="copdl">
<datalist id="copdl">$(awk -F'|' '{ gsub(/[&<>"]/, ""); print "<option value=\"" $1 "\">" }' "$RUN/dischi.list" 2>/dev/null)</datalist>
<label for="copm">Tetto sul disco <span>(MB, auto = 1024; oltre il tetto la cache si azzera)</span></label>
<input id="copm" name="cache_copertine_mb" inputmode="numeric" maxlength="6" value="$(esc "$(conf CACHE_COPERTINE_MB auto)")">
<p class="sub">$(esc "$(artwork_status)")</p>

<details>
<summary>Opzioni per esperti</summary>
<label for="ssh">Accesso SSH</label>
<select id="ssh" name="ssh">
$(option no "Spento" "$(if is_yes "$(conf SSH no)"; then echo si; else echo no; fi)")
$(option si "Acceso" "$(if is_yes "$(conf SSH no)"; then echo si; else echo no; fi)")
</select>
<label for="sshu">Utente SSH</label>
<select id="sshu" name="ssh_utente">
$(option assistenza "assistenza: utente senza privilegi (consigliato)" "$(lower "$(conf SSH_UTENTE assistenza)")")
$(option root "root: accesso completo al sistema" "$(lower "$(conf SSH_UTENTE assistenza)")")
</select>
<label for="sshp">Password SSH <span>(lascia vuoto per non cambiarla)</span></label>
<input id="sshp" name="ssh_password" type="password" autocomplete="new-password">
<small>Almeno 12 caratteri; vuoto = nessuna modifica (o solo chiavi).</small>
$([ -n "$(conf PASSWORD_WEB)" ] ||
	echo '<p class="sub">Per cambiare l'"'"'accesso SSH da qui imposta prima una password per queste pagine: SSH apre il sistema come amministratore e la modifica richiede di riscriverla. In alternativa scrivi SSH nel file sweetspot.txt con il computer.</p>')
<label for="webp">Password di queste pagine <span>(utente admin; lascia vuoto per non cambiarla)</span></label>
<input id="webp" name="web_password" type="password" autocomplete="new-password">
<p class="sub">Ogni pagina chiede la password; vale subito e non si può togliere da qui (minimo 10 caratteri). Se la dimentichi, togli la riga PASSWORD_WEB da sweetspot.txt sulla chiavetta: al riavvio il codice di primo accesso (file PRIMO-ACCESSO.txt) permette di sceglierne una nuova.</p>
$(if [ -n "$(conf PASSWORD_WEB)" ]; then
	printf '<input type="hidden" name="ct" value="%s">\n' "$(esc "$(confirm_token)")"
	echo '<label for="cpw">Conferma con la password attuale di queste pagine <span>(serve solo se cambi accesso SSH, utente o password SSH, o la password di queste pagine)</span></label>'
	echo '<input id="cpw" name="conferma_password" type="password" autocomplete="current-password">'
fi)
$(lyr=$(priv sweetspot-lms credenziali 2>/dev/null)
lyr_st=$(printf '%s\n' "$lyr" | sed -n 's/^stato=//p')
lyr_u=$(printf '%s\n' "$lyr" | sed -n 's/^utente=//p')
lyr_p=$(printf '%s\n' "$lyr" | sed -n 's/^password=//p')
echo '<h3>Accesso a Lyrion (porta 9000, app e CLI)</h3>'
case "$lyr_st" in
	preesistente) echo '<p class="sub">Lyrion ha credenziali già presenti che Sweetspot ha conservato senza cambiarle e non conosce: per usare Sweetspot con Lyrion scegli qui sotto una password nuova (utente sweetspot), oppure scrivi le tue LYRION_UTENTE e LYRION_PASSWORD in sweetspot.txt.</p>' ;;
	"") echo '<p class="sub">Stato della protezione di Lyrion non disponibile.</p>' ;;
	*) printf '<p class="sub">Lyrion chiede utente e password (anche Material Skin e le app JSON/CLI). Utente: <code>%s</code>.' "$(esc "$lyr_u")"
	   echo ' Inseriscili nelle app (Squeezer, iPeng, Material come app) quando li chiedono. I player (porta 3483) non usano la password: la porta resta protetta solo dalla rete di casa.</p>'
	   [ -n "$lyr_p" ] && printf '<details><summary>Mostra la password di Lyrion</summary><p><code>%s</code></p></details>\n' "$(esc "$lyr_p")" ;;
esac
if [ -n "$lyr_st" ]; then
	echo '<label for="lyrp">Nuova password di Lyrion <span>(lascia vuoto per non cambiarla)</span></label>'
	echo '<input id="lyrp" name="lyrion_password" type="password" autocomplete="new-password" minlength="10" maxlength="64">'
	echo '<p class="sub">Da 10 a 64 caratteri, senza spazi e senza il segno %. Lyrion si riavvia per applicarla (la musica in corso si ferma) e va reinserita nelle app e in Material.</p>'
fi)
<label for="https">Connessione protetta (HTTPS)</label>
<select id="https" name="https">
$(option no "Spenta: pagine solo in chiaro (http)" "$(if is_yes "$(conf HTTPS no)"; then echo si; else echo no; fi)")
$(option si "Accesa: anche https://$(web_host)/ con certificato autofirmato" "$(if is_yes "$(conf HTTPS no)"; then echo si; else echo no; fi)")
</select>
<label for="httpsr">Pagine in chiaro</label>
<select id="httpsr" name="https_reindirizza">
$(option no "Restano raggiungibili (http)" "$(if is_yes "$(conf HTTPS_REINDIRIZZA no)"; then echo si; else echo no; fi)")
$(option si "Rimandano a https (se HTTPS e' accesa)" "$(if is_yes "$(conf HTTPS_REINDIRIZZA no)"; then echo si; else echo no; fi)")
</select>
<p class="sub">Il certificato lo crea Sweetspot al primo avvio con HTTPS accesa e resta sulla chiavetta: il browser avvisa che non e' di un ente riconosciuto, e va accettato una volta. $(if [ -s "$RUN/https.impronta" ]; then printf 'Impronta SHA-256 da confrontare: <code>%s</code>.' "$(esc "$(cat "$RUN/https.impronta")")"; fi) Con HTTPS accesa il cookie di accesso viaggia solo cifrato. Lyrion (porta 9000) resta in chiaro. Il rimando a https non vale per i comandi dati dal computer stesso.</p>
<label for="ott">Ottimizzazioni del sistema</label>
<select id="ott" name="ottimizzazioni">
$(option si "Attive: core dedicati, frequenza fissa, interruzioni isolate (consigliato)" "$(conf OTTIMIZZAZIONI si)")
$(option no "Spente: per provare se un problema dipende da loro" "$(conf OTTIMIZZAZIONI si)")
</select>
</details>
<p class="sub">Nome e modalità ascolto valgono subito; il resto dal prossimo avvio.</p>
<button class="primary">Salva</button>
</form>
</div>
HTML

# --- Versione e aggiornamenti -------------------------------------------------------
st=$(priv sweetspot-aggiorna stato)
sv() { printf '%s\n' "$st" | sed -n "s/^$1=//p" | tail -n 1; }
ver=$(sv versione)
slot=$(sv copia)
upper() { printf '%s' "$1" | tr 'ab' 'AB'; }
job=$(sv lavoro)
jstate=${job%%|*}
jmsg=${job#*|}
avail=$(sv disponibile_versione)
echo '<h2>Versione e aggiornamenti</h2><div class="card">'
info_row OK "Sweetspot $ver" "in uso la copia $(upper "$slot") del sistema"
if [ -n "$(sv fallita)" ]; then
	info_row ATTENZIONE "L'aggiornamento a $(sv fallita) non è partito" "Sweetspot è tornato da solo alla versione di prima: la musica e le impostazioni sono al loro posto. Puoi riprovare più tardi."
	[ -n "$(sv fallita_controllo)" ] && info_row ATTENZIONE "Controllo fallito: $(sv fallita_controllo | cut -d'|' -f1)" "$(sv fallita_controllo | cut -d'|' -f2-)"
fi
[ -n "$(sv riuscita)" ] && info_row OK "Aggiornamento riuscito" "Questa versione si è avviata correttamente ed è ora quella in uso."
if [ -n "$(sv predefinita)" ] && [ "$(sv predefinita)" != "$slot" ] && [ -z "$(sv prova)" ]; then
	printf '<div class="row ATTENZIONE"><span class="dot"></span><div class="grow"><div class="k">Stai usando l%sversione scelta dal menu di avvio</div><div class="v">Alla prossima accensione partirà l%saltra, a meno che tu non scelga questa.</div></div>' "'" "'"
	button aggiorna_predefinita "Usa sempre questa"
	echo '</div>'
fi
case "$jstate" in
	scarica|controlla)
		tot=$(sv totale); done_kb=$(sv progresso); pct=0
		[ "${tot:-0}" -gt 0 ] 2>/dev/null && pct=$(( ${done_kb:-0} * 100 / tot ))
		[ "$pct" -gt 100 ] && pct=100
		[ "$jstate" = controlla ] && pct=100
		echo '<div class="row ATTENZIONE"><span class="dot"></span><div class="grow">'
		if [ "$jstate" = scarica ]; then
			printf '<div class="k">Aggiornamento in corso</div><div class="v">%s%% - mentre la musica suona si sospende e riprende da solo</div>' "$pct"
		else
			echo '<div class="k">Controllo dell'"'"'aggiornamento</div><div class="v">verifica del pacchetto (SHA-256)</div>'
		fi
		printf '<progress max="100" value="%s"></progress>' "$pct"
		button aggiorna_annulla "Annulla" "" "" danger
		echo '</div></div><meta http-equiv="refresh" content="5">' ;;
	pronto)
		printf '<div class="row OK"><span class="dot"></span><div class="grow"><div class="k">Versione %s pronta</div><div class="v">Riavvia per usarla. Se non dovesse partire, Sweetspot torna da solo a questa versione.</div></div>' "$(esc "$jmsg")"
		button riavvia "Riavvia ora" "" "" primary
		echo '</div>' ;;
	errore) info_row ATTENZIONE "Aggiornamento non riuscito" "$jmsg" ;;
	spazio)
		printf '<div class="row ATTENZIONE"><span class="dot"></span><div class="grow"><div class="k">Aggiornamento non avviato: manca spazio</div><div class="v">%s</div></div>' "$(esc "$jmsg")"
		button aggiorna_libera "Cancella la versione precedente" "" "" danger
		echo '</div>' ;;
esac
if [ "$jstate" != scarica ] && [ "$jstate" != controlla ] && [ "$jstate" != pronto ]; then
	if [ -n "$avail" ] && [ "$avail" != "$ver" ]; then
		printf '<div class="row"><span class="dot"></span><div class="grow"><div class="k">Disponibile Sweetspot %s</div><div class="v">pubblicata il %s</div>' \
			"$(esc "$avail")" "$(esc "$(sv disponibile_data)")"
		if [ -s "$RUN/aggiornamento/note" ]; then
			printf '<details><summary>Novità</summary><pre class="note">%s</pre></details>' "$(esc "$(cat "$RUN/aggiornamento/note")")"
		fi
		echo '</div>'
		button aggiorna_scarica "Aggiorna" "" "" primary
		echo '</div>'
	elif [ -n "$avail" ]; then
		info_row OK "Hai l'ultima versione" "Nessun aggiornamento disponibile."
	fi
	priv sweetspot-aggiorna pacchetti | while IFS= read -r f; do
		printf '<div class="row"><span class="dot"></span><div class="grow"><div class="k">Pacchetto di aggiornamento su disco</div><div class="v">%s</div></div>' "$(esc "${f#"$MEDIA_DIR"/}")"
		# Sostituisce il sistema: conferma forte (password attuale + gettone).
		if [ -n "$(conf PASSWORD_WEB)" ]; then
			printf '<form method="post" action="/cgi-bin/azione" class="inline">'
			printf '<input type="hidden" name="t" value="%s"><input type="hidden" name="a" value="aggiorna_file">' "$(token)"
			printf '<input type="hidden" name="file" value="%s"><input type="hidden" name="ct" value="%s">' "$(esc "$f")" "$(esc "$(confirm_token)")"
			echo '<input name="conferma_password" type="password" autocomplete="current-password" required placeholder="Password di queste pagine" aria-label="Conferma con la password attuale di queste pagine">'
			echo '<label><input type="checkbox" name="consenti_downgrade" value="si"> Consenti una versione più vecchia di quella in uso (downgrade)</label>'
			echo '<button>Installa</button></form>'
		else
			echo '<div class="v">Per installarlo da qui imposta prima una password per queste pagine.</div>'
		fi
		echo '</div>'
	done
	other=$(sv altra_versione)
	# L'altra copia e' quella che non e' partita: non si propone.
	if [ -n "$other" ] && [ "$other" != "$(sv fallita)" ]; then
		printf '<div class="row"><span class="dot"></span><div class="grow"><div class="k">Altra versione installata: %s</div><div class="v">resta pronta: puoi tornare a questa quando vuoi</div></div>' "$(esc "$other")"
		printf '<form method="post" action="/cgi-bin/azione" class="inline" onsubmit="return %s">' \
			"$(esc "confirm(\"Riavviare Sweetspot con la versione $other?\")")"
		printf '<input type="hidden" name="t" value="%s"><input type="hidden" name="a" value="aggiorna_altra">' "$(token)"
		echo '<button>Riavvia con questa</button></form></div>'
	fi
	echo '<div class="row"><div class="grow">'
	button aggiorna_cerca "Cerca aggiornamenti"
	echo '<p class="sub">Gli aggiornamenti arrivano da GitHub e si installano accanto alla versione in uso, che resta come riserva. Senza internet: scarica il pacchetto con il computer e copialo su un disco collegato (o nella cartella di rete Musica).</p></div></div>'
fi
echo '</div>'

# --- Installazione sul disco interno (solo PC: il Raspberry Pi parte gia'
# dalla sua scheda SD) ------------------------------------------------------------
installed=""
if [ "$(boot_type)" = grub ]; then
ist=$(priv sweetspot-installa stato)
istate=${ist%%|*}; irest=${ist#*|}
istep=${irest%%|*}; irest=${irest#*|}
itot=${irest%%|*}; imsg=${irest#*|}
bootdisk=$(stick_disk)
echo '<h2>Installazione sul disco interno</h2><div class="card formcard">'
case "$istate" in
	prepara|partizioni|formatta|copia|impostazioni|controllo|avvio)
		pct=$(( ${istep:-0} * 100 / ${itot:-7} ))
		printf '<p><b>Installazione in corso</b>: %s</p><progress max="100" value="%s"></progress>' "$(esc "$imsg")" "$pct"
		echo '<p class="sub">Non spegnere il computer. Mentre la musica suona l'"'"'installazione si sospende.</p><meta http-equiv="refresh" content="5">'
		echo '</div>'
		page_end
		exit 0 ;;
	finita)
		case "$imsg" in
		accanto*)
			# "accanto DISCO si|no": si = voce "Sweetspot" creata nella NVRAM UEFI.
			cat <<'HTML'
<p class="msg">Sweetspot è installato accanto al sistema che c'era già: le altre partizioni non sono state toccate.</p>
<p>Ora: <b>spegni</b>, <b>togli la chiavetta</b> e riaccendi. Parte il menu di Sweetspot: la prima voce avvia Sweetspot,
la voce <b>Windows</b> (se sul computer c'è Windows) avvia Windows.</p>
HTML
			if [ "${imsg##* }" = no ]; then
				echo '<p class="sub">La voce di avvio UEFI non è stata creata (il firmware non lo permette da qui): all'"'"'accensione apri il menu di avvio del computer e scegli <b>Sweetspot</b> o il disco interno, oppure aggiungi la voce da Windows con bcdedit (README, "Installazione accanto a Windows").</p>'
			else
				echo '<p class="sub">Se parte direttamente Windows, Windows si è rimesso primo nell'"'"'ordine di avvio: all'"'"'accensione apri il menu di avvio del computer e scegli <b>Sweetspot</b>, o rimettilo primo nel BIOS/UEFI. Il Secure Boot resta spento, come per la chiavetta.</p>'
			fi
			button spegni "Spegni" "" "" primary
			echo '</div>'
			page_end
			exit 0 ;;
		esac
		cat <<'HTML'
<p class="msg">Sweetspot è installato sul disco interno.</p>
<p>Ora: <b>spegni</b>, <b>togli la chiavetta</b> e riaccendi. Sweetspot partirà dal disco, con le stesse impostazioni, plugin e libreria.</p>
<p class="sub">Se il computer non parte dal disco, all'accensione apri il menu di avvio o il BIOS/UEFI e scegli il disco come primo dispositivo
(su UEFI tieni spento il Secure Boot, come per la chiavetta). La chiavetta resta valida: puoi conservarla come copia di riserva.</p>
HTML
		button spegni "Spegni" "" "" primary
		echo '</div>'
		page_end
		exit 0 ;;
	errore) printf '<p class="msg">Installazione non riuscita: %s.</p>' "$(esc "$imsg")" ;;
esac
installed=""
if [ -n "$bootdisk" ] && ! readlink -f "$SYS/block/$bootdisk" 2>/dev/null | grep -q /usb; then
	installed=1
	printf '<p>Sweetspot è installato su questo computer e parte dal disco interno (%s).</p>\n<details><summary>Installa su un altro disco</summary>\n' "$(esc "$bootdisk")"
fi
cat <<'HTML'
<p class="sub">Come su Daphile: Sweetspot si copia sul disco del computer e da lì parte da solo, senza chiavetta.
Il sistema lavora comunque tutto in RAM: il disco si legge solo all'accensione e si scrive solo per salvare impostazioni e libreria.
Il resto del disco può diventare l'archivio musicale, per i CD copiati e la musica copiata dal computer.
<b>Tutto ciò che c'è ora sul disco scelto viene cancellato.</b></p>
HTML
n=0
disks=$(priv sweetspot-installa dischi)
# Cancellare un disco chiede la password di queste pagine (conferma forte):
# senza password impostata si installa solo dopo averla scelta.
webpw=""
[ -n "$(conf PASSWORD_WEB)" ] && webpw=1
[ -n "$disks" ] && [ -z "$webpw" ] && echo '<p class="sub">Per installare imposta prima una password per queste pagine (Opzioni per esperti): cancellare un disco richiede di riscriverla.</p>'
while IFS='|' read -r d gb model bus contents arch; do
	[ -n "$d" ] || continue
	n=$((n + 1))
	printf '<div class="row"><span class="dot"></span><div class="grow"><div class="k">%s</div><div class="v">%s, %s GB (%s) - %s</div>\n' \
		"$(esc "$model")" "$(esc "$d")" "$gb" "$(esc "$bus")" "$(esc "${contents:-vuoto}")"
	if [ -z "$webpw" ]; then
		echo '</div></div>'
		continue
	fi
	printf '<form method="post" action="/cgi-bin/azione" onsubmit="return %s">\n' \
		"$(esc "confirm(\"Cancellare TUTTO il contenuto di $(printf '%s' "$model" | tr -d '"\\') ($d, $gb GB) e installare Sweetspot?\")")"
	printf '<input type="hidden" name="t" value="%s"><input type="hidden" name="a" value="installa"><input type="hidden" name="disco" value="%s">\n' "$(token)" "$(esc "$d")"
	if [ "$arch" = si ]; then
		echo '<label class="check"><input type="checkbox" name="archivio" value="si" checked> Usa il resto del disco come archivio musicale</label>'
	fi
	echo '<label class="check"><input type="checkbox" name="conferma" value="si" required> Ho capito: il contenuto del disco verrà cancellato</label>'
	printf '<input type="hidden" name="ct" value="%s">\n' "$(esc "$(confirm_token)")"
	printf '<label for="dim-%s">Scrivi la dimensione del disco <span>(%s, in GB)</span></label>\n' "$(esc "$d")" "$gb"
	printf '<input id="dim-%s" name="dimensione" inputmode="numeric" pattern="[0-9]+" autocomplete="off" required>\n' "$(esc "$d")"
	printf '<label for="cpw-%s">Password di queste pagine</label>\n' "$(esc "$d")"
	printf '<input id="cpw-%s" name="conferma_password" type="password" autocomplete="current-password" required>\n' "$(esc "$d")"
	echo '<button class="danger">Installa su questo disco</button></form></div></div>'
done <<EOF2
$disks
EOF2
[ $n -eq 0 ] && info_row "" "Nessun disco adatto" "Serve un disco interno (o USB) di almeno 2 GB, diverso da quello da cui parte Sweetspot."
[ -n "$installed" ] && echo '</details>'
echo '</div>'

# --- Accanto al sistema che c'e' gia' (Windows, Linux): solo spazio libero.
echo '<h2>Installazione accanto a Windows</h2><div class="card formcard">'
cat <<'HTML'
<p class="sub">Sweetspot si aggiunge al disco senza cancellare nulla: crea una partizione da 4 GB nello <b>spazio libero</b>
e una voce di avvio. All'accensione un menu chiede se avviare Sweetspot o Windows.
Le partizioni che ci sono già non vengono toccate né ridimensionate: se il disco è tutto occupato, prima libera almeno 4 GB
da Windows (Gestione disco, "Riduci volume") e poi torna qui. Serve un disco GPT e la chiavetta avviata in modalità UEFI.
Prima di cambiare le partizioni di un disco conviene comunque avere una copia dei dati importanti.</p>
<p class="sub"><b>BitLocker:</b> se Windows è cifrato, avviarlo dal menu di Sweetspot (con il Secure Boot spento) cambia le misure del TPM e
Windows può chiedere la chiave di ripristino a 48 cifre. Prima di procedere verifica di averla (account Microsoft o l'amministratore del computer),
oppure sospendi la protezione da Windows. Per evitarlo avvia Windows dal menu di avvio del computer (F12, F11, F8 o Esc) e non da qui.</p>
HTML
if [ ! -d "$SYS/firmware/efi" ]; then
	info_row "" "Avvio non UEFI" "Sweetspot è partito in modalità BIOS (legacy): riavvia la chiavetta in modalità UEFI per installarlo accanto a Windows."
else
	n=0
	sdisks=$(priv sweetspot-installa accanto)
	[ -n "$sdisks" ] && [ -z "$webpw" ] && echo '<p class="sub">Per installare imposta prima una password per queste pagine (Opzioni per esperti).</p>'
	while IFS='|' read -r d gb model bus contents free; do
		[ -n "$d" ] || continue
		n=$((n + 1))
		printf '<div class="row"><span class="dot"></span><div class="grow"><div class="k">%s</div><div class="v">%s, %s GB (%s), %s GB liberi - %s</div>\n' \
			"$(esc "$model")" "$(esc "$d")" "$gb" "$(esc "$bus")" "$free" "$(esc "${contents:-vuoto}")"
		if [ -z "$webpw" ]; then
			echo '</div></div>'
			continue
		fi
		printf '<form method="post" action="/cgi-bin/azione" onsubmit="return %s">\n' \
			"$(esc "confirm(\"Installare Sweetspot nello spazio libero di $(printf '%s' "$model" | tr -d '"\\') ($d)? Le altre partizioni non vengono toccate.\")")"
		printf '<input type="hidden" name="t" value="%s"><input type="hidden" name="a" value="affianca"><input type="hidden" name="disco" value="%s">\n' "$(token)" "$(esc "$d")"
		echo '<label class="check"><input type="checkbox" name="conferma" value="si" required> Ho capito: si aggiunge una partizione da 4 GB nello spazio libero e una voce di avvio</label>'
		printf '<input type="hidden" name="ct" value="%s">\n' "$(esc "$(confirm_token)")"
		printf '<label for="sdim-%s">Scrivi la dimensione del disco <span>(%s, in GB)</span></label>\n' "$(esc "$d")" "$gb"
		printf '<input id="sdim-%s" name="dimensione" inputmode="numeric" pattern="[0-9]+" autocomplete="off" required>\n' "$(esc "$d")"
		printf '<label for="scpw-%s">Password di queste pagine</label>\n' "$(esc "$d")"
		printf '<input id="scpw-%s" name="conferma_password" type="password" autocomplete="current-password" required>\n' "$(esc "$d")"
		echo '<button>Installa accanto</button></form></div></div>'
	done <<EOF2
$sdisks
EOF2
	[ $n -eq 0 ] && info_row "" "Nessun disco con spazio libero" "Serve un disco GPT con almeno 4 GB non assegnati a nessuna partizione, diverso da quello da cui parte Sweetspot."
fi
echo '</div>'

fi
cat <<HTML
<h2>Accensione</h2>
<div class="card formcard">
<p class="sub">Spegni Sweetspot da qui prima di staccare la corrente: libreria, plugin e impostazioni vengono salvati sulla $(if [ "$(boot_type)" = rpi ]; then echo "scheda SD"; elif [ -n "$installed" ]; then echo "partizione di sistema del disco"; else echo chiavetta; fi).</p>
HTML
button riavvia "Riavvia"
button spegni "Spegni" "" "" danger
echo '</div>'

echo '<h2>Diagnostica</h2><div class="card formcard">'
cat <<'HTML'
<p class="sub">Registro e timeline degli eventi (avvii, riavvii del player e di Lyrion, XRUN, cambi di frequenza, aggiornamenti, rollback, montaggi) restano sulla chiavetta anche dopo il riavvio, insieme ai crash dump del kernel. Il pacchetto da allegare a una segnalazione contiene anche versioni, <code>aplay -l</code>, <code>/proc/asound</code> e lo stato; password, chiavi e token sono oscurati.</p>
<a class="btn" href="/cgi-bin/diagnostica">Scarica il pacchetto diagnostico (tar.gz)</a>
</div>
HTML

echo '<h2>Impostazioni iniziali</h2><div class="card formcard">'
form_start ripristina
cat <<'HTML'
<p class="sub">Riporta sweetspot.txt com'era alla prima accensione: modalità, audio, rete (anche il Wi-Fi), password e opzioni tornano quelle iniziali, poi Sweetspot si riavvia. Musica, archivio, libreria di Lyrion e filtri della correzione restano.</p>
<label class="check"><input type="checkbox" name="conferma" value="si" required> Ho capito: tutte le impostazioni torneranno quelle iniziali</label>
HTML
