#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# Sweetspot - pagina "Musica": da dove arriva la libreria.

. "${SWEETSPOT_LIB:-/usr/lib/sweetspot}/web.sh"

page_start "Musica" musica

if [ "$(mode)" = player ]; then
	cat <<HTML
<p class="sub">Sweetspot è in modalità solo player: la libreria e la scelta dei brani
sono sul server Lyrion dell'altro computer. Per avere libreria, plugin e
interfaccia qui, passa alla modalità completa in <a href="/cgi-bin/sistema">Sistema</a>.</p>
HTML
	page_end
	exit 0
fi

# --- Libreria ---------------------------------------------------------------------
r=$(lms_json '' serverstatus 0 0)
songs=$(printf '%s' "$r" | jq -r '.result."info total songs" // empty' 2>/dev/null)
albums=$(printf '%s' "$r" | jq -r '.result."info total albums" // 0' 2>/dev/null)
artists=$(printf '%s' "$r" | jq -r '.result."info total artists" // 0' 2>/dev/null)
scanning=$(printf '%s' "$r" | jq -r '.result.rescan // 0' 2>/dev/null)
progress=$(printf '%s' "$r" | jq -r 'if .result.progressname then "\(.result.progressname) \(.result.progressdone // 0)/\(.result.progresstotal // 0)" else "" end' 2>/dev/null)

echo '<h2>Libreria</h2><div class="card"><div class="row"><div class="grow">'
if [ -z "$r" ]; then
	echo '<div class="k">Lyrion si sta avviando</div><div class="v">La pagina si aggiorna da sola tra poco.</div>'
	echo '<meta http-equiv="refresh" content="10">'
else
	printf '<div class="k">%s brani, %s album, %s artisti</div>' "${songs:-0}" "$albums" "$artists"
	if [ "$scanning" = 1 ]; then
		printf '<div class="v">Lettura della libreria in corso%s: la pagina si aggiorna da sola.</div>' "$(esc "${progress:+ ($progress)}")"
		echo '<meta http-equiv="refresh" content="10">'
	else
		echo '<div class="v">Sweetspot legge i dischi e le cartelle qui sotto. I dischi USB collegati vengono aggiunti da soli; dopo aver copiato musica nuova premi Aggiorna.</div>'
	fi
	echo '<div>'
	button aggiorna "Aggiorna la libreria" "" "" primary
	button ricostruisci "Ricostruisci da zero"
	echo '</div>'
fi
echo '</div></div></div>'

# --- Dischi -------------------------------------------------------------------------
echo '<h2>Dischi</h2><div class="card">'
n=0
if [ -s "$RUN/dischi.list" ]; then
	while IFS='|' read -r name _dev type gb links how _id; do
		n=$((n + 1))
		printf '<div class="row OK"><span class="dot"></span><div class="grow"><div class="k">%s</div>' "$(esc "$name")"
		access="sola lettura"
		[ "$how" = rw ] && access="archivio scrivibile"
		printf '<div class="v">%s, %s GB, %s. In libreria: %s</div></div>' \
			"$(esc "$type")" "$gb" "$access" "$(esc "${links:-nessuna cartella con musica}")"
		button escludi_disco "Escludi" nome "$name" danger
		echo '</div>'
	done < "$RUN/dischi.list"
fi
for e in $(conf ESCLUDI_DISCHI | tr ',' ' '); do
	n=$((n + 1))
	printf '<div class="row"><span class="dot"></span><div class="grow"><div class="k">%s</div><div class="v">Escluso dalla libreria</div></div>' "$(esc "$e")"
	button includi_disco "Includi" nome "$e"
	echo '</div>'
done
if [ $n -eq 0 ]; then
	echo '<div class="row"><div class="grow"><div class="v">Nessun disco con musica trovato. Puoi collegare un disco USB: viene aggiunto da solo.</div></div></div>'
fi
echo '</div>'

# --- Cartelle di rete ---------------------------------------------------------------------
echo '<h2>Cartelle condivise in rete</h2><div class="card">'
n=0
for i in 1 2 3 4 5 6 7 8 9; do
	path=$(conf "CONDIVISIONE_$i")
	[ -n "$path" ] || continue
	n=$((n + 1))
	line=$(grep "^$i|" "$RUN/rete.list" 2>/dev/null | head -n 1)
	state=$(printf '%s' "$line" | cut -d'|' -f3)
	detail=$(printf '%s' "$line" | cut -d'|' -f4-)
	user=$(conf "CONDIVISIONE_${i}_UTENTE")
	if [ "$state" = OK ]; then cls=OK; else cls=ATTENZIONE; fi
	# Non montata ma con ritentativi in corso (sweetspot-rete ritenta)
	next=$(grep "^$i|" "$RUN/rete.attesa" 2>/dev/null | head -n 1 | cut -d'|' -f3)
	if [ "$state" != OK ] && [ -n "$next" ]; then
		left=$(( next - $(date +%s) ))
		[ $left -lt 0 ] && left=0
		detail="$detail. In attesa: nuovo tentativo tra circa $(( (left + 59) / 60 )) min"
	fi
	printf '<div class="row %s"><span class="dot"></span><div class="grow"><div class="k">%s</div>' "$cls" "$(esc "$path")"
	proto=SMB
	is_nfs "$path" && proto=NFS
	smb1=""
	is_yes "$(conf "CONDIVISIONE_${i}_SMB1" no)" && smb1=", SMB1 ammesso (insicuro)"
	printf '<div class="v">%s, %s%s%s</div></div>' "$(esc "${detail:-in collegamento}")" "$proto" "$(esc "${user:+, utente $user}")" "$smb1"
	button rimuovi_condivisione "Rimuovi" n "$i" danger
	echo '</div>'
done
[ $n -eq 0 ] && echo '<div class="row"><div class="grow"><div class="v">Nessuna cartella di rete. Aggiungi qui sotto quella del NAS o del computer con la musica.</div></div></div>'
echo '</div>'

cat <<HTML
<div class="card formcard">
<form method="post" action="/cgi-bin/azione">
<input type="hidden" name="t" value="$(token)">
<input type="hidden" name="a" value="aggiungi_condivisione">
<label for="prot">Tipo di cartella</label>
<select id="prot" name="protocollo">
<option value="smb" selected>SMB: NAS, PC Windows, Mac (Condivisione di rete)</option>
<option value="nfs">NFS: NAS e server Linux (esportazione NFS)</option>
</select>
<label for="srv">Indirizzo del NAS o del computer <span>(meglio l'indirizzo IP, es. 192.168.1.10)</span></label>
<input id="srv" name="server" required autocapitalize="off" autocorrect="off" placeholder="192.168.1.10">
<label for="dir">Cartella condivisa <span>(SMB: Musica o Musica/FLAC; NFS: il percorso esportato, es. export/musica)</span></label>
<input id="dir" name="cartella" required autocapitalize="off" placeholder="Musica">
<label for="usr">Utente <span>(solo SMB; vuoto se la cartella è aperta a tutti)</span></label>
<input id="usr" name="utente" autocapitalize="off" autocorrect="off" autocomplete="off">
<label for="pwd">Password</label>
<input id="pwd" name="password" type="password" autocomplete="new-password">
<label for="smb1">Vecchi NAS <span>(solo SMB)</span></label>
<select id="smb1" name="smb1">
<option value="no" selected>Solo SMB 2.1 o più recente (consigliato)</option>
<option value="si">Ammetti anche SMB1: INSICURO, solo per NAS molto vecchi</option>
</select>
<p class="sub">SMB1 è un protocollo obsoleto e insicuro (senza firma né cifratura, attaccabile
da chiunque sia nella rete): usalo solo se il NAS non supporta altro, meglio ancora aggiornando il NAS.
Sweetspot legge soltanto: non modifica e non cancella nulla sul NAS.
Se il NAS si spegne durante l'ascolto, la musica riprende da sola quando torna.
La password resta salvata in sweetspot.txt sulla chiavetta.</p>
<button class="primary">Aggiungi la cartella</button>
</form>
</div>
HTML

page_end
