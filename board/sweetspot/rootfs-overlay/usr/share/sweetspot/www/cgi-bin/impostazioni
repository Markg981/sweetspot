#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# Sweetspot - pagina "Impostazioni".

. "${SWEETSPOT_LIB:-/usr/lib/sweetspot}/web.sh"

# opzione VALORE ETICHETTA VALORE_ATTUALE
option() {
	if [ "$(lower "$3")" = "$1" ]; then sel=' selected'; else sel=''; fi
	printf '<option value="%s"%s>%s</option>' "$1" "$sel" "$(esc "$2")"
}

page_start "Impostazioni" impostazioni

cat <<HTML
<div class="card formcard">
<form method="post" action="/cgi-bin/azione">
<input type="hidden" name="t" value="$(token)">
<input type="hidden" name="a" value="impostazioni">

<label for="nome">Nome del player</label>
<input id="nome" name="nome" maxlength="40" value="$(esc "$(conf NOME_PLAYER Sweetspot)")">

<label for="modo">Modalita'</label>
<select id="modo" name="modalita">
$(option completa "Completa: libreria e interfaccia su Sweetspot (consigliata)" "$(mode)")
$(option lyrion "Lyrion: player per un Lyrion Music Server su un altro computer" "$(mode)")
</select>

<label for="prof">Funzionamento del processore</label>
<select id="prof" name="profilo">
$(option bilanciato "Bilanciato: frequenza fissa intermedia (consigliato)" "$(conf PROFILO bilanciato)")
$(option silenzio "Silenzio: frequenza fissa al minimo, meno consumo e calore" "$(conf PROFILO bilanciato)")
$(option prestazioni "Prestazioni: frequenza fissa alla nominale" "$(conf PROFILO bilanciato)")
</select>

<label for="dsd">DSD</label>
<select id="dsd" name="dsd">
$(option auto "Automatico: nativo se il DAC lo supporta (consigliato)" "$(conf DSD auto)")
$(option nativo "Nativo forzato: per DAC che lo supportano ma non lo dichiarano" "$(conf DSD auto)")
$(option dop "DoP: solo se il DAC lo supporta, altrimenti forte fruscio" "$(conf DSD auto)")
$(option no "Convertito in PCM" "$(conf DSD auto)")
</select>

<p class="sub">Le modifiche vengono salvate sulla chiavetta e valgono dal prossimo avvio.</p>
<button class="primary">Salva</button>
</form>
</div>

<h2>Sistema</h2>
<div class="card formcard">
<p class="sub">Spegni Sweetspot da qui prima di staccare la corrente: libreria e playlist vengono salvate sulla chiavetta.</p>
HTML
button riavvia "Riavvia"
button spegni "Spegni" "" "" danger
echo '</div>'

page_end
