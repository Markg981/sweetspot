#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# Sweetspot - pagina "Audio": il DAC, il formato che gli arriva davvero e le
# impostazioni del percorso del segnale.

. "${SWEETSPOT_LIB:-/usr/lib/sweetspot}/web.sh"

page_start "Audio" audio

card=$(dac_find)
mac=$(cat "$RUN/player.mac" 2>/dev/null)

# --- DAC ---------------------------------------------------------------------------
echo '<h2>DAC</h2><div class="card">'
if [ -z "$card" ]; then
	info_row ATTENZIONE "Nessun DAC USB collegato" "Collega il DAC a una porta USB e accendilo: Sweetspot lo riconosce da solo."
elif [ -z "$(dac_usbid "$card")" ]; then
	# Scheda DAC I2S sul Raspberry Pi: niente descrittori USB, le frequenze
	# le decide il driver della scheda.
	info_row OK "$(dac_name "$card")" "Scheda DAC I2S ($(conf SCHEDA_I2S)) - DSD convertito in PCM"
else
	rates=$(dac_rates "$card")
	maxr=$(last_word "$rates")
	dsd=$(dac_native_dsd "$card")
	if [ -n "$dsd" ]; then dsdtxt="DSD nativo ($dsd)"; else dsdtxt="DSD nativo non dichiarato (DoP o conversione in PCM)"; fi
	info_row OK "$(dac_name "$card")" "USB $(dac_usbid "$card")${maxr:+ - fino a $((maxr / 1000)) kHz} - $dsdtxt"
	[ -n "$rates" ] && info_row "" "Frequenze supportate" "$(printf '%s' "$rates" | tr ' ' '\n' | awk '{printf "%s%g", sep, $1/1000; sep=", "} END {print " kHz"}')"
fi
echo '</div>'

# --- Cosa arriva al DAC adesso --------------------------------------------------------
# Confronto tra il brano (dati di Lyrion) e il formato aperto sul DAC (ALSA):
# stessa frequenza, nessun bit perso, volume fisso e nessun ricampionamento
# = bit-perfect.
verdict() { # formato frequenza canali
	local hwfmt="$1" hwrate="$2" hwch="$3" m out why
	case "$hwfmt" in
		DSD*)
			case "$hwfmt" in DSD_U8) m=8 ;; DSD_U16*) m=16 ;; *) m=32 ;; esac
			info_row OK "DSD nativo" "Il DAC riceve il flusso DSD così com'è: DSD$((hwrate * m / 44100)), $hwch canali ($hwfmt)."
			return ;;
	esac
	out="$(alsa_bits "$hwfmt") bit ($hwfmt), $(awk "BEGIN {printf \"%g\", $hwrate/1000}") kHz, $hwch canali"
	if [ -f "$RUN/correzione.attiva" ]; then
		if [ "$(lower "$(conf CORREZIONE no)")" = confronto ]; then
			info_row ATTENZIONE "Confronto a pari volume" "Il segnale passa per CamillaDSP con la sola attenuazione, senza i filtri. Uscita: $out."
		else
			info_row OK "Correzione ambientale" "I filtri della stanza sono applicati da CamillaDSP in virgola mobile a 64 bit, alla frequenza del brano. Uscita: $out."
		fi
		return
	fi
	case "$src_type" in
		dsf|dff)
			if [ "$src_rate" = "$((hwrate * 16))" ]; then
				info_row OK "DSD via DoP" "Il flusso DSD$((src_rate / 44100)) arriva intatto, impacchettato in PCM ($out)."
			else
				info_row ATTENZIONE "DSD convertito in PCM" "Il DAC riceve PCM: $out."
			fi
			return ;;
	esac
	why=""
	if [ -n "$src_rate" ] && [ "$src_rate" != "$hwrate" ]; then
		why="la frequenza del brano ($src_rate Hz) viene cambiata in $hwrate Hz"
	elif [ -n "$src_bits" ] && [ "$src_bits" -gt "$(alsa_bits "$hwfmt")" ] 2>/dev/null; then
		why="il brano ha $src_bits bit, il DAC ne riceve $(alsa_bits "$hwfmt")"
	elif [ "$(lower "$(conf VOLUME fisso)")" = software ]; then
		why="il volume è regolato dal software"
	elif [ "$(lower "$(conf RICAMPIONAMENTO no)")" != no ]; then
		why="il ricampionamento è attivo"
	fi
	if [ -n "$why" ]; then
		info_row ATTENZIONE "Non bit-perfect" "$why. Uscita: $out."
	elif [ -n "$src_rate" ]; then
		info_row OK "Bit-perfect" "Il DAC riceve esattamente i campioni del file${src_type:+ ($src_type${src_bits:+ $src_bits bit})}: $out."
	else
		info_row OK "Uscita diretta" "$out."
	fi
}

echo '<h2>In riproduzione</h2><div class="card">'
hw=""
[ -n "$card" ] && hw=$(dac_hw_now "$card")
np=""
[ "$(mode)" = completa ] && [ -n "$mac" ] && np=$(lms_now_playing "$mac")
src_rate=$(printf '%s' "$np" | jq -r '.rate // empty' 2>/dev/null)
src_bits=$(printf '%s' "$np" | jq -r '.bits // empty' 2>/dev/null)
src_type=$(printf '%s' "$np" | jq -r '.type // empty' 2>/dev/null)
if [ -z "$hw" ]; then
	info_row "" "Uscita ferma" "Quando la musica suona qui compare il formato che arriva al DAC, con la verifica bit-perfect."
else
	title=$(printf '%s' "$np" | jq -r '[.artist, .title] | map(select(. != "")) | join(" - ")' 2>/dev/null)
	[ -n "$title" ] && info_row "" "Brano" "$title"
	# shellcheck disable=SC2086
	verdict $hw
fi
echo '</div>'

# --- Correzione ambientale ------------------------------------------------------------
echo '<h2>Correzione ambientale</h2><div class="card">'
case "$(lower "$(conf CORREZIONE no)")" in
	si) cst="accesa"; ccl=OK ;;
	confronto) cst="esclusa a pari volume, per il confronto"; ccl=ATTENZIONE ;;
	*) cst="spenta: percorso bit-perfect"; ccl="" ;;
esac
[ -s "$RUN/correzione/sinistro.txt" ] || cst="nessun filtro: si misura la stanza con REW e un microfono di misura"
printf '<div class="row %s"><span class="dot"></span><div class="grow"><div class="k"><a href="/cgi-bin/correzione">Correggi i bassi della stanza</a></div><div class="v">%s</div></div></div>\n' "$ccl" "$(esc "$cst")"
echo '</div>'

# --- Scheda DAC sul Raspberry Pi (I2S) -------------------------------------------------
if [ "$(boot_type)" = rpi ]; then
	cur=$(conf SCHEDA_I2S)
	known=""
	echo '<h2>Scheda DAC sul Raspberry Pi</h2><div class="card formcard">'
	echo '<p class="sub">Per un DAC montato sopra il Raspberry Pi (collegamento I2S). Con un DAC USB lascia "Nessuna".</p>'
	form_start scheda_i2s
	echo '<label for="sch">Scheda</label><select id="sch" name="scheda">'
	option "" "Nessuna: DAC USB" "$cur"
	while IFS='|' read -r ov nome; do
		case "$ov" in ''|'#'*) continue ;; esac
		[ "$ov" = "$cur" ] && known=1
		option "$ov" "$nome" "$cur"
	done < "${SWEETSPOT_SCHEDE_I2S:-/usr/share/sweetspot/schede-i2s.txt}"
	echo '</select>'
	printf '<label for="sov">Altra scheda <span>(nome dell%soverlay, dalle istruzioni del produttore)</span></label>' "'"
	printf '<input id="sov" name="overlay" autocapitalize="off" autocorrect="off" value="%s">\n' "$( [ -n "$cur" ] && [ -z "$known" ] && esc "$cur")"
	echo '<p class="sub">Il Raspberry Pi si riavvia per caricare la scheda.</p><button class="primary">Salva e riavvia</button></form></div>'
fi

# --- Impostazioni -------------------------------------------------------------------
vol=$(lower "$(conf VOLUME fisso)")
rs=$(lower "$(conf RICAMPIONAMENTO no)")
echo '<h2>Impostazioni</h2><div class="card formcard">'
form_start audio
cat <<HTML
<label for="vol">Volume</label>
<select id="vol" name="volume">
$(option fisso "Fisso al 100%: si regola dall'amplificatore (bit-perfect, consigliato)" "$vol")
$(option dac "Dal DAC: usa il controllo di volume del DAC (bit-perfect)" "$vol")
$(option software "Dal software: per diffusori attivi senza volume (non bit-perfect)" "$vol")
</select>

<label for="dsd">DSD</label>
<select id="dsd" name="dsd">
$(option auto "Automatico: nativo se il DAC lo supporta (consigliato)" "$(conf DSD auto)")
$(option nativo "Nativo forzato: per DAC che lo supportano senza dichiararlo" "$(conf DSD auto)")
$(option dop "DoP: solo se il DAC lo supporta, altrimenti forte fruscio" "$(conf DSD auto)")
$(option no "Convertito in PCM" "$(conf DSD auto)")
</select>

<label for="rs">Ricampionamento <span>(cambia il segnale: di serie è spento)</span></label>
<select id="rs" name="ricampionamento">
$(option no "Spento: ogni brano alla sua frequenza originale (bit-perfect)" "$rs")
$(option sincrono "Multiplo intero: 44,1 kHz verso 176,4/352,8, 48 kHz verso 192/384" "$rs")
$(option asincrono "Tutto alla frequenza massima del DAC" "$rs")
</select>

<label for="fil">Filtro del ricampionamento</label>
<select id="fil" name="filtro">
$(option lineare "Fase lineare (predefinito)" "$(conf FILTRO lineare)")
$(option intermedio "Fase intermedia" "$(conf FILTRO lineare)")
$(option minimo "Fase minima: niente pre-eco" "$(conf FILTRO lineare)")
</select>

<details>
<summary>Opzioni per esperti</summary>
<label for="fmax">Frequenza massima inviata al DAC <span>(0 = quella dichiarata dal DAC)</span></label>
<input id="fmax" name="frequenza_max" inputmode="numeric" value="$(esc "$(conf FREQUENZA_MAX 0)")">
<label for="buf">Buffer ALSA in millisecondi <span>(20-499, predefinito 400)</span></label>
<input id="buf" name="buffer" inputmode="numeric" value="$(esc "$(conf BUFFER_ALSA_MS 400)")">
<label for="per">Periodi ALSA <span>(2-16, predefinito 4)</span></label>
<input id="per" name="periodi" inputmode="numeric" value="$(esc "$(conf PERIODI_ALSA 4)")">
<label for="pf">Pausa al cambio di frequenza, in millisecondi <span>(per DAC che perdono l'inizio del brano)</span></label>
<input id="pf" name="pausa_frequenza" inputmode="numeric" value="$(esc "$(conf PAUSA_FREQUENZA_MS 0)")">
<label for="pd">Pausa al passaggio tra DSD e PCM, in millisecondi</label>
<input id="pd" name="pausa_dsd" inputmode="numeric" value="$(esc "$(conf PAUSA_DSD_MS 500)")">
</details>

<p class="sub">Le modifiche si applicano subito: il player si riavvia e la musica si ferma per qualche secondo.</p>
<button class="primary">Salva e applica</button>
</form>
</div>
HTML

page_end
