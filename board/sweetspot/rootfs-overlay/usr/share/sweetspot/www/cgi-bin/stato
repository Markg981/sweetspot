#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# Sweetspot - pagina di stato (CGI per l'httpd di BusyBox).

. /usr/lib/sweetspot/common.sh

esc() { sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g'; }

# Traffico di rete in 2 secondi: durante l'ascolto deve essere quasi zero,
# perche' il brano e' gia' tutto in memoria.
net_bytes() { awk 'NR>2 && $1 !~ /^lo:/ {sub(/^[^:]*:/, ""); split($0, a, " "); t += a[1] + a[9]} END {print t+0}' /proc/net/dev; }
b1=$(net_bytes); sleep 2; b2=$(net_bytes)
traffic=$(( (b2 - b1) / 2 ))

ip=$(net_ipv4)
srv=$(lms_server_ip)

printf 'Content-Type: text/html; charset=utf-8\r\nCache-Control: no-store\r\n\r\n'
cat <<HTML
<!doctype html>
<html lang="it">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="refresh" content="10">
<title>Sweetspot</title>
<style>
:root { --bg:#f6f4ef; --card:#fff; --ink:#1d1b18; --muted:#6b665d; --ok:#2f7d4f; --warn:#b4541a; --line:#e4dfd5; }
@media (prefers-color-scheme: dark) { :root { --bg:#14130f; --card:#1e1c18; --ink:#efebe3; --muted:#a29c90; --ok:#6fcf97; --warn:#f2994a; --line:#2f2c26; } }
* { box-sizing: border-box; }
body { margin:0; background:var(--bg); color:var(--ink); font:16px/1.45 -apple-system, "Segoe UI", Roboto, sans-serif; }
main { max-width:720px; margin:0 auto; padding:24px 16px 48px; }
h1 { font-size:28px; letter-spacing:.02em; margin:0 0 4px; }
.sub { color:var(--muted); margin:0 0 20px; }
.card { background:var(--card); border:1px solid var(--line); border-radius:12px; padding:4px 16px; margin-bottom:16px; }
.row { display:flex; gap:12px; padding:12px 0; border-bottom:1px solid var(--line); }
.row:last-child { border-bottom:0; }
.dot { flex:0 0 10px; height:10px; border-radius:50%; margin-top:7px; background:var(--line); }
.OK .dot { background:var(--ok); }
.ATTENZIONE .dot { background:var(--warn); }
.k { font-weight:600; }
.v { color:var(--muted); word-break:break-word; }
a { color:inherit; }
.btn { display:inline-block; padding:10px 14px; border:1px solid var(--line); border-radius:10px; background:var(--card); text-decoration:none; margin:0 8px 8px 0; }
</style>
</head>
<body><main>
<h1>Sweetspot</h1>
<p class="sub">Player in ${ip:-rete non collegata} &middot; si aggiorna ogni 10 secondi</p>
HTML
if [ -n "$srv" ]; then
	echo "<p><a class=\"btn\" href=\"http://$srv:9000/\">Apri Lyrion per scegliere la musica</a></p>"
fi
echo '<div class="card">'
if [ "$traffic" -lt 2048 ]; then t_esito=OK; else t_esito=INFO; fi
{
	sweetspot-check --dati
	echo "$t_esito|Traffico di rete ora|$((traffic / 1024)) KB/s (durante l'ascolto, a brano caricato, resta vicino a zero)"
} | while IFS='|' read -r esito voce dettaglio; do
	[ -n "$voce" ] || continue
	v=$(printf '%s' "$voce" | esc)
	d=$(printf '%s' "$dettaglio" | esc)
	printf '<div class="row %s"><span class="dot"></span><div><div class="k">%s</div><div class="v">%s</div></div></div>\n' "$esito" "$v" "$d"
done
echo '</div>'
echo "<p class=\"sub\">Versione $(cat /etc/sweetspot-version 2>/dev/null | esc)</p>"
echo '</main></body></html>'
