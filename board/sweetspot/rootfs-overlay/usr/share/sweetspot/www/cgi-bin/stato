# Sweetspot - pagina "Stato": verifica del sistema e del percorso del segnale.

. "${SWEETSPOT_LIB:-/usr/lib/sweetspot}/web.sh"

# La pagina legge solo la cache del demone sweetspot-stato (esiti e traffico
# di rete): niente attese e niente controlli a ogni richiesta.
CACHE_DATI=$RUN/stato.dati
# Cache piu' vecchia di qualche secondo: il demone fa un giro nuovo adesso.
stato_richiedi
read -r st_ts st_every < "$RUN/stato.ts" 2>/dev/null || { st_ts=0; st_every=20; }
case "$st_ts" in ''|*[!0-9]*) st_ts=0 ;; esac
case "$st_every" in ''|*[!0-9]*) st_every=20 ;; esac
st_age=$(( $(date +%s) - st_ts ))

page_start "Stato" stato 15
printf '<p class="sub">Player in %s &middot; si aggiorna ogni 15 secondi</p>\n' "$(esc "$(net_ipv4)")"
srv=$(lms_server_ip)
if [ "$(mode)" = player ] && [ -n "$srv" ]; then
	printf '<p><a class="btn" href="http://%s:9000/">Apri Lyrion per scegliere la musica</a></p>\n' "$srv"
fi
echo '<div class="card">'
if [ "$st_ts" -eq 0 ] || [ ! -r "$CACHE_DATI" ]; then
	echo '<div class="row ATTENZIONE"><span class="dot"></span><div class="grow"><div class="k">Stato non ancora disponibile</div><div class="v">Il servizio che raccoglie lo stato non ha ancora scritto i dati: riprova tra qualche secondo.</div></div></div>'
else
	if [ "$st_age" -gt $(( st_every * 3 + 5 )) ]; then
		printf '<div class="row ATTENZIONE"><span class="dot"></span><div class="grow"><div class="k">Dati non aggiornati</div><div class="v">Ultimo aggiornamento %s secondi fa: il servizio dello stato potrebbe essere fermo.</div></div></div>\n' "$st_age"
	fi
	while IFS='|' read -r esito voce dettaglio; do
		[ -n "$voce" ] || continue
		printf '<div class="row %s"><span class="dot"></span><div class="grow"><div class="k">%s</div><div class="v">%s</div></div></div>\n' \
			"$esito" "$(esc "$voce")" "$(esc "$dettaglio")"
	done < "$CACHE_DATI"
fi
echo '</div>'
printf '<p class="sub"><a href="/cgi-bin/rapporto">Scarica il rapporto di compatibilità</a>: computer, DAC e questi esiti, senza indirizzi né dati personali. Allegalo a una segnalazione su <a href="https://github.com/Markg981/sweetspot/issues/new?template=compatibilita.yml" target="_blank" rel="noopener">GitHub</a> per la matrice di compatibilità.</p>\n'
page_end
