# Sweetspot - pagina "Stato": verifica del sistema e del percorso del segnale.

. "${SWEETSPOT_LIB:-/usr/lib/sweetspot}/web.sh"

# Traffico di rete in 2 secondi: durante l'ascolto deve essere quasi zero,
# perché i brani sono già tutti in memoria.
net_bytes() { awk 'NR>2 && $1 !~ /^lo:/ {sub(/^[^:]*:/, ""); split($0, a, " "); t += a[1] + a[9]} END {print t+0}' /proc/net/dev; }
b1=$(net_bytes); sleep 2; b2=$(net_bytes)
traffic=$(( (b2 - b1) / 2 ))

page_start "Stato" stato 15
printf '<p class="sub">Player in %s &middot; si aggiorna ogni 15 secondi</p>\n' "$(esc "$(net_ipv4)")"
srv=$(lms_server_ip)
if [ "$(mode)" = player ] && [ -n "$srv" ]; then
	printf '<p><a class="btn" href="http://%s:9000/">Apri Lyrion per scegliere la musica</a></p>\n' "$srv"
fi
echo '<div class="card">'
if [ "$traffic" -lt 2048 ]; then t_esito=OK; else t_esito=INFO; fi
{
	sweetspot-check --dati
	echo "$t_esito|Traffico di rete ora|$((traffic / 1024)) KB/s (durante l'ascolto, a brani caricati, resta vicino a zero)"
} | while IFS='|' read -r esito voce dettaglio; do
	[ -n "$voce" ] || continue
	printf '<div class="row %s"><span class="dot"></span><div class="grow"><div class="k">%s</div><div class="v">%s</div></div></div>\n' \
		"$esito" "$(esc "$voce")" "$(esc "$dettaglio")"
done
echo '</div>'
page_end
