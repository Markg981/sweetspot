#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Sweetspot - misura la latenza real-time dei core dedicati all'audio.
#   sweetspot-latenza [secondi]     (predefinito 60)
#   sweetspot-latenza --ascolto CORE
# Meglio eseguirlo a riproduzione ferma: il risultato e' il ritardo
# massimo con cui il kernel risveglia un thread real-time.
# Con --ascolto (lo avvia il player se LATENZA_ASCOLTO=si) misura per
# tutta la sessione, solo mentre l'uscita audio suona, con 100 risvegli
# al secondo invece di 2000: il thread di misura toglie al core della
# riproduzione pochi microsecondi ogni 10 ms. Scrive in
# $RUN/latenza.ascolto "MASSIMA FINESTRE ULTIMA" (microsecondi).

. "${SWEETSPOT_LIB:-/usr/lib/sweetspot}/common.sh"

# Un'uscita audio in riproduzione (anche quella verso il DAC dietro CamillaDSP).
playing() {
	grep -qs '^state: RUNNING' "$PROC"/asound/card*/pcm*p/sub*/status
}

# Finestre di 30 secondi: valgono solo se l'uscita suona all'inizio e alla
# fine. Si ferma con il player che l'ha avviata.
listen_watch() { # core
	local cpid="" m max n
	trap 'kill "$cpid" 2>/dev/null; exit 0' TERM INT
	while kill -0 "$PPID" 2>/dev/null; do
		if ! playing; then sleep 5; continue; fi
		cyclictest -m -q -p 85 -i 10000 -D 30 -a "$1" -t 1 > "$RUN/latenza.finestra" 2>/dev/null &
		cpid=$!
		wait "$cpid"
		playing || continue
		m=$(sed -n 's/.*Max:[[:space:]]*\([0-9]*\).*/\1/p' "$RUN/latenza.finestra" | head -n 1)
		[ -n "$m" ] || continue
		max=0; n=0
		[ -s "$RUN/latenza.ascolto" ] && read -r max n _ < "$RUN/latenza.ascolto"
		[ "$m" -gt "$max" ] && max=$m
		echo "$max $((n + 1)) $m" > "$RUN/latenza.ascolto"
	done
}

if [ "$1" = --ascolto ]; then
	listen_watch "${2:?core}"
	exit 0
fi

secs=${1:-60}
cpus=$(cat "$SYS/devices/system/cpu/isolated" 2>/dev/null)
[ -n "$cpus" ] || cpus=$(join_list "$(cpu_online)")
n=$(count_words "$(expand_list "$cpus")")

echo "Misura della latenza sui core $cpus per $secs secondi..."
res=$(cyclictest -m -q -p 85 -i 500 -D "$secs" -a "$cpus" -t "$n" 2>/dev/null)
max=$(printf '%s\n' "$res" | sed -n 's/.*Max:[[:space:]]*\([0-9]*\).*/\1/p' | sort -n | tail -n 1)
avg=$(printf '%s\n' "$res" | sed -n 's/.*Avg:[[:space:]]*\([0-9]*\).*/\1/p' | sort -n | tail -n 1)
if [ -z "$max" ]; then
	echo "Misura non riuscita."
	exit 1
fi
echo "Latenza media: $avg us, massima: $max us"
if [ "$max" -le 50 ]; then
	echo "Risultato: ottimo (obiettivo: sotto 50 us)."
elif [ "$max" -le 150 ]; then
	echo "Risultato: buono, ampiamente sufficiente per l'audio."
else
	echo "Risultato: alto. Prova il profilo 'prestazioni' e controlla le impostazioni del BIOS."
fi
log "latenza: media $avg us, massima $max us su $cpus"
