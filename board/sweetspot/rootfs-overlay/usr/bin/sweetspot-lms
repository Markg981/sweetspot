#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Sweetspot - Lyrion Music Server sulla stessa macchina del player.
#
#   sweetspot-lms prepara          cartelle, preferenze iniziali, Material
#   sweetspot-lms servizio         avvia Lyrion e lo riavvia se si ferma
#   sweetspot-lms ferma            ferma Lyrion (salva le sue preferenze)
#   sweetspot-lms attendi [s]      aspetta che Lyrion risponda
#   sweetspot-lms primo-controllo  dopo l'avvio: cerca i brani aggiunti mentre
#                                  Sweetspot era spento
#   sweetspot-lms aggiorna         cerca nella libreria i brani nuovi o cambiati
#   sweetspot-lms ricostruisci     rilegge tutta la libreria da capo
#   sweetspot-lms plugin stato|installa NOME|rimuovi NOME
#   sweetspot-lms riavvia          riavvia Lyrion (per i plugin)
#   sweetspot-lms operazione avvia TIPO [NOME]   operazione lunga in background
#   sweetspot-lms operazione stato ID            stato (JSON) di un'operazione
#
# Lyrion gira con un utente proprio (lms), sui core di sistema e con
# priorita' bassa: il player, sul suo core dedicato, ha sempre la precedenza.

. "${SWEETSPOT_LIB:-/usr/lib/sweetspot}/common.sh"

LMS_DIR=${SWEETSPOT_LMS_DIR:-/opt/lms}
LMS_USER=lms
LMS_LOG=/var/log/lms
PREFS=$LMS_DATA/prefs
CACHE=$LMS_DATA/cache
PLAYLISTS=$LMS_DATA/playlists
STOPFLAG=$RUN/lms.ferma
PLUGIN_SRC=/usr/share/sweetspot/lms-plugins

# Versione di un plugin dal suo install.xml.
plugin_version() {
	sed -n 's:.*<version>\([^<]*\)</version>.*:\1:p' "$1/install.xml" 2>/dev/null | head -n 1
}

# Preferenze del primo avvio: libreria in /musica, italiano, niente
# procedura guidata di Lyrion (la fa Sweetspot), niente avvisi di
# aggiornamento di Lyrion (si aggiorna tutto Sweetspot insieme).
first_prefs() {
	cat <<EOF
---
language: IT
libraryname: $(conf NOME_PLAYER Sweetspot | tr -d '"\\:')
mediadirs:
  - $MUSIC_DIR
playlistdir: $PLAYLISTS
wizardDone: 1
checkVersion: 0
scannerPriority: 10
csrfProtectionLevel: $CSRF_LEVEL
EOF
}

# Protezione CSRF di Lyrion (pref csrfProtectionLevel: 0 nessuna, 1 media,
# 2 alta). Il livello 1 e' quello predefinito di Lyrion: blocca le richieste
# che arrivano da una pagina di un altro sito (Referer/Origin diverso) ma
# lascia passare quelle senza Referer, come i client di terzi (iPeng,
# Squeezer, app JSON-RPC) e wget di Sweetspot (lms_json). Il livello 2
# chiederebbe un gettone a ogni comando e romperebbe quei client. Se manca o
# e' 0 (nessuna protezione) lo si riporta a 1; 1 e 2 scelti dall'utente restano.
CSRF_LEVEL=1

ensure_csrf() {
	local f=$PREFS/server.prefs cur
	cur=$(grep '^csrfProtectionLevel:' "$f" 2>/dev/null | tail -n 1 | cut -d: -f2 | tr -d ' "'"'")
	case "$cur" in 1|2) return 0 ;; esac
	grep -v '^csrfProtectionLevel:' "$f" > "$f.tmp" 2>/dev/null
	echo "csrfProtectionLevel: $CSRF_LEVEL" >> "$f.tmp"
	mv "$f.tmp" "$f"
	log "lyrion: protezione CSRF portata al livello $CSRF_LEVEL"
}

# Voci di Sweetspot nel menu di Material: le impostazioni del sistema si
# aprono dentro l'interfaccia, come su Daphile.
material_actions() {
	cat <<'EOF'
{
  "settings": [
    { "title": "Impostazioni Sweetspot", "icon": "tune", "iframe": "http://$HOST/cgi-bin/audio" },
    { "title": "Stato di Sweetspot", "icon": "assessment", "iframe": "http://$HOST/cgi-bin/stato" }
  ]
}
EOF
}

# Cache delle copertine di Lyrion (artwork.db: copertine ridimensionate;
# imgproxy.db: copertine dei servizi in streaming). In RAM crescono con la
# libreria (Lyrion le prepara durante la lettura) e si perdono a ogni
# avvio: se c'e' l'archivio musicale stanno li', nella cartella
# .sweetspot-cache, e in RAM resta solo un collegamento.
CACHE_DBS="artwork.db imgproxy.db"

# Senza archivio le cache stanno in un tmpfs a parte, con un tetto (size=):
# l'artwork non puo' crescere fino all'OOM ne' riempire il tmpfs che contiene
# il database della libreria. Superato il tetto Lyrion non riesce piu' a
# scrivere in queste cache (le copertine si rifanno a ogni richiesta) e la
# pagina Stato lo segnala; si svuotano a ogni avvio.
ART_RAM=$LMS_DATA/artwork-ram
ART_FULL=$RUN/lms.artwork.piena

# Tetto in MB: ARTWORK_RAM_MB, auto = 4% della memoria, tra 32 e 256 MB.
art_ram_mb() {
	local mb tot
	mb=$(conf ARTWORK_RAM_MB auto)
	case "$mb" in
		''|auto|*[!0-9]*)
			tot=$(mem_total_kb); [ -n "$tot" ] || tot=0
			mb=$((tot / 1024 / 25))
			[ "$mb" -ge 32 ] || mb=32
			[ "$mb" -le 256 ] || mb=256 ;;
	esac
	echo "$mb"
}

# Monta (una volta) il tmpfs delle cache in RAM; fallisce se non si puo'.
art_ram_mount() {
	[ -d "$ART_RAM" ] && grep -q " $ART_RAM tmpfs " "$PROC/mounts" 2>/dev/null && return 0
	mkdir -p "$ART_RAM" || return 1
	"${SWEETSPOT_MOUNT:-mount}" -t tmpfs -o "size=$(art_ram_mb)m,mode=0755,nosuid,nodev" tmpfs "$ART_RAM" || return 1
	chown "$LMS_USER:$LMS_USER" "$ART_RAM" 2>/dev/null
	return 0
}

# Percentuale occupata del tmpfs delle cache (vuoto se non montato).
art_ram_used() {
	df -P "$ART_RAM" 2>/dev/null | awk 'NR == 2 { sub(/%/, "", $5); print $5 }'
}

# Avviso per Stato quando il tmpfs delle cache e' quasi pieno.
art_ram_check() {
	local u
	u=$(art_ram_used)
	case "$u" in ''|*[!0-9]*) rm -f "$ART_FULL"; return 0 ;; esac
	if [ "$u" -ge 95 ]; then
		[ -f "$ART_FULL" ] || log "lyrion: cache delle copertine in RAM piena ($u%), le nuove non si salvano"
		echo "$u" > "$ART_FULL"
	else
		rm -f "$ART_FULL"
	fi
}

link_caches() {
	local arch dir f
	arch=$(sweetspot-dischi archivio)
	[ -n "$arch" ] && [ -d "$arch" ] || { link_caches_ram; return 0; }
	dir=$arch/.sweetspot-cache
	mkdir -p "$dir" 2>/dev/null || { log "lyrion: archivio non scrivibile, copertine in RAM"; link_caches_ram; return 0; }
	for f in $CACHE_DBS; do
		# Una cache rimasta in RAM (es. archivio scelto dopo l'avvio) si sposta.
		if [ -f "$CACHE/$f" ] && [ ! -L "$CACHE/$f" ] && [ ! -f "$dir/$f" ]; then
			mv "$CACHE/$f" "$dir/$f" 2>/dev/null
		fi
		rm -f "$CACHE/$f" "$CACHE/$f-wal" "$CACHE/$f-shm"
		ln -s "$dir/$f" "$CACHE/$f"
	done
	chown -R "$LMS_USER:$LMS_USER" "$dir" 2>/dev/null
	rm -f "$ART_FULL"
	log "lyrion: cache delle copertine sull'archivio ($dir)"
}

# Cache in RAM con tetto: collegamenti verso il tmpfs a misura.
link_caches_ram() {
	local f
	art_ram_mount || { log "lyrion: tmpfs delle copertine non montato, cache senza tetto"; return 0; }
	for f in $CACHE_DBS; do
		# Le cache sono ricostruibili: un file vero (avvio precedente senza
		# tetto) o un collegamento vecchio si sostituisce.
		rm -f "$CACHE/$f" "$CACHE/$f-wal" "$CACHE/$f-shm"
		ln -s "$ART_RAM/$f" "$CACHE/$f"
	done
}

do_prepare() {
	local inst have want
	mkdir -p "$PREFS/material-skin" "$CACHE/InstalledPlugins/Plugins" "$PLAYLISTS" "$LMS_LOG"
	if [ ! -s "$PREFS/server.prefs" ]; then
		first_prefs > "$PREFS/server.prefs"
		log "lyrion: preferenze iniziali scritte"
	fi
	ensure_csrf
	material_actions > "$PREFS/material-skin/actions.json"
	# Material Skin preinstallata. Se l'utente l'ha aggiornata dal gestore
	# dei plugin si tiene la sua versione.
	if [ -d "$PLUGIN_SRC/MaterialSkin" ]; then
		inst=$CACHE/InstalledPlugins/Plugins/MaterialSkin
		have=$(plugin_version "$inst")
		want=$(plugin_version "$PLUGIN_SRC/MaterialSkin")
		if [ -z "$have" ]; then
			rm -rf "$inst"
			cp -a "$PLUGIN_SRC/MaterialSkin" "$inst"
			log "lyrion: Material Skin $want installata"
		fi
	fi
	link_caches
	chown -R "$LMS_USER:$LMS_USER" "$LMS_DATA" "$LMS_LOG" 2>/dev/null
}

# Limiti di memoria cgroup (memory.high rallenta e recupera, memory.max e'
# il tetto duro) per Lyrion e, a parte, per lo scanner, che nasce figlio di
# Lyrion e viene spostato nel suo gruppo. LYRION_MEM_MB e SCANNER_MEM_MB
# (MB; auto = 70% e 40% della memoria totale, high all'85% del tetto).
# Il tmpfs conta nel gruppo di chi lo scrive: il tetto di Lyrion lascia il
# posto al database della libreria in RAM. Senza cgroup v2 non si fa nulla.
CG_LYRION=sweetspot-lyrion
CG_SCANNER=sweetspot-scanner

lms_cgroups() {
	local max high
	max=$(mem_limit_bytes LYRION_MEM_MB 70); high=$((max / 100 * 85))
	cg_make "$CG_LYRION" "memory.max=$max" "memory.high=$high" "memory.swap.max=0" || return 1
	max=$(mem_limit_bytes SCANNER_MEM_MB 40); high=$((max / 100 * 85))
	cg_make "$CG_SCANNER" "memory.max=$max" "memory.high=$high" "memory.swap.max=0" "io.weight=default 20"
}

# Finche' Lyrion vive, ogni 20 secondi porta lo scanner (figlio del server,
# nasce con il valore di Lyrion) tra i primi candidati dell'OOM killer e nel
# suo gruppo di memoria. Un giro leggero sulle righe di comando; niente
# scanner, niente scritture.
oom_watch() {
	local spid
	while kill -0 "$1" 2>/dev/null; do
		oom_adj_cmd 500 scanner.pl
		spid=$(pgrep -f scanner.pl 2>/dev/null)
		[ -n "$spid" ] && cg_add "$CG_SCANNER" $spid
		art_ram_check
		sleep 20
	done
}

do_service() {
	local restarts=0 started rc hk
	rm -f "$STOPFLAG"
	cpu_layout
	hk=$(join_list "$LAYOUT_HK")
	[ -n "$hk" ] || hk=$(join_list "$(cpu_online)")
	while [ ! -f "$STOPFLAG" ]; do
		started=$(date +%s)
		log "lyrion: avvio sui core $hk"
		# Utente lms, core di sistema, priorita' bassa. taskset, nice, su
		# (BusyBox) e la shell fanno exec: il PID resta quello di Lyrion,
		# anche quando si riavvia da solo dopo l'installazione di un plugin.
		# I percorsi sono fissi e senza spazi: si possono scrivere nel comando.
		taskset -c "$hk" nice -n 10 \
			su -s /bin/sh "$LMS_USER" -c "exec perl $LMS_DIR/slimserver.pl --prefsdir $PREFS --cachedir $CACHE --logdir $LMS_LOG --charset utf8" \
				>> "$LMS_LOG/avvio.log" 2>&1 &
		lmspid=$!
		echo "$lmspid" > "$RUN/lms.pid"
		lms_cgroups && cg_add "$CG_LYRION" "$lmspid"
		# OOM killer: Lyrion poco protetto, lo scanner (figlio, lo eredita)
		# tra i primi a cadere; il player (-1000) mai.
		oom_adj -100 "$lmspid"
		oom_watch "$lmspid" &
		wait "$lmspid"
		rc=$?
		[ -f "$STOPFLAG" ] && break
		# Fermate ripetute subito dopo l'avvio: si aspetta di piu'.
		if [ $(( $(date +%s) - started )) -lt 60 ]; then
			restarts=$((restarts + 1))
		else
			restarts=0
		fi
		log "lyrion: fermo (codice $rc), riavvio"
		if [ $restarts -gt 5 ]; then sleep 60; else sleep 3; fi
	done
	rm -f "$RUN/lms.pid"
}

do_stop() {
	local pid i=0
	touch "$STOPFLAG"
	pid=$(cat "$RUN/lms.pid" 2>/dev/null)
	[ -n "$pid" ] || return 0
	kill "$pid" 2>/dev/null
	# Lyrion salva preferenze e database prima di uscire.
	while [ $i -lt 40 ] && kill -0 "$pid" 2>/dev/null; do
		usleep 500000
		i=$((i + 1))
	done
	kill -9 "$pid" 2>/dev/null
}

do_wait() {
	local max=${1:-120} i=0
	while [ $i -lt "$max" ]; do
		lms_ready && return 0
		sleep 1
		i=$((i + 1))
	done
	return 1
}

# Una volta per avvio, quando Lyrion risponde e le cartelle di rete sono
# montate: i dischi possono essere cambiati mentre Sweetspot era spento.
# Lyrion legge solo cio' che e' nuovo o cambiato.
do_first_check() {
	local i=0
	do_wait 600 || return 1
	while [ $i -lt 120 ] && [ ! -f "$RUN/rete.pronta" ] && [ -n "$(conf CONDIVISIONE_1)" ]; do
		sleep 1
		i=$((i + 1))
	done
	lms_scanning && return 0
	lms_json '' rescan > /dev/null && log "lyrion: controllo della libreria dopo l'avvio"
}

# plugin stato: righe "nome|versione|stato|errore" dei plugin scaricati,
# poi "#scaricamenti|riavvio" (riavvio=1: serve riavviare Lyrion).
# plugin installa|rimuovi NOME: stampa l'eventuale errore e fallisce.
do_plugin() {
	local r err
	case "$1" in
		stato)
			r=$(lms_json '' sweetspot plugin-stato) || return $?
			printf '%s\n' "$r" | jq -r '.result | ((.plugins_loop // [])[] | "\(.nome)|\(.versione)|\(.stato)|\(.errore)"), "#\(.scaricamenti)|\(.riavvio)"'
			;;
		installa|rimuovi)
			case "$2" in ''|*[!A-Za-z0-9_]*) echo "nome non valido"; return 1 ;; esac
			r=$(LMS_TIMEOUT=${LMS_TIMEOUT_OP:-60} lms_json '' sweetspot "plugin-$1" "nome:$2") || { err=$?; lms_errore_testo "$err"; return "$err"; }
			err=$(printf '%s\n' "$r" | jq -r '.result.errore // empty')
			[ -z "$err" ] || { echo "$err"; return 1; }
			log "lyrion: plugin $2: $1"
			;;
		*) return 1 ;;
	esac
}

# --- Operazioni lunghe in background ------------------------------------------
# Installazione e rimozione di plugin, scansione e ricostruzione della libreria
# non bloccano piu' la pagina: partono in background con un identificativo e
# scrivono il loro stato in $OPS/ID.json, che si legge con /cgi-bin/operazione
# (o con "operazione stato ID") finche' non e' "riuscita" o "fallita".
#
# Formato dello stato (versione 1, stabile: e' anche il corpo previsto per
# l'API JSON versionata e per gli eventi SSE, che invieranno lo stesso oggetto):
#   {"versione":1,"id":"1700000000-ab12cd34","tipo":"plugin-installa",
#    "nome":"Qobuz","stato":"in_corso|riuscita|fallita","messaggio":"...",
#    "errore":null|"non_in_esecuzione|in_avvio|timeout|applicativo|occupato|operazione",
#    "avviata":1700000000,"aggiornata":1700000012}
OPS=$RUN/operazioni

# Testo sicuro dentro una stringa JSON.
json_esc() {
	printf '%s' "$1" | tr '\001-\037' ' ' | awk '{gsub(/\\/, "\\\\"); gsub(/"/, "\\\""); print}'
}

# op_scrivi ID TIPO NOME STATO MESSAGGIO ERRORE AVVIATA (scrittura atomica)
op_scrivi() {
	local err=null
	[ -z "$6" ] || err="\"$6\""
	mkdir -p "$OPS"
	printf '{"versione":1,"id":"%s","tipo":"%s","nome":"%s","stato":"%s","messaggio":"%s","errore":%s,"avviata":%s,"aggiornata":%s}\n' \
		"$1" "$2" "$(json_esc "$3")" "$4" "$(json_esc "$5")" "$err" "$7" "$(date +%s)" > "$OPS/$1.nuovo" &&
		mv "$OPS/$1.nuovo" "$OPS/$1.json"
	chmod 644 "$OPS/$1.json" 2>/dev/null
}

# Operazioni rimaste "in_corso" senza il loro processo (kill, riavvio del
# servizio): diventano fallite, cosi' nessuno aspetta per sempre.
op_recupera() {
	local f id pid
	for f in "$OPS"/*.json; do
		[ -f "$f" ] || continue
		grep -q '"stato":"in_corso"' "$f" || continue
		id=$(basename "$f" .json)
		pid=$(cat "$OPS/$id.pid" 2>/dev/null)
		# Appena creata, il processo non ha ancora scritto il suo pid.
		[ -z "$pid" ] && [ ! -s "$OPS/$id.pid" ] && [ "$(( $(date +%s) - $(jq -r .avviata "$f") ))" -lt 5 ] && continue
		[ -n "$pid" ] && kill -0 "$pid" 2>/dev/null && continue
		op_scrivi "$id" "$(jq -r .tipo "$f")" "$(jq -r .nome "$f")" fallita "Operazione interrotta." operazione "$(jq -r .avviata "$f")"
	done
}

op_tipo_ok() { # TIPO NOME
	case "$1" in
		plugin-installa|plugin-rimuovi) case "$2" in ''|*[!A-Za-z0-9_]*) return 1 ;; esac ;;
		aggiorna|ricostruisci) [ -z "$2" ] ;;
		*) return 1 ;;
	esac
}

# operazione avvia TIPO [NOME]: stampa l'identificativo. Una richiesta uguale
# a una gia' in corso non ne avvia un'altra: restituisce quella.
op_avvia() {
	local tipo=$1 nome=${2:-} id f n
	op_tipo_ok "$tipo" "$nome" || { echo "operazione non valida" >&2; return 1; }
	mkdir -p "$OPS"
	chmod 755 "$OPS" 2>/dev/null
	op_recupera
	f=$(grep -l "\"tipo\":\"$tipo\",\"nome\":\"$nome\",\"stato\":\"in_corso\"" "$OPS"/*.json 2>/dev/null | head -n 1)
	if [ -n "$f" ]; then
		basename "$f" .json
		return 0
	fi
	# Si tengono le ultime 20 operazioni.
	ls -t "$OPS"/*.json 2>/dev/null | tail -n +21 | while read -r f; do
		rm -f "$f" "${f%.json}.pid"
	done
	id=$(date +%s)-$(head -c 4 /dev/urandom | od -An -tx1 | tr -d ' \n')
	op_scrivi "$id" "$tipo" "$nome" in_corso "In corso." "" "$(date +%s)"
	if command -v setsid > /dev/null 2>&1; then
		setsid "$0" operazione esegui "$id" "$tipo" "$nome" < /dev/null > /dev/null 2>&1 &
	else
		"$0" operazione esegui "$id" "$tipo" "$nome" < /dev/null > /dev/null 2>&1 &
	fi
	echo "$id"
}

# operazione esegui ID TIPO NOME: il lavoro vero, nel processo in background.
op_esegui() {
	local id=$1 tipo=$2 nome=${3:-} avviata err="" rc=0 msg="" code
	avviata=$(jq -r .avviata "$OPS/$id.json" 2>/dev/null || date +%s)
	echo $$ > "$OPS/$id.pid"
	# shellcheck disable=SC2034 # lo legge lms_json (common.sh)
	LMS_TIMEOUT=${LMS_TIMEOUT_OP:-60}
	case "$tipo" in
		plugin-installa|plugin-rimuovi)
			err=$(do_plugin "${tipo#plugin-}" "$nome") || rc=$?
			if [ "$tipo" = plugin-installa ]; then
				msg="Plugin in arrivo: a scaricamento finito riavvia Lyrion per attivarlo."
			else
				msg="Il plugin viene tolto al riavvio di Lyrion."
			fi ;;
		aggiorna)
			lms_json '' rescan > /dev/null || rc=$?
			msg="La libreria si sta aggiornando." ;;
		ricostruisci)
			lms_json '' wipecache > /dev/null || rc=$?
			msg="La libreria viene riletta da capo." ;;
	esac
	if [ "$rc" -eq 0 ]; then
		op_scrivi "$id" "$tipo" "$nome" riuscita "$msg" "" "$avviata"
	else
		[ -n "$err" ] || err=$(lms_errore_testo "$rc")
		case "$rc" in 2|3|4|5|6) code=$(lms_errore_nome "$rc") ;; *) code=applicativo ;; esac
		op_scrivi "$id" "$tipo" "$nome" fallita "$err" "$code" "$avviata"
	fi
	rm -f "$OPS/$id.pid"
}

do_operazione() {
	case "$1" in
		avvia) op_avvia "${2:-}" "${3:-}" ;;
		esegui) op_esegui "${2:-}" "${3:-}" "${4:-}" ;;
		stato)
			case "${2:-}" in ''|*[!0-9a-f-]*) return 1 ;; esac
			cat "$OPS/$2.json" 2>/dev/null ;;
		*) return 1 ;;
	esac
}

[ "${SWEETSPOT_TEST:-}" = 1 ] && return 0

# Le richieste delle pagine web passano dalla cache condivisa e dal limite di
# richieste contemporanee verso Lyrion (vedi common.sh).
# shellcheck disable=SC2034 # lo legge lms_json (common.sh)
case "$1" in json|plugin|operazione) LMS_WEB=1 ;; esac

case "$1" in
	prepara) do_prepare ;;
	servizio) do_service ;;
	ferma) do_stop ;;
	attendi) do_wait "$2" ;;
	primo-controllo) do_first_check ;;
	aggiorna) lms_json '' rescan > /dev/null ;;
	ricostruisci) lms_json '' wipecache > /dev/null ;;
	# json PLAYER PAROLA...: richiesta a Lyrion con le credenziali di
	# Sweetspot, per le pagine web (che non le conoscono); sweetspot-priv
	# lascia passare solo i comandi che le pagine usano.
	json) shift; lms_json_locale "$@" ;;
	plugin) shift; do_plugin "$@" ;;
	operazione) shift; do_operazione "$@" ;;
	riavvia) lms_json '' restartserver > /dev/null; log "lyrion: riavvio richiesto" ;;
	*) echo "uso: $0 prepara|servizio|ferma|attendi|aggiorna|ricostruisci|plugin|operazione|riavvia" >&2; exit 1 ;;
esac
