#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Sweetspot - volume a 64 bit (VOLUME=dsp): il volume del player in Lyrion
# lo applica CamillaDSP in virgola mobile con il dither all'uscita, mentre
# Squeezelite lascia i campioni invariati (-F).
#
#   sweetspot-volume segui MAC          segue il volume del player (lo avvia
#                                       il player con CamillaDSP in uso)
#   sweetspot-volume applica VOL MUTO   volume 0-100 e sordina 0/1
#   sweetspot-volume db VOL             guadagno in dB di un volume 0-100
#
# Scala: la stessa che Lyrion usa per Squeezelite (Slim::Player::SqueezePlay,
# 74 dB in due tratti), cosi' il cursore suona uguale al volume software e
# alle zone: 100 = 0 dB, da 100 a 25 circa 0,49 dB per passo (50 = -24,7 dB,
# 25 = -37 dB), da 25 a 1 1,48 dB per passo (1 = -72,5 dB), 0 = sordina.
# Ogni valore va nel file che il plugin cdsp legge a ogni avvio di CamillaDSP
# (sweetspot-dsp stato) e, dal vivo, al websocket di CamillaDSP (rampa di
# 400 ms; l'esito si verifica, si ritenta e ogni 10 s si risincronizza). Il guadagno non supera mai 0 dB (volume_limit nella configurazione).

. "${SWEETSPOT_LIB:-/usr/lib/sweetspot}/common.sh"

LMS_CLI_PORT=${SWEETSPOT_LMS_CLI_PORT:-9090}

# Modalita' player: il volume si legge dal Lyrion indicato in SERVER (la
# porta eventuale e' quella di Squeezelite: qui serve solo l'indirizzo).
if [ "$(mode)" != completa ] && [ -n "$(conf SERVER)" ]; then
	LMS_HOST=$(conf SERVER)
	# "[v6]:porta", v6 senza porta (piu' di un ':'), host:porta o solo host.
	case "$LMS_HOST" in
		\[*\]*) LMS_HOST=${LMS_HOST#\[}; LMS_HOST=${LMS_HOST%%\]*} ;;
		*:*:*) ;;
		*) LMS_HOST=${LMS_HOST%%:*} ;;
	esac
fi

db() { # volume 0-100
	awk -v v="$1" 'BEGIN {
		if (v >= 100) { printf "0.0"; exit }
		if (v < 0) v = 0
		if (v > 25) d = (v - 100) * 37 / 75; else d = v * 74 / 50 - 74
		printf "%.1f", d
	}'
}

# Un comando al websocket di CamillaDSP, ritentato poche volte: vale solo se
# la risposta dice "Ok" (un errore IPC o un riavvio in corso non lo sono).
dsp_send() { # comando
	local i=0 r max=${SWEETSPOT_VOLUME_TENTATIVI:-3}
	while [ $i -lt "$max" ]; do
		r=$(sweetspot-camilla "$DSP_PORTA" "$1" 2>/dev/null)
		case "$r" in *'"result":"Ok"'*) return 0 ;; esac
		i=$((i + 1))
		[ $i -lt "$max" ] && sleep "${SWEETSPOT_VOLUME_PAUSA:-1}"
	done
	return 1
}

# volume.dsp = stato richiesto (cio' che Lyrion ha chiesto); volume.applicato
# = stato confermato da CamillaDSP, oppure "errore" se non ha risposto Ok.
# La diagnostica (sweetspot-check) mostra se i due divergono.
apply() { # volume muto
	local v=${1%.*} m=$2 d mute=false
	case "$v" in ''|-|*[!0-9-]*) return 1 ;; esac
	# Lyrion indica la sordina anche con un volume negativo.
	if [ "$v" -lt 0 ]; then v=$((-v)); m=1; fi
	[ "$v" -gt 100 ] && v=100
	[ "$v" = 0 ] && m=1
	d=$(db "$v")
	[ "$m" = 1 ] && mute=true
	if [ "$mute" = true ]; then sweetspot-dsp stato "$d" muto; else sweetspot-dsp stato "$d"; fi || return 1
	echo "$v $d $m" > "$RUN/volume.dsp"
	if dsp_send "{\"SetVolume\":$d}" && dsp_send "{\"SetMute\":$mute}"; then
		echo "$v $d $m" > "$RUN/volume.applicato"
	else
		echo errore > "$RUN/volume.applicato"
		return 1
	fi
}

# Risincronizza CamillaDSP con il volume richiesto: dopo un riavvio riparte
# dal file, ma un comando perso o un riavvio a meta' lo lasciano diverso.
# Non fa nulla se non c'e' ancora un volume richiesto o CamillaDSP non risponde.
dsp_resync() {
	local v d m gv gm
	[ -s "$RUN/volume.dsp" ] || return 0
	read -r v d m < "$RUN/volume.dsp"
	gv=$(sweetspot-camilla "$DSP_PORTA" GetVolume 2>/dev/null | sed -n 's/.*"value":\(-\{0,1\}[0-9.]*\).*/\1/p')
	gm=$(sweetspot-camilla "$DSP_PORTA" GetMute 2>/dev/null | sed -n 's/.*"value":\(true\|false\).*/\1/p')
	[ -n "$gv" ] && [ -n "$gm" ] || return 0
	if [ "$gm" = true ]; then gm=1; else gm=0; fi
	if [ "$gm" != "$m" ] || ! awk -v a="$gv" -v b="$d" 'BEGIN { x = a - b; exit !(x < 0.05 && x > -0.05) }'; then
		apply "$v" "$m"
	fi
}

# Riapplica sempre il volume richiesto, senza confronti: dopo che il player ha
# riavviato l'istanza di sessione di CamillaDSP (riparte dal file di volume)
# volume.applicato torna quello confermato dalla nuova istanza.
dsp_reapply() {
	local v d m
	[ -s "$RUN/volume.dsp" ] || return 0
	read -r v d m < "$RUN/volume.dsp"
	apply "$v" "$m"
}

# Volume e sordina attuali del player, letti da Lyrion. Esce con 1 se Lyrion
# non risponde o non conosce ancora il player.
sync_now() { # mac
	local v m
	v=$(LMS_TIMEOUT=5 lms_get '._volume' "$1" mixer volume '?')
	[ -n "$v" ] || return 1
	m=$(LMS_TIMEOUT=5 lms_get '._muting' "$1" mixer muting '?')
	apply "$v" "${m:-0}"
}

# Il player appena avviato si presenta a Lyrion dopo qualche secondo: si
# riprova finche' il volume non si legge (senza, il brano partirebbe al
# volume di riserva del file finche' qualcuno non tocca il cursore).
sync_first() { # mac
	local i=0
	while [ $i -lt "${SWEETSPOT_VOLUME_ATTESA:-120}" ]; do
		sync_now "$1" && return 0
		sleep 2
		i=$((i + 2))
	done
	return 1
}

# Notifiche della CLI di Lyrion: ogni cambio del mixer del player rilegge
# il valore assoluto (le notifiche possono essere relative, es. "+5"); a
# ogni (ri)collegamento del player si rilegge, perche' Lyrion non manda il
# volume a chi si ricollega.
# Comandi iniziali per la CLI: con Lyrion protetto prima il login
# (LYRION_UTENTE e LYRION_PASSWORD), poi l'iscrizione alle notifiche.
cli_subscribe() {
	local user
	user=$(lms_user)
	[ -n "$user" ] && echo "login $user $(conf LYRION_PASSWORD)"
	echo "subscribe mixer,client"
}

follow() { # mac
	local mac=$1 enc me=$$
	# Controllo periodico: dopo un errore IPC o un riavvio di CamillaDSP il
	# guadagno applicato torna quello richiesto.
	( while kill -0 "$me" 2>/dev/null; do
		sleep "${SWEETSPOT_VOLUME_RISINC:-10}"
		dsp_resync
	done ) &
	enc=$(printf '%s' "$mac" | sed 's/:/%3A/g')
	while kill -0 "$PPID" 2>/dev/null; do
		sync_first "$mac"
		{ cli_subscribe; while kill -0 "$me" 2>/dev/null; do sleep 30; done; } |
			nc "$LMS_HOST" "$LMS_CLI_PORT" 2>/dev/null |
			while read -r line; do
				case "$line" in
					"$enc mixer "*) sync_now "$mac" ;;
					"$enc client new"*|"$enc client reconnect"*) sync_first "$mac" ;;
				esac
			done
		sleep 5
	done
}

[ "${SWEETSPOT_TEST:-}" = 1 ] && return 0

case "$1" in
	segui) follow "${2:?mac}" ;;
	applica) apply "${2:?volume}" "${3:-0}" ;;
	risincronizza) dsp_reapply ;;
	db) db "${2:?volume}"; echo ;;
	*) echo "uso: $0 segui MAC | applica VOLUME MUTO | risincronizza | db VOLUME" >&2; exit 1 ;;
esac
