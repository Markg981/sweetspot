#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Sweetspot - demone a eventi dello stato. Calcola gli esiti di
# sweetspot-check e il traffico di rete e li lascia in cache, cosi' la pagina
# Stato, l'endpoint JSON e il comando "sweetspot stato" di Lyrion leggono un
# file invece di rifare i controlli a ogni richiesta.
#
#   sweetspot-stato aggiorna    un solo giro (scrive la cache e basta)
#   sweetspot-stato sorveglia   il demone: aspetta eventi, non fa polling
#
# Il demone e' un solo processo shell che dorme in read -t su una FIFO
# ($RUN/stato.eventi) dove tre ascoltatori di lunga durata, avviati una volta,
# scrivono una riga per evento:
#   L  CLI di Lyrion (nc sulla porta 9090, "subscribe playlist,mixer,
#      prefset,client,rescan"): modo di ascolto, coda, client, scansioni, e
#      la risposta a "version ?" che fa da liveness di Lyrion
#   U  udev (udevadm monitor su sound, block, net): DAC e dischi collegati
#      o scollegati, rete
#   I  inotify (inotifyd su $RUN): configurazione, pid, player.mac, ...
# Piu' le richieste (FIFO stato.richiesta, da pagina Stato, stato.json e
# plugin di Lyrion) e pochi timer. Il resto del tempo il demone non lancia
# alcun processo: meno di 100 fork al minuto a riposo (tests/forks-riposo.sh).
#
# Quando si calcola lo stato (do_round, un giro del check completo):
#   - a un evento udev o inotify, o a un client/prefset di Lyrion (con
#     1 s di raccolta e almeno STATO_MIN s dal giro precedente);
#   - su richiesta di chi legge la cache piu' vecchia di 10 s (40 s durante
#     l'ascolto);
#   - come battito di sicurezza ogni STATO_BATTITO s (predefinito 900).
# Il precarico (sweetspot-precarico) e' guidato dallo stesso demone: step()
# sugli eventi playlist, senza il giro ogni 5 s con "status 0 1000".
# La scansione della libreria (evento rescan) porta lo scanner a +500
# nell'OOM killer senza un processo che controlla ogni 20 s.
# La cache dei risultati di aplay del DAC (dac_cached) vale finche' udev
# non segnala un evento sound.
#
# In $RUN (scritti in modo atomico, leggibili da tutti: li legge anche lms):
#   stato.dati   righe "ESITO|voce|dettaglio", come sweetspot-check --dati,
#                con in coda la riga del traffico di rete
#   stato.json   gli stessi dati in JSON
#   stato.ts     "momento tolleranza" dell'ultimo giro (secondi); la pagina
#                avvisa se il dato e' piu' vecchio di 3 volte la tolleranza
#   liveness.*   contatori della liveness applicativa (vedi sotto)
#
# Liveness applicativa (nel demone, guidata dagli eventi):
#   - Lyrion (solo modalita' completa): ogni LIVENESS_LYRION_PING s (45) il
#     demone scrive "version ?" nella connessione CLI aperta: se la risposta
#     arriva entro LIVENESS_LYRION_TIMEOUT s e' vivo, senza alcun processo. Se
#     manca (o la CLI non e' collegata) si conferma con la richiesta
#     JSON-RPC "serverstatus" (come prima); dopo LIVENESS_LYRION_FALLIMENTI
#     fallimenti consecutivi si ferma Lyrion e il servizio (sweetspot-lms
#     servizio) lo riavvia. Sospetto: si riprova ogni 15 s.
#   - Player: il modo di Lyrion arriva dagli eventi playlist. Con "play" il
#     demone guarda i PCM ALSA ogni 5 s con la sola shell (nessun fork); se
#     nessuno e' RUNNING parte il conto, ogni 2 s, e dopo
#     LIVENESS_PLAYER_SECONDI (20) un'ultima richiesta a Lyrion conferma e lo
#     stato e' "bloccato": si ferma squeezelite, il supervisore
#     (sweetspot-player) lo riavvia.
#   - Controlli funzionali (uno ogni LIVENESS_FUNZ_PERIODO s, 120, senza
#     processi permanenti): il player principale e ogni zona risultano
#     connessi a Lyrion (JSON-RPC "connected ?") e, se Lyrion dice "play",
#     suonano davvero; CamillaDSP, se e' nel percorso, risponde sul websocket
#     (GetState). Il "time ?" di Lyrion NON si usa: Lyrion lo estrapola dal
#     momento dell'ultimo stato ricevuto dal player (songElapsedSeconds), quindi
#     con Squeezelite bloccato continua ad avanzare e non prova nulla. Il
#     criterio e' lato player, non estrapolato: nel PCM ALSA del player
#     (/proc/asound/cardN/pcmXp/sub*/status; per il principale le schede che
#     non sono zone, per una zona la sua scheda in $RUN/zone/<scheda>) lo
#     stato e' RUNNING e hw_ptr e' cambiato dal controllo precedente (lo legge
#     il kernel dal DAC, non il player). Esiti, con Lyrion in "play":
#       - RUNNING e hw_ptr che avanza: ok;
#       - RUNNING ma hw_ptr fermo: fallimento (il DAC non consuma);
#       - PCM non RUNNING e processo squeezelite fermo (utime+stime di
#         /proc/<pid>/stat invariati): fallimento, il player e' bloccato;
#       - PCM non RUNNING ma il processo lavora (buffer di stream vuoto per
#         rete lenta, Squeezelite che attende i dati): stato "attesa", niente
#         riavvio ne' fallimento; se dura LIVENESS_FUNZ_ATTESA (5) controlli
#         di fila (il processo potrebbe girare a vuoto) conta come fallimento.
#     Dopo LIVENESS_FUNZ_FALLIMENTI (3) controlli falliti di fila si ferma il
#     solo componente (squeezelite lo riparte sweetspot-player, che riavvia
#     anche le zone; CamillaDSP riparte con la riapertura del dispositivo). Se
#     Lyrion non risponde non si giudica il player: ci pensa il controllo di
#     Lyrion. Con il DAC al Bluetooth il PCM non si giudica.
# I riavvii hanno un backoff (LIVENESS_BACKOFF_MIN, raddoppia fino a
# LIVENESS_BACKOFF_MAX) e un limite: al piu' LIVENESS_RIAVVII_MAX (3) riavvii
# per componente in LIVENESS_RIAVVII_FINESTRA s (1800), poi stato "limite" e
# nessun altro riavvio finche' i vecchi non escono dalla finestra (niente
# cicli). Contatori per componente in liveness.c.<nome> e in stato.json
# (liveness.funzionali); eventi nel log e nello stato.

. "${SWEETSPOT_LIB:-/usr/lib/sweetspot}/common.sh"

DATI=$RUN/stato.dati
JSON=$RUN/stato.json
TS=$RUN/stato.ts
NET=$RUN/stato.rete
# Tolleranza scritta in stato.ts: chi legge ne chiede un giro nuovo se il dato
# ha piu' di 10 s, quindi oltre 3 volte questo valore il demone e' fermo.
# Numero dalle variabili SWEETSPOT_STATO_*: se non e' un numero si usa il
# predefinito e si scrive una riga nel log, senza spegnere il demone.
num_env() { # valore predefinito nome
	case "$1" in
		''|*[!0-9]*) log "stato: $3='$1' non e' un numero, uso $2"; printf '%s' "$2" ;;
		*) printf '%s' "$1" ;;
	esac
}
EVERY=$(num_env "${SWEETSPOT_STATO_TOLLERANZA:-20}" 20 SWEETSPOT_STATO_TOLLERANZA)

net_bytes() { awk 'NR>2 && $1 !~ /^lo:/ {sub(/^[^:]*:/, ""); split($0, a, " "); t += a[1] + a[9]} END {print t+0}' "$PROC/net/dev"; }

# Testo sicuro dentro una stringa JSON.
json_esc() {
	printf '%s' "$1" | tr '\001-\037' ' ' | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'
}

# Lo stesso, con la sola shell: il risultato resta in JE. Un giro del check
# chiama json_esc centinaia di volte, ognuna con tre processi.
# shellcheck disable=SC2034
json_esc_v() {
	local s=$1 o='' r c
	# Caratteri di controllo: uno spazio.
	while :; do
		case "$s" in *[[:cntrl:]]*) ;; *) break ;; esac
		r=${s%%[[:cntrl:]]*}
		s="$r ${s#"$r"?}"
	done
	# Barra e virgolette: una barra davanti.
	while :; do
		case "$s" in *[\\\"]*) ;; *) break ;; esac
		r=${s%%[\\\"]*}
		o="$o$r"
		s=${s#"$r"}
		c=${s%"${s#?}"}
		s=${s#?}
		o="$o\\$c"
	done
	JE="$o$s"
}

# Traffico in KB/s dall'ultimo giro: nessuno sleep, la misura e' la
# differenza con i byte letti la volta scorsa.
traffic_kbs() {
	local now b prev_t prev_b kbs=0
	now=$(date +%s)
	b=$(net_bytes)
	if [ -r "$NET" ] && read -r prev_t prev_b < "$NET" && [ "$now" -gt "$prev_t" ] && [ "$b" -ge "$prev_b" ]; then
		kbs=$(( (b - prev_b) / (now - prev_t) / 1024 ))
	fi
	echo "$now $b" > "$NET.nuovo" && mv "$NET.nuovo" "$NET"
	echo "$kbs"
}

# --- Liveness applicativa -----------------------------------------------------

LV_LMS=$RUN/liveness.lyrion      # fallimenti ultimo_riavvio backoff pid_riavviato riavvii
LV_PLY=$RUN/liveness.player      # da ultimo_riavvio backoff riavvii

lv_num() { # nome predefinito
	local v
	v=$(conf "$1" "$2")
	case "$v" in ''|*[!0-9]*) v=$2 ;; esac
	printf '%s' "$v"
}

# Backoff dei riavvii: parte da MIN, raddoppia fino a MAX.
lv_next_backoff() { # attuale
	local n min max
	min=$(lv_num LIVENESS_BACKOFF_MIN 60)
	max=$(lv_num LIVENESS_BACKOFF_MAX 900)
	if [ "$1" -lt "$min" ]; then n=$min; else n=$(( $1 * 2 )); fi
	[ "$n" -gt "$max" ] && n=$max
	echo "$n"
}

LV_ROWS=''
LV_JSON='"liveness":{}'
lv_row() { LV_ROWS="$LV_ROWS$1|$2|$3
"; }
lv_save() { echo "$2" > "$1.n" && mv "$1.n" "$1"; }

lv_lyrion() { # momento
	local now=$1 fails=0 last=0 bo=0 rpid=0 nrest=0 pid st age tmo k
	LV_LYR_STATO=non_attivo
	LV_LYR_FAILS=0
	[ "$(mode)" = completa ] || return 0
	pid=$(cat "$RUN/lms.pid" 2>/dev/null)
	if [ -z "$pid" ] || ! kill -0 "$pid" 2>/dev/null; then
		lv_row INFO "Lyrion" "non in esecuzione (lo riavvia il servizio)"
		return 0
	fi
	[ -r "$LV_LMS" ] && read -r fails last bo rpid nrest < "$LV_LMS"
	tmo=$(lv_num LIVENESS_LYRION_TIMEOUT 8)
	k=$(lv_num LIVENESS_LYRION_FALLIMENTI 3)
	# LV_CLI_OK=1: il demone ha appena avuto la risposta di Lyrion sulla
	# connessione CLI (version ?), non serve il JSON-RPC.
	if [ "${LV_CLI_OK:-0}" = 1 ] || LMS_TIMEOUT=$tmo lms_json '' serverstatus 0 0 > /dev/null 2>&1; then
		[ "${fails:-0}" -gt 0 ] && log "liveness: Lyrion risponde di nuovo dopo $fails fallimenti"
		lv_save "$LV_LMS" "0 ${last:-0} 0 ${rpid:-0} ${nrest:-0}"
		LV_LYR_STATO=ok
		if [ "${LV_CLI_OK:-0}" = 1 ]; then
			lv_row OK "Lyrion risponde" "CLI version ? entro $tmo s (riavvii per liveness: ${nrest:-0})"
		else
			lv_row OK "Lyrion risponde" "JSON-RPC serverstatus entro $tmo s (riavvii per liveness: ${nrest:-0})"
		fi
		return 0
	fi
	# Appena avviato (il servizio riscrive lms.pid a ogni avvio): si aspetta.
	st=$(stat -c %Y "$RUN/lms.pid" 2>/dev/null || echo 0)
	age=$(( now - st ))
	if [ "$age" -lt "$(lv_num LIVENESS_LYRION_AVVIO 180)" ]; then
		LV_LYR_STATO=avvio
		lv_row INFO "Lyrion risponde" "in avvio, non risponde ancora ($age s dall'avvio)"
		return 0
	fi
	fails=$(( ${fails:-0} + 1 ))
	LV_LYR_STATO=non_risponde
	LV_LYR_FAILS=$fails
	log "liveness: Lyrion non risponde entro $tmo s (fallimento $fails di $k)"
	if [ "$fails" -ge "$k" ] && [ $(( now - ${last:-0} )) -ge "${bo:-0}" ] && ! lv_budget lyrion "$now"; then
		log "liveness: Lyrion in stallo ma gia' $(lv_num LIVENESS_RIAVVII_MAX 3) riavvii negli ultimi $(lv_num LIVENESS_RIAVVII_FINESTRA 1800) s: non riavvio (limite)"
		LV_LYR_STATO=limite
		bo=$(lv_next_backoff "${bo:-0}")
		lv_save "$LV_LMS" "$fails $now $bo ${rpid:-0} ${nrest:-0}"
	elif [ "$fails" -ge "$k" ] && [ $(( now - ${last:-0} )) -ge "${bo:-0}" ]; then
		nrest=$(( ${nrest:-0} + 1 ))
		lv_note_restart lyrion "$now"
		if [ "$rpid" = "$pid" ]; then
			log "liveness: Lyrion (pid $pid) ancora in stallo dopo il riavvio, kill -9 (riavvio $nrest)"
			kill -9 "$pid" 2>/dev/null
		else
			log "liveness: Lyrion in stallo dopo $fails fallimenti, riavvio (pid $pid, riavvio $nrest)"
			kill "$pid" 2>/dev/null
		fi
		bo=$(lv_next_backoff "${bo:-0}")
		lv_save "$LV_LMS" "0 $now $bo $pid $nrest"
		LV_LYR_STATO=riavviato
	else
		lv_save "$LV_LMS" "$fails ${last:-0} ${bo:-0} ${rpid:-0} ${nrest:-0}"
	fi
	lv_row ERRORE "Lyrion risponde" "no: serverstatus senza risposta entro $tmo s ($LV_LYR_STATO, fallimenti $fails di $k, riavvii $nrest)"
}

lv_player() { # momento
	local now=$1 since=0 last=0 bo=0 nrest=0 pid mac mode_now T
	LV_PLY_STATO=n/d
	# Il DAC e' del Bluetooth (sweetspot-bluetooth): non e' un blocco.
	if bt_dac_busy; then
		LV_PLY_STATO=bluetooth
		lv_row INFO "Player" "DAC in uso dal Bluetooth"
		rm -f "$LV_PLY"
		return 0
	fi
	pid=$(cat "$RUN/squeezelite.pid" 2>/dev/null)
	if [ -z "$pid" ] || ! kill -0 "$pid" 2>/dev/null; then
		rm -f "$LV_PLY"
		return 0
	fi
	[ -r "$LV_PLY" ] && read -r since last bo nrest < "$LV_PLY"
	T=$(lv_num LIVENESS_PLAYER_SECONDI 20)
	LV_PLY_STATO=ok
	if dac_playing; then
		lv_save "$LV_PLY" "0 ${last:-0} 0 ${nrest:-0}"
		return 0
	fi
	# Il PCM non suona: e' un problema solo se Lyrion dice "play".
	mac=$(cat "$RUN/player.mac" 2>/dev/null)
	mode_now=$(LMS_TIMEOUT=$(lv_num LIVENESS_LYRION_TIMEOUT 8) lms_get '._mode' "$mac" mode '?' 2>/dev/null)
	if [ "$mode_now" != play ]; then
		lv_save "$LV_PLY" "0 ${last:-0} 0 ${nrest:-0}"
		return 0
	fi
	[ "${since:-0}" -gt 0 ] || since=$now
	if [ $(( now - since )) -ge "$T" ]; then
		LV_PLY_STATO=bloccato
		lv_row ERRORE "Player" "bloccato: Lyrion dice play ma il PCM ALSA non e' RUNNING da $(( now - since )) s (soglia $T s, riavvii ${nrest:-0})"
		if [ $(( now - ${last:-0} )) -ge "${bo:-0}" ] && ! lv_budget principale "$now"; then
			log "liveness: player bloccato ma gia' $(lv_num LIVENESS_RIAVVII_MAX 3) riavvii negli ultimi $(lv_num LIVENESS_RIAVVII_FINESTRA 1800) s: non riavvio (limite)"
			LV_PLY_STATO=limite
			bo=$(lv_next_backoff "${bo:-0}")
			last=$now
		elif [ $(( now - ${last:-0} )) -ge "${bo:-0}" ]; then
			nrest=$(( ${nrest:-0} + 1 ))
			lv_note_restart principale "$now"
			log "liveness: player bloccato da $(( now - since )) s (play senza PCM RUNNING), riavvio squeezelite pid $pid (riavvio $nrest)"
			kill "$pid" 2>/dev/null
			bo=$(lv_next_backoff "${bo:-0}")
			last=$now
			since=$now
		fi
	fi
	lv_save "$LV_PLY" "$since ${last:-0} ${bo:-0} ${nrest:-0}"
}

# --- Limite di riavvii e controlli funzionali ----------------------------------
#
# Ogni componente (lyrion, principale, zona-<id>, camilladsp) ha un file
# $RUN/liveness.c.<nome>: FALLIMENTI RIAVVII_TOTALI TEMPO_RIAVVIO... (i tempi
# sono quelli dei riavvii dentro la finestra LIVENESS_RIAVVII_FINESTRA).
# Dopo LIVENESS_RIAVVII_MAX riavvii nella finestra non si riavvia piu': il
# componente resta "limite" (visibile in Stato e in stato.json) per non fare
# un ciclo di riavvii; si riprende da solo quando i riavvii escono dalla
# finestra.

lv_cf() { printf '%s/liveness.c.%s' "$RUN" "$1"; }

lv_cread() { # nome: LV_C_FAILS LV_C_TOT LV_C_TS
	LV_C_FAILS=0; LV_C_TOT=0; LV_C_TS=''
	[ -r "$(lv_cf "$1")" ] && read -r LV_C_FAILS LV_C_TOT LV_C_TS < "$(lv_cf "$1")"
	case "$LV_C_FAILS" in ''|*[!0-9]*) LV_C_FAILS=0 ;; esac
	case "$LV_C_TOT" in ''|*[!0-9]*) LV_C_TOT=0 ;; esac
	return 0
}

# Riavvii del componente ancora dentro la finestra.
lv_in_window() { # nome momento
	local win t n=0
	win=$(lv_num LIVENESS_RIAVVII_FINESTRA 1800)
	lv_cread "$1"
	for t in $LV_C_TS; do
		case "$t" in ''|*[!0-9]*) continue ;; esac
		[ $(( $2 - t )) -lt "$win" ] && n=$(( n + 1 ))
	done
	echo "$n"
}

lv_budget() { # nome momento: riesce se un riavvio e' ancora consentito
	[ "$(lv_in_window "$1" "$2")" -lt "$(lv_num LIVENESS_RIAVVII_MAX 3)" ]
}

lv_note_restart() { # nome momento
	local win keep='' t
	win=$(lv_num LIVENESS_RIAVVII_FINESTRA 1800)
	lv_cread "$1"
	for t in $LV_C_TS; do
		case "$t" in ''|*[!0-9]*) continue ;; esac
		[ $(( $2 - t )) -lt "$win" ] && keep="$keep $t"
	done
	lv_save "$(lv_cf "$1")" "0 $(( LV_C_TOT + 1 ))$keep $2"
}

lv_set_fails() { # nome valore
	lv_cread "$1"
	lv_save "$(lv_cf "$1")" "$2 $LV_C_TOT${LV_C_TS:+ $LV_C_TS}"
}

LV_FN=$RUN/liveness.funz   # righe: nome|etichetta|stato|riavvii|in_finestra|dettaglio
LV_FN_NEW=''
LV_FN_BAD=0

# Esito di un controllo funzionale: dopo LIVENESS_FUNZ_FALLIMENTI esiti
# negativi di fila si ferma il solo componente (lo riavvia chi lo
# supervisiona), se il limite di riavvii nella finestra lo consente.
lv_fn_esito() { # nome etichetta momento pid esito(0 ok, 1 fallito, 2 in attesa) dettaglio
	local nome=$1 et=$2 now=$3 pid=$4 ko=$5 det=$6 k stato=ok f
	k=$(lv_num LIVENESS_FUNZ_FALLIMENTI 3)
	lv_cread "$nome"
	if [ "$ko" = 2 ]; then
		stato=attesa   # in attesa di dati: ne' ok ne' fallito, i contatori restano
	elif [ "$ko" = 0 ]; then
		if [ "$LV_C_FAILS" -gt 0 ]; then
			log "liveness: $et risponde di nuovo dopo $LV_C_FAILS controlli falliti"
			lv_set_fails "$nome" 0
		fi
	else
		f=$(( LV_C_FAILS + 1 ))
		stato=sospetto
		log "liveness: $et: $det (controllo fallito $f di $k)"
		if [ "$f" -ge "$k" ]; then
			if lv_budget "$nome" "$now"; then
				log "liveness: $et bloccato ($det), riavvio pid $pid (riavvio $(( LV_C_TOT + 1 )))"
				kill "$pid" 2>/dev/null
				lv_note_restart "$nome" "$now"
				stato=riavviato
			else
				log "liveness: $et bloccato ($det) ma gia' $(lv_num LIVENESS_RIAVVII_MAX 3) riavvii negli ultimi $(lv_num LIVENESS_RIAVVII_FINESTRA 1800) s: non riavvio (limite)"
				stato=limite
				lv_set_fails "$nome" "$f"
			fi
		else
			lv_set_fails "$nome" "$f"
		fi
	fi
	lv_cread "$nome"
	LV_FN_NEW="$LV_FN_NEW$nome|$et|$stato|$LV_C_TOT|$(lv_in_window "$nome" "$now")|$det
"
}

# PCM ALSA del player: LV_PCM_ST (stato del primo substream RUNNING, altrimenti
# l'ultimo letto, vuoto se non c'e') e LV_PCM_HW (hw_ptr del RUNNING).
# Scheda vuota = principale: tutte le schede che non sono zone.
lv_pcm_leggi() { # scheda
	local f c l st h want=$1
	LV_PCM_ST=''; LV_PCM_HW=''
	for f in "$PROC"/asound/card*/pcm*p/sub*/status; do
		[ -r "$f" ] || continue
		c=${f#"$PROC"/asound/card}; c=${c%%/*}
		if [ -n "$want" ]; then
			[ "$c" = "$want" ] || continue
		else
			[ -e "$RUN/zone/$c" ] && continue
		fi
		st=''; h=''
		while IFS= read -r l; do
			case "$l" in
				"state:"*) set -- ${l#*:}; st=$1 ;;
				"hw_ptr"*) set -- ${l#*:}; h=$1 ;;
			esac
		done < "$f"
		[ -n "$st" ] || continue
		LV_PCM_ST=$st
		if [ "$st" = RUNNING ]; then LV_PCM_HW=$h; return 0; fi
	done
	return 0
}

# Tick di CPU (utime+stime) del processo: cambiano se il processo lavora.
lv_cpu() { # pid
	local l
	[ -r "$PROC/$1/stat" ] || return 0
	read -r l < "$PROC/$1/stat" || return 0
	l=${l##*) }
	set -- $l
	[ -n "${12:-}" ] && echo "$(( ${12} + ${13:-0} ))"
	return 0
}

# Un player (principale o zona): risulta connesso a Lyrion e, se Lyrion dice
# "play", il PCM ALSA avanza (criterio in testa al file).
# Lyrion che non risponde non e' colpa del player: nessun giudizio.
lv_fn_player() { # nome etichetta momento pid mac [scheda]
	local nome=$1 et=$2 now=$3 pid=$4 mac=$5 card=$6 tmo conn mode det ko=0 tf
	local hw cpu phw pcpu att=0 amax
	tmo=$(lv_num LIVENESS_LYRION_TIMEOUT 8)
	tf="$RUN/liveness.t.$nome"
	conn=$(LMS_TIMEOUT=$tmo lms_get '._connected' "$mac" connected '?' 2>/dev/null)
	if [ -z "$conn" ]; then
		LV_FN_NEW="$LV_FN_NEW$nome|$et|n/d|0|0|Lyrion non risponde: nessun giudizio sul player
"
		return 0
	fi
	if [ "$conn" != 1 ]; then
		ko=1; det="non risulta connesso a Lyrion"
		rm -f "$tf"
	else
		mode=$(LMS_TIMEOUT=$tmo lms_get '._mode' "$mac" mode '?' 2>/dev/null)
		if [ "$mode" != play ]; then
			rm -f "$tf"
			det="connesso a Lyrion"
		elif [ -z "$card" ] && bt_dac_busy; then
			rm -f "$tf"
			det="connesso a Lyrion, DAC al Bluetooth: PCM non giudicato"
		else
			lv_pcm_leggi "$card"
			hw=$LV_PCM_HW
			cpu=$(lv_cpu "$pid")
			phw=''; pcpu=''
			[ -r "$tf" ] && read -r phw pcpu att < "$tf"
			[ "$phw" = - ] && phw=''
			[ "$pcpu" = - ] && pcpu=''
			case "$att" in ''|*[!0-9]*) att=0 ;; esac
			amax=$(lv_num LIVENESS_FUNZ_ATTESA 5)
			if [ "$LV_PCM_ST" = RUNNING ]; then
				att=0
				if [ -z "$phw" ] || [ -z "$hw" ] || [ "$hw" != "$phw" ]; then
					det="connesso a Lyrion, in play, il PCM ALSA avanza"
				else
					ko=1; det="in play, PCM RUNNING ma hw_ptr fermo a $hw"
				fi
			elif [ -n "$cpu" ] && [ -n "$pcpu" ] && [ "$cpu" = "$pcpu" ]; then
				att=0
				ko=1; det="in play ma PCM ${LV_PCM_ST:-assente} e processo player fermo"
			else
				att=$(( att + 1 ))
				if [ "$att" -ge "$amax" ]; then
					ko=1; det="in play, PCM ${LV_PCM_ST:-assente} da $att controlli (il processo lavora ma non suona)"
				else
					ko=2; det="in attesa di dati: in play, PCM ${LV_PCM_ST:-assente} ma il processo lavora (ribuffering, controllo $att di $amax)"
				fi
			fi
			echo "${hw:--} ${cpu:--} $att" > "$tf.n" && mv "$tf.n" "$tf"
		fi
	fi
	lv_fn_esito "$nome" "$et" "$now" "$pid" "$ko" "$det"
}

# Controlli funzionali con scadenza, ogni LIVENESS_FUNZ_PERIODO s (li chiama
# il demone; nessun processo permanente). Non fanno nulla se il componente
# non c'e'.
lv_func() { # momento
	local now=$1 pid mac f card id p st
	LV_FN_NEW=''
	LV_FN_BAD=0
	# Configurazione e PID con la sola shell: ogni "$(conf)" o "$(cat)" e' un fork.
	confv LIVENESS si
	is_yes "$CONFV" || { rm -f "$LV_FN"; return 0; }
	confv MODALITA completa
	# (stesse parole di mode(), che dice "player" per questi valori)
	case "$CONFV" in *[A-Z]*) CONFV=$(lower "$CONFV") ;; esac
	case "$CONFV" in
		player|solo-player|soloplayer|squeezelite|lyrion|lms) f=player ;;
		*) f=completa ;;
	esac
	if [ "$f" = completa ]; then
		pid=''; mac=''
		read -r pid < "$RUN/squeezelite.pid" 2>/dev/null
		read -r mac < "$RUN/player.mac" 2>/dev/null
		if [ -n "$pid" ] && [ -n "$mac" ] && kill -0 "$pid" 2>/dev/null; then
			lv_fn_player principale "Player principale" "$now" "$pid" "$mac"
		fi
		for f in "$RUN"/zone/*; do
			[ -f "$f" ] || continue
			card=${f##*/}
			read -r pid id < "$f"
			mac=''
			read -r mac < "$RUN/zone.mac/$card" 2>/dev/null
			[ -n "$pid" ] && [ -n "$mac" ] && kill -0 "$pid" 2>/dev/null || continue
			lv_fn_player "zona-$id" "Zona $id" "$now" "$pid" "$mac" "$card"
		done
	fi
	# CamillaDSP, solo se e' nel percorso: deve rispondere sul websocket.
	if [ -f "$RUN/correzione.attiva" ]; then
		p=$(${SWEETSPOT_PIDOF:-pidof} camilladsp 2>/dev/null | cut -d' ' -f1)
		if [ -n "$p" ]; then
			st=$(sweetspot-camilla "$DSP_PORTA" GetState 2>/dev/null | sed -n 's/.*"value":"\([A-Za-z]*\)".*/\1/p')
			if [ -n "$st" ]; then
				lv_fn_esito camilladsp "CamillaDSP" "$now" "$p" 0 "websocket risponde (stato $st)"
			else
				lv_fn_esito camilladsp "CamillaDSP" "$now" "$p" 1 "websocket senza risposta"
			fi
		fi
	fi
	if [ -n "$LV_FN_NEW" ]; then
		printf '%s' "$LV_FN_NEW" > "$LV_FN.n" && mv "$LV_FN.n" "$LV_FN"
	else
		rm -f "$LV_FN"
	fi
	case "$LV_FN_NEW" in *"|sospetto|"*|*"|riavviato|"*|*"|limite|"*) LV_FN_BAD=1 ;; esac
}

# Righe per la pagina Stato e JSON dei componenti dei controlli funzionali.
lv_fn_report() {
	local nome et stato nr win det sep='' lim e
	LV_FN_JSON=''
	[ -r "$LV_FN" ] || return 0
	while IFS='|' read -r nome et stato nr win det; do
		[ -n "$nome" ] || continue
		case "$stato" in
			ok) e=OK ;;
			n/d|attesa) e=INFO ;;
			sospetto) e=ATTENZIONE ;;
			*) e=ERRORE ;;
		esac
		lv_row "$e" "$et risponde" "$det ($stato, riavvii $nr, nella finestra $win di $(lv_num LIVENESS_RIAVVII_MAX 3))"
		lim=false; [ "$stato" = limite ] && lim=true
		json_esc_v "$nome"
		LV_FN_JSON="$LV_FN_JSON$sep{\"componente\":\"$JE\",\"stato\":\"$stato\",\"riavvii\":$nr,\"riavvii_finestra\":$win,\"limite\":$lim}"
		sep=,
	done < "$LV_FN"
}

liveness_round() { # momento
	local ln=0 pn=0
	LV_ROWS=''
	LV_LYR_STATO=non_attivo
	LV_LYR_FAILS=0
	LV_PLY_STATO=n/d
	is_yes "$(conf LIVENESS si)" || { LV_JSON='"liveness":{"attiva":false}'; return 0; }
	lv_lyrion "$1"
	lv_player "$1"
	[ -r "$LV_LMS" ] && read -r _ _ _ _ ln < "$LV_LMS"
	[ -r "$LV_PLY" ] && read -r _ _ _ pn < "$LV_PLY"
	LV_JSON=$(printf '"liveness":{"attiva":true,"lyrion":{"stato":"%s","fallimenti":%s,"riavvii":%s},"player":{"stato":"%s","riavvii":%s}}' \
		"$LV_LYR_STATO" "$LV_LYR_FAILS" "${ln:-0}" "$LV_PLY_STATO" "${pn:-0}")
	lv_fn_report
	LV_JSON="${LV_JSON%\}},\"funzionali\":[$LV_FN_JSON]}"
}

do_round() {
	local every=$1 kbs esito now listening=false rows sep='' e v d je jv
	mkdir -p "$RUN"
	now=$(date +%s)
	kbs=$(traffic_kbs)
	if [ "$kbs" -lt 2 ]; then esito=OK; else esito=INFO; fi
	dac_playing && listening=true
	if [ "$2" = leggero ] && [ -n "$ROWS_CACHE" ]; then
		rows=$ROWS_CACHE
	else
		rows=$(sweetspot-check --dati)
		ROWS_CACHE=$rows
	fi
	liveness_round "$now"
	stick_guardia
	{
		[ -n "$rows" ] && printf '%s\n' "$rows"
		[ -n "$LV_ROWS" ] && printf '%s' "$LV_ROWS"
		echo "$esito|Traffico di rete ora|$kbs KB/s (streaming e controllo remoto possono mantenere attiva la rete)"
	} > "$DATI.nuovo"
	{
		printf '{"ts":%s,"intervallo":%s,"ascolto":%s,"traffico_kbs":%s,%s,"voci":[' "$now" "$every" "$listening" "$kbs" "$LV_JSON"
		while IFS='|' read -r e v d; do
			[ -n "$v" ] || continue
			json_esc_v "$e"; je=$JE; json_esc_v "$v"; jv=$JE; json_esc_v "$d"
			printf '%s{"esito":"%s","voce":"%s","dettaglio":"%s"}' "$sep" "$je" "$jv" "$JE"
			sep=,
		done < "$DATI.nuovo"
		printf ']}\n'
	} > "$JSON.nuovo"
	echo "$now $every" > "$TS.nuovo"
	chmod 644 "$DATI.nuovo" "$JSON.nuovo" "$TS.nuovo"
	# Prima i dati, per ultimo il momento: chi vede il momento nuovo trova
	# gia' i dati nuovi.
	mv "$DATI.nuovo" "$DATI"; mv "$JSON.nuovo" "$JSON"; mv "$TS.nuovo" "$TS"
}


# --- Demone a eventi -----------------------------------------------------------

EV=$RUN/stato.eventi         # FIFO: una riga per evento (L, U, I, C, R)
CLIF=$RUN/stato.cli          # FIFO verso la connessione CLI di Lyrion (nc)
REQ=$RUN/stato.richiesta     # FIFO scrivibile da tutti: chiede un giro
SOSTA=$RUN/stato.sosta       # FIFO mai scritta: serve a "dormire" senza fork
ALLARME=$RUN/stato.allarme   # FIFO: secondi alla prossima scadenza, per l'allarme
ATTIVA=$RUN/dac.cache.attiva # esiste finche' il demone gira (cache del DAC)
# Porta CLI di Lyrion (la stessa di sweetspot-volume) e strumenti di ascolto
# (sostituibili nelle prove: BusyBox preferisce i suoi applet al PATH).
LMS_CLI_PORT=${SWEETSPOT_LMS_CLI_PORT:-9090}
NC=${SWEETSPOT_NC:-nc}
UDEVADM=${SWEETSPOT_UDEVADM:-udevadm}
INOTIFYD=${SWEETSPOT_INOTIFYD:-inotifyd}
BATTITO=$(num_env "${SWEETSPOT_STATO_BATTITO:-900}" 900 SWEETSPOT_STATO_BATTITO)
MIN_GAP=$(num_env "${SWEETSPOT_STATO_MIN:-5}" 5 SWEETSPOT_STATO_MIN)
PRE_GAP=5
# Secondi dopo l'avvio di Lyrion in cui si cerca lo scanner anche senza evento.
SCAN_WIN=$(num_env "${SWEETSPOT_STATO_SCAN:-120}" 120 SWEETSPOT_STATO_SCAN)

# Secondi dall'avvio del computer, senza lanciare date (non salta con NTP).
up_now() {
	local u
	read -r u _ < /proc/uptime 2>/dev/null && NOW=${u%%.*}
}

# Dorme in secondi senza fork: legge una FIFO che nessuno scrive.
# (read -t c'e' nell'ash di BusyBox, non in dash: shellcheck non lo sa.)
# shellcheck disable=SC3045
nap() { read -r -t "$1" _ <&7; }

# Impostazioni usate dal demone, lette dal file solo all'avvio e quando
# cambia (ogni conf e' un processo).
cfg_load() {
	CFG_COMPLETA=0; [ "$(mode)" = completa ] && CFG_COMPLETA=1
	CFG_LIVE=0; is_yes "$(conf LIVENESS si)" && CFG_LIVE=1
	CFG_TMO=$(lv_num LIVENESS_LYRION_TIMEOUT 8)
	CFG_PLY=$(lv_num LIVENESS_PLAYER_SECONDI 20)
	CFG_FUNC=$(lv_num LIVENESS_FUNZ_PERIODO 120)
	[ "$CFG_FUNC" -ge 30 ] || CFG_FUNC=30
	LIVE_EVERY=$(lv_num LIVENESS_LYRION_PING 45)
	[ "$LIVE_EVERY" -ge 5 ] || LIVE_EVERY=5
	[ "$CFG_TMO" -ge 1 ] || CFG_TMO=1
	CLI_USER=$(lms_user)
	CLI_PASS=$(conf LYRION_PASSWORD)
}

# MAC del player in forma URL-encoded, come lo scrive la CLI di Lyrion.
mac_load() {
	local m=''
	MAC_RAW=''; MAC_ENC=''
	read -r m < "$RUN/player.mac" 2>/dev/null
	MAC_RAW=$m
	[ -z "$m" ] || MAC_ENC=$(printf '%s' "$m" | sed 's/:/%3A/g')
}

# Un giro nuovo del check completo: raccoglie gli eventi ravvicinati (1 s) e
# rispetta MIN_GAP dal giro precedente.
#
# want_round_ev (eventi udev, inotify, CLI) e want_light (cambi di liveness)
# per ora fanno un giro completo come want_round: restano separati per poterli
# alleggerire in seguito senza toccare chi li chiama.
want_gap() { # distanza minima dal giro precedente, 1 = giro completo
	local t=$((NOW + 1))
	[ "$t" -ge $((LAST_ROUND + $1)) ] || t=$((LAST_ROUND + $1))
	[ "$2" != 1 ] || FULL=1
	if [ "$DIRTY" = 1 ] && [ "$DL_ROUND" -gt 0 ] && [ "$DL_ROUND" -le "$t" ]; then return 0; fi
	DIRTY=1
	DL_ROUND=$t
}
want_round() { want_gap "$MIN_GAP" 1; }
want_round_ev() { want_round; }
want_light() { want_round; }

run_round() {
	local m=leggero
	[ "$FULL" != 1 ] || m=completo
	DIRTY=0; DL_ROUND=0; FULL=0
	do_round "$EVERY" "$m"
	[ "$m" != completo ] || lms_scanner_step
	up_now
	LAST_ROUND=$NOW
	DL_BEAT=$((NOW + BATTITO))
	PUB_LYR=$LV_LYR_STATO
	[ -z "$SWEETSPOT_STATO_DEBUG" ] || echo "$NOW giro concluso" >> "$RUN/stato.debug"
}

# Un passo del precarico (la coda di Lyrion e' cambiata).
pre_want() {
	[ "$PRE_OK" = 1 ] || return 0
	[ "$PRE_DIRTY" = 1 ] && return 0
	PRE_DIRTY=1
	DL_PRE=$((NOW + 1))
	[ "$DL_PRE" -ge $((PRE_LAST + PRE_GAP)) ] || DL_PRE=$((PRE_LAST + PRE_GAP))
}

pre_tick() {
	DL_PRE=0; PRE_DIRTY=0
	step
	up_now
	PRE_LAST=$NOW
	# Con il caricamento in corso o la coda in RAM il passo si ripete ogni
	# minuto (disco svegliato da altro, standby da ritentare); senza coda no.
	if holder_running; then DL_PRETICK=$((NOW + 60)); else DL_PRETICK=0; fi
}

# Scanner di Lyrion: a +500 per l'OOM killer. Si controlla solo durante una
# scansione (evento rescan) e nei due minuti dopo l'avvio di Lyrion.
# Cgroup di memoria dello scanner e tmpfs delle copertine (sweetspot-lms
# scanner, ex oom_watch): durante le scansioni e a ogni giro dello stato.
# SWEETSPOT_LMS vuoto = non farlo (prove).
lms_scanner_step() {
	local cmd=${SWEETSPOT_LMS-${0%/*}/sweetspot-lms}
	[ "$CFG_COMPLETA" = 1 ] && [ -n "$cmd" ] && [ -x "$cmd" ] && "$cmd" scanner
	return 0
}

scan_window() {
	[ "$SCAN_WIN" -gt 0 ] || return 0
	SCAN_UNTIL=$((NOW + SCAN_WIN))
	DL_SCAN=$((NOW + 10))
}

scan_tick() {
	local lp=''
	read -r lp < "$RUN/lms.pid" 2>/dev/null
	[ -z "$lp" ] || oom_adj_cmd 500 scanner.pl "$lp"
	lms_scanner_step
	DL_SCAN=0
	if [ "$SCANNING" = 1 ] || [ "$NOW" -lt "$SCAN_UNTIL" ]; then DL_SCAN=$((NOW + 20)); fi
}

# --- Liveness guidata dagli eventi ---------------------------------------------

# Conferma con il JSON-RPC (come prima): aggiorna i contatori, puo' riavviare
# Lyrion e chiede un giro se lo stato pubblicato e' cambiato.
lms_probe() {
	local lp=''
	LV_CLI_OK=0
	read -r lp < "$RUN/lms.pid" 2>/dev/null
	[ -n "$lp" ] && kill -0 "$lp" 2>/dev/null || return 0
	liveness_round "$(date +%s)"
	[ "$LV_LYR_STATO" = "$PUB_LYR" ] || want_light
	[ "$LV_LYR_STATO" = ok ] || DL_LIVE=$((NOW + 15))
}

# "version ?" sulla connessione CLI: la risposta arriva come riga L (REPLY_AT).
live_tick() {
	DL_LIVE=0
	[ "$CFG_LIVE" = 1 ] && [ "$CFG_COMPLETA" = 1 ] || return 0
	DL_LIVE=$((NOW + LIVE_EVERY))
	if [ "$CLI_UP" = 1 ]; then
		[ "$DL_PINGCHK" -gt 0 ] && return 0
		echo "version ?" >&5
		PING_AT=$NOW
		DL_PINGCHK=$((NOW + CFG_TMO))
	else
		lms_probe
	fi
}

ping_check() {
	DL_PINGCHK=0
	if [ "$REPLY_AT" -ge "$PING_AT" ]; then
		LV_CLI_OK=1
		if [ "$LV_SUSP" = 1 ]; then LV_SUSP=0; want_light; fi
	else
		LV_SUSP=1
		lms_probe
	fi
}

mode_resolve() {
	local m=''
	[ -z "$MAC_RAW" ] || m=$(LMS_TIMEOUT=$CFG_TMO lms_get '._mode' "$MAC_RAW" mode '?' 2>/dev/null)
	LMS_MODE=${m:-x}
}

# Verdetto del player (lv_player: conferma il modo con Lyrion, applica soglia
# e backoff, tiene i contatori).
ply_call() {
	lv_player "$(date +%s)"
	case "$LV_PLY_STATO" in bloccato) PLY_SUSP=0; want_light ;; esac
}

# Con "play" il PCM deve essere RUNNING: lo si guarda con la sola shell. Se
# non lo e' si conta, ogni 2 s, fino a LIVENESS_PLAYER_SECONDI (~20 s).
player_tick() {
	local pid='' s=0
	DL_PLAYER=0
	[ "$CFG_LIVE" = 1 ] && [ "$CFG_COMPLETA" = 1 ] || return 0
	[ -n "$LMS_MODE" ] || mode_resolve
	if [ "$LMS_MODE" = play ]; then
		read -r pid < "$RUN/squeezelite.pid" 2>/dev/null
		if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
			if dac_playing; then
				if [ "$PLY_SUSP" = 1 ]; then PLY_SUSP=0; ply_call; fi
				DL_PLAYER=$((NOW + 5))
			elif [ "$PLY_SUSP" = 0 ]; then
				PLY_SUSP=1; PLY_T0=$NOW
				ply_call
				DL_PLAYER=$((NOW + 2))
			elif [ $((NOW - PLY_T0)) -ge "$CFG_PLY" ]; then
				ply_call
				if [ "$PLY_SUSP" = 1 ]; then
					read -r s _ < "$LV_PLY" 2>/dev/null
					if [ "${s:-0}" = 0 ]; then
						# Lyrion non dice piu' "play": l'evento era vecchio.
						PLY_SUSP=0; LMS_MODE=''
					else
						DL_PLAYER=$((NOW + 2))
					fi
				fi
			else
				DL_PLAYER=$((NOW + 2))
			fi
			return 0
		fi
	fi
	if [ "$PLY_SUSP" = 1 ]; then PLY_SUSP=0; ply_call; fi
	return 0
}

# Controlli funzionali (player connesso e tempo che avanza, zone, CamillaDSP):
# uno ogni LIVENESS_FUNZ_PERIODO s, senza processi permanenti. Se il giro
# trova qualcosa che non va (o che e' tornato a posto) chiede un giro di stato.
func_tick() {
	local was=$LV_FN_BAD
	DL_FUNC=$((NOW + CFG_FUNC))
	[ "$CFG_LIVE" = 1 ] || { DL_FUNC=0; return 0; }
	lv_func "$(date +%s)"
	if [ "$LV_FN_BAD" = 1 ] || [ "$was" = 1 ]; then want_light; fi
}

# --- Eventi --------------------------------------------------------------------

# Righe della CLI: "<mac> playlist pause 1", "<mac> client new", "rescan done",
# "version 9.1.1" (risposta al ping)...
cli_line() {
	local a b c d cmd arg
	set -f; set -- $1; set +f
	a=${1:-}; b=${2:-}; c=${3:-}; d=${4:-}
	case "$a" in
		version) REPLY_AT=$NOW; return 0 ;;
		rescan)
			case "$b" in
				done) SCANNING=0; want_round_ev ;;
				*) SCANNING=1; DL_SCAN=$((NOW + 2)) ;;
			esac
			return 0 ;;
		prefset)
			# Lyrion scrive preferenze di continuo: solo quelle che cambiano
			# la libreria rifanno il precarico e lo stato.
			case "$c" in audiodir|playlistdir) pre_want; want_round_ev ;; esac
			return 0 ;;
		login|subscribe|listen) return 0 ;;
	esac
	case "$b" in
		client)
			want_round_ev
			if [ -z "$MAC_ENC" ] || [ "$a" = "$MAC_ENC" ]; then
				LMS_MODE=''; DL_PLAYER=$NOW; pre_want
			fi
			return 0 ;;
	esac
	[ -z "$MAC_ENC" ] || [ "$a" = "$MAC_ENC" ] || return 0
	case "$b" in
		playlist) cmd=$c; arg=$d ;;
		play|pause|stop) cmd=$b; arg=$c ;;
		*) return 0 ;;
	esac
	case "$cmd" in
		play|newsong) LMS_MODE=play ;;
		stop) LMS_MODE=stop ;;
		pause)
			case "$arg" in
				1) LMS_MODE=pause ;;
				0) LMS_MODE=play ;;
				*) LMS_MODE='' ;;
			esac ;;
	esac
	DL_PLAYER=$NOW
	pre_want
}

# Righe di udevadm monitor: "UDEV  [123.456] add /devices/... (sound)".
udev_line() {
	case "$1" in
		"UDEV  ["*"(sound)") dac_cache_purge; want_round_ev ;;
		"UDEV  ["*"(block)"|"UDEV  ["*"(net)") want_round_ev ;;
	esac
}

# Righe di inotifyd: "w<TAB>/run/sweetspot/sweetspot.conf".
ino_line() {
	local name=${1##*	}
	name=${name##*/}
	case "$name" in
		sweetspot.conf) cfg_load; mac_load; want_round_ev; pre_want ;;
		player.mac) mac_load; LMS_MODE=''; DL_PLAYER=$NOW; pre_want ;;
		squeezelite.pid) PLY_SUSP=0; DL_PLAYER=$NOW; want_round_ev ;;
		lms.pid) scan_window; want_round_ev ;;
		volume.effettivo|volume.modo|correzione.filtri|correzione.attiva) want_round_ev ;;
		precarico.stato) pre_want ;;
	esac
}

# La connessione CLI e' pronta: login (se serve), iscrizione agli eventi e
# un primo ping.
cli_hello() {
	CLI_UP=1
	if [ -n "$CLI_USER" ]; then echo "login $CLI_USER $CLI_PASS" >&5; fi
	echo "subscribe playlist,mixer,prefset,client,rescan" >&5
	echo "version ?" >&5
	PING_AT=$NOW; DL_PINGCHK=$((NOW + CFG_TMO))
	LMS_MODE=''; DL_PLAYER=$NOW
	pre_want
}

# La FIFO si rifa a ogni caduta: i comandi non consumati non finiscono nella
# connessione successiva.
cli_down() {
	CLI_UP=0; LV_CLI_OK=0; DL_PINGCHK=0; LMS_MODE=''
	rm -f "$CLIF"
	mkfifo -m 600 "$CLIF"
	exec 5<>"$CLIF"
	DL_LIVE=$((NOW + 5))
}

handle() {
	# Diagnosi: SWEETSPOT_STATO_DEBUG=1 annota ogni evento con il momento.
	[ -z "$SWEETSPOT_STATO_DEBUG" ] || echo "$NOW $1" >> "$RUN/stato.debug"
	case "$1" in
		"L "*) cli_line "${1#L }" ;;
		"U "*) udev_line "${1#U }" ;;
		"I "*) ino_line "${1#I }" ;;
		"C su") cli_hello ;;
		"C giu") cli_down ;;
		R) want_round ;;
	esac
}

# --- Ascoltatori: processi di lunga durata, avviati una sola volta -------------

start_feeders() {
	rm -f "$EV" "$CLIF" "$REQ" "$SOSTA" "$ALLARME"
	mkfifo -m 600 "$EV" "$CLIF" "$SOSTA" "$ALLARME" || return 1
	mkfifo -m 622 "$REQ" || return 1
	exec 3<>"$EV" 5<>"$CLIF" 6<>"$REQ" 7<>"$SOSTA" 8<>"$ALLARME"
	FEEDERS=''
	# L'allarme: attende i secondi scritti nella FIFO e poi scrive T.
	(
		w=3600
		while :; do
			# shellcheck disable=SC3045
			if read -r -t "$w" a <&8; then
				[ -z "$SWEETSPOT_STATO_DEBUG" ] || echo "allarme: comando [$a] (era $w)" >> "$RUN/stato.debug"
				case "$a" in ''|*[!0-9]*) ;; *) w=$a ;; esac
			else
				[ -z "$SWEETSPOT_STATO_DEBUG" ] || echo "allarme: T dopo $w s" >> "$RUN/stato.debug"
				echo T >&3
				w=3600
			fi
		done
	) &
	FEEDERS="$FEEDERS $!"
	# Richieste di chi legge la cache: qualunque riga vale "R".
	(
		while IFS= read -r _; do echo R; done <&6 >&3
	) &
	FEEDERS="$FEEDERS $!"
	if command -v "$UDEVADM" >/dev/null 2>&1; then
		(
			while :; do
				"$UDEVADM" monitor --udev -s sound -s block -s net 2>/dev/null |
					while IFS= read -r l; do echo "U $l"; done >&3
				nap 30
			done
		) &
		FEEDERS="$FEEDERS $!"
	fi
	if command -v "$INOTIFYD" >/dev/null 2>&1; then
		(
			while :; do
				"$INOTIFYD" -"$RUN:wyn" 2>/dev/null |
					while IFS= read -r l; do echo "I $l"; done >&3
				nap 30
			done
		) &
		FEEDERS="$FEEDERS $!"
	fi
	if [ "$CFG_COMPLETA" = 1 ] && command -v "$NC" >/dev/null 2>&1; then
		(
			wait_s=5
			while :; do
				p=''
				read -r p < "$RUN/lms.pid" 2>/dev/null
				if [ -z "$p" ] || ! kill -0 "$p" 2>/dev/null; then nap 15; continue; fi
				t0=$(read -r u _ < /proc/uptime && echo "${u%%.*}")
				echo "C su" >&3
				"$NC" "$LMS_HOST" "$LMS_CLI_PORT" < "$CLIF" 2>/dev/null |
					while IFS= read -r l; do echo "L $l"; done >&3
				echo "C giu" >&3
				read -r u _ < /proc/uptime
				if [ $(( ${u%%.*} - ${t0:-0} )) -gt 60 ]; then wait_s=5; fi
				nap "$wait_s"
				wait_s=$((wait_s * 2)); [ "$wait_s" -le 60 ] || wait_s=60
			done
		) &
		FEEDERS="$FEEDERS $!"
	fi
}

daemon_stop() {
	local p
	trap '' TERM INT
	for p in $FEEDERS; do
		pkill -P "$p" 2>/dev/null
		kill "$p" 2>/dev/null
	done
	if [ "$PRE_OK" = 1 ]; then release; write_summary spento; fi
	rm -f "$ATTIVA" "$EV" "$CLIF" "$REQ" "$SOSTA" "$ALLARME"
	exit 0
}

# Il tempo che passa arriva come riga T, scritta da un solo allarme di lunga
# durata (subshell avviata una volta, vedi start_feeders): attende con read -t
# sulla FIFO dell'allarme i secondi che il demone gli scrive (la scadenza piu'
# vicina), poi scrive T. Si riarma solo quando e' scattato o se una scadenza
# nuova e' piu' vicina: nessun processo per scadenza, nessun ticker. Dopo ogni
# T l'allarme torna a 3600 s, quindi il demone lo considera scarico: se un
# riarmo arriva mentre il read -t scade, il timeout ne consuma meta' riga e la
# T che arriva e' quella vecchia, ma il demone lo riarma comunque.
arm_alarm() {
	local m=0 d w
	for d in $DL_ROUND $DL_BEAT $DL_LIVE $DL_PINGCHK $DL_PLAYER $DL_FUNC $DL_PRE $DL_PRETICK $DL_SCAN; do
		[ "$d" -gt 0 ] || continue
		if [ "$m" -eq 0 ] || [ "$d" -lt "$m" ]; then m=$d; fi
	done
	[ "$m" -gt 0 ] || return 0
	w=$((m - NOW))
	[ "$w" -ge 1 ] || w=1
	if [ "$ALARM_FIRE" -le "$NOW" ] || [ $((NOW + w)) -lt "$ALARM_FIRE" ]; then
		ALARM_FIRE=$((NOW + w))
		[ -z "$SWEETSPOT_STATO_DEBUG" ] || echo "$NOW arma $w (fire $ALARM_FIRE)" >> "$RUN/stato.debug"
		echo "$w" >&8
	fi
}

timers() {
	[ "$TIMEDOUT" = 1 ] && [ "$DL_PINGCHK" -gt 0 ] && [ "$NOW" -ge "$DL_PINGCHK" ] && ping_check
	[ "$DL_LIVE" -gt 0 ] && [ "$NOW" -ge "$DL_LIVE" ] && live_tick
	[ "$DL_PLAYER" -gt 0 ] && [ "$NOW" -ge "$DL_PLAYER" ] && player_tick
	[ "$DL_FUNC" -gt 0 ] && [ "$NOW" -ge "$DL_FUNC" ] && func_tick
	[ "$DL_SCAN" -gt 0 ] && [ "$NOW" -ge "$DL_SCAN" ] && scan_tick
	[ "$DL_PRETICK" -gt 0 ] && [ "$NOW" -ge "$DL_PRETICK" ] && { DL_PRETICK=0; pre_want; }
	[ "$DL_PRE" -gt 0 ] && [ "$NOW" -ge "$DL_PRE" ] && pre_tick
	[ "$DL_BEAT" -gt 0 ] && [ "$NOW" -ge "$DL_BEAT" ] && { DL_BEAT=0; want_round; }
	[ "$DL_ROUND" -gt 0 ] && [ "$NOW" -ge "$DL_ROUND" ] && run_round
	return 0
}

do_watch() {
	local line pre
	mkdir -p "$RUN"
	NOW=0; up_now
	DIRTY=0; FULL=1; ROWS_CACHE=; DL_ROUND=0; DL_BEAT=0; DL_LIVE=0; DL_PINGCHK=0; DL_PLAYER=0; DL_FUNC=0
	DL_PRE=0; DL_PRETICK=0; DL_SCAN=0
	LAST_ROUND=$((NOW - MIN_GAP)); PRE_LAST=$((NOW - PRE_GAP)); PRE_DIRTY=0
	CLI_UP=0; LV_CLI_OK=0; LV_SUSP=0; PUB_LYR=''; PING_AT=0; REPLY_AT=0
	LMS_MODE=''; PLY_SUSP=0; PLY_T0=0; SCANNING=0; SCAN_UNTIL=0; TIMEDOUT=0
	FEEDERS=''; PRE_OK=0; ALARM_FIRE=0
	cfg_load; mac_load
	trap daemon_stop TERM INT
	: > "$ATTIVA"
	dac_cache_purge
	pre=${SWEETSPOT_PRECARICO:-${0%/*}/sweetspot-precarico}
	[ -r "$pre" ] || pre=/usr/bin/sweetspot-precarico
	if [ -r "$pre" ]; then
		SWEETSPOT_TEST=1
		# shellcheck disable=SC1090
		. "$pre"
		unset SWEETSPOT_TEST
		PRE_OK=1
	fi
	start_feeders || { log "stato: FIFO degli eventi non create"; exit 1; }
	[ "$CFG_COMPLETA" = 1 ] && [ -s "$RUN/lms.pid" ] && scan_window
	run_round
	DL_LIVE=$((NOW + LIVE_EVERY))
	[ "$CFG_LIVE" = 1 ] && DL_FUNC=$((NOW + CFG_FUNC))
	pre_want
	while :; do
		TIMEDOUT=0
		arm_alarm
		# Lettura bloccante, senza -t: un timeout che scade a meta' riga
		# butta via i primi byte (la riga dopo arriva troncata).
		read -r line <&3
		up_now
		case "$line" in
			T) TIMEDOUT=1; ALARM_FIRE=0 ;;
			*) handle "$line" ;;
		esac
		timers
	done
}

[ "${SWEETSPOT_TEST:-}" = 1 ] && return 0

case "$1" in
	aggiorna) do_round "$EVERY" ;;
	funzionale) lv_func "$(date +%s)"; do_round "$EVERY" ;;
	sorveglia) do_watch ;;
	*) echo "uso: $0 aggiorna|funzionale|sorveglia" >&2; exit 1 ;;
esac
