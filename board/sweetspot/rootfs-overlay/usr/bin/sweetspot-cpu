#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Sweetspot - frequenza fissa della CPU secondo il profilo.
#
#   bilanciato   frequenza FISSA a meta' strada tra minima e nominale
#                (predefinito; il nome indica il compromesso, non una
#                gestione dinamica: per quella c'e' "dinamico")
#   silenzio     frequenza fissa alla minima: meno corrente e meno calore
#   prestazioni  frequenza fissa alla nominale, i core non entrano mai in pausa
#   dinamico     governor schedutil/ondemand, minima libera, massima la
#                nominale; stati C profondi consentiti, salvo sui core audio
#                isolati (isolcpus), dove si evita la latenza di risveglio
#
# In tutti i profili il Turbo e' spento. Nei profili a frequenza fissa
# frequenza e tensione restano costanti e l'assorbimento non varia con il
# carico; in "dinamico" seguono il carico (meno consumo e calore a riposo).
# Il confronto fra profili si fa con sweetspot-banco.

. "${SWEETSPOT_LIB:-/usr/lib/sweetspot}/common.sh"

PROFILE=$(lower "${1:-$(conf PROFILO bilanciato)}")
CPUFREQ=$SYS/devices/system/cpu/cpufreq

turbo_off() {
	[ -f "$SYS/devices/system/cpu/intel_pstate/no_turbo" ] &&
		put 1 "$SYS/devices/system/cpu/intel_pstate/no_turbo"
	[ -f "$CPUFREQ/boost" ] && put 0 "$CPUFREQ/boost"
	for b in "$CPUFREQ"/policy*/boost; do
		[ -f "$b" ] && put 0 "$b"
	done
}

# Frequenza nominale (senza Turbo) in kHz.
base_freq() {
	local pol=$1 list f1 f2
	if [ -f "$pol/base_frequency" ]; then
		cat "$pol/base_frequency"
		return
	fi
	if [ -f "$pol/scaling_available_frequencies" ]; then
		list=$(tr ' ' '\n' < "$pol/scaling_available_frequencies" | grep . | sort -n -r)
		f1=$(echo "$list" | sed -n 1p)
		f2=$(echo "$list" | sed -n 2p)
		# acpi-cpufreq indica il Turbo come "nominale + 1 MHz".
		if [ -n "$f2" ] && [ $((f1 - f2)) -eq 1000 ]; then echo "$f2"; else echo "$f1"; fi
		return
	fi
	cat "$pol/cpuinfo_max_freq"
}

# La frequenza disponibile piu' vicina a quella richiesta.
snap_freq() {
	local pol=$1 want=$2 best="" bestd="" f d
	if [ ! -f "$pol/scaling_available_frequencies" ]; then
		echo "$want"
		return
	fi
	for f in $(cat "$pol/scaling_available_frequencies"); do
		d=$((f - want)); [ $d -lt 0 ] && d=$((-d))
		if [ -z "$bestd" ] || [ $d -lt "$bestd" ]; then best=$f; bestd=$d; fi
	done
	echo "${best:-$want}"
}

# Profilo energetico conservativo: governor che segue il carico, intervallo
# di frequenza intero, SMT attivo e stati C tutti abilitati (a runtime).
set_policy_conservativo() {
	local pol=$1 g=""
	for g in schedutil ondemand; do
		grep -qw "$g" "$pol/scaling_available_governors" 2>/dev/null && break
		g=""
	done
	[ -n "$g" ] && put "$g" "$pol/scaling_governor"
	put "$(cat "$pol/cpuinfo_min_freq")" "$pol/scaling_min_freq"
	put "$(cat "$pol/cpuinfo_max_freq")" "$pol/scaling_max_freq"
	echo "${g:-auto}"
}

conservativo_runtime() {
	local d
	[ -f "$SYS/devices/system/cpu/smt/control" ] &&
		put on "$SYS/devices/system/cpu/smt/control"
	for d in "$SYS"/devices/system/cpu/cpu*/cpuidle/state*/disable; do
		[ -f "$d" ] && put 0 "$d"
	done
}

# Elenco di CPU "0-2,5" -> "0 1 2 5".
espandi_cpu() {
	printf '%s' "$1" | tr ',' '
' | awk -F- 'NF==1 && $1!="" {print $1} NF==2 {for(i=$1;i<=$2;i++) print i}'
}

# Profilo dinamico: governor che segue il carico, intervallo libero fino alla
# nominale (Turbo spento).
set_policy_dinamico() {
	local pol=$1 g=""
	for g in schedutil ondemand; do
		grep -qw "$g" "$pol/scaling_available_governors" 2>/dev/null && break
		g=""
	done
	[ -n "$g" ] && put "$g" "$pol/scaling_governor"
	put "$(cat "$pol/cpuinfo_min_freq")" "$pol/scaling_min_freq"
	put "$(snap_freq "$pol" "$(base_freq "$pol")")" "$pol/scaling_max_freq"
	echo "${g:-auto}"
}

# Stati C: tutti consentiti, tranne quelli con risveglio lento (> 50 us) sui
# core isolati per l'audio, dove la latenza di uscita pesa sulla puntualita'.
dinamico_cstate() {
	local iso c d lat
	for d in "$SYS"/devices/system/cpu/cpu*/cpuidle/state*/disable; do
		[ -f "$d" ] && put 0 "$d"
	done
	iso=$(cat "$SYS/devices/system/cpu/isolated" 2>/dev/null)
	for c in $(espandi_cpu "$iso"); do
		for d in "$SYS/devices/system/cpu/cpu$c"/cpuidle/state*; do
			[ -f "$d/disable" ] || continue
			lat=$(cat "$d/latency" 2>/dev/null)
			[ "${lat:-0}" -gt 50 ] && put 1 "$d/disable"
		done
	done
}

set_policy() {
	local pol=$1 min base target
	min=$(cat "$pol/cpuinfo_min_freq")
	base=$(base_freq "$pol")
	case "$PROFILE" in
		silenzio) target=$min ;;
		prestazioni) target=$base ;;
		*) target=$(( (min + base) / 2 )) ;;
	esac
	target=$(snap_freq "$pol" "$target")
	if grep -qw performance "$pol/scaling_available_governors" 2>/dev/null; then
		put performance "$pol/scaling_governor"
	fi
	# Prima si allarga l'intervallo, poi lo si chiude sul valore scelto.
	put "$(cat "$pol/cpuinfo_max_freq")" "$pol/scaling_max_freq"
	put "$target" "$pol/scaling_min_freq"
	put "$target" "$pol/scaling_max_freq"
	put "$target" "$pol/scaling_min_freq"
	echo "$target"
}

# Profilo prestazioni: i core restano sempre svegli (nessuna latenza di
# risveglio). Il valore resta attivo finche' il file rimane aperto.
pm_qos() {
	if [ -f "$RUN/pmqos.pid" ]; then
		kill "$(cat "$RUN/pmqos.pid")" 2>/dev/null
		rm -f "$RUN/pmqos.pid"
	fi
	if [ "$PROFILE" = prestazioni ] && [ -c /dev/cpu_dma_latency ]; then
		sh -c 'exec 3>/dev/cpu_dma_latency; printf 0x00000000 >&3; exec sleep 2147483647' &
		echo $! > "$RUN/pmqos.pid"
	fi
}

mkdir -p "$RUN"
if safe_mode; then
	log "cpu: avvio senza ottimizzazioni, frequenza gestita dal kernel"
	exit 0
fi
if [ "$(energia)" = conservativo ]; then
	for pol in "$CPUFREQ"/policy*; do
		[ -d "$pol" ] || continue
		f=$(set_policy_conservativo "$pol")
	done
	conservativo_runtime
	pm_qos
	echo "$PROFILE conservativo:${f:-?}" > "$RUN/cpu.stato"
	log "cpu: energia conservativa, governor ${f:-?}"
	exit 0
fi
turbo_off
for pol in "$CPUFREQ"/policy*; do
	[ -d "$pol" ] || continue
	if [ "$PROFILE" = dinamico ]; then f=$(set_policy_dinamico "$pol"); else f=$(set_policy "$pol"); fi
done
[ "$PROFILE" = dinamico ] && dinamico_cstate
pm_qos
echo "$PROFILE ${f:-?}" > "$RUN/cpu.stato"
if [ "$PROFILE" = dinamico ]; then
	log "cpu: profilo dinamico, governor ${f:-?}"
else
	log "cpu: profilo $PROFILE, frequenza ${f:-?} kHz"
fi
