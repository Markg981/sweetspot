#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Sweetspot - cartelle condivise in rete (NAS, PC Windows, Mac) via SMB o NFS.
#
#   sweetspot-rete monta      monta le condivisioni configurate
#   sweetspot-rete smonta     le smonta
#   sweetspot-rete elenco     righe "numero|percorso|stato|dettaglio"
#   sweetspot-rete prova N    prova la condivisione N e risponde OK o l'errore
#   sweetspot-rete ritenta    riprova le condivisioni non montate, a intervalli
#                             crescenti, finche' non sono tutte montate
#
# Configurazione in sweetspot.txt (fino a 9 condivisioni):
#   CONDIVISIONE_1=//192.168.1.10/Musica
#   CONDIVISIONE_1_UTENTE=marco          (vuoto = accesso ospite)
#   CONDIVISIONE_1_PASSWORD=...
#   CONDIVISIONE_1_SMB1=si               (solo se il NAS parla solo SMB1: insicuro)
#   CONDIVISIONE_2=nfs://192.168.1.10/export/musica   (cartella NFS)
# Le condivisioni sono montate in sola lettura. SMB: almeno 2.1.

. "${SWEETSPOT_LIB:-/usr/lib/sweetspot}/common.sh"

LIST=$RUN/rete.list
# Condivisioni in attesa di un nuovo tentativo: "numero|tentativi|prossimo" (secondi epoch).
ATTESA=$RUN/rete.attesa
RETRY_LOCK=$RUN/rete.ritenta.lock
RETRY_PID=$RUN/rete.ritenta.pid
# Stato per sorgente, per Stato e per la pagina Musica:
# "numero|montata/attesa/errore|ultimo errore|prossimo tentativo (epoch)|tentativi"
STATO=$RUN/rete.stato
RETRY_MIN=${SWEETSPOT_RETE_MIN:-10}
RETRY_MAX=${SWEETSPOT_RETE_MAX:-300}
# Tempo massimo per accorgersi che un montaggio "hard" non risponde piu' (stale).
STALE_TIMEOUT=${SWEETSPOT_STALE_TIMEOUT:-5}
SVEGLIA=0

share_name() {
	local p=$1 last
	last=${p##*/}
	safe_name "Rete - $last"
}

wait_network() {
	local i=0
	while [ $i -lt 30 ] && [ -z "$(net_ipv4)" ]; do
		sleep 1
		i=$((i + 1))
	done
	[ -n "$(net_ipv4)" ]
}

# Opzioni comuni di montaggio. "hard" e non "soft": con "soft" un NAS lento o
# un Wi-Fi che cade fanno restituire errori di I/O a Squeezelite e a Lyrion
# nel mezzo di un brano (brano saltato, file scartati dalla scansione, a volte
# libreria incompleta). Con "hard" il processo aspetta il ritorno del server e
# riprende da dove era (il buffer del DAC copre le pause brevi); i processi in
# attesa restano comunque interrompibili (kill) e lo smontaggio e' "lazy"
# (umount -l), quindi nulla si blocca per sempre. Il montaggio vero e proprio
# non resta appeso: ha un tempo massimo e, se fallisce, valgono i ritentativi
# di 'sweetspot-rete ritenta'.
SMB_OPZIONI=${SWEETSPOT_SMB_OPZIONI:-hard,echo_interval=10,iocharset=utf8,noserverino}
NFS_OPZIONI=${SWEETSPOT_NFS_OPZIONI:-hard,timeo=100,retrans=3,retry=0,noatime}
MOUNT_TIMEOUT=${SWEETSPOT_MOUNT_TIMEOUT:-60}

# mount_limitato COMANDO...: come il comando, ma con un tempo massimo se
# 'timeout' c'e' (BusyBox).
mount_limitato() {
	if command -v timeout > /dev/null 2>&1; then
		timeout "$MOUNT_TIMEOUT" "$@"
	else
		"$@"
	fi
}

# mount_share N -> stampa "OK" oppure il messaggio d'errore
mount_share() {
	local n=$1 raw unc user pass mp cred err e v name auth smb1
	raw=$(conf "CONDIVISIONE_$n")
	[ -n "$raw" ] || return 1
	mp="$MEDIA_DIR/rete-$n"
	if is_nfs "$raw"; then
		if ! unc=$(normalize_nfs "$raw"); then
			echo "percorso non valido: scrivi nfs://indirizzo/cartella"
			return 1
		fi
		mkdir -p "$mp"
		grep -q " $mp " "$PROC/mounts" && umount -l "$mp" 2>/dev/null
		modprobe nfs 2>/dev/null
		err=""
		# Prima NFSv4 (negozia 4.2, 4.1, 4.0), poi NFSv3 per i server piu'
		# vecchi (senza 'lockd' locale: nolock).
		for v in "vers=4" "vers=3,nolock"; do
			if e=$(mount_limitato mount.nfs "$unc" "$mp" -o "ro,$NFS_OPZIONI,$v" 2>&1); then
				err=""
				break
			fi
			err="$err$(printf '%s' "$e" | head -n 1)
"
		done
		if [ -n "$err" ]; then
			rmdir "$mp" 2>/dev/null
			case "$err" in
				*"access denied"*|*"Permission denied"*) echo "accesso negato: il server NFS non esporta la cartella a questo indirizzo" ;;
				*"No such file"*|*"does not exist"*) echo "cartella non trovata sul server" ;;
				*"Connection refused"*|*"timed out"*|*"No route"*|*"unreachable"*|*"Host is down"*|*"RPC"*) echo "server non raggiungibile" ;;
				*"Unknown host"*|*"Name or service"*|*"resolve"*|*"get address"*) echo "nome del server sconosciuto: prova con l'indirizzo IP" ;;
				*) echo "errore: $(printf '%s' "$err" | head -n 1)" ;;
			esac
			return 1
		fi
		name=$(share_name "$unc")
		ln -sfn "$mp" "$MUSIC_DIR/$name"
		echo OK
		return 0
	fi
	if ! unc=$(normalize_unc "$raw"); then
		echo "percorso non valido: scrivi //indirizzo/cartella"
		return 1
	fi
	user=$(conf "CONDIVISIONE_${n}_UTENTE")
	pass=$(conf "CONDIVISIONE_${n}_PASSWORD")
	smb1=$(conf "CONDIVISIONE_${n}_SMB1" no)
	cred="$RUN/credenziali-$n"
	mkdir -p "$mp"
	grep -q " $mp " "$PROC/mounts" && umount -l "$mp" 2>/dev/null
	if [ -n "$user" ]; then
		# Le credenziali vanno in un file: la password puo' contenere
		# virgole e altri caratteri che non si possono passare come opzione.
		( umask 077; printf 'username=%s\npassword=%s\n' "$user" "$pass" > "$cred" )
		auth="credentials=$cred"
	else
		auth=guest
	fi
	modprobe cifs 2>/dev/null
	err=""
	# Mai meno di SMB 2.1: prima la versione scelta dal NAS (3.x preferita),
	# poi 3.0 e 2.1 espliciti. SMB1 (insicuro: niente firma ne' cifratura,
	# bersaglio di attacchi noti) solo se l'utente lo ha chiesto per questa
	# cartella (CONDIVISIONE_N_SMB1=si).
	set -- "" ",vers=3.0" ",vers=2.1"
	is_yes "$smb1" && set -- "$@" ",vers=1.0"
	for v in "$@"; do
		if e=$(mount_limitato mount.cifs "$unc" "$mp" -o "ro,$auth,$SMB_OPZIONI$v" 2>&1); then
			err=""
			break
		fi
		err="$err$(printf '%s' "$e" | head -n 1)
"
	done
	if [ -n "$err" ]; then
		rmdir "$mp" 2>/dev/null
		case "$err" in
			*"Permission denied"*|*"error(13)"*) echo "accesso negato: controlla utente e password" ;;
			*"No such file"*|*"error(2)"*) echo "cartella non trovata sul server" ;;
			*"Host is down"*|*"error(112)"*|*"No route"*|*"error(113)"*) echo "server non raggiungibile" ;;
			*"could not resolve"*|*"resolve address"*) echo "nome del server sconosciuto: prova con l'indirizzo IP" ;;
			*) echo "errore: $(printf '%s' "$err" | head -n 1)" ;;
		esac
		return 1
	fi
	name=$(share_name "$unc")
	ln -sfn "$mp" "$MUSIC_DIR/$name"
	echo OK
}

# scrivi_stato: ricalcola $STATO da $LIST (esito) e $ATTESA (ritentativi).
scrivi_stato() {
	local n unc st err next t a b c
	mkdir -p "$RUN"
	: > "$STATO.new"
	while IFS='|' read -r n unc st err; do
		[ -n "$n" ] || continue
		if [ "$st" = OK ]; then
			echo "$n|montata|||0" >> "$STATO.new"
			continue
		fi
		# Un solo ciclo di lettura: nessun processo in piu' per riga.
		next=""
		t=0
		while IFS='|' read -r a b c; do
			[ "$a" = "$n" ] && { t=$b; next=$c; }
		done 2> /dev/null < "$ATTESA"
		if [ -n "$next" ]; then
			echo "$n|attesa|$err|$next|$t" >> "$STATO.new"
		else
			echo "$n|errore|$err||0" >> "$STATO.new"
		fi
	done 2> /dev/null < "$LIST"
	sort -t'|' -k1,1n "$STATO.new" > "$STATO.tmp"
	mv "$STATO.tmp" "$STATO"
	rm -f "$STATO.new"
}

# musica_link N -> cartella con cui Lyrion vede la sorgente N
musica_link() {
	local l
	for l in "$MUSIC_DIR"/*; do
		[ -L "$l" ] && [ "$(readlink "$l")" = "$MEDIA_DIR/rete-$1" ] && { echo "$l"; return 0; }
	done
	return 1
}

# rescan_sorgente N: scansione incrementale (rescan, mai wipe) della sola
# cartella della sorgente N; se Lyrion non accetta il filtro, rescan generale.
rescan_sorgente() {
	local d lms=${SWEETSPOT_LMS:-/usr/bin/sweetspot-lms}
	if d=$(musica_link "$1") && $lms aggiorna "$d" > /dev/null 2>&1; then
		log "rete: richiesto a Lyrion il controllo della sola condivisione $1"
	elif $lms aggiorna > /dev/null 2>&1; then
		log "rete: richiesto a Lyrion il controllo della libreria"
	fi
}

# stale_check N: vero se la condivisione montata N risponde. Con un NAS sparito
# e montaggio "hard" lo stat resta appeso: il tempo massimo lo smaschera.
stale_check() {
	local mp="$MEDIA_DIR/rete-$1"
	if command -v timeout > /dev/null 2>&1; then
		timeout "$STALE_TIMEOUT" "${SWEETSPOT_STAT:-stat}" -t "$mp" > /dev/null 2>&1
	else
		"${SWEETSPOT_STAT:-stat}" -t "$mp" > /dev/null 2>&1
	fi
}

# controlla: smonta (lazy) e segna in errore le condivisioni montate che non
# rispondono, cosi' il ciclo di ritentativi le rimonta. Stampa quante erano stale.
do_controlla() {
	local n stato k=0
	for n in 1 2 3 4 5 6 7 8 9; do
		[ -n "$(conf "CONDIVISIONE_$n")" ] || continue
		stato=$(grep "^$n|" "$LIST" 2>/dev/null | head -n 1 | cut -d'|' -f3)
		[ "$stato" = OK ] || continue
		stale_check "$n" && continue
		"${SWEETSPOT_UMOUNT:-umount}" -l "$MEDIA_DIR/rete-$n" 2>/dev/null
		set_stato "$n" ERRORE "errore: montaggio non risponde (stale), da rimontare"
		log "rete: condivisione $n non risponde, la rimonto"
		k=$((k + 1))
	done
	scrivi_stato
	echo "$k"
}

# sveglia: dopo un evento di rete (link up, DHCP). Cerca i montaggi stale e
# anticipa il prossimo tentativo; se nessun ciclo e' attivo e c'e' qualcosa
# da rimontare ne avvia uno. Con tutto montato non fa nulla (nessun polling).
do_sveglia() {
	local pid
	do_controlla > /dev/null
	pid=$(cat "$RETRY_PID" 2>/dev/null)
	if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
		kill -USR1 "$pid" 2>/dev/null
	elif grep -q '|errore|\|attesa|' "$STATO" 2>/dev/null; then
		# Staccato: da udev/udhcpc non deve restare appeso al ciclo.
		"${SWEETSPOT_SELF:-$0}" ritenta > /dev/null 2>&1 &
	fi
}

do_mount() {
	local n res has=0
	mkdir -p "$MEDIA_DIR" "$MUSIC_DIR" "$RUN"
	: > "$LIST"
	for n in 1 2 3 4 5 6 7 8 9; do
		[ -n "$(conf "CONDIVISIONE_$n")" ] && has=1
	done
	[ $has = 1 ] || return 0
	if ! wait_network; then
		log "rete: nessuna connessione, condivisioni non montate"
	fi
	for n in 1 2 3 4 5 6 7 8 9; do
		[ -n "$(conf "CONDIVISIONE_$n")" ] || continue
		res=$(mount_share "$n")
		if [ "$res" = OK ]; then
			echo "$n|$(conf "CONDIVISIONE_$n")|OK|montata" >> "$LIST"
			log "rete: condivisione $n montata"
		else
			echo "$n|$(conf "CONDIVISIONE_$n")|ERRORE|$res" >> "$LIST"
			log "rete: condivisione $n non montata: $res"
		fi
	done
	scrivi_stato
}

# retry_delay TENTATIVI -> secondi di attesa: raddoppia ogni volta, fino al tetto
retry_delay() {
	local d=$RETRY_MIN i=1
	while [ $i -lt "$1" ] && [ $d -lt $RETRY_MAX ]; do
		d=$((d * 2))
		i=$((i + 1))
	done
	[ $d -gt $RETRY_MAX ] && d=$RETRY_MAX
	echo $d
}

# set_stato N STATO DETTAGLIO: aggiorna la riga di N nell'elenco
set_stato() {
	{ grep -v "^$1|" "$LIST" 2>/dev/null; echo "$1|$(conf "CONDIVISIONE_$1")|$2|$3"; } > "$LIST.new"
	mv "$LIST.new" "$LIST"
}

# Si ritenta solo quando il NAS puo' tornare da solo (spento, rete assente).
# Password sbagliata, cartella inesistente o percorso scritto male li deve
# correggere l'utente: ritentare all'infinito non serve.
retryable() {
	case "$1" in
		"server non raggiungibile"*|"nome del server sconosciuto"*) return 0 ;;
		"errore:"*) return 0 ;;
	esac
	return 1
}

# Dopo l'avvio: riprova a montare le condivisioni che non c'erano (NAS acceso
# dopo il player). Un solo ciclo alla volta (flock); l'avvio non lo aspetta.
do_retry() {
	local n t next now line res stato min nuovo="$ATTESA.new" riuscite=""
	mkdir -p "$RUN"
	exec 7> "$RETRY_LOCK"
	flock -n 7 || return 0
	echo $$ > "$RETRY_PID"
	# Evento di rete (sveglia): il prossimo giro non aspetta la scadenza.
	trap 'SVEGLIA=1' USR1
	: > "$ATTESA"
	now=$(date +%s)
	for n in 1 2 3 4 5 6 7 8 9; do
		[ -n "$(conf "CONDIVISIONE_$n")" ] || continue
		line=$(grep "^$n|" "$LIST" 2>/dev/null | head -n 1)
		[ "$(printf '%s' "$line" | cut -d'|' -f3)" = ERRORE ] || continue
		retryable "$(printf '%s' "$line" | cut -d'|' -f4-)" || continue
		echo "$n|1|$((now + $(retry_delay 1)))" >> "$ATTESA"
	done
	scrivi_stato
	while [ -s "$ATTESA" ]; do
		now=$(date +%s)
		: > "$nuovo"
		min=""
		while IFS='|' read -r n t next; do
			# Rimossa nel frattempo, oppure gia' montata (pulsante "prova")
			[ -n "$(conf "CONDIVISIONE_$n")" ] || continue
			stato=$(grep "^$n|" "$LIST" 2>/dev/null | head -n 1 | cut -d'|' -f3)
			[ "$stato" = ERRORE ] || continue
			[ $SVEGLIA = 1 ] && next=$now
			if [ "$now" -ge "$next" ]; then
				res=$(mount_share "$n")
				if [ "$res" = OK ]; then
					set_stato "$n" OK montata
					log "rete: condivisione $n montata al tentativo $((t + 1))"
					riuscite="$riuscite $n"
					continue
				fi
				set_stato "$n" ERRORE "$res"
				retryable "$res" || continue
				t=$((t + 1))
				next=$((now + $(retry_delay "$t")))
			fi
			echo "$n|$t|$next" >> "$nuovo"
			if [ -z "$min" ] || [ "$next" -lt "$min" ]; then min=$next; fi
		done < "$ATTESA"
		mv "$nuovo" "$ATTESA"
		SVEGLIA=0
		scrivi_stato
		# Musica nuova sul NAS: Lyrion legge solo cio' che e' nuovo o cambiato,
		# e solo nella cartella della sorgente appena tornata.
		for n in $riuscite; do rescan_sorgente "$n"; done
		riuscite=""
		[ -s "$ATTESA" ] || break
		now=$(date +%s)
		if [ "$min" -gt "$now" ]; then
			# sleep in secondo piano: USR1 interrompe 'wait' e anticipa il giro
			sleep $((min - now)) &
			wait $!
			kill $! 2>/dev/null
		fi
	done
	rm -f "$ATTESA" "$RETRY_PID"
	scrivi_stato
}

do_umount() {
	local mp l
	[ -f "$RETRY_PID" ] && kill "$(cat "$RETRY_PID")" 2>/dev/null
	rm -f "$RETRY_PID" "$ATTESA" "$STATO"
	for mp in "$MEDIA_DIR"/rete-*; do
		[ -d "$mp" ] || continue
		umount -l "$mp" 2>/dev/null
		rmdir "$mp" 2>/dev/null
	done
	for l in "$MUSIC_DIR"/*; do
		[ -L "$l" ] || continue
		case "$(readlink "$l")" in "$MEDIA_DIR"/rete-*) rm -f "$l" ;; esac
	done
	rm -f "$RUN"/credenziali-*
}

do_umount_one() {
	local n=$1 mp l
	mp="$MEDIA_DIR/rete-$n"
	for l in "$MUSIC_DIR"/*; do
		[ -L "$l" ] && [ "$(readlink "$l")" = "$mp" ] && rm -f "$l"
	done
	umount -l "$mp" 2>/dev/null
	rmdir "$mp" 2>/dev/null
	rm -f "$RUN/credenziali-$n"
	if [ -f "$LIST" ]; then
		grep -v "^$n|" "$LIST" > "$LIST.new"
		mv "$LIST.new" "$LIST"
		scrivi_stato
	fi
	return 0
}

[ "${SWEETSPOT_TEST:-}" = 1 ] && return 0

case "$1" in
	monta) do_mount; touch "$RUN/rete.pronta"; do_retry ;;
	ritenta) do_retry ;;
	sveglia) do_sveglia ;;
	controlla) do_controlla ;;
	stato) cat "$STATO" 2>/dev/null ;;
	smonta) do_umount ;;
	smonta-una)
		case "$2" in [1-9]) do_umount_one "$2" ;; *) exit 1 ;; esac ;;
	elenco) cat "$LIST" 2>/dev/null ;;
	prova)
		case "$2" in [1-9]) ;; *) echo "numero non valido"; exit 1 ;; esac
		res=$(mount_share "$2")
		rc=$?
		echo "$res"
		# Montata: la pagina Musica la mostra subito, senza attendere il prossimo avvio.
		if [ "$res" = OK ]; then
			set_stato "$2" OK montata
			scrivi_stato
		fi
		exit $rc ;;
	*) echo "uso: $0 monta|smonta|smonta-una N|elenco|stato|prova N|ritenta|sveglia|controlla" >&2; exit 1 ;;
esac
