#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Sweetspot - aggiornamenti del sistema con ritorno automatico alla
# versione precedente.
#
#   sweetspot-aggiorna stato           righe CHIAVE=VALORE per la pagina Sistema
#   sweetspot-aggiorna cerca           chiede a GitHub l'ultima versione pubblicata
#   sweetspot-aggiorna scarica         la scarica e la installa, in sottofondo
#   sweetspot-aggiorna file PACCHETTO  installa un pacchetto .tar da un disco
#   sweetspot-aggiorna file-downgrade PACCHETTO
#                                      come "file" ma accetta anche una versione
#                                      piu' vecchia di quella in uso
#   sweetspot-aggiorna pacchetti       pacchetti di aggiornamento sui dischi
#   sweetspot-aggiorna annulla         interrompe l'aggiornamento in corso
#   sweetspot-aggiorna libera          cancella la versione non in uso, se
#                                      non c'e' posto per tenerla durante
#                                      l'aggiornamento
#   sweetspot-aggiorna altra           al prossimo avvio prova l'altra versione
#   sweetspot-aggiorna predefinita     la versione in uso diventa quella predefinita
#   sweetspot-aggiorna conferma        a fine avvio: questa versione funziona
#                                      (impostazioni, pagina web, rete,
#                                      supervisore del player, Lyrion,
#                                      libreria; il DAC opzionale non conta)
#   sweetspot-aggiorna watchdog        all'avvio dopo un riavvio del watchdog
#                                      (S21): conta i riavvii consecutivi e,
#                                      al secondo, al prossimo avvio parte
#                                      l'altra copia
#   sweetspot-aggiorna stabile         dopo 10 minuti di funzionamento (S99):
#                                      azzera il conteggio
#
# Sulla partizione SWEETSPOT ci sono due copie del sistema (vedi common.sh):
# l'aggiornamento va sempre in quella non in uso, poi GRUB la avvia una
# volta sola. Se il nuovo sistema arriva in fondo all'avvio e risponde dalla
# rete, conferma se stesso e diventa la versione in uso; altrimenti (blocco,
# errore del kernel: riavvio automatico dopo 10 secondi) riparte la
# versione di prima, che lo segnala nella pagina Sistema.
#
# Pacchetto (creato da post-image.sh): un .tar con il kernel (bzImage, sul
# Raspberry Pi Image.gz con alberi dei dispositivi e overlay), rootfs.cpio.zst,
# versione, architettura e SHA256SUMS, che viene controllato prima di
# rendere avviabile la nuova copia. La compilazione ufficiale aggiunge
# SHA256SUMS.minisig, la firma con la chiave del progetto: se il sistema ha la
# chiave pubblica (/etc/sweetspot/aggiornamenti.pub) la firma e' obbligatoria;
# senza chiave gli aggiornamenti sono disabilitati.

. "${SWEETSPOT_LIB:-/usr/lib/sweetspot}/common.sh"

DIR=$RUN/aggiornamento
PAUSABLE=$RUN/sospendibili
# AGGIORNAMENTI_URL in sweetspot.txt: un altro indirizzo (es. per una copia
# del progetto su GitHub), nella forma dell'API delle release di GitHub.
RELEASES=${SWEETSPOT_RELEASES:-$(conf AGGIORNAMENTI_URL https://api.github.com/repos/Markg981/sweetspot/releases/latest)}
# Solo https anche dopo un redirect, salvo un AGGIORNAMENTI_URL http scelto
# apposta (stessa regola del controllo dell'indirizzo del pacchetto).
case "$RELEASES" in
	http://*) CURL_PROTO="=http,https" ;;
	*) CURL_PROTO="=https" ;;
esac
# Tetti alla dimensione: la risposta dell'API e' un JSON di pochi KB (1 MB e'
# larghissimo); il pacchetto (kernel + rootfs compressi) sta nell'ordine delle
# centinaia di MB, 1 GiB blocca un file enorme prima che riempia disco o tmpfs.
MAX_JSON=1048576
MAX_PKG=${SWEETSPOT_MAX_PKG:-1073741824}
AVVIO=${SWEETSPOT_AVVIO:-/usr/share/sweetspot/avvio}
# Scheda del sistema (x86_64, rpi): il pacchetto deve essere per lei.
ARCH=${SWEETSPOT_ARCH:-$(board)}
PKG_NAME="sweetspot-$ARCH-aggiornamento.tar"
VERSION_FILE=${SWEETSPOT_VERSION_FILE:-/etc/sweetspot-version}
# Chiave pubblica del progetto: con questa, solo i pacchetti firmati dalla
# chiave privata (nei segreti di GitHub, la usa solo la compilazione
# ufficiale) si possono installare.
PUBKEY=${SWEETSPOT_CHIAVE_FIRMA:-/etc/sweetspot/aggiornamenti.pub}
IPC=${SWEETSPOT_IP:-ip}

current_version() { cut -d' ' -f1 "$VERSION_FILE" 2>/dev/null; }

state() { mkdir -p "$DIR"; echo "$*" > "$DIR/stato"; }

running() { [ -f "$DIR/pid" ] && kill -0 "$(cat "$DIR/pid")" 2>/dev/null; }

# --- Stato -----------------------------------------------------------------------

do_status() {
	local slot other env def job t
	slot=$(running_slot)
	other=$(other_slot "$slot")
	echo "versione=$(current_version)"
	echo "copia=$slot"
	if stick_mount ro; then
		env=$(boot_env)
		def=$(grubenv_get "$env" slot)
		echo "predefinita=${def:-a}"
		echo "prova=$(grubenv_get "$env" prova)"
		if [ -f "$(slot_dir "$STICK_MNT" "$other")/$(kernel_file)" ]; then
			echo "altra_versione=$(cat "$STICK_MNT/boot/versioni/$other" 2>/dev/null || echo sconosciuta)"
		fi
		stick_umount
	fi
	[ -f "$DIR/fallita" ] && echo "fallita=$(cat "$DIR/fallita")"
	[ -f "$DIR/riuscita" ] && echo "riuscita=1"
	[ -s "$DIR/fallita.motivo" ] && echo "fallita_controllo=$(cat "$DIR/fallita.motivo")"
	[ -f "$DIR/watchdog.riavvii" ] && echo "watchdog_riavvii=$(cat "$DIR/watchdog.riavvii")"
	[ -f "$DIR/watchdog.ritorno" ] && echo "watchdog_ritorno=$(cat "$DIR/watchdog.ritorno")"
	if [ -f "$DIR/stato" ]; then
		job=$(cat "$DIR/stato")
		if running; then
			# Avanzamento: KB gia' estratti sulla chiavetta e KB attesi.
			echo "progresso=$(du -sk "$STICK_MNT/aggiornamento.tmp" 2>/dev/null | cut -f1)"
			case "$job" in
				scarica\|url*)
					t=$(sed -n 's/^dimensione=//p' "$DIR/disponibile" 2>/dev/null)
					echo "totale=$((${t:-0} / 1024))" ;;
				scarica\|file\|*)
					echo "totale=$(du -sk "${job#scarica|file|}" 2>/dev/null | cut -f1)" ;;
			esac
		else
			case "$job" in scarica*|controlla*) job="errore|aggiornamento interrotto" ;; esac
		fi
		echo "lavoro=$job"
	fi
	[ -f "$DIR/disponibile" ] && sed 's/^/disponibile_/' "$DIR/disponibile"
	return 0
}

# --- Ricerca ---------------------------------------------------------------------

# Scrive in $DIR/disponibile: versione, url, dimensione, data (e le note
# in $DIR/note). Esce con 1 se non si riesce a sapere.
do_check() {
	local json tag url size
	mkdir -p "$DIR"
	rm -f "$DIR/disponibile" "$DIR/note"
	json=$(curl -fsSL --proto "$CURL_PROTO" --proto-redir "$CURL_PROTO" --max-filesize "$MAX_JSON" --max-time 30 -H 'Accept: application/vnd.github+json' "$RELEASES" 2>/dev/null) ||
		{ echo "errore=impossibile contattare GitHub: controlla la connessione a internet"; return 1; }
	tag=$(printf '%s' "$json" | jq -r '.tag_name // empty')
	url=$(printf '%s' "$json" | jq -r --arg n "$PKG_NAME" '.assets[]? | select(.name == $n) | .browser_download_url' | head -n 1)
	size=$(printf '%s' "$json" | jq -r --arg n "$PKG_NAME" '.assets[]? | select(.name == $n) | .size' | head -n 1)
	[ -n "$tag" ] || { echo "errore=nessuna versione pubblicata"; return 1; }
	valid_value "$tag" || { echo "errore=risposta non valida"; return 1; }
	[ -n "$url" ] || { echo "errore=la versione $tag non ha il pacchetto per questo computer ($ARCH)"; return 1; }
	# Solo https, salvo un indirizzo http scelto apposta in AGGIORNAMENTI_URL.
	case "$url" in
		https://*) ;;
		http://*) case "$RELEASES" in http://*) ;; *) echo "errore=indirizzo del pacchetto non valido"; return 1 ;; esac ;;
		*) echo "errore=indirizzo del pacchetto non valido"; return 1 ;;
	esac
	{
		echo "versione=$tag"
		echo "url=$url"
		echo "dimensione=${size:-0}"
		echo "data=$(printf '%s' "$json" | jq -r '.published_at // empty' | cut -c1-10)"
	} > "$DIR/disponibile"
	printf '%s' "$json" | jq -r '.body // empty' | head -c 4000 > "$DIR/note"
	cat "$DIR/disponibile"
}

# --- Installazione nella copia non in uso -----------------------------------------

# Prepara l'aggiornamento: la versione in uso diventa quella predefinita
# (se era stata scelta a mano dal menu di avvio) e la cartella temporanea si
# svuota. La copia non in uso resta intatta (e avviabile) finche' il nuovo
# pacchetto non e' scaricato e verificato. Stampa la cartella della copia.
prepare_slot() {
	local slot other env
	slot=$(running_slot)
	other=$(other_slot "$slot")
	env=$(boot_env)
	grubenv_set "$env" "slot=$slot" prova= tentato= || return 1
	# Anche i resti di un'esecuzione interrotta di colpo (corrente, SIGKILL).
	rm -rf "$STICK_MNT/aggiornamento.tmp"
	rm -f "$STICK_MNT/aggiornamento.tar.tmp"
	mkdir -p "$STICK_MNT/aggiornamento.tmp" || return 1
	sync
	slot_dir "$STICK_MNT" "$other"
}

# Cancella la copia $2 (cartella $1). Raspberry Pi: la copia e' una
# cartella intera (kernel, albero dei dispositivi, overlay); con GRUB la
# copia A sta nella cartella principale.
clear_slot() { # cartella_copia copia
	if [ "$(boot_type)" = rpi ]; then rm -rf "$1"; fi
	mkdir -p "$1" "$STICK_MNT/boot/versioni" || return 1
	# Prima il marcatore (e subito su disco): da qui la copia non e' piu' valida.
	rm -f "$STICK_MNT/boot/versioni/$2"
	sync
	rm -f "$1/$(kernel_file)" "$1/rootfs.cpio.zst"
}

# La copia $2 (cartella $1) e' completa e avviabile: kernel, sistema e
# marcatore boot/versioni/<copia>. Il marcatore si scrive per ultimo, dopo
# la sync di tutti i file (install_package) e clear_slot lo toglie per primo:
# una copia interrotta da un taglio di corrente non lo ha e non e' valida.
# Le copie gia' installate sul campo hanno gia' questo file (lo scrivevano
# anche le versioni precedenti), quindi restano valide senza migrazione.
slot_valid() { # cartella_copia copia
	[ -f "$1/$(kernel_file)" ] && [ -f "$1/rootfs.cpio.zst" ] && [ -f "$STICK_MNT/boot/versioni/$2" ]
}

# Spazio libero sulla chiavetta, in KB (vuoto se non si sa).
free_kb() {
	if [ -n "${SWEETSPOT_SPAZIO_LIBERO:-}" ]; then echo "$SWEETSPOT_SPAZIO_LIBERO"; return; fi
	df -P -k "$STICK_MNT" 2>/dev/null | awk 'NR == 2 { print $4 }'
}

# KB occupati da kernel e sistema della copia nella cartella $1.
slot_kb() {
	local f t=0 k
	for f in "$1/$(kernel_file)" "$1/rootfs.cpio.zst"; do
		[ -f "$f" ] || continue
		k=$(du -k "$f" 2>/dev/null | cut -f1)
		t=$((t + ${k:-0}))
	done
	echo "$t"
}

# KB del pacchetto da installare (0 se non si sa).
package_kb() { # url|file SORGENTE
	local b
	if [ "$1" = url ]; then
		b=$(sed -n 's/^dimensione=//p' "$DIR/disponibile" 2>/dev/null)
		case "$b" in ''|*[!0-9]*) b=0 ;; esac
		echo $((b / 1024))
	else
		b=$(du -k "$2" 2>/dev/null | cut -f1)
		echo "${b:-0}"
	fi
}

# Pacchetto e sua estrazione (circa il doppio della dimensione, piu' 1 MB di
# margine) devono stare accanto alla copia precedente, che si cancella solo
# dopo la verifica. Se non c'e' posto lo si dice prima di cancellare:
# "spazio|..." quando cancellando la copia precedente (sweetspot-aggiorna
# libera, dalla pagina Sistema) il posto ci sarebbe.
check_space() { # url|file SORGENTE cartella_copia
	local need free
	need=$(package_kb "$1" "$2")
	[ "$need" -gt 0 ] || return 0
	need=$((need * 2 + 1024))
	free=$(free_kb)
	case "$free" in ''|*[!0-9]*) return 0 ;; esac
	[ "$free" -lt "$need" ] || return 0
	if [ -f "$3/$(kernel_file)" ] && [ $((free + $(slot_kb "$3"))) -ge "$need" ]; then
		state "spazio|sulla chiavetta non c'è posto per la nuova versione accanto a quella precedente (servono $((need / 1024)) MB, liberi $((free / 1024)) MB): per aggiornare cancella la versione precedente, poi non potrai tornare indietro fino al prossimo aggiornamento"
	else
		state "errore|spazio insufficiente sulla chiavetta: servono $((need / 1024)) MB, liberi $((free / 1024)) MB"
	fi
	return 1
}

unsigned_fixture() {
	case "${SWEETSPOT_TEST:-}" in 1|cli) [ "${SWEETSPOT_ALLOW_UNSIGNED:-}" = 1 ] ;; *) return 1 ;; esac
}

# Solo i file prodotti da post-image.sh possono entrare nella copia avviabile.
package_payload() {
	case "$1" in
		"$(kernel_file)"|rootfs.cpio.zst|versione|architettura) return 0 ;;
	esac
	[ "$(boot_type)" = rpi ] || return 1
	case "$1" in
		overlays/README|overlays/overlay_map.dtb|overlays/*.dtbo)
			case "${1#overlays/}" in */*) ;; *) return 0 ;; esac ;;
		*.dtb) case "$1" in */*) ;; *) return 0 ;; esac ;;
	esac
	return 1
}

# Ispeziona il tar prima di estrarre: nessun link, dispositivo, percorso
# esterno o membro ripetuto puo' alterare file fuori dalla cartella temporanea.
extract_package() {
	local archive="$1" x="$2" listing="$DIR/membri" raw="$DIR/tar.list" kind name
	LC_ALL=C tar -tvf "$archive" > "$raw" 2>/dev/null || return 1
	awk '
		NF != 6 || $1 !~ /^[-d]/ { exit 1 }
		{ n=$6; sub(/^\.\//, "", n); sub(/\/$/, "", n)
		  if (n == ".") n=""
		  if (n ~ /[^A-Za-z0-9._\/-]/ || n ~ /^\// || n ~ /(^|\/)\.\.?(\/|$)/) exit 1
		  print (substr($1,1,1) == "d" ? "d" : "f") "|" n }
	' "$raw" > "$listing" || return 1
	[ -s "$listing" ] || return 1
	[ -z "$(cut -d'|' -f2 "$listing" | LC_ALL=C sort | uniq -d)" ] || return 1
	while IFS='|' read -r kind name; do
		if [ "$kind" = d ]; then
			case "$name" in '') ;; overlays) [ "$(boot_type)" = rpi ] || return 1 ;; *) return 1 ;; esac
		else
			case "$name" in SHA256SUMS|SHA256SUMS.minisig) ;; *) package_payload "$name" || return 1 ;; esac
		fi
	done < "$listing"
	tar -xf "$archive" -C "$x" 2>/dev/null
}

# Controlla il pacchetto estratto in $1 e ne stampa la versione (o il motivo
# del rifiuto). Non tocca la copia non in uso.
verify_package() { # cartella_estratta
	local x="$1" v tc f manifest="$DIR/manifesto" actual="$DIR/file.reali"
	state "controlla|verifica del pacchetto"
	[ -f "$x/SHA256SUMS" ] || { echo "pacchetto incompleto"; return 1; }
	# Firma dell'elenco dei file (SHA256SUMS): prima di tutto il resto. Il
	# commento firmato lega la firma a versione e architettura del pacchetto.
	if [ -s "$PUBKEY" ]; then
		[ -f "$x/SHA256SUMS.minisig" ] ||
			{ echo "pacchetto non firmato: non è un aggiornamento ufficiale"; return 1; }
		tc=$(minisign -V -p "$PUBKEY" -m "$x/SHA256SUMS" -x "$x/SHA256SUMS.minisig" -Q 2>/dev/null) ||
			{ echo "firma non valida: il pacchetto è stato alterato o non è ufficiale"; return 1; }
		[ "$tc" = "Sweetspot $(head -n 1 "$x/versione" 2>/dev/null) $(cat "$x/architettura" 2>/dev/null)" ] ||
			{ echo "la firma appartiene a un altro pacchetto"; return 1; }
	elif ! unsigned_fixture; then
		echo "chiave pubblica degli aggiornamenti assente: installazione disabilitata"
		return 1
	fi
	# Formato canonico di sha256sum, nomi relativi ammessi e copertura esatta:
	# firmare il manifesto non autorizza file aggiunti al tar dopo la firma.
	awk '{ h=substr($0,1,64); s=substr($0,65,2); f=substr($0,67)
		if (length(h) != 64 || h ~ /[^0-9a-fA-F]/ || (s != "  " && s != " *") || f == "" || f ~ /[^A-Za-z0-9._\/-]/ || f ~ /^\// || f ~ /(^|\/)\.\.?(\/|$)/) exit 1
		print f }' "$x/SHA256SUMS" > "$manifest" || { echo "manifesto non valido"; return 1; }
	if [ ! -s "$manifest" ] || [ -n "$(LC_ALL=C sort "$manifest" | uniq -d)" ]; then echo "manifesto non valido"; return 1; fi
	while IFS= read -r f; do
		package_payload "$f" || { echo "file non ammesso nel pacchetto"; return 1; }
	done < "$manifest"
	[ -z "$(find "$x" ! -type f ! -type d -print)" ] || { echo "tipo di file non ammesso"; return 1; }
	(cd "$x" && find . -type f | sed 's|^\./||' | LC_ALL=C sort) > "$actual"
	{ cat "$manifest"; echo SHA256SUMS; [ -f "$x/SHA256SUMS.minisig" ] && echo SHA256SUMS.minisig; } | LC_ALL=C sort > "$manifest.atteso"
	cmp -s "$actual" "$manifest.atteso" || { echo "file non coperto dal manifesto"; return 1; }
	for f in "$(kernel_file)" rootfs.cpio.zst versione architettura; do
		grep -Fxq "$f" "$manifest" || { echo "pacchetto incompleto"; return 1; }
	done
	[ "$(cat "$x/architettura" 2>/dev/null)" = "$ARCH" ] ||
		{ echo "pacchetto per un altro tipo di computer ($(cat "$x/architettura" 2>/dev/null))"; return 1; }
	(cd "$x" && sha256sum -c SHA256SUMS > /dev/null 2>&1) ||
		{ echo "pacchetto rovinato (controllo SHA-256 non superato): riprova"; return 1; }
	v=$(head -n 1 "$x/versione")
	valid_value "$v" || { echo "versione non valida"; return 1; }
	echo "$v"
}

# Controlla gli hash di SHA256SUMS ($1) sui file del pacchetto gia' spostati
# nella cartella della copia $2 (versione e architettura non si copiano).
verify_slot_files() { # SHA256SUMS cartella_copia
	local list="$DIR/hash.copia"
	grep -Ev '^.{64} [ *](versione|architettura)$' "$1" > "$list" || true
	[ -s "$list" ] || return 1
	(cd "$2" && sha256sum -c "$list" > /dev/null 2>&1)
}

# Sostituisce la copia $3 (cartella $2) con il pacchetto verificato in $1:
# solo adesso la versione precedente si cancella.
install_package() { # cartella_estratta cartella_copia copia versione
	local x="$1" d="$2" other="$3" v="$4" f
	clear_slot "$d" "$other" || { echo "scrittura non riuscita"; return 1; }
	# Tutto il contenuto del pacchetto va nella copia (kernel e sistema; sul
	# Raspberry Pi anche alberi dei dispositivi e overlay).
	for f in "$x"/*; do
		case "${f##*/}" in SHA256SUMS*|versione|architettura) continue ;; esac
		mv "$f" "$d/" || { echo "scrittura non riuscita"; return 1; }
		# Un file alla volta su disco: un taglio di corrente non lascia
		# file a meta' dietro a un marcatore gia' scritto.
		sync
	done
	# Gli hash del pacchetto devono tornare anche sui file gia' nella copia.
	verify_slot_files "$x/SHA256SUMS" "$d" || { echo "scrittura non riuscita"; return 1; }
	if [ "$(boot_type)" = rpi ]; then
		# Riga di comando della copia nuova, con i parametri adattati a questo
		# Raspberry Pi; tryboot.txt la fa provare al prossimo riavvio.
		rpi_cmdline "$other" "$(rpi_tune "$(running_slot)")" > "$d/cmdline.txt"
		rpi_boot_config "$STICK_MNT/tryboot.txt" "$other" || { echo "scrittura non riuscita"; return 1; }
	fi
	# Marcatore di copia completa per ultimo, scritto e rinominato dopo la sync.
	echo "$v" > "$STICK_MNT/boot/versioni/$other.nuovo" &&
		sync && mv "$STICK_MNT/boot/versioni/$other.nuovo" "$STICK_MNT/boot/versioni/$other" ||
		{ echo "scrittura non riuscita"; return 1; }
	sync
	# Prova una volta sola al prossimo avvio.
	grubenv_set "$(boot_env)" "prova=$other" || { echo "scrittura non riuscita"; return 1; }
	echo "$v"
}

# Rilascia il montaggio preso da install_job, una sola volta.
release_stick() {
	[ "${STICK_HELD:-0}" = 1 ] || return 0
	STICK_HELD=0
	# Su ogni uscita (errore, SIGTERM) non restano file temporanei sulla chiavetta.
	rm -rf "$STICK_MNT/aggiornamento.tmp"
	rm -f "$STICK_MNT/aggiornamento.tar.tmp"
	stick_umount
}

# Con "tentato" impostato la versione appena aggiornata non si e' ancora
# confermata (o la conferma del ritorno non e' ancora passata): prepare_slot
# la renderebbe predefinita senza controllo di salute e cancellerebbe l'altra
# copia, l'unica sicuramente buona. Si aspetta la conferma, oppure si sceglie
# a mano con "predefinita".
IN_PROVA="la versione in uso e' ancora in prova: attendi la conferma (fino a 10 minuti dall'avvio) o rendila predefinita"

# Confronta due versioni nel formato di "git describe" (v1.2.3, oppure
# v1.2.3-5-gabcdef per i commit dopo il tag, con -dirty finale facoltativo):
# stampa -1, 0 o 1 (la prima e' minore, uguale, maggiore) oppure ? se una
# delle due non e' confrontabile (es. "sviluppo", un hash, v1.0.0-rc1).
# Si confrontano fino a quattro componenti numeriche e poi i commit dopo il tag.
version_cmp() { # versione_a versione_b
	awk -v a="$1" -v b="$2" '
	function parse(v, arr,   m, n, i, p) {
		sub(/-dirty$/, "", v); sub(/^v/, "", v)
		if (v !~ /^[0-9]+(\.[0-9]+)*(-[0-9]+-g[0-9a-f]+)?$/) return 0
		arr[1] = arr[2] = arr[3] = arr[4] = arr[5] = 0
		n = split(v, m, "-"); split(m[1], p, ".")
		for (i = 1; i <= 4; i++) arr[i] = p[i] + 0
		if (n >= 2) arr[5] = m[2] + 0
		return 1
	}
	BEGIN {
		if (!parse(a, x) || !parse(b, y)) { print "?"; exit }
		for (i = 1; i <= 5; i++) {
			if (x[i] < y[i]) { print -1; exit }
			if (x[i] > y[i]) { print 1; exit }
		}
		print 0
	}'
}

# Estrae il pacchetto (da internet o da un file) e lo installa. Con $3 =
# downgrade accetta anche una versione piu' vecchia di quella in uso; la
# stessa versione e' una reinstallazione, sempre ammessa.
install_job() { # url|file SORGENTE
	local kind="$1" src="$2" allow="${3:-}" d x other archive err="" v try=1 rc=0 cmp
	other=$(other_slot "$(running_slot)")
	rm -f "$DIR/fallita" "$DIR/riuscita"
	if ! stick_mount rw; then
		state "errore|chiavetta (o disco di sistema) non trovata"
		return 1
	fi
	# Il conteggio dei montaggi si rilascia su ogni uscita (anche annullando
	# l'aggiornamento con SIGTERM), altrimenti la chiavetta resta montata rw.
	STICK_HELD=1
	trap release_stick EXIT
	trap 'exit 143' TERM INT HUP
	if [ -n "$(grubenv_get "$(boot_env)" tentato)" ]; then
		state "errore|$IN_PROVA"
		release_stick
		return 1
	fi
	if ! d=$(prepare_slot); then
		state "errore|impossibile scrivere sulla chiavetta"
		release_stick
		return 1
	fi
	if ! check_space "$kind" "$src" "$d"; then
		rm -rf "$STICK_MNT/aggiornamento.tmp"
		release_stick
		return 1
	fi
	x=$STICK_MNT/aggiornamento.tmp
	archive=$STICK_MNT/aggiornamento.tar.tmp
	state "scarica|$kind|$src"
	if [ "$kind" = url ]; then
		# Se la modalita' ascolto sospende lo scaricamento a lungo, la
		# connessione puo' cadere: si riprova da capo, fino a 5 volte.
		while :; do
			curl -fsSL --proto "$CURL_PROTO" --proto-redir "$CURL_PROTO" --max-filesize "$MAX_PKG" --connect-timeout 30 --speed-time 120 --speed-limit 1 -o "$archive" "$src" 2>/dev/null && break
			if [ $try -ge 5 ]; then
				err="scaricamento non riuscito: controlla la connessione a internet e riprova"
				break
			fi
			try=$((try + 1))
			rm -f "$archive"
			sleep "${SWEETSPOT_RIPROVA_ATTESA:-10}"
		done
	else
		# Il disco sorgente puo' essere condiviso e modificato durante il
		# lavoro: elenco ed estrazione devono leggere la stessa copia privata.
		cp "$src" "$archive" 2>/dev/null || err="copia del pacchetto non riuscita, oppure spazio esaurito sulla chiavetta"
	fi
	if [ -z "$err" ] && ! extract_package "$archive" "$x"; then
		err="pacchetto illeggibile, contenuto non ammesso oppure spazio esaurito sulla chiavetta"
	fi
	# Scaricamento, estrazione o verifica falliti: la copia precedente e'
	# ancora tutta al suo posto. Solo un errore durante la sostituzione la
	# lascia a meta', e allora non deve restare avviabile.
	if [ -n "$err" ]; then
		state "errore|$err"
		rc=1
	elif ! v=$(verify_package "$x"); then
		state "errore|$v"
		rc=1
	elif cmp=$(version_cmp "$v" "$(current_version)"); [ "$allow" != downgrade ] &&
		{ [ "$cmp" = -1 ] || [ "$cmp" = "?" ]; }; then
		# Una versione firmata ma vecchia puo' avere falle note: serve la
		# conferma esplicita. Se una delle due versioni non e' confrontabile
		# (rc, hash, "sviluppo") non c'e' modo di escludere un downgrade:
		# si rifiuta, e file-downgrade (con conferma) e' il percorso forzato.
		# Limite noto: a parita' di stringa di versione il pacchetto firmato
		# non porta un identificativo monotono (la firma lega solo versione
		# e architettura), quindi una build piu' vecchia non si distingue.
		if [ "$cmp" = "?" ]; then
			state "errore|impossibile confrontare il pacchetto ($v) con la versione in uso ($(current_version)): per installarlo comunque serve la conferma esplicita del downgrade"
		else
			state "errore|il pacchetto ($v) e' piu' vecchio della versione in uso ($(current_version)): per installarlo comunque serve la conferma esplicita del downgrade"
		fi
		rc=1
	elif v=$(install_package "$x" "$d" "$other" "$v"); then
		state "pronto|$v"
		log "aggiornamento: versione $v installata nella copia $other, si prova al prossimo avvio"
	else
		state "errore|$v"
		rm -f "$d/$(kernel_file)" "$d/rootfs.cpio.zst"
		rc=1
	fi
	rm -rf "$x"
	rm -f "$STICK_MNT/aggiornamento.tar.tmp" "$DIR/membri" "$DIR/tar.list" "$DIR/manifesto" "$DIR/manifesto.atteso" "$DIR/file.reali"
	sync
	release_stick
	return "$rc"
}

start_job() { # url|file SORGENTE [downgrade]
	local tried=
	running && { echo "c'e' gia' un aggiornamento in corso"; return 1; }
	if stick_mount ro; then
		tried=$(grubenv_get "$(boot_env)" tentato)
		stick_umount
	fi
	[ -z "$tried" ] || { echo "$IN_PROVA"; return 1; }
	mkdir -p "$DIR" "$PAUSABLE"
	state "scarica|$1|$2"
	setsid "$0" _lavoro "$1" "$2" "${3:-}" > /dev/null 2>&1 < /dev/null &
	echo $! > "$DIR/pid"
	echo $! > "$PAUSABLE/aggiornamento"
}

do_download() {
	local url
	[ -f "$DIR/disponibile" ] || do_check > /dev/null || { echo "nessun aggiornamento disponibile"; return 1; }
	url=$(sed -n 's/^url=//p' "$DIR/disponibile")
	[ -n "$url" ] || { echo "nessun aggiornamento disponibile"; return 1; }
	start_job url "$url"
}

# Pacchetti di aggiornamento nella cartella principale dei dischi collegati
# (es. scaricato dal computer e copiato nella cartella di rete Musica).
do_packages() {
	local f
	for f in "$MEDIA_DIR"/*/sweetspot-*-aggiornamento*.tar "$MEDIA_DIR"/*/*/sweetspot-*-aggiornamento*.tar; do
		[ -f "$f" ] && echo "$f"
	done
	return 0
}

do_file() { # PACCHETTO [downgrade]
	local p m
	p=$(readlink -f "$1" 2>/dev/null) || { echo "file non trovato"; return 1; }
	m=$(readlink -f "$MEDIA_DIR")
	case "$p" in "$m"/*.tar) ;; *) echo "file non valido"; return 1 ;; esac
	[ -f "$p" ] || { echo "file non trovato"; return 1; }
	start_job file "$p" "${2:-}"
}

do_cancel() {
	local pid
	running || return 0
	pid=$(cat "$DIR/pid")
	kill -CONT "-$pid" 2>/dev/null
	kill -TERM "-$pid" 2>/dev/null
	rm -f "$DIR/pid" "$PAUSABLE/aggiornamento"
	sleep 1
	# La copia non in uso resta vuota: si torna a usare quella attuale.
	if stick_mount rw; then
		rm -rf "$STICK_MNT/aggiornamento.tmp"
		rm -f "$STICK_MNT/aggiornamento.tar.tmp"
		grubenv_set "$(boot_env)" prova=
		stick_umount
	fi
	state "annullato|"
	log "aggiornamento: annullato"
}

# Cancella la versione non in uso, quando non c'e' posto per tenerla durante
# l'aggiornamento (dopo l'avviso "spazio" nella pagina Sistema). Si torna a
# partire sempre da quella in uso.
do_free() {
	local slot other
	running && { echo "c'e' un aggiornamento in corso"; return 1; }
	slot=$(running_slot)
	other=$(other_slot "$slot")
	stick_mount rw || { echo "chiavetta non trovata"; return 1; }
	# Con la versione in uso ancora in prova la copia precedente e' l'unica
	# sicuramente buona: non si cancella (come in do_other e start_job).
	if [ -n "$(grubenv_get "$(boot_env)" tentato)" ]; then
		stick_umount
		echo "$IN_PROVA"
		return 1
	fi
	if [ "$(boot_type)" = rpi ] && ! rpi_boot_config "$STICK_MNT/config.txt" "$slot"; then
		stick_umount
		echo "scrittura non riuscita"
		return 1
	fi
	grubenv_set "$(boot_env)" "slot=$slot" prova= tentato=
	clear_slot "$(slot_dir "$STICK_MNT" "$other")" "$other"
	sync
	stick_umount
	rm -f "$DIR/stato"
	log "aggiornamento: versione precedente (copia $other) cancellata per fare spazio"
}

# L'altra versione installata parte una volta al prossimo avvio; se funziona
# si conferma e resta quella in uso (come un aggiornamento).
do_other() {
	local other d
	other=$(other_slot "$(running_slot)")
	stick_mount rw || { echo "chiavetta non trovata"; return 1; }
	d=$(slot_dir "$STICK_MNT" "$other")
	if ! slot_valid "$d" "$other"; then
		stick_umount
		echo "non c'e' un'altra versione installata"
		return 1
	fi
	if ! grubenv_set "$(boot_env)" "prova=$other"; then
		stick_umount
		echo "non riesco a scrivere sulla chiavetta"
		return 1
	fi
	[ "$(boot_type)" = rpi ] && rpi_boot_config "$STICK_MNT/tryboot.txt" "$other"
	stick_umount
	log "aggiornamento: al prossimo avvio si prova la copia $other"
}

# La versione in uso (avviata a mano dal menu) diventa quella predefinita.
do_default() {
	stick_mount rw || { echo "chiavetta non trovata"; return 1; }
	# Sul Pi prima config.txt (quello che il firmware usa), poi lo stato.
	if [ "$(boot_type)" = rpi ] && ! rpi_boot_config "$STICK_MNT/config.txt" "$(running_slot)"; then
		stick_umount
		echo "non riesco a scrivere sulla chiavetta"
		return 1
	fi
	if ! grubenv_set "$(boot_env)" "slot=$(running_slot)" prova= tentato=; then
		stick_umount
		echo "non riesco a scrivere sulla chiavetta"
		return 1
	fi
	stick_umount
}

# --- Riavvii del watchdog ----------------------------------------------------
#
# Un blocco totale fa ripartire il computer con il watchdog, ma nella stessa
# copia: se il blocco si ripete a ogni avvio (una versione che si blocca
# dopo la conferma, un'impostazione sbagliata) resterebbe cosi' per sempre.
# Il conteggio dei riavvii consecutivi del watchdog sta nello stato
# dell'avvio (riavvii=N, con la copia in uso); al secondo, se l'altra copia
# e' installata, diventa quella predefinita dal prossimo avvio (senza
# riavviare adesso: se questo avvio regge, l'utente legge l'avviso nella
# pagina Stato e puo' decidere). Dopo 10 minuti di funzionamento il
# conteggio si azzera.

WATCHDOG_MAX=2

do_watchdog_reset() {
	local env slot n other d
	slot=$(running_slot)
	other=$(other_slot "$slot")
	mkdir -p "$DIR"
	stick_mount rw || return 0
	env=$(boot_env)
	n=$(grubenv_get "$env" riavvii)
	[ "$(grubenv_get "$env" riavvii_copia)" = "$slot" ] || n=0
	case "$n" in ''|*[!0-9]*) n=0 ;; esac
	n=$((n + 1))
	grubenv_set "$env" "riavvii=$n" "riavvii_copia=$slot"
	echo "$n" > "$DIR/watchdog.riavvii"
	log "aggiornamento: $n riavvii consecutivi del watchdog con la copia $slot"
	d=$(slot_dir "$STICK_MNT" "$other")
	if [ "$n" -ge "$WATCHDOG_MAX" ] && slot_valid "$d" "$other" &&
		[ "$(grubenv_get "$env" slot)" != "$other" ]; then
		[ "$(boot_type)" = rpi ] && rpi_boot_config "$STICK_MNT/config.txt" "$other"
		grubenv_set "$env" "slot=$other" prova= tentato= riavvii= riavvii_copia=
		echo "$other" > "$DIR/watchdog.ritorno"
		log "aggiornamento: dal prossimo avvio parte la copia $other ($(cat "$STICK_MNT/boot/versioni/$other" 2>/dev/null || echo versione sconosciuta))"
	fi
	stick_umount
}

# Dieci minuti di funzionamento: i riavvii del watchdog non sono piu'
# consecutivi.
do_stable() {
	local env
	stick_mount rw || return 0
	env=$(boot_env)
	if [ -n "$(grubenv_get "$env" riavvii)" ]; then
		grubenv_set "$env" riavvii= riavvii_copia=
		log "aggiornamento: funzionamento stabile, conteggio dei riavvii del watchdog azzerato"
	fi
	stick_umount
	rm -f "$DIR/watchdog.riavvii"
}

# --- Conferma a fine avvio ----------------------------------------------------

# Aggiorna menu e GRUB sulla chiavetta se questa versione ne porta di nuovi
# (solo dopo che la versione si e' confermata).
same() { cmp -s "$1" "$2"; }

replace_file() { # nuovo destinazione
	[ -f "$1" ] || return 0
	same "$1" "$2" && return 0
	mkdir -p "${2%/*}"
	cp "$1" "$2.nuovo" && sync && mv "$2.nuovo" "$2" && sync && log "aggiornamento: $(basename "$2") aggiornato"
}

refresh_boot() {
	[ -d "$AVVIO" ] || return 0
	if [ "$(boot_type)" = rpi ]; then refresh_boot_rpi; else refresh_boot_grub; fi
}

# Raspberry Pi: config.txt dal modello di questa versione, con questa copia;
# firmware del Pi 4 (start4.elf, fixup4.dat) se la versione ne porta uno nuovo.
refresh_boot_rpi() {
	local f
	rpi_boot_config "$STICK_MNT/config.txt" "$(running_slot)" && sync
	for f in "$AVVIO"/firmware/*; do
		[ -f "$f" ] && replace_file "$f" "$STICK_MNT/${f##*/}"
	done
	return 0
}

# Scrive su un disco il secondo stadio di GRUB (settori 1..n) e poi il primo
# (i 440 byte del settore 0), controllando ogni dd e rileggendo per
# confrontare. Se qualcosa non va rimette com'erano le copie vecchie
# ($DIR/grub.ora e $DIR/mbr.ora, lette prima) e torna 1. Ordine: prima il
# secondo stadio, poi il primo; il vecchio primo stadio punta allo stesso
# settore, quindi in ogni momento il disco ha un primo stadio che trova un
# secondo stadio intero (vecchio o nuovo). Limite residuo: un dd su un
# settore grezzo non e' atomico; se manca la corrente proprio durante la
# scrittura o il ripristino, il secondo stadio puo' restare a meta' e la
# chiavetta non parte (si rifa' con sweetspot-installa o a mano). La
# rilettura puo' venire dalla cache: sync prima, ma non prova il supporto.
scrivi_grub_bios() { # disco n
	local disk=$1 n=$2 size
	size=$(wc -c < "$AVVIO/grub.img")
	blockdev --setrw "$disk" 2>/dev/null
	if dd if="$AVVIO/grub.img" of="$disk" bs=512 seek=1 conv=notrunc,fsync 2>/dev/null && sync &&
		dd if="$disk" bs=512 skip=1 count="$n" 2>/dev/null | head -c "$size" > "$DIR/grub.letto" &&
		same "$DIR/grub.letto" "$AVVIO/grub.img"; then
		if dd if="$DIR/mbr.nuovo" of="$disk" bs=440 count=1 conv=notrunc,fsync 2>/dev/null && sync &&
			dd if="$disk" bs=440 count=1 2>/dev/null > "$DIR/mbr.letto" &&
			same "$DIR/mbr.letto" "$DIR/mbr.nuovo"; then
			rm -f "$DIR/grub.letto" "$DIR/mbr.letto"
			return 0
		fi
		dd if="$DIR/mbr.ora" of="$disk" bs=440 count=1 conv=notrunc,fsync 2>/dev/null
	fi
	dd if="$DIR/grub.ora" of="$disk" bs=512 seek=1 conv=notrunc,fsync 2>/dev/null
	sync
	rm -f "$DIR/grub.letto" "$DIR/mbr.letto"
	return 1
}

# Vero se il disco ha una GPT (LBA1 = "EFI PART"): e' il caso
# dell'installazione accanto a Windows, dove il settore 1 e le voci di
# partizione non vanno toccati e GRUB per BIOS (che vive in quei settori)
# non si scrive.
disco_gpt() { # dispositivo
	[ "$(dd if="$1" bs=512 skip=1 count=1 2>/dev/null | head -c 8)" = "EFI PART" ]
}

refresh_boot_grub() {
	local disk dev start n bios=0
	replace_file "$AVVIO/BOOTX64.EFI" "$STICK_MNT/EFI/BOOT/BOOTX64.EFI"
	replace_file "$AVVIO/BOOTIA32.EFI" "$STICK_MNT/EFI/BOOT/BOOTIA32.EFI"
	# GRUB per BIOS: primo stadio nel settore 0 (senza la tabella delle
	# partizioni) e secondo stadio nei settori liberi prima della partizione.
	dev=$(stick_device)
	disk=$(stick_disk)
	if [ -n "$disk" ] && [ -b "/dev/$disk" ] && [ -f "$AVVIO/grub.img" ]; then
		start=$(cat "$SYS/class/block/${dev##*/}/start" 2>/dev/null || echo 0)
		n=$((($(wc -c < "$AVVIO/grub.img") + 511) / 512))
		if disco_gpt "/dev/$disk"; then
			log "aggiornamento: disco GPT su /dev/$disk, GRUB per BIOS non toccato"
		elif [ "$start" -gt $((n + 1)) ]; then
			dd if="/dev/$disk" bs=512 skip=1 count=$n 2>/dev/null | head -c "$(wc -c < "$AVVIO/grub.img")" > "$DIR/grub.ora"
			dd if="/dev/$disk" bs=440 count=1 2>/dev/null > "$DIR/mbr.ora"
			head -c 440 "$AVVIO/boot.img" > "$DIR/mbr.nuovo"
			if ! same "$DIR/grub.ora" "$AVVIO/grub.img" || ! same "$DIR/mbr.ora" "$DIR/mbr.nuovo"; then
				if scrivi_grub_bios "/dev/$disk" "$n"; then
					log "aggiornamento: GRUB per BIOS aggiornato su /dev/$disk"
				else
					bios=1
					log "aggiornamento: GRUB per BIOS non aggiornato su /dev/$disk, ripristinato com'era"
				fi
			fi
			rm -f "$DIR/grub.ora" "$DIR/mbr.ora" "$DIR/mbr.nuovo"
		fi
	fi
	# Il menu per ultimo: usa solo comandi presenti nel GRUB appena scritto.
	# Se il GRUB per BIOS e' rimasto quello vecchio il menu non si tocca: un
	# menu nuovo con un secondo stadio vecchio potrebbe non avviarsi.
	[ "$bios" = 0 ] || return 0
	replace_file "$AVVIO/grub.cfg" "$STICK_MNT/boot/grub/grub.cfg"
}

# Il sistema e' partito: risponde la pagina web locale. Con la password
# delle pagine (PASSWORD_WEB) la pagina vivo accetta l'utente "sweetspot" con
# la chiave di questo avvio, scritta da sweetspot-accesso; senza, un 401
# annullerebbe ogni aggiornamento.
check_web() {
	local url key
	url="http://127.0.0.1/cgi-bin/vivo"
	key=$(cat "$RUN/vivo.chiave" 2>/dev/null)
	[ -n "$key" ] && url="http://sweetspot:$key@127.0.0.1/cgi-bin/vivo"
	"${SWEETSPOT_WGET:-wget}" -q -T 5 -O /dev/null "$url" 2>/dev/null
}

# Raggiungibile dalla rete: la pagina locale risponde anche con la rete
# rotta, e un lettore senza schermo confermato cosi' resterebbe isolato.
# Basta l'hotspot di configurazione acceso, oppure una scheda vera (anche
# USB, come in S40sweetspot-net) con un indirizzo IPv4 e, se via cavo, il
# collegamento attivo (un IP_FISSO resta sulla scheda anche senza cavo).
check_network() {
	local n i
	[ -s "$RUN/hotspot.attivo" ] && return 0
	for n in "$SYS"/class/net/*; do
		i=${n##*/}
		[ -e "$n/device" ] || continue
		[ "$(cat "$n/type" 2>/dev/null)" = 1 ] || continue
		if [ ! -d "$n/wireless" ] && [ ! -d "$n/phy80211" ]; then
			[ "$(cat "$n/carrier" 2>/dev/null)" = 1 ] || continue
		fi
		[ -n "$("$IPC" -4 -o addr show scope global dev "$i" 2>/dev/null)" ] && return 0
	done
	return 1
}

# Impostazioni: l'unione tra predefinite e sweetspot.txt (costruita
# all'avvio) esiste e non e' vuota, e la copia dell'utente si legge. Un
# sweetspot.txt con valori sbagliati non e' un guasto della versione (la
# precedente leggerebbe lo stesso file): qui conta solo che questa versione
# sappia leggere le impostazioni.
check_settings() {
	[ -s "$CONF" ] || return 1
	if [ -f "$RUN/sweetspot.txt" ]; then
		config_normalize "$RUN/sweetspot.txt" > /dev/null 2>&1 || return 1
	fi
	return 0
}

# Lyrion avviato e che risponde (solo in modalita' completa; in modalita'
# player il server e' un altro computer e non dipende da questa versione).
check_lms() {
	[ "$(mode)" = completa ] || return 0
	lms_ready
}

# Supervisore del player in esecuzione. Il DAC e' opzionale: lo stato
# "in attesa del DAC" e' valido e non e' un guasto.
check_player() {
	local pid
	pid=$(cat "$RUN/supervisore.pid" 2>/dev/null)
	[ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

# Libreria e cache raggiungibili: cartella della musica leggibile (puo'
# essere vuota o con un disco ancora da montare: non si pretende contenuto)
# e dati di Lyrion scrivibili (solo in modalita' completa).
check_library() {
	[ -d "$MUSIC_DIR" ] && [ -r "$MUSIC_DIR" ] || return 1
	if [ "$(mode)" = completa ]; then
		[ -d "$LMS_DATA" ] && [ -w "$LMS_DATA" ] || return 1
	fi
	return 0
}

# wait_check NOME SECONDI FUNZIONE DESCRIZIONE: ritenta ogni 2 s fino alla
# scadenza; al fallimento registra quale controllo non e' passato.
wait_check() {
	local i=0
	while :; do
		"$3" && return 0
		[ "$i" -ge "$2" ] && break
		sleep 2
		i=$((i + 2))
	done
	CHECK_FAILED="$1|$4"
	return 1
}

# Lyrion al primo avvio su un Raspberry Pi puo' impiegare minuti: attesa
# lunga (SWEETSPOT_CONFERMA_ATTESA_LMS, 600 s); il watchdog hardware e'
# alimentato a parte e non scatta durante l'attesa. La rete puo' arrivare
# solo con l'hotspot, acceso dopo HOTSPOT_ATTESA secondi senza connessione:
# si aspetta quel tempo piu' un minuto (SWEETSPOT_CONFERMA_ATTESA_RETE).
healthy() {
	local t=${SWEETSPOT_CONFERMA_ATTESA:-60} tl=${SWEETSPOT_CONFERMA_ATTESA_LMS:-600} tn
	tn=$(conf HOTSPOT_ATTESA 60)
	case "$tn" in ''|*[!0-9]*) tn=60 ;; esac
	tn=${SWEETSPOT_CONFERMA_ATTESA_RETE:-$((tn + 60))}
	CHECK_FAILED=
	wait_check impostazioni 0 check_settings "sweetspot.txt illeggibile o impostazioni non costruite" || return 1
	wait_check web "$t" check_web "la pagina locale (/cgi-bin/vivo) non risponde" || return 1
	wait_check rete "$tn" check_network "nessuna rete: nessuna scheda con indirizzo e collegamento, ne' hotspot" || return 1
	wait_check supervisore "$t" check_player "il supervisore del player non e' in esecuzione" || return 1
	wait_check lyrion "$tl" check_lms "Lyrion non risponde" || return 1
	wait_check libreria "$t" check_library "musica o dati di Lyrion non accessibili" || return 1
	return 0
}

do_confirm() {
	local slot env def tried fail_reboot=0 werr=0
	slot=$(running_slot)
	mkdir -p "$DIR"
	stick_mount rw || { log "aggiornamento: conferma non riuscita, chiavetta non scrivibile"; return 1; }
	env=$(boot_env)
	[ -f "$env" ] || grubenv_set "$env" "slot=$slot" || { stick_umount; log "aggiornamento: conferma non riuscita, scrittura su chiavetta fallita"; return 1; }
	# Sul Pi config.txt e avvio.env devono concordare prima di decidere (dopo
	# il controllo del montaggio, perche' puo' scrivere sulla chiavetta).
	rpi_riconcilia || werr=1
	def=$(grubenv_get "$env" slot)
	tried=$(grubenv_get "$env" tentato)
	if [ -n "$tried" ] && [ "$tried" != "$slot" ]; then
		# La copia appena aggiornata non e' arrivata qui: si e' tornati a
		# questa. La copia rimane, ma non si riprova da sola.
		cat "$STICK_MNT/boot/versioni/$tried" > "$DIR/fallita" 2>/dev/null || echo "$tried" > "$DIR/fallita"
		# Il motivo l'ha lasciato sulla chiavetta la nuova versione.
		if [ -f "$STICK_MNT/boot/conferma-fallita" ]; then
			cp "$STICK_MNT/boot/conferma-fallita" "$DIR/fallita.motivo" 2>/dev/null
			rm -f "$STICK_MNT/boot/conferma-fallita"
		fi
		grubenv_set "$env" tentato= || werr=1
		log "aggiornamento: la nuova versione (copia $tried) non e' partita, si e' tornati alla precedente"
	elif [ "$tried" = "$slot" ]; then
		if healthy; then
			# Sul Pi prima config.txt (quello che il firmware usa), poi lo stato.
			if [ "$(boot_type)" = rpi ] && ! { rpi_boot_config "$STICK_MNT/config.txt" "$slot" && sync; }; then
				stick_umount
				log "aggiornamento: conferma non riuscita, scrittura su chiavetta fallita"
				return 1
			fi
			if ! grubenv_set "$env" "slot=$slot" tentato=; then
				stick_umount
				log "aggiornamento: conferma non riuscita, scrittura su chiavetta fallita"
				return 1
			fi
			touch "$DIR/riuscita"
			rm -f "$STICK_MNT/boot/conferma-fallita"
			log "aggiornamento: la versione $(current_version) funziona ed e' ora quella in uso"
			refresh_boot
		else
			# Quale controllo e' fallito: resta nel registro e sulla chiavetta,
			# cosi' la versione di prima lo mostra dopo il ritorno.
			echo "$CHECK_FAILED" > "$STICK_MNT/boot/conferma-fallita" 2>/dev/null
			log "aggiornamento: conferma non riuscita (${CHECK_FAILED%%|*}: ${CHECK_FAILED#*|}), al prossimo avvio riparte la precedente"
			fail_reboot=1
		fi
	elif [ -z "$def" ]; then
		grubenv_set "$env" "slot=$slot" || werr=1
	fi
	stick_umount
	[ "$werr" = 1 ] && { log "aggiornamento: scrittura su chiavetta fallita"; return 1; }
	# Conferma fallita: si riavvia subito. La prova di GRUB e' a colpo unico
	# (sul Pi config.txt resta sulla copia di prima), quindi riparte la copia
	# precedente senza aspettare un riavvio manuale.
	if [ "$fail_reboot" = 1 ]; then
		sync
		if [ -n "${SWEETSPOT_REBOOT:-}" ]; then
			"$SWEETSPOT_REBOOT"
		elif [ -z "${SWEETSPOT_TEST:-}" ]; then
			sleep 5
			reboot
		fi
	fi
}

[ "${SWEETSPOT_TEST:-}" = 1 ] && return 0

case "$1" in
	stato) do_status ;;
	cerca) do_check ;;
	scarica) do_download ;;
	file) do_file "$2" ;;
	file-downgrade) do_file "$2" downgrade ;;
	pacchetti) do_packages ;;
	annulla) do_cancel ;;
	libera) do_free ;;
	altra) do_other ;;
	watchdog) do_watchdog_reset ;;
	stabile) do_stable ;;
	predefinita) do_default ;;
	conferma) do_confirm ;;
	_lavoro) install_job "$2" "$3" "$4"; rc=$?; rm -f "$DIR/pid" "$PAUSABLE/aggiornamento"; exit "$rc" ;;
	*) echo "uso: $0 stato|cerca|scarica|file PACCHETTO|file-downgrade PACCHETTO|pacchetti|annulla|libera|altra|predefinita|conferma" >&2; exit 1 ;;
esac
