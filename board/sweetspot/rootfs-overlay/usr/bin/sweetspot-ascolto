#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Sweetspot - modalita' ascolto: mentre il DAC suona, i lavori che possono
# aspettare restano fermi (lettura della libreria di Lyrion, copie verso
# l'archivio, ripping dei CD) e ripartono da soli quando la musica si ferma.
# Si disattiva con MODALITA_ASCOLTO=no.
#
# Gli altri script registrano i propri lavori in $RUN/sospendibili/NOME,
# con il numero del gruppo di processi.
#
# Il salvataggio sulla chiavetta (sweetspot-dati) aspetta gia' da solo la
# fine dell'ascolto; i plugin di Lyrion si aggiornano solo su richiesta.
#
# La prova dell'ascolto puro: all'inizio di ogni ascolto (DAC che parte) si
# annotano i settori letti dai dischi con la musica e i byte passati dalla
# rete ($RUN/ascolto.io); la pagina Stato mostra quanto e' stato letto e
# trasmesso da allora. Con il precarico finito devono restare a zero.

. "${SWEETSPOT_LIB:-/usr/lib/sweetspot}/common.sh"

STOPPED=$RUN/ascolto.fermi
PAUSABLE=$RUN/sospendibili
IO=$RUN/ascolto.io

# Processi della lettura della libreria di Lyrion (pgrep: un solo processo,
# non una lettura di /proc per ogni PID a ogni giro).
scanner_pids() { pgrep -f scanner.pl 2>/dev/null; }

# Inizio dell'ascolto: contatori di partenza (io_counters in common.sh).
io_start() {
	{ echo "inizio $(date +%s)"; io_counters; } > "$IO.nuovo" && mv "$IO.nuovo" "$IO"
}

# Fine dell'ascolto: i contatori di arrivo restano per la pagina Stato
# ("nell'ultimo ascolto"), con il momento della fine.
io_stop() {
	[ -f "$IO" ] || return 0
	grep -q '^fine ' "$IO" && return 0
	{ echo "fine $(date +%s)"; io_counters | sed 's/^/fine_/'; } >> "$IO"
}

pause_work() {
	local pid f g
	for f in "$PAUSABLE"/*; do
		[ -f "$f" ] || continue
		g=$(cat "$f" 2>/dev/null)
		case "$g" in ''|*[!0-9]*) continue ;; esac
		grep -qx -- "-$g" "$STOPPED" 2>/dev/null && continue
		kill -STOP "-$g" 2>/dev/null && echo "-$g" >> "$STOPPED" &&
			log "ascolto: ${f##*/} sospeso durante l'ascolto"
	done
	for pid in $(scanner_pids); do
		grep -qx "$pid" "$STOPPED" 2>/dev/null && continue
		kill -STOP "$pid" 2>/dev/null && echo "$pid" >> "$STOPPED" &&
			log "ascolto: lettura della libreria sospesa durante l'ascolto"
	done
}

resume_work() {
	local pid
	[ -s "$STOPPED" ] || return 0
	while read -r pid; do
		kill -CONT "$pid" 2>/dev/null
	done < "$STOPPED"
	: > "$STOPPED"
	log "ascolto: lavori ripresi"
}

[ "${SWEETSPOT_TEST:-}" = 1 ] && return 0

mkdir -p "$RUN"
: > "$STOPPED"
rm -f "$IO"
playing=0
trap 'resume_work; io_stop; exit 0' TERM INT
while true; do
	if dac_playing; then
		[ "$playing" = 1 ] || { playing=1; io_start; }
		if is_yes "$(conf MODALITA_ASCOLTO si)"; then pause_work; else resume_work; fi
	else
		[ "$playing" = 0 ] || { playing=0; io_stop; }
		resume_work
	fi
	sleep 5
done
