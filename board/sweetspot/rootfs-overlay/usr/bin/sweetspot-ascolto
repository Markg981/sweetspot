#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Sweetspot - modalita' ascolto: mentre il DAC suona, i lavori che possono
# aspettare restano fermi (lettura della libreria di Lyrion, copie verso
# l'archivio, ripping dei CD) e ripartono da soli quando la musica si ferma.
# Si disattiva con MODALITA_ASCOLTO=no.
#
# Gli altri script registrano i propri lavori in $RUN/sospendibili/NOME,
# con il numero del gruppo di processi.
#
# Nelle voci di ascolto.fermi, accanto al PID (o -GRUPPO), c'e' lo starttime
# del processo: alla ripresa un PID riusato da altri non riceve segnali.
# Direzione futura (non ancora fatta): sospensione cooperativa, cioe' i
# lavori controllano da soli un file di pausa invece di subire SIGSTOP.
#
# Il salvataggio sulla chiavetta (sweetspot-dati) aspetta gia' da solo la
# fine dell'ascolto; i plugin di Lyrion si aggiornano solo su richiesta.
#
# La prova dell'ascolto puro: all'inizio di ogni ascolto (DAC che parte) si
# annotano i settori letti dai dischi con la musica e i byte passati dalla
# rete ($RUN/ascolto.io); la pagina Stato mostra quanto e' stato letto e
# trasmesso da allora. Con il precarico finito devono restare a zero.

. "${SWEETSPOT_LIB:-/usr/lib/sweetspot}/common.sh"

STOPPED=$RUN/ascolto.fermi
PAUSABLE=$RUN/sospendibili
IO=$RUN/ascolto.io

# Processi della lettura della libreria di Lyrion (pgrep: un solo processo,
# non una lettura di /proc per ogni PID a ogni giro).
scanner_pids() { pgrep -f scanner.pl 2>/dev/null; }

# Inizio dell'ascolto: contatori di partenza (io_counters in common.sh).
io_start() {
	{ echo "inizio ${SWEETSPOT_NOW:-$(date +%s)}"; io_counters; } > "$IO.nuovo" && mv "$IO.nuovo" "$IO"
}

# Fine dell'ascolto: i contatori di arrivo restano per la pagina Stato
# ("nell'ultimo ascolto"), con il momento della fine.
io_stop() {
	[ -f "$IO" ] || return 0
	grep -q '^fine ' "$IO" && return 0
	{ echo "fine ${SWEETSPOT_NOW:-$(date +%s)}"; io_counters | sed 's/^/fine_/'; } >> "$IO"
}

# --- Rallentamento con cgroup v2 ---------------------------------------------
# SIGSTOP su scanner.pl puo' fermarlo con una transazione SQLite in scrittura
# aperta: Lyrion non scriverebbe piu' nel database finche' la musica non si
# ferma. Dove c'e' cgroup v2 i lavori restano vivi ma con poca CPU (cpu.max,
# cpu.weight) e I/O idle (ionice -c3); altrimenti si ripiega su SIGSTOP.
CGROOT=${SWEETSPOT_CGROUP:-/sys/fs/cgroup}
CG=$CGROOT/sweetspot-ascolto
SLOWED=$RUN/ascolto.lenti

# Processi di un gruppo (ps di busybox: intestazione scartata dal test numerico).
group_pids() { ps -o pid,pgid 2>/dev/null | awk -v g="$1" '$1 ~ /^[0-9]+$/ && $2 == g { print $1 }'; }

# Il cgroup dell'ascolto e' pronto (controller cpu attivo, limiti scritti)?
# Lo si prepara qui, la prima volta.
cg_ready() {
	[ -f "$CG/cpu.max" ] && return 0
	[ -f "$CGROOT/cgroup.controllers" ] || return 1
	grep -qw cpu "$CGROOT/cgroup.controllers" 2>/dev/null || return 1
	grep -qw cpu "$CGROOT/cgroup.subtree_control" 2>/dev/null ||
		echo +cpu >> "$CGROOT/cgroup.subtree_control" 2>/dev/null
	mkdir -p "$CG" 2>/dev/null || return 1
	echo "5000 100000" > "$CG/cpu.max" 2>/dev/null || return 1
	echo 1 > "$CG/cpu.weight" 2>/dev/null
	return 0
}

# In cgroup v2 un processo sta in un solo gruppo. Chi e' gia' in un gruppo
# proprio di Sweetspot (lo scanner in sweetspot-scanner, con i suoi tetti di
# memoria e I/O) non viene spostato: i limiti di CPU dell'ascolto si applicano
# a quel gruppo e alla fine si ripristinano i valori di prima.
CGSAVED=$RUN/ascolto.cgsalvati
CG_SCANNER=sweetspot-scanner
CG_LYRION=sweetspot-lyrion

# Gruppo del processo, relativo a $CGROOT; vuoto = radice o sconosciuto.
cg_of() {
	local p
	p=$(sed -n 's/^0:://p' "${SWEETSPOT_PROCFS:-/proc}/$1/cgroup" 2>/dev/null | head -n 1)
	p=${p#/}
	case "$p" in ''|*..*) return 0 ;; esac
	echo "$p"
}

# Limita sul posto un gruppo proprio; i valori originali restano annotati.
# Riuscito solo se il gruppo accetta i limiti di CPU. Con "nuovo" il gruppo e'
# appena stato creato: si prova comunque a scrivere (senza controller cpu la
# scrittura fallisce) e i valori originali sono quelli predefiniti.
slow_group() {
	local d=$CGROOT/$1 max weight
	[ "$2" = nuovo ] || { [ -f "$d/cpu.max" ] && [ -f "$d/cpu.weight" ]; } || return 1
	if ! grep -q "^$1|" "$CGSAVED" 2>/dev/null; then
		max=$(cat "$d/cpu.max" 2>/dev/null); weight=$(cat "$d/cpu.weight" 2>/dev/null)
		echo "$1|${max:-max 100000}|${weight:-100}" >> "$CGSAVED" || return 1
	fi
	echo "5000 100000" > "$d/cpu.max" 2>/dev/null || return 1
	echo 1 > "$d/cpu.weight" 2>/dev/null
	return 0
}

# Sposta nel cgroup lento i PID dati e li mette in I/O idle. Riuscito = almeno
# uno rallentato.
slow_pids() {
	local pid ok=1 cur
	while read -r pid; do
		[ -n "$pid" ] || continue
		cur=$(cg_of "$pid")
		case "$cur" in
			''|sweetspot-ascolto) echo "$pid" >> "$CG/cgroup.procs" 2>/dev/null || continue ;;
			"$CG_SCANNER") slow_group "$cur" || continue ;;
			# Lo scanner nasce nel gruppo di Lyrion: prima lo si assegna al
			# gruppo dedicato, poi si limita quello; mai il gruppo del server.
			"$CG_LYRION")
				mkdir -p "$CGROOT/$CG_SCANNER" 2>/dev/null
				echo "$pid" >> "$CGROOT/$CG_SCANNER/cgroup.procs" 2>/dev/null || continue
				slow_group "$CG_SCANNER" nuovo || continue ;;
			sweetspot-*) continue ;;
			*) echo "$pid" >> "$CG/cgroup.procs" 2>/dev/null || continue ;;
		esac
		ok=0
		command -v ionice >/dev/null 2>&1 && ionice -c 3 -p "$pid" 2>/dev/null
	done <<EOF
$1
EOF
	return $ok
}

# Rimette nel gruppo radice quanto e' nel cgroup lento (compresi i figli nati
# dopo), ripristina i limiti dei gruppi propri e torna alla classe I/O
# normale. I limiti restano nel cgroup vuoto.
unslow_all() {
	local pid g max weight
	if [ -s "$CGSAVED" ]; then
		while IFS='|' read -r g max weight; do
			[ -n "$g" ] || continue
			[ -d "$CGROOT/$g" ] || continue
			echo "$max" > "$CGROOT/$g/cpu.max" 2>/dev/null
			echo "$weight" > "$CGROOT/$g/cpu.weight" 2>/dev/null
			for pid in $(cat "$CGROOT/$g/cgroup.procs" 2>/dev/null); do
				command -v ionice >/dev/null 2>&1 && ionice -c 2 -n 4 -p "$pid" 2>/dev/null
			done
		done < "$CGSAVED"
		: > "$CGSAVED"
	fi
	[ -f "$CG/cgroup.procs" ] || return 0
	for pid in $(cat "$CG/cgroup.procs" 2>/dev/null); do
		echo "$pid" >> "$CGROOT/cgroup.procs" 2>/dev/null
		command -v ionice >/dev/null 2>&1 && ionice -c 2 -n 4 -p "$pid" 2>/dev/null
	done
}

# Momento di nascita (starttime, campo 22 di /proc/PID/stat) di un processo:
# insieme al PID ne dice l'identita'. Vuoto se il processo non c'e'. Il nome
# (comm) puo' contenere spazi e parentesi: si conta dopo l'ultima ")".
proc_start() {
	local st
	st=$(cat "${SWEETSPOT_PROCFS:-/proc}/$1/stat" 2>/dev/null) || return 1
	st=${st##*) }
	set -- $st
	echo "${20}"
}

# Il processo annotato e' ancora lo stesso? $1 = voce ("-GRUPPO" o PID),
# $2 = starttime annotato. Il PID puo' essere stato riusato da un altro
# processo: in quel caso niente segnali. Senza starttime (elenco di una
# versione precedente) vale come prima. Di un gruppo si guarda il capogruppo:
# se non c'e' piu' il numero non puo' essere stato riusato da altri finche'
# il gruppo ha membri, quindi il segnale va al gruppo giusto.
stesso_processo() {
	local ora
	[ -n "$2" ] || return 0
	ora=$(proc_start "${1#-}") || { case "$1" in -*) return 0 ;; *) return 1 ;; esac; }
	[ "$ora" = "$2" ]
}

# Rallenta (cgroup) o, in mancanza, sospende (SIGSTOP) un lavoro.
# $1 = voce da annotare ("-GRUPPO" o PID), $2 = descrizione, poi i PID.
throttle() {
	local entry=$1 what=$2 pids=$3 st
	if cg_ready && slow_pids "$pids"; then
		grep -qx -- "$entry" "$SLOWED" 2>/dev/null && return 0
		echo "$entry" >> "$SLOWED" && log "ascolto: $what rallentato durante l'ascolto"
		return 0
	fi
	grep -q -- "^$entry\( \|\$\)" "$STOPPED" 2>/dev/null && return 0
	st=$(proc_start "${entry#-}")
	kill -STOP -- "$entry" 2>/dev/null && echo "$entry${st:+ $st}" >> "$STOPPED" &&
		log "ascolto: $what sospeso durante l'ascolto"
}

pause_work() {
	local pid f g
	for f in "$PAUSABLE"/*; do
		[ -f "$f" ] || continue
		g=$(cat "$f" 2>/dev/null)
		case "$g" in ''|*[!0-9]*) continue ;; esac
		throttle "-$g" "${f##*/}" "$(group_pids "$g")"
	done
	for pid in $(scanner_pids); do
		throttle "$pid" "lettura della libreria" "$pid"
	done
}

# Riprende quanto e' sospeso (SIGCONT) e toglie i limiti a quanto e' rallentato.
# Chiamata anche all'avvio: dopo un riavvio del demone (o kill -9, senza trap)
# i processi elencati in $STOPPED resterebbero fermi per sempre.
resume_work() {
	local pid st
	if [ -s "$STOPPED" ]; then
		while read -r pid st; do
			[ -n "$pid" ] || continue
			if stesso_processo "$pid" "$st"; then
				kill -CONT -- "$pid" 2>/dev/null
			else
				log "ascolto: $pid non e' piu' il processo sospeso (PID riusato), nessun segnale"
			fi
		done < "$STOPPED"
		: > "$STOPPED"
		log "ascolto: lavori ripresi"
	fi
	# (cgroup.procs ha sempre dimensione 0: il test e' sull'elenco annotato.)
	if [ -s "$SLOWED" ]; then
		unslow_all
		: > "$SLOWED"
		log "ascolto: limiti tolti, lavori a velocita' normale"
	fi
}

# Avvio del demone: prima si riprende quanto una vita precedente (riavviata o
# uccisa con -9, senza trap) aveva lasciato sospeso o rallentato, poi si
# svuotano gli elenchi. Svuotarli senza riprendere lascerebbe i processi
# fermi per sempre.
start_clean() {
	resume_work
	unslow_all
	: > "$STOPPED"
	: > "$SLOWED"
}

[ "${SWEETSPOT_TEST:-}" = 1 ] && return 0

mkdir -p "$RUN"
nap_init
start_clean
rm -f "$IO"
playing=0
trap 'resume_work; io_stop; exit 0' TERM INT
while true; do
	if dac_playing; then
		[ "$playing" = 1 ] || { playing=1; io_start; }
		if is_yes "$(conf MODALITA_ASCOLTO si)"; then pause_work; else resume_work; fi
	else
		[ "$playing" = 0 ] || { playing=0; io_stop; }
		resume_work
	fi
	nap 5
done
