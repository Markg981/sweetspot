#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Sweetspot - correzione ambientale con i filtri misurati con REW.
#
#   sweetspot-dsp leggi FILE        filtri di un'esportazione di REW, uno per
#                                   riga: "TIPO FREQ GUADAGNO PARAMETRO VALORE";
#                                   errori come "errore|riga|messaggio"
#   sweetspot-dsp attiva            esce con 0 se CamillaDSP va usato (per la
#                                   correzione o per il volume a 64 bit)
#   sweetspot-dsp correzione        esce con 0 se la correzione va usata
#                                   (CORREZIONE=si o confronto, filtri validi)
#   sweetspot-dsp richiesta         esce con 0 se la correzione e' chiesta
#                                   (CORREZIONE=si o confronto)
#   sweetspot-dsp problema          stampa perche' la correzione chiesta non e'
#                                   applicabile (file mancanti, illeggibili,
#                                   malformati, incoerenti); nulla se va bene
#   sweetspot-dsp volume           esce con 0 con VOLUME=dsp (modalita' completa)
#   sweetspot-dsp stato DB [muto]   volume di partenza dei prossimi processi
#   sweetspot-dsp guadagno          margine conservativo in dB dei filtri
#   sweetspot-dsp risposta          curva della correzione: "Hz sinistro destro"
#   sweetspot-dsp prepara SCHEDA    scrive la configurazione di CamillaDSP e il
#                                   dispositivo ALSA "sweetspot_correzione"
#   sweetspot-dsp salva SX DX       conserva i filtri (file di testo di REW)
#                                   sulla chiavetta e in memoria
#   sweetspot-dsp ripristina DIR    carica la generazione salvata, o la precedente
#   sweetspot-dsp fir-frequenze     frequenze dei FIR presenti (se validi)
#   sweetspot-dsp frequenze         "FREQ MODO FIR" dell'ultima preparazione
#   sweetspot-dsp avvio             argomenti di CamillaDSP per la sessione
#
# Come funziona: squeezelite suona sul dispositivo ALSA sweetspot_correzione
# (plugin cdsp). Il player avvia una sola istanza di CamillaDSP per sessione
# (stdin da una pipe); a ogni cambio di frequenza il plugin le fa caricare,
# dal websocket, la configurazione di quella frequenza (camilladsp-FREQ.yml)
# senza riavviarla. CamillaDSP applica i filtri in virgola mobile a 64 bit e
# suona sul DAC con il formato migliore che accetta. Con la correzione
# spenta niente di tutto questo e' in mezzo: il percorso resta bit-perfect.
#
# Filtri: l'esportazione "Filter settings as text" dell'equalizzatore
# "Generic" di REW (PK, LS/HS, LSC/HSC, HP/LP, HPQ/LPQ, NO, BP, AP), uno per
# il diffusore sinistro e uno per il destro (se manca, il destro usa il
# sinistro). Sono indipendenti dalla frequenza di campionamento: valgono per
# tutti i brani. Sulla chiavetta stanno nella cartella correzione-ambientale.

. "${SWEETSPOT_LIB:-/usr/lib/sweetspot}/common.sh"

DSP_DIR=$RUN/correzione
DSP_YML=$RUN/camilladsp.yml
DSP_VOLUME=$RUN/camilladsp.volume
ASOUND=${SWEETSPOT_ASOUND:-/etc/asound.conf}
CAMILLADSP=${SWEETSPOT_CAMILLADSP:-/usr/bin/camilladsp}
DSP_PCM=sweetspot_correzione
MAX_TEXT=20000

# --- Lettura dei filtri di REW --------------------------------------------------

parse_rew() { # file
	tr -d '\r' < "$1" | head -c "$MAX_TEXT" | awk '
	function num(s) { gsub(/,/, ".", s); return s + 0 }
	function isnum(s) { gsub(/,/, ".", s); return s ~ /^[-+]?[0-9]*\.?[0-9]+$/ }
	function bad(msg) { printf "errore|%d|%s\n", NR, msg; errors++ }
	/^[ \t]*Filter[ \t]+[0-9]+[ \t]*:/ {
		sub(/^[ \t]*Filter[ \t]+[0-9]+[ \t]*:[ \t]*/, "")
		n = split($0, t, /[ \t]+/)
		if (t[1] != "ON") next
		type = ""; i = 2
		while (i <= n && t[i] != "Fc") { type = type (type == "" ? "" : " ") t[i]; i++ }
		if (type == "" || type == "None") next
		fc = ""; gain = ""; q = ""; bw = ""
		for (; i <= n; i++) {
			if (t[i] == "Fc" && isnum(t[i + 1])) { fc = num(t[i + 1]); if (t[i + 2] == "kHz") fc *= 1000 }
			else if (t[i] == "Gain" && isnum(t[i + 1])) gain = num(t[i + 1])
			else if (t[i] == "Q" && isnum(t[i + 1])) q = num(t[i + 1])
			else if (t[i] == "BW" && t[i + 1] == "Oct" && isnum(t[i + 2])) bw = num(t[i + 2])
		}
		if (fc == "") { bad("frequenza mancante"); next }
		if (fc < 5 || fc > 20000) { bad("frequenza " fc " Hz fuori dai limiti (5-20000 Hz)"); next }
		if (gain != "" && (gain < -30 || gain > 20)) { bad("guadagno " gain " dB fuori dai limiti (-30/+20 dB)"); next }
		if (q != "" && (q < 0.05 || q > 50)) { bad("Q " q " fuori dai limiti (0,05-50)"); next }
		if (bw != "" && (bw < 0.01 || bw > 8)) { bad("larghezza " bw " ottave fuori dai limiti"); next }
		if (type == "PK" || type == "PEQ") {
			if (gain == "") { bad("guadagno mancante"); next }
			if (q != "") print "Peaking", fc, gain, "q", q
			else if (bw != "") print "Peaking", fc, gain, "bandwidth", bw
			else bad("Q mancante")
		} else if (type == "LS" || type == "LS 12dB" || type == "HS" || type == "HS 12dB") {
			if (gain == "") { bad("guadagno mancante"); next }
			print (substr(type, 1, 1) == "L" ? "Lowshelf" : "Highshelf"), fc, gain, "slope", 12
		} else if (type == "LS 6dB" || type == "HS 6dB") {
			if (gain == "") { bad("guadagno mancante"); next }
			print (substr(type, 1, 1) == "L" ? "LowshelfFO" : "HighshelfFO"), fc, gain, "none", 0
		} else if (type == "LSC" || type == "HSC" || type == "LSQ" || type == "HSQ") {
			if (gain == "") { bad("guadagno mancante"); next }
			print (substr(type, 1, 1) == "L" ? "Lowshelf" : "Highshelf"), fc, gain, "q", (q == "" ? 0.7071 : q)
		} else if (type == "HP" || type == "LP" || type == "HPQ" || type == "LPQ") {
			print (substr(type, 1, 1) == "H" ? "Highpass" : "Lowpass"), fc, 0, "q", (q == "" ? 0.7071 : q)
		} else if (type == "HP1" || type == "LP1" || type == "HP 6dB" || type == "LP 6dB") {
			print (substr(type, 1, 1) == "H" ? "HighpassFO" : "LowpassFO"), fc, 0, "none", 0
		} else if (type == "NO") {
			print "Notch", fc, 0, "q", (q == "" ? 30 : q)
		} else if (type == "BP") {
			print "Bandpass", fc, 0, "q", (q == "" ? 0.7071 : q)
		} else if (type == "AP") {
			print "Allpass", fc, 0, "q", (q == "" ? 0.7071 : q)
		} else {
			bad("tipo di filtro " type " non supportato (usa l'\''equalizzatore Generic di REW)")
		}
		count++
		if (count > 60) { bad("troppi filtri (al massimo 60 per canale)"); exit }
	}
	END { exit errors > 0 }'
}

# Filtri validi di un canale (sinistro|destro) in memoria; il destro senza
# file usa quelli del sinistro.
channel_filters() {
	local f=$DSP_DIR/$1.txt
	[ "$1" = destro ] && [ ! -s "$f" ] && f=$DSP_DIR/sinistro.txt
	[ -s "$f" ] || return 0
	parse_rew "$f" 2>/dev/null | grep -v '^errore|'
}

filters_ok() {
	[ -s "$DSP_DIR/sinistro.txt" ] || return 1
	parse_rew "$DSP_DIR/sinistro.txt" > /dev/null || return 1
	[ ! -s "$DSP_DIR/destro.txt" ] || parse_rew "$DSP_DIR/destro.txt" > /dev/null
}

# CORREZIONE: no (spenta: percorso bit-perfect), si, confronto (CamillaDSP
# con la sola attenuazione, per confrontare a pari volume).
dsp_mode() {
	case "$(lower "$(conf CORREZIONE no)")" in
		si|yes|1) echo si ;;
		confronto) echo confronto ;;
		*) echo no ;;
	esac
}

# Correzione chiesta (CORREZIONE=si o confronto), a prescindere dai file.
correction_requested() {
	[ "$(dsp_mode)" != no ]
}

# La correzione e' in uso solo se chiesta e se TUTTI i file presenti sono
# validi: un FIR rotto accanto a filtri di REW buoni non si ignora in silenzio.
correction_active() {
	correction_requested && correction_problem > /dev/null
}

# --- Filtri FIR (convoluzione) ------------------------------------------------
#
# Impulsi WAV esportati da rePhase, Acourate o REW, nella cartella della
# correzione. Un FIR vale per la sua frequenza di campionamento: CamillaDSP
# lavora alla frequenza del brano e usa il FIR di quella frequenza, senza
# ricampionare. Nomi (FREQ e' la frequenza in Hz, per esempio 44100):
#   fir-sinistro-FREQ.wav, fir-destro-FREQ.wav   un impulso per canale
#   fir-FREQ.wav                                 un file per i due canali (mono:
#                                                per entrambi; stereo: canale 0 a
#                                                sinistra, canale 1 a destra)
#   fir-sinistro.wav, fir-destro.wav             senza frequenza nel nome: valgono
#                                                per la frequenza scritta nel file
# Il destro senza file proprio usa quello del sinistro; la frequenza scritta
# nel nome deve essere quella del file.
# Frequenza senza FIR: decide la politica CORREZIONE_SE_ASSENTE (blocca: il
# brano non suona e lo Stato lo dice; diretto: suona senza FIR, con avviso).
# Solo con FIR_RICAMPIONA=si il brano si ricampiona alla frequenza del FIR
# piu' vicino (della stessa famiglia, 44,1 o 48 kHz, se c'e').
# Attenuazione in piu' per i FIR: FIR_MARGINE_DB (predefinito 3 dB).
FIR_MAX_KB=16384

# Politica per le frequenze senza FIR: blocca (predefinito) o diretto.
fir_politica() {
	case "$(lower "$(conf CORREZIONE_SE_ASSENTE blocca)")" in
		diretto) echo diretto ;;
		*) echo blocca ;;
	esac
}

# "FREQUENZA CANALI" di un WAV (intestazione standard: fmt subito dopo RIFF).
wav_info() { # file
	local ch rate
	[ -s "$1" ] || return 1
	[ "$(head -c 4 "$1")" = RIFF ] || return 1
	[ "$(dd if="$1" bs=1 skip=8 count=8 2>/dev/null)" = "WAVEfmt " ] || return 1
	ch=$(od -An -tu2 -j22 -N2 "$1" | tr -d ' ')
	rate=$(od -An -tu4 -j24 -N4 "$1" | tr -d ' ')
	[ "${ch:-0}" -ge 1 ] && [ "${ch:-0}" -le 2 ] && [ "${rate:-0}" -ge 8000 ] || return 1
	echo "$rate $ch"
}

# File FIR presenti (con la frequenza nel nome o senza), uno per riga.
fir_list() { # [cartella]
	local f dir=${1:-$DSP_DIR}
	for f in "$dir"/fir-sinistro.wav "$dir"/fir-destro.wav \
		"$dir"/fir-sinistro-[0-9]*.wav "$dir"/fir-destro-[0-9]*.wav "$dir"/fir-[0-9]*.wav; do
		[ -e "$f" ] && echo "$f"
	done
}

# Frequenza di un file FIR: quella del nome o, per fir-sinistro.wav e
# fir-destro.wav, quella scritta nel file.
fir_file_rate() { # file
	local b=${1##*/}
	b=${b%.wav}
	case "$b" in
		fir-sinistro|fir-destro) wav_info "$1" 2>/dev/null | cut -d' ' -f1 ;;
		*) echo "${b##*-}" ;;
	esac
}

# Frequenze con almeno un FIR, in ordine crescente.
fir_rates() {
	local f r
	for f in $(fir_list); do
		r=$(fir_file_rate "$f")
		case "$r" in ''|*[!0-9]*) continue ;; esac
		echo "$r"
	done | sort -un
}

# File FIR di un canale a una frequenza: il suo, quello stereo della
# frequenza, i file senza frequenza nel nome se hanno quella frequenza; il
# destro ricade sul sinistro. Niente e uscita 1 se non c'e'.
fir_side_file() { # frequenza sinistro|destro
	local r=$1 s=$2 f
	for f in "$DSP_DIR/fir-$s-$r.wav" "$DSP_DIR/fir-$r.wav"; do
		[ -s "$f" ] && { echo "$f"; return 0; }
	done
	[ "$s" = destro ] && [ -s "$DSP_DIR/fir-sinistro-$r.wav" ] && { echo "$DSP_DIR/fir-sinistro-$r.wav"; return 0; }
	for f in "$DSP_DIR/fir-$s.wav" "$DSP_DIR/fir-sinistro.wav"; do
		[ -s "$f" ] && [ "$(fir_file_rate "$f")" = "$r" ] && { echo "$f"; return 0; }
		[ "$s" = sinistro ] && break
	done
	return 1
}

# Canale del file da usare: 1 solo per il destro letto da un file stereo che
# non e' il suo.
fir_side_channel() { # file sinistro|destro
	case "${1##*/}" in fir-destro*) echo 0; return ;; esac
	if [ "$2" = destro ] && [ "$(wav_info "$1" | cut -d' ' -f2)" = 2 ]; then echo 1; else echo 0; fi
}

# Campioni (per canale) di un impulso WAV: dalla dimensione del file, con
# l'intestazione standard di 44 byte (per difetto, mai in meno).
wav_frames() { # file
	local ch bps size
	ch=$(od -An -tu2 -j22 -N2 "$1" | tr -d ' ')
	bps=$(od -An -tu2 -j34 -N2 "$1" | tr -d ' ')
	size=$(wc -c < "$1")
	case "$bps" in 8|16|24|32|64) ;; *) bps=16 ;; esac
	[ "${ch:-0}" -ge 1 ] || ch=1
	echo $(( (size - 44) / (ch * bps / 8) ))
}

# Il FIR piu' lungo fra tutti i file, in campioni alla sua frequenza.
fir_taps() {
	local f n max=0
	for f in $(fir_list); do
		[ -s "$f" ] || continue
		n=$(wav_frames "$f")
		[ "$n" -gt "$max" ] && max=$n
	done
	echo "$max"
}

# Il FIR piu' lungo dei due canali a una frequenza.
fir_taps_rate() { # frequenza
	local f n s max=0
	for s in sinistro destro; do
		f=$(fir_side_file "$1" "$s") || continue
		n=$(wav_frames "$f")
		[ "$n" -gt "$max" ] && max=$n
	done
	echo "$max"
}

fir_ok() {
	[ -n "$(fir_rates)" ] && fir_problem > /dev/null
}

# Problema di un file di filtri REW: una riga di spiegazione, esce con 1.
rew_problem() { # file nome
	local out rc
	[ -r "$1" ] || { echo "$2 illeggibile"; return 1; }
	if ! tr -d '\r' < "$1" | grep -Eq '^[[:space:]]*Filter[[:space:]]+[0-9]+[[:space:]]*:'; then
		echo "$2 non e' un'esportazione di REW (nessuna riga \"Filter N:\")"
		return 1
	fi
	out=$(parse_rew "$1" 2>/dev/null); rc=$?
	[ "$rc" = 0 ] && return 0
	echo "$2 non valido: $(printf '%s\n' "$out" | sed -n 's/^errore|\([0-9]*\)|\(.*\)$/\2 (riga \1)/p' | head -n 1)"
	return 1
}

# Problema dei file FIR presenti: leggibili, WAV validi, sotto il limite di
# dimensione, con la frequenza del nome, e per ogni frequenza stessi canali nei
# due file (e frequenza uguale nei file senza frequenza nel nome).
fir_problem() {
	local f b n r l d s ls ld
	for f in $(fir_list); do
		b=${f##*/}
		[ -r "$f" ] || { echo "$b illeggibile"; return 1; }
		[ -s "$f" ] || { echo "$b vuoto"; return 1; }
		[ "$(( $(wc -c < "$f") / 1024 ))" -le "$FIR_MAX_KB" ] ||
			{ echo "$b supera $((FIR_MAX_KB / 1024)) MB"; return 1; }
		wav_info "$f" > /dev/null ||
			{ echo "$b non e' un WAV valido (mono o stereo, almeno 8000 Hz)"; return 1; }
		case "$b" in fir-sinistro.wav|fir-destro.wav) continue ;; esac
		n=${b%.wav}
		n=${n##*-}
		case "$n" in
			''|*[!0-9]*) echo "$b: la frequenza nel nome deve essere un numero (per esempio fir-44100.wav)"; return 1 ;;
		esac
		r=$(wav_info "$f" | cut -d' ' -f1)
		[ "$r" = "$n" ] ||
			{ echo "$b ha frequenza $r Hz, non $n Hz come nel nome"; return 1; }
	done
	if [ -e "$DSP_DIR/fir-sinistro.wav" ] || [ -e "$DSP_DIR/fir-destro.wav" ]; then
		if [ ! -s "$DSP_DIR/fir-sinistro.wav" ]; then
			echo "c'e' fir-destro.wav ma manca fir-sinistro.wav"
			return 1
		fi
		if [ -s "$DSP_DIR/fir-destro.wav" ]; then
			l=$(wav_info "$DSP_DIR/fir-sinistro.wav")
			d=$(wav_info "$DSP_DIR/fir-destro.wav")
			[ "${l% *}" = "${d% *}" ] ||
				{ echo "i FIR hanno frequenze diverse (sinistro ${l% *} Hz, destro ${d% *} Hz)"; return 1; }
			[ "${l#* }" = "${d#* }" ] ||
				{ echo "i FIR hanno canali diversi (sinistro ${l#* }, destro ${d#* })"; return 1; }
		fi
	fi
	for r in $(fir_rates); do
		s=$(fir_side_file "$r" sinistro) ||
			{ echo "a $r Hz c'e' il FIR del destro ma manca quello del sinistro (fir-sinistro-$r.wav o fir-$r.wav)"; return 1; }
		d=$(fir_side_file "$r" destro)
		[ "$s" = "$d" ] && continue
		ls=$(wav_info "$s")
		ld=$(wav_info "$d")
		[ "${ls#* }" = "${ld#* }" ] ||
			{ echo "i FIR a $r Hz hanno canali diversi (sinistro ${ls#* }, destro ${ld#* })"; return 1; }
	done
	return 0
}

# Perche' la correzione chiesta non e' applicabile: una riga e uscita 1; con
# la correzione spenta o i file a posto, nessun output e uscita 0.
correction_problem() {
	local have=0 side msg
	correction_requested || return 0
	if [ -s "$DSP_DIR/sinistro.txt" ] || [ -s "$DSP_DIR/destro.txt" ]; then
		have=1
		[ -s "$DSP_DIR/sinistro.txt" ] || { echo "c'e' destro.txt ma manca sinistro.txt"; return 1; }
		for side in sinistro destro; do
			[ -s "$DSP_DIR/$side.txt" ] || continue
			msg=$(rew_problem "$DSP_DIR/$side.txt" "$side.txt") || { echo "$msg"; return 1; }
		done
	fi
	if [ -n "$(fir_list)" ]; then
		have=1
		msg=$(fir_problem) || { echo "$msg"; return 1; }
	fi
	[ "$have" = 1 ] || { echo "nessun filtro trovato (servono sinistro.txt o fir-sinistro.wav)"; return 1; }
	return 0
}

fir_margin() {
	local m
	m=$(conf FIR_MARGINE_DB 3)
	case "$m" in ''|*[!0-9.]*) m=3 ;; esac
	echo "$m"
}

# FIR in uso: correzione attiva e file validi (anche nel confronto a pari
# volume: stessa frequenza e stessa attenuazione, senza i filtri).
fir_in_use() { correction_active && fir_ok; }

# VOLUME=dsp: il volume di Lyrion lo applica CamillaDSP a 64 bit, con il
# dither all'uscita, invece del troncamento di Squeezelite. Il volume si
# legge da Lyrion (sweetspot-volume): in modalita' completa e' quello locale,
# in modalita' player serve SERVER, l'indirizzo del Lyrion esterno (con la
# ricerca automatica non si sa dove sia: volume software, e lo Stato dice
# perche').
volume_dsp() {
	[ "$(lower "$(conf VOLUME fisso)")" = dsp ] || return 1
	[ "$(mode)" = completa ] || [ -n "$(conf SERVER)" ]
}

# CamillaDSP serve per la correzione, per il volume o per entrambi.
active() {
	correction_active || volume_dsp
}

# Volume di partenza "GUADAGNO_DB SORDINA(0|1)": il plugin cdsp lo legge
# (vol_file) a ogni avvio di CamillaDSP e lo passa con -g/-m, quindi ogni
# brano parte gia' al volume giusto. Se il file manca o non e' valido il
# plugin non avvia CamillaDSP: silenzio, mai il volume massimo. Lo aggiorna
# sweetspot-volume; si scrive sempre con un rename (mai a meta').
dsp_state_write() { # dB [muto]
	local mute=0
	[ "${2:-}" = muto ] && mute=1
	case "$1" in -[0-9]*|0|0.0) ;; *) return 1 ;; esac
	echo "$1 $mute" > "$DSP_VOLUME.nuovo" && mv "$DSP_VOLUME.nuovo" "$DSP_VOLUME"
}

# Senza il volume a 64 bit il volume principale resta a 0 dB (solo la
# correzione); con il volume si parte in sordina (-30 dB, muto) finche' Lyrion
# non dice il suo: silenzio, come promesso; sweetspot-volume toglie la sordina
# al primo volume letto. Un valore gia' scritto (anche 0.0, cioe' il cursore al 100%) resta.
dsp_state_prepare() {
	if ! volume_dsp; then
		dsp_state_write 0.0
	elif ! grep -qE '^-?[0-9]+(\.[0-9]+)? [01]$' "$DSP_VOLUME" 2>/dev/null; then
		dsp_state_write -30.0 muto
	fi
}

# --- Risposta in frequenza (formule di R. Bristow-Johnson) -------------------------

# Modulo in dB della catena di filtri letta da stdin, sulle frequenze di
# "Hz" (una per riga in $1), a 48 kHz.
RESPONSE_AWK='
function biquad(type, f0, g, p, v, w,    A, w0, cw, sw, al, b0, b1, b2, a0, a1, a2, sa, nr, ni, dr, di) {
	A = exp(g / 40 * log(10)); w0 = 2 * pi * f0 / fs; cw = cos(w0); sw = sin(w0)
	if (p == "q") al = sw / (2 * v)
	else if (p == "bandwidth") al = sw * sinh(log(2) / 2 * v * w0 / sw)
	else if (p == "slope") al = sw / 2 * sqrt((A + 1 / A) * (12 / v - 1) + 2)
	if (type == "Peaking") { b0 = 1 + al * A; b1 = -2 * cw; b2 = 1 - al * A; a0 = 1 + al / A; a1 = -2 * cw; a2 = 1 - al / A }
	else if (type == "Lowshelf") { sa = 2 * sqrt(A) * al
		b0 = A * ((A + 1) - (A - 1) * cw + sa); b1 = 2 * A * ((A - 1) - (A + 1) * cw); b2 = A * ((A + 1) - (A - 1) * cw - sa)
		a0 = (A + 1) + (A - 1) * cw + sa; a1 = -2 * ((A - 1) + (A + 1) * cw); a2 = (A + 1) + (A - 1) * cw - sa }
	else if (type == "Highshelf") { sa = 2 * sqrt(A) * al
		b0 = A * ((A + 1) + (A - 1) * cw + sa); b1 = -2 * A * ((A - 1) + (A + 1) * cw); b2 = A * ((A + 1) + (A - 1) * cw - sa)
		a0 = (A + 1) - (A - 1) * cw + sa; a1 = 2 * ((A - 1) - (A + 1) * cw); a2 = (A + 1) - (A - 1) * cw - sa }
	else if (type == "Lowpass") { b0 = (1 - cw) / 2; b1 = 1 - cw; b2 = (1 - cw) / 2; a0 = 1 + al; a1 = -2 * cw; a2 = 1 - al }
	else if (type == "Highpass") { b0 = (1 + cw) / 2; b1 = -(1 + cw); b2 = (1 + cw) / 2; a0 = 1 + al; a1 = -2 * cw; a2 = 1 - al }
	else if (type == "Notch") { b0 = 1; b1 = -2 * cw; b2 = 1; a0 = 1 + al; a1 = -2 * cw; a2 = 1 - al }
	else if (type == "Bandpass") { b0 = al; b1 = 0; b2 = -al; a0 = 1 + al; a1 = -2 * cw; a2 = 1 - al }
	else return 0
	nr = b0 + b1 * cos(w) + b2 * cos(2 * w); ni = -(b1 * sin(w) + b2 * sin(2 * w))
	dr = a0 + a1 * cos(w) + a2 * cos(2 * w); di = -(a1 * sin(w) + a2 * sin(2 * w))
	return 10 * log((nr * nr + ni * ni) / (dr * dr + di * di)) / log(10)
}
function sinh(x) { return (exp(x) - exp(-x)) / 2 }
function first_order(type, f0, g, f,    A2, r) {
	A2 = exp(g / 10 * log(10)); r = (f / f0) * (f / f0)
	if (type == "LowshelfFO") return 10 * log((r + A2) / (r + 1)) / log(10)
	if (type == "HighshelfFO") return 10 * log((A2 * r + 1) / (r + 1)) / log(10)
	if (type == "LowpassFO") return 10 * log(1 / (1 + r)) / log(10)
	if (type == "HighpassFO") return 10 * log(r / (1 + r)) / log(10)
	return 0
}
BEGIN { pi = atan2(0, -1); fs = 48000 }
FNR == NR { hz[++nf] = $1; next }
{ n++; type[n] = $1; f0[n] = $2; g[n] = $3; p[n] = $4; v[n] = $5 }
END {
	for (i = 1; i <= nf; i++) {
		db = 0; w = 2 * pi * hz[i] / fs
		for (k = 1; k <= n; k++) {
			if (type[k] ~ /FO$/) db += first_order(type[k], f0[k], g[k], hz[i])
			else if (type[k] != "Allpass") db += biquad(type[k], f0[k], g[k], p[k], v[k], w)
		}
		printf "%s %.2f\n", hz[i], db
	}
}'

# Frequenze in scala logaritmica da 20 Hz a 20 kHz.
freq_grid() {
	$AWK 'BEGIN { for (i = 0; i <= 150; i++) printf "%.1f\n", 20 * exp(i / 150 * log(1000)) }'
}

do_response() {
	local g
	g=$RUN/correzione.griglia
	mkdir -p "$RUN"
	freq_grid > "$g"
	channel_filters sinistro | $AWK "$RESPONSE_AWK" "$g" - > "$g.sx"
	channel_filters destro | $AWK "$RESPONSE_AWK" "$g" - > "$g.dx"
	# "Hz sinistro destro"
	awk 'FNR == NR { dx[$1] = $2; next } { print $1, $2, dx[$1] }' "$g.dx" "$g.sx"
	rm -f "$g" "$g.sx" "$g.dx"
}

# Massimo analitico di ogni filtro sull'intero spettro: la somma dei massimi
# positivi e' un limite superiore della catena, anche per picchi molto stretti.
# La trasformazione bilineare copre tutto lo spettro: il limite non dipende
# dalla griglia a 48 kHz usata solo per disegnare la curva.
channel_gain_bound() {
	channel_filters "$1" | $AWK '
	function ratio(y, n2,n1,n0,d2,d1,d0) {
		return (n2*y*y+n1*y+n0)/(d2*y*y+d1*y+d0)
	}
	function maximum(n2,n1,n0,d2,d1,d0,    m,c2,c1,c0,disc,y,r,j) {
		m=n0/d0; r=n2/d2; if (r>m) m=r
		c2=n2*d1-n1*d2; c1=2*(n2*d0-n0*d2); c0=n1*d0-n0*d1
		if (c2==0) {
			if (c1==0) return m
			y=-c0/c1
			if (y>=0) { r=ratio(y,n2,n1,n0,d2,d1,d0); if(r>m)m=r }
		} else {
			disc=c1*c1-4*c2*c0
			if (disc>=0) for(j=-1;j<=1;j+=2) {
				y=(-c1+j*sqrt(disc))/(2*c2)
				if (y>=0) { r=ratio(y,n2,n1,n0,d2,d1,d0); if(r>m)m=r }
			}
		}
		return m
	}
	{
		peak=0
		if ($1=="Peaking" || $1 ~ /shelfFO$/) peak=$3
		else if ($1=="Lowpass" || $1=="Highpass") {
			q=$5
			if(q>sqrt(0.5)) peak=20*log(q/sqrt(1-1/(4*q*q)))/log(10)
		} else if ($1=="Lowshelf" || $1=="Highshelf") {
			A=exp($3/40*log(10))
			q=($4=="q" ? $5 : 1/sqrt((A+1/A)*(12/$5-1)+2))
			b=A*(1/(q*q)-2)
			# Shelf alto e basso hanno lo stesso massimo (y -> 1/y).
			peak=10*log(A*A*maximum(1,b,A*A,A*A,b,1))/log(10)
		}
		if(peak>0) sum+=peak
	}
	END { printf "%.9f\n", sum }'
}

# Mezzo dB di margine, arrotondato verso maggiore attenuazione; identico sui
# canali e in modalita' confronto. E' un limite in frequenza, non una garanzia
# contro ogni overshoot nel tempo: verifica i contatori clipping di CamillaDSP.
do_gain() {
	{ channel_gain_bound sinistro; channel_gain_bound destro; } | awk '
		$1 > m { m=$1 }
		END { if (m>0) printf "%.1f\n", -int((m+0.5)*10+0.999999)/10; else print "0.0" }'
}

# --- Configurazione di CamillaDSP e del dispositivo ALSA ---------------------------

# Motivo per cui la preparazione e' fallita: nel registro e in
# $RUN/correzione.motivo, da dove il player lo porta in Stato.
fail_reason() {
	log "correzione: $1"
	mkdir -p "$RUN"
	echo "$1" > "$RUN/correzione.motivo"
}

# Formato di uscita verso il DAC, il migliore che accetta (nomi di CamillaDSP).
dsp_out_format() {
	local f
	f=" $(dac_formats "$1" 2) "
	case "$f" in
		*" S32_LE "*) echo S32_LE ;;
		*" S24_3LE "*) echo S24_3_LE ;;
		*" S24_LE "*) echo S24_4_RJ_LE ;;
		*" S16_LE "*) echo S16_LE ;;
		*) return 1 ;;
	esac
}

# Filtri attivi: nessuno nel confronto a pari volume o con il solo volume.
active_filters() {
	correction_active || return 0
	[ "$(dsp_mode)" = confronto ] && return 0
	channel_filters "$1"
}

write_filters_yaml() { # prefisso canale
	active_filters "$2" | awk -v pre="$1" '
		{ n++
		  printf "  %s_%d:\n    type: Biquad\n    parameters:\n      type: %s\n      freq: %s\n", pre, n, $1, $2
		  if ($1 ~ /shelf|Peaking/) printf "      gain: %s\n", $3
		  if ($4 != "none") printf "      %s: %s\n", $4, $5 }'
}

filter_names() { # prefisso canale
	active_filters "$2" | awk -v pre="$1" '{ printf "      - %s_%d\n", pre, NR }'
}

# Configurazione di CamillaDSP per una frequenza del brano. Modo:
#   fir         il FIR di quella frequenza (FIRFREQ e' la stessa)
#   ricampiona  il FIR di FIRFREQ: il brano e' ricampionato a quella frequenza
#   senza       nessun FIR: solo l'attenuazione, i filtri di REW e il volume
write_config() { # scheda frequenza modo frequenza_fir file
	local card=$1 rate=$2 mode=$3 firrate=$4 out=$5 id dev fmt gain=0.0 ch pre side bits fir="" proc=$2 extra=8192 f
	id=$(dac_id "$card")
	dev=$(dac_playback_dev "$card") || return 1
	fmt=$(dsp_out_format "$card") || { fail_reason "formato PCM del playback non disponibile"; return 1; }
	if [ -n "${PREP_GUADAGNO+x}" ]; then gain=$PREP_GUADAGNO; else correction_active && gain=$(do_gain); fi
	# Con un FIR CamillaDSP lavora (e suona sul DAC) alla frequenza del FIR.
	if [ "$mode" != senza ]; then
		fir=1
		proc=$firrate
		gain=$(awk -v g="$gain" -v m="$(fir_margin)" 'BEGIN { printf "%.1f", g - m }')
		extra=$(( $(fir_taps_rate "$firrate") + 8192 ))
	fi
	# Dither TPDF alla risoluzione dell'uscita: CamillaDSP modifica sempre i
	# campioni (attenuazione, filtri o volume), quindi il passaggio da 64 bit
	# all'uscita va fatto con il dither e non con il troncamento: a 16 bit con
	# il DAC a 16 bit, a 24 bit negli altri casi (i DAC "a 32 bit" ne
	# convertono al piu' 24 in modo lineare).
	if [ "$fmt" = S16_LE ]; then
		bits=16
	else
		bits=24
	fi
	{
		echo "---"
		echo "# Generato da Sweetspot (sweetspot-dsp): non modificare."
		echo "# Una sola istanza per sessione: il plugin cdsp cambia configurazione"
		echo "# (questa, camilladsp-FREQUENZA.yml) a ogni cambio di frequenza."
		echo "devices:"
		echo "  samplerate: $proc"
		echo "  chunksize: 4096"
		if [ "$mode" = ricampiona ]; then
			# Il brano arriva a $rate e si ricampiona alla frequenza del FIR.
			echo "  capture_samplerate: $rate"
		fi
		if [ -n "$fir" ]; then
			# Se la frequenza d'ingresso coincide con quella dei FIR il
			# ricampionatore si spegne da solo.
			echo "  resampler:"
			echo "    type: Synchronous"
		fi
		echo "  queuelimit: 1"
		# Il volume non supera mai 0 dB, qualunque comando arrivi.
		echo "  volume_limit: 0.0"
		echo "  capture:"
		echo "    type: Stdin"
		echo "    channels: 2"
		echo "    format: S32_LE"
		# Coda del brano: quando il plugin chiude lo stream (stop, cambio di
		# frequenza) scrive nella pipe tanto silenzio quanto extra_samples
		# (il plugin lo legge da qui), cosi' CamillaDSP finisce i blocchi e la
		# coda dei filtri: due blocchi per la coda dei biquad e, con i FIR,
		# tutta la loro lunghezza.
		echo "    extra_samples: $extra"
		echo "  playback:"
		echo "    type: Alsa"
		echo "    channels: 2"
		echo "    device: \"hw:CARD=$id,DEV=$dev\""
		echo "    format: $fmt"
		echo "filters:"
		echo "  attenuazione:"
		echo "    type: Gain"
		echo "    parameters:"
		echo "      gain: $gain"
		if [ -n "${PREP_GUADAGNO+x}" ]; then
			printf '%s' "$PREP_YAML_SX$PREP_YAML_DX"
		else
			write_filters_yaml sx sinistro
			write_filters_yaml dx destro
		fi
		if [ -n "$fir" ]; then
			for side in sinistro destro; do
				f=$(fir_side_file "$firrate" "$side")
				echo "  fir_$side:"
				echo "    type: Conv"
				echo "    parameters:"
				echo "      type: Wav"
				echo "      filename: \"$f\""
				echo "      channel: $(fir_side_channel "$f" "$side")"
			done
		fi
		echo "  dither:"
		echo "    type: Dither"
		echo "    parameters:"
		echo "      type: Flat"
		echo "      bits: $bits"
		echo "      amplitude: 2.0"
		echo "pipeline:"
		for ch in 0 1; do
			if [ $ch = 0 ]; then pre=sx; side=sinistro; else pre=dx; side=destro; fi
			echo "  - type: Filter"
			echo "    channels: [$ch]"
			echo "    names:"
			echo "      - attenuazione"
			if [ -n "${PREP_GUADAGNO+x}" ]; then
				if [ $ch = 0 ]; then printf '%s' "$PREP_NOMI_SX"; else printf '%s' "$PREP_NOMI_DX"; fi
			else
				filter_names "$pre" "$side"
			fi
			[ -n "$fir" ] && [ "$(dsp_mode)" = si ] && echo "      - fir_$side"
			echo "      - dither"
		done
	} > "$out.nuovo" && mv "$out.nuovo" "$out"
}

# Frequenze offerte a squeezelite: quelle del DAC fino a 384 kHz.
dsp_rates() {
	local r fmt out=""
	fmt=$(dsp_out_format "$1") || return 1
	case "$fmt" in S24_3_LE) fmt=S24_3LE ;; S24_4_RJ_LE) fmt=S24_LE ;; esac
	for r in $(dac_rates "$1" "$fmt" 2); do
		case "$r" in 44100|48000|88200|96000|176400|192000|352800|384000) out="$out $r" ;; esac
	done
	[ -n "$out" ] || return 1
	printf '%s' "${out# }"
}

fir_rate_has() { fir_side_file "$1" sinistro > /dev/null; }

# Frequenza di un elenco ("44100 96000") piu' vicina a $1, di preferenza della
# stessa famiglia (multipli di 44100 o di 48000).
fir_nearest() { # frequenza elenco
	awk -v r="$1" -v list="$2" 'BEGIN {
		n = split(list, a, " "); best = ""; bd = 1e18
		for (i = 1; i <= n; i++) {
			d = (a[i] > r ? a[i] - r : r - a[i])
			if ((a[i] % 44100 == 0) != (r % 44100 == 0)) d += 1e9
			if (d < bd) { bd = d; best = a[i] }
		}
		print best }'
}

# Come si tratta ogni frequenza del DAC, una per riga "FREQ MODO FIRFREQ":
#   fir         il FIR della frequenza
#   ricampiona  ricampionata alla frequenza del FIR piu' vicino (FIR_RICAMPIONA=si)
#   senza       nessun FIR: nessun FIR in uso, oppure politica diretto
#   escluso     non offerta a squeezelite: il brano non suona (politica blocca)
# Con i FIR in uso ma nessuna frequenza del DAC coperta non c'e' piano (1).
rate_plan() { # scheda
	local rates r firs=""
	rates=$(dsp_rates "$1") || { fail_reason "frequenze PCM del playback non disponibili"; return 1; }
	if ! fir_in_use; then
		for r in $rates; do echo "$r senza -"; done
		return 0
	fi
	for r in $rates; do
		fir_rate_has "$r" && firs="$firs $r"
	done
	if [ -z "$firs" ]; then
		fail_reason "il DAC non accetta nessuna delle frequenze dei filtri FIR ($(fir_rates | tr '\n' ' ' | sed 's/ $//') Hz)"
		return 1
	fi
	for r in $rates; do
		if fir_rate_has "$r"; then
			echo "$r fir $r"
		elif is_yes "$(conf FIR_RICAMPIONA no)"; then
			echo "$r ricampiona $(fir_nearest "$r" "$firs")"
		elif [ "$(fir_politica)" = diretto ]; then
			echo "$r senza -"
		else
			echo "$r escluso -"
		fi
	done
}

# Avviso per le frequenze senza FIR (dal piano su stdin); nulla se ogni
# frequenza ha il suo.
plan_warning() {
	awk '
		$2 == "escluso" { e = e " " $1 }
		$2 == "senza" { n = n " " $1 }
		$2 == "ricampiona" { r = r " " $1 ">" $3 }
		function add(t) { out = out (out == "" ? "" : "; ") t }
		END {
			if (e != "") add("nessun FIR a" e " Hz: i brani a queste frequenze non vengono riprodotti (CORREZIONE_SE_ASSENTE=blocca)")
			if (n != "") add("nessun FIR a" n " Hz: suonano senza FIR (CORREZIONE_SE_ASSENTE=diretto)")
			if (r != "") add("nessun FIR, brani ricampionati alla frequenza del FIR piu'"'"' vicino (FIR_RICAMPIONA=si):" r)
			if (out != "") print out }'
}

write_asound() { # scheda frequenze_offerte
	{
		echo "# Generato da Sweetspot (sweetspot-dsp): correzione ambientale."
		echo "pcm.$DSP_PCM {"
		echo "	type cdsp"
		echo "	cpath \"$CAMILLADSP\""
		echo "	config_out \"$DSP_YML\""
		echo "	config_cdsp 1"
		echo "	channels 2"
		echo "	rates = [ $2 ]"
		# Una sola istanza di CamillaDSP per sessione, avviata dal player: il
		# plugin scrive i campioni nella pipe e, a ogni cambio di frequenza,
		# carica camilladsp-FREQUENZA.yml dal websocket (solo locale).
		echo "	fifo \"$DSP_FIFO\""
		echo "	ws_port $DSP_PORTA"
		echo "	config_rate_prefix \"$RUN/camilladsp-\""
		echo "	chunk_frames 4096"
		echo "	tail_frames 8192"
		echo "	cargs [ -l \"warn\" -o \"/var/log/camilladsp.log\" -p \"$DSP_PORTA\" -a \"127.0.0.1\" ]"
		echo "	vol_file \"$DSP_VOLUME\""
		echo "}"
	} > "$ASOUND.nuovo" && mv "$ASOUND.nuovo" "$ASOUND"
}

do_prepare() { # scheda
	local plan rates r mode fr first warn
	active || return 1
	mkdir -p "$RUN"
	rm -f "$RUN/correzione.motivo" "$RUN/correzione.avviso" "$RUN/correzione.frequenze" "$RUN"/camilladsp-[0-9]*.yml
	plan=$(rate_plan "$1") || return 1
	rates=$(printf '%s\n' "$plan" | awk '$2 != "escluso" { printf "%s%s", (n++ ? " " : ""), $1 }')
	[ -n "$rates" ] || { fail_reason "nessuna frequenza utilizzabile"; return 1; }
	first=${rates%% *}
	# Gli stessi filtri e la stessa attenuazione per ogni frequenza: si leggono
	# una volta sola (le sostituzioni di comando tolgono l'ultimo a capo).
	PREP_GUADAGNO=0.0
	correction_active && PREP_GUADAGNO=$(do_gain)
	PREP_YAML_SX=$(write_filters_yaml sx sinistro; echo .)
	PREP_YAML_SX=${PREP_YAML_SX%.}
	PREP_YAML_DX=$(write_filters_yaml dx destro; echo .)
	PREP_YAML_DX=${PREP_YAML_DX%.}
	PREP_NOMI_SX=$(filter_names sx sinistro; echo .)
	PREP_NOMI_SX=${PREP_NOMI_SX%.}
	PREP_NOMI_DX=$(filter_names dx destro; echo .)
	PREP_NOMI_DX=${PREP_NOMI_DX%.}
	printf '%s\n' "$plan" | while read -r r mode fr; do
		[ "$mode" = escluso ] && continue
		write_config "$1" "$r" "$mode" "$fr" "$RUN/camilladsp-$r.yml" || exit 1
	done || return 1
	unset PREP_GUADAGNO PREP_YAML_SX PREP_YAML_DX PREP_NOMI_SX PREP_NOMI_DX
	printf '%s\n' "$plan" > "$RUN/correzione.frequenze"
	# Configurazione di partenza dell'istanza: quella della prima frequenza.
	cp "$RUN/camilladsp-$first.yml" "$DSP_YML.nuovo" && mv "$DSP_YML.nuovo" "$DSP_YML" || return 1
	write_asound "$1" "$rates" || return 1
	if fir_in_use; then
		warn=$(printf '%s\n' "$plan" | plan_warning)
		if [ -n "$warn" ]; then
			echo "$warn" > "$RUN/correzione.avviso"
			log "correzione: $warn"
		fi
	fi
	dsp_state_prepare
	if [ -x "$CAMILLADSP" ]; then
		for r in $rates; do
			"$CAMILLADSP" -c "$RUN/camilladsp-$r.yml" > "$RUN/camilladsp.verifica" 2>&1 && continue
			fail_reason "configurazione a $r Hz rifiutata da CamillaDSP: $(tail -n 1 "$RUN/camilladsp.verifica")"
			return 1
		done
	fi
	echo "$DSP_PCM"
}

# Argomenti con cui il player avvia l'unica istanza di CamillaDSP della
# sessione (stdin dalla pipe $DSP_FIFO): registro, websocket solo locale,
# volume di partenza e configurazione della prima frequenza offerta.
do_start_args() {
	local gain=-30.0 mute=1 first
	[ -s "$DSP_VOLUME" ] && read -r gain mute < "$DSP_VOLUME"
	case "$gain" in -[0-9]*|0|0.0) ;; *) gain=-30.0; mute=1 ;; esac
	first=$(awk '$2 != "escluso" { print $1; exit }' "$RUN/correzione.frequenze" 2>/dev/null)
	[ -n "$first" ] || return 1
	printf -- '-l warn -o /var/log/camilladsp.log -p %s -a 127.0.0.1 -g%s' "$DSP_PORTA" "$gain"
	[ "$mute" = 1 ] && printf ' -m'
	printf ' %s\n' "$RUN/camilladsp-$first.yml"
}

# --- Salvataggio -------------------------------------------------------------------

# Sulla chiavetta i filtri stanno in una cartella propria, leggibile anche
# dal computer: correzione-ambientale/sinistro.txt e destro.txt, e gli
# impulsi FIR di tutte le frequenze (copiati dal computer).
STICK_DSP_DIR=correzione-ambientale

filters_source() {
	if [ -d "$1" ]; then printf '%s\n' "$1"
	elif [ -d "$1.vecchio" ]; then printf '%s\n' "$1.vecchio"
	else return 1
	fi
}

saved_filter_files() { # cartella
	printf '%s\n' "$1/sinistro.txt" "$1/destro.txt"
	fir_list "$1"
}

ram_filter_permissions() {
	local f owner
	owner="$(id -u):$(id -g)"
	chown "$owner" "$1" && chmod 755 "$1" || return 1
	while IFS= read -r f; do
		[ -f "$f" ] && [ ! -L "$f" ] || continue
		chown "$owner" "$f" && chmod 644 "$f" || return 1
	done <<EOF
$(saved_filter_files "$1")
EOF
	return 0
}

# La vecchia generazione resta recuperabile anche fra le due rinomine.
publish_filters() { # nuova destinazione
	local new=$1 dst=$2
	if [ ! -d "$dst" ] && [ -d "$dst.vecchio" ]; then
		mv "$dst.vecchio" "$dst" || return 1
	fi
	rm -rf "$dst.vecchio" || return 1
	if [ -d "$dst" ]; then
		mv "$dst" "$dst.vecchio" || return 1
	fi
	if ! mv "$new" "$dst"; then
		if [ -d "$dst.vecchio" ]; then
			mv "$dst.vecchio" "$dst" ||
				log "correzione: recupero non riuscito, filtri precedenti in $dst.vecchio"
		fi
		return 1
	fi
}

do_restore() (
	local src tmp f
	src=$(filters_source "$1") || return 0
	exec 8> "$RUN/correzione.lock" || return 1
	flock -n 8 || { log "correzione: ripristino rimandato, salvataggio in corso"; return 1; }
	tmp=$(mktemp -d "$RUN/correzione.ripristino.XXXXXX") || return 1
	trap 'rm -rf "$tmp"' EXIT
	while IFS= read -r f; do
		[ -f "$f" ] || continue
		cp "$f" "$tmp/${f##*/}" || { log "correzione: ripristino di ${f##*/} non riuscito"; return 1; }
	done <<EOF
$(saved_filter_files "$src")
EOF
	ram_filter_permissions "$tmp" && publish_filters "$tmp" "$DSP_DIR" ||
		{ log "correzione: ripristino non riuscito"; return 1; }
	rm -rf "$DSP_DIR.vecchio"
	[ "$src" = "$1" ] || log "correzione: recuperata la generazione precedente"
	return 0
)

do_save() ( # file_sinistro file_destro
	local side src tmp current dst disk_tmp="" mounted=0
	exec 8> "$RUN/correzione.lock" || return 1
	flock -n 8 || { log "correzione: un altro salvataggio e' in corso"; return 1; }
	tmp=$(mktemp -d "$RUN/correzione.salva.XXXXXX") || return 1
	trap 'rm -rf "$tmp"; [ -z "$disk_tmp" ] || rm -rf "$disk_tmp"; [ "$mounted" = 0 ] || stick_umount' EXIT
	mkdir "$tmp/ram" || return 1
	current=$(filters_source "$DSP_DIR")
	if [ -n "$current" ] && ! cp -a "$current/." "$tmp/ram/"; then
		log "correzione: preparazione in memoria non riuscita, filtri precedenti conservati"
		return 1
	fi
	rm -f "$tmp/ram/sinistro.txt" "$tmp/ram/destro.txt" || return 1
	for side in sinistro destro; do
		if [ "$side" = sinistro ]; then src=$1; else src=$2; fi
		if [ -n "$src" ] && { [ ! -f "$src" ] || [ ! -r "$src" ]; }; then
			log "correzione: file $side non leggibile, filtri precedenti conservati"
			return 1
		fi
		if [ -n "$src" ] && [ -s "$src" ]; then
			if ! tr -d '\r' < "$src" > "$tmp/testo" ||
				! head -c "$MAX_TEXT" "$tmp/testo" > "$tmp/ram/$side.txt"; then
				log "correzione: preparazione del $side non riuscita, filtri precedenti conservati"
				return 1
			fi
		fi
	done
	if ! ram_filter_permissions "$tmp/ram" || ! publish_filters "$tmp/ram" "$DSP_DIR"; then
		log "correzione: salvataggio in memoria non riuscito, filtri precedenti conservati"
		return 1
	fi
	rm -rf "$DSP_DIR.vecchio"
	if ! stick_mount rw; then
		log "correzione: chiavetta non disponibile, filtri salvati solo in memoria"
		return 2
	fi
	mounted=1
	dst="$STICK_MNT/$STICK_DSP_DIR"
	disk_tmp=$(mktemp -d "$STICK_MNT/.correzione.nuova.XXXXXX") ||
		{ log "correzione: chiavetta non scrivibile, filtri salvati solo in memoria"; return 2; }
	current=$(filters_source "$dst")
	if [ -n "$current" ] && ! cp -a "$current/." "$disk_tmp/"; then
		log "correzione: copia sulla chiavetta non riuscita, generazione precedente conservata"
		return 2
	fi
	rm -f "$disk_tmp/sinistro.txt" "$disk_tmp/destro.txt" || return 2
	for side in sinistro destro; do
		[ -f "$DSP_DIR/$side.txt" ] || continue
		if ! cp "$DSP_DIR/$side.txt" "$disk_tmp/$side.txt" ||
			! cmp -s "$DSP_DIR/$side.txt" "$disk_tmp/$side.txt"; then
			log "correzione: scrittura del $side non riuscita, generazione precedente conservata"
			return 2
		fi
	done
	if ! sync || ! publish_filters "$disk_tmp" "$dst" || ! sync; then
		log "correzione: pubblicazione non riuscita, filtri precedenti conservati nella generazione di recupero"
		return 2
	fi
	log "correzione: filtri salvati sulla chiavetta"
	return 0
)

[ "${SWEETSPOT_TEST:-}" = 1 ] && return 0

case "$1" in
	leggi) parse_rew "$2" ;;
	attiva) active ;;
	correzione) correction_active ;;
	richiesta) correction_requested ;;
	problema) correction_problem; exit 0 ;;
	fir)
		# Primo FIR (frequenza piu' bassa):
		# "FREQUENZA CANALI DESTRO(proprio|sinistro) MARGINE_DB"
		fir_ok || exit 1
		r=$(fir_rates | head -n 1)
		f=$(fir_side_file "$r" sinistro)
		d=sinistro
		[ "$(fir_side_file "$r" destro)" != "$f" ] && d=proprio
		echo "$(wav_info "$f") $d $(fir_margin)" ;;
	fir-frequenze) fir_ok && fir_rates ;;
	frequenze) cat "$RUN/correzione.frequenze" 2>/dev/null ;;
	avvio) do_start_args ;;
	volume) volume_dsp ;;
	stato) dsp_state_write "$2" "$3" ;;
	guadagno) do_gain ;;
	risposta) do_response ;;
	prepara) do_prepare "$2" ;;
	salva) do_save "$2" "$3" ;;
	ripristina) do_restore "$2" ;;
	*) echo "uso: $0 leggi FILE|attiva|guadagno|risposta|prepara SCHEDA|salva SX DX|ripristina DIR|fir-frequenze|frequenze|avvio" >&2; exit 1 ;;
esac
