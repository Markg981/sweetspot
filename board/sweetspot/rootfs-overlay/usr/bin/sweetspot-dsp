#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Sweetspot - correzione ambientale con i filtri misurati con REW.
#
#   sweetspot-dsp leggi FILE        filtri di un'esportazione di REW, uno per
#                                   riga: "TIPO FREQ GUADAGNO PARAMETRO VALORE";
#                                   errori come "errore|riga|messaggio"
#   sweetspot-dsp attiva            esce con 0 se CamillaDSP va usato (per la
#                                   correzione o per il volume a 64 bit)
#   sweetspot-dsp correzione        esce con 0 se la correzione va usata
#                                   (CORREZIONE=si o confronto, filtri validi)
#   sweetspot-dsp volume            esce con 0 con VOLUME=dsp (modalita' completa)
#   sweetspot-dsp stato DB [muto]   volume di partenza dei prossimi processi
#   sweetspot-dsp guadagno          margine conservativo in dB dei filtri
#   sweetspot-dsp risposta          curva della correzione: "Hz sinistro destro"
#   sweetspot-dsp prepara SCHEDA    scrive la configurazione di CamillaDSP e il
#                                   dispositivo ALSA "sweetspot_correzione"
#   sweetspot-dsp salva SX DX       conserva i filtri (file di testo di REW)
#                                   sulla chiavetta e in memoria
#
# Come funziona: squeezelite suona sul dispositivo ALSA sweetspot_correzione
# (plugin cdsp). A ogni brano il plugin avvia CamillaDSP con la frequenza, il
# formato e i canali del brano; CamillaDSP applica i filtri in virgola mobile
# a 64 bit e suona sul DAC con il formato migliore che accetta. Con la
# correzione spenta niente di tutto questo e' in mezzo: il percorso resta
# bit-perfect.
#
# Filtri: l'esportazione "Filter settings as text" dell'equalizzatore
# "Generic" di REW (PK, LS/HS, LSC/HSC, HP/LP, HPQ/LPQ, NO, BP, AP), uno per
# il diffusore sinistro e uno per il destro (se manca, il destro usa il
# sinistro). Sono indipendenti dalla frequenza di campionamento: valgono per
# tutti i brani. Sulla chiavetta stanno nella cartella correzione-ambientale.

. "${SWEETSPOT_LIB:-/usr/lib/sweetspot}/common.sh"

DSP_DIR=$RUN/correzione
DSP_YML=$RUN/camilladsp.yml
DSP_VOLUME=$RUN/camilladsp.volume
ASOUND=${SWEETSPOT_ASOUND:-/etc/asound.conf}
CAMILLADSP=${SWEETSPOT_CAMILLADSP:-/usr/bin/camilladsp}
DSP_PCM=sweetspot_correzione
MAX_TEXT=20000

# --- Lettura dei filtri di REW --------------------------------------------------

parse_rew() { # file
	tr -d '\r' < "$1" | head -c "$MAX_TEXT" | awk '
	function num(s) { gsub(/,/, ".", s); return s + 0 }
	function isnum(s) { gsub(/,/, ".", s); return s ~ /^[-+]?[0-9]*\.?[0-9]+$/ }
	function bad(msg) { printf "errore|%d|%s\n", NR, msg; errors++ }
	/^[ \t]*Filter[ \t]+[0-9]+[ \t]*:/ {
		sub(/^[ \t]*Filter[ \t]+[0-9]+[ \t]*:[ \t]*/, "")
		n = split($0, t, /[ \t]+/)
		if (t[1] != "ON") next
		type = ""; i = 2
		while (i <= n && t[i] != "Fc") { type = type (type == "" ? "" : " ") t[i]; i++ }
		if (type == "" || type == "None") next
		fc = ""; gain = ""; q = ""; bw = ""
		for (; i <= n; i++) {
			if (t[i] == "Fc" && isnum(t[i + 1])) { fc = num(t[i + 1]); if (t[i + 2] == "kHz") fc *= 1000 }
			else if (t[i] == "Gain" && isnum(t[i + 1])) gain = num(t[i + 1])
			else if (t[i] == "Q" && isnum(t[i + 1])) q = num(t[i + 1])
			else if (t[i] == "BW" && t[i + 1] == "Oct" && isnum(t[i + 2])) bw = num(t[i + 2])
		}
		if (fc == "") { bad("frequenza mancante"); next }
		if (fc < 5 || fc > 20000) { bad("frequenza " fc " Hz fuori dai limiti (5-20000 Hz)"); next }
		if (gain != "" && (gain < -30 || gain > 20)) { bad("guadagno " gain " dB fuori dai limiti (-30/+20 dB)"); next }
		if (q != "" && (q < 0.05 || q > 50)) { bad("Q " q " fuori dai limiti (0,05-50)"); next }
		if (bw != "" && (bw < 0.01 || bw > 8)) { bad("larghezza " bw " ottave fuori dai limiti"); next }
		if (type == "PK" || type == "PEQ") {
			if (gain == "") { bad("guadagno mancante"); next }
			if (q != "") print "Peaking", fc, gain, "q", q
			else if (bw != "") print "Peaking", fc, gain, "bandwidth", bw
			else bad("Q mancante")
		} else if (type == "LS" || type == "LS 12dB" || type == "HS" || type == "HS 12dB") {
			if (gain == "") { bad("guadagno mancante"); next }
			print (substr(type, 1, 1) == "L" ? "Lowshelf" : "Highshelf"), fc, gain, "slope", 12
		} else if (type == "LS 6dB" || type == "HS 6dB") {
			if (gain == "") { bad("guadagno mancante"); next }
			print (substr(type, 1, 1) == "L" ? "LowshelfFO" : "HighshelfFO"), fc, gain, "none", 0
		} else if (type == "LSC" || type == "HSC" || type == "LSQ" || type == "HSQ") {
			if (gain == "") { bad("guadagno mancante"); next }
			print (substr(type, 1, 1) == "L" ? "Lowshelf" : "Highshelf"), fc, gain, "q", (q == "" ? 0.7071 : q)
		} else if (type == "HP" || type == "LP" || type == "HPQ" || type == "LPQ") {
			print (substr(type, 1, 1) == "H" ? "Highpass" : "Lowpass"), fc, 0, "q", (q == "" ? 0.7071 : q)
		} else if (type == "HP1" || type == "LP1" || type == "HP 6dB" || type == "LP 6dB") {
			print (substr(type, 1, 1) == "H" ? "HighpassFO" : "LowpassFO"), fc, 0, "none", 0
		} else if (type == "NO") {
			print "Notch", fc, 0, "q", (q == "" ? 30 : q)
		} else if (type == "BP") {
			print "Bandpass", fc, 0, "q", (q == "" ? 0.7071 : q)
		} else if (type == "AP") {
			print "Allpass", fc, 0, "q", (q == "" ? 0.7071 : q)
		} else {
			bad("tipo di filtro " type " non supportato (usa l'\''equalizzatore Generic di REW)")
		}
		count++
		if (count > 60) { bad("troppi filtri (al massimo 60 per canale)"); exit }
	}
	END { exit errors > 0 }'
}

# Filtri validi di un canale (sinistro|destro) in memoria; il destro senza
# file usa quelli del sinistro.
channel_filters() {
	local f=$DSP_DIR/$1.txt
	[ "$1" = destro ] && [ ! -s "$f" ] && f=$DSP_DIR/sinistro.txt
	[ -s "$f" ] || return 0
	parse_rew "$f" 2>/dev/null | grep -v '^errore|'
}

filters_ok() {
	[ -s "$DSP_DIR/sinistro.txt" ] || return 1
	parse_rew "$DSP_DIR/sinistro.txt" > /dev/null || return 1
	[ ! -s "$DSP_DIR/destro.txt" ] || parse_rew "$DSP_DIR/destro.txt" > /dev/null
}

# CORREZIONE: no (spenta: percorso bit-perfect), si, confronto (CamillaDSP
# con la sola attenuazione, per confrontare a pari volume).
dsp_mode() {
	case "$(lower "$(conf CORREZIONE no)")" in
		si|yes|1) echo si ;;
		confronto) echo confronto ;;
		*) echo no ;;
	esac
}

correction_active() {
	[ "$(dsp_mode)" != no ] && { filters_ok || fir_ok; }
}

# --- Filtri FIR (convoluzione) ------------------------------------------------
#
# Impulsi WAV esportati da rePhase, Acourate o REW, nella cartella della
# correzione: fir-sinistro.wav e, facoltativo, fir-destro.wav (senza, il
# destro usa il sinistro; un file stereo da solo vale per i due canali).
# CamillaDSP lavora alla frequenza dei file: ogni brano viene ricampionato
# (Synchronous) a quella frequenza, salvo che sia gia' la stessa.
# Attenuazione in piu' per i FIR: FIR_MARGINE_DB (predefinito 3 dB).
FIR_MAX_KB=16384

# "FREQUENZA CANALI" di un WAV (intestazione standard: fmt subito dopo RIFF).
wav_info() { # file
	local ch rate
	[ -s "$1" ] || return 1
	[ "$(head -c 4 "$1")" = RIFF ] || return 1
	[ "$(dd if="$1" bs=1 skip=8 count=8 2>/dev/null)" = "WAVEfmt " ] || return 1
	ch=$(od -An -tu2 -j22 -N2 "$1" | tr -d ' ')
	rate=$(od -An -tu4 -j24 -N4 "$1" | tr -d ' ')
	[ "${ch:-0}" -ge 1 ] && [ "${ch:-0}" -le 2 ] && [ "${rate:-0}" -ge 8000 ] || return 1
	echo "$rate $ch"
}

# File FIR di un canale (il destro ricade sul sinistro).
fir_file() { # sinistro|destro
	local f=$DSP_DIR/fir-$1.wav
	[ "$1" = destro ] && [ ! -s "$f" ] && f=$DSP_DIR/fir-sinistro.wav
	echo "$f"
}

# Canale del file da usare: 1 solo per il destro letto da un file stereo unico.
fir_channel() { # sinistro|destro
	local info
	[ "$1" = destro ] || { echo 0; return; }
	[ -s "$DSP_DIR/fir-destro.wav" ] && { echo 0; return; }
	info=$(wav_info "$DSP_DIR/fir-sinistro.wav")
	if [ "${info#* }" = 2 ]; then echo 1; else echo 0; fi
}

fir_rate() { wav_info "$DSP_DIR/fir-sinistro.wav" | cut -d' ' -f1; }

fir_ok() {
	local l r f
	for f in "$DSP_DIR/fir-sinistro.wav" "$DSP_DIR/fir-destro.wav"; do
		[ -s "$f" ] || continue
		[ "$(( $(wc -c < "$f") / 1024 ))" -le "$FIR_MAX_KB" ] || return 1
	done
	l=$(wav_info "$DSP_DIR/fir-sinistro.wav") || return 1
	[ -s "$DSP_DIR/fir-destro.wav" ] || return 0
	r=$(wav_info "$DSP_DIR/fir-destro.wav") || return 1
	# Stessa frequenza per i due canali.
	[ "${l% *}" = "${r% *}" ]
}

fir_margin() {
	local m
	m=$(conf FIR_MARGINE_DB 3)
	case "$m" in ''|*[!0-9.]*) m=3 ;; esac
	echo "$m"
}

# FIR in uso: correzione attiva e file validi (anche nel confronto a pari
# volume: stessa frequenza e stessa attenuazione, senza i filtri).
fir_in_use() { correction_active && fir_ok; }

# VOLUME=dsp: il volume di Lyrion lo applica CamillaDSP a 64 bit, con il
# dither all'uscita, invece del troncamento di Squeezelite. Solo nella
# modalita' completa: il player deve poter fissare Squeezelite al 100%.
volume_dsp() {
	[ "$(lower "$(conf VOLUME fisso)")" = dsp ] && [ "$(mode)" = completa ]
}

# CamillaDSP serve per la correzione, per il volume o per entrambi.
active() {
	correction_active || volume_dsp
}

# Volume di partenza "GUADAGNO_DB SORDINA(0|1)": il plugin cdsp lo legge
# (vol_file) a ogni avvio di CamillaDSP e lo passa con -g/-m, quindi ogni
# brano parte gia' al volume giusto. Se il file manca o non e' valido il
# plugin non avvia CamillaDSP: silenzio, mai il volume massimo. Lo aggiorna
# sweetspot-volume; si scrive sempre con un rename (mai a meta').
dsp_state_write() { # dB [muto]
	local mute=0
	[ "${2:-}" = muto ] && mute=1
	case "$1" in -[0-9]*|0|0.0) ;; *) return 1 ;; esac
	echo "$1 $mute" > "$DSP_VOLUME.nuovo" && mv "$DSP_VOLUME.nuovo" "$DSP_VOLUME"
}

# Senza il volume a 64 bit il volume principale resta a 0 dB (solo la
# correzione); con il volume si parte da -30 dB finche' Lyrion non dice il
# suo, e un valore gia' scritto (anche 0.0, cioe' il cursore al 100%) resta.
dsp_state_prepare() {
	if ! volume_dsp; then
		dsp_state_write 0.0
	elif ! grep -qE '^-?[0-9]+(\.[0-9]+)? [01]$' "$DSP_VOLUME" 2>/dev/null; then
		dsp_state_write -30.0
	fi
}

# --- Risposta in frequenza (formule di R. Bristow-Johnson) -------------------------

# Modulo in dB della catena di filtri letta da stdin, sulle frequenze di
# "Hz" (una per riga in $1), a 48 kHz.
RESPONSE_AWK='
function biquad(type, f0, g, p, v, w,    A, w0, cw, sw, al, b0, b1, b2, a0, a1, a2, sa, nr, ni, dr, di) {
	A = exp(g / 40 * log(10)); w0 = 2 * pi * f0 / fs; cw = cos(w0); sw = sin(w0)
	if (p == "q") al = sw / (2 * v)
	else if (p == "bandwidth") al = sw * sinh(log(2) / 2 * v * w0 / sw)
	else if (p == "slope") al = sw / 2 * sqrt((A + 1 / A) * (12 / v - 1) + 2)
	if (type == "Peaking") { b0 = 1 + al * A; b1 = -2 * cw; b2 = 1 - al * A; a0 = 1 + al / A; a1 = -2 * cw; a2 = 1 - al / A }
	else if (type == "Lowshelf") { sa = 2 * sqrt(A) * al
		b0 = A * ((A + 1) - (A - 1) * cw + sa); b1 = 2 * A * ((A - 1) - (A + 1) * cw); b2 = A * ((A + 1) - (A - 1) * cw - sa)
		a0 = (A + 1) + (A - 1) * cw + sa; a1 = -2 * ((A - 1) + (A + 1) * cw); a2 = (A + 1) + (A - 1) * cw - sa }
	else if (type == "Highshelf") { sa = 2 * sqrt(A) * al
		b0 = A * ((A + 1) + (A - 1) * cw + sa); b1 = -2 * A * ((A - 1) + (A + 1) * cw); b2 = A * ((A + 1) + (A - 1) * cw - sa)
		a0 = (A + 1) - (A - 1) * cw + sa; a1 = 2 * ((A - 1) - (A + 1) * cw); a2 = (A + 1) - (A - 1) * cw - sa }
	else if (type == "Lowpass") { b0 = (1 - cw) / 2; b1 = 1 - cw; b2 = (1 - cw) / 2; a0 = 1 + al; a1 = -2 * cw; a2 = 1 - al }
	else if (type == "Highpass") { b0 = (1 + cw) / 2; b1 = -(1 + cw); b2 = (1 + cw) / 2; a0 = 1 + al; a1 = -2 * cw; a2 = 1 - al }
	else if (type == "Notch") { b0 = 1; b1 = -2 * cw; b2 = 1; a0 = 1 + al; a1 = -2 * cw; a2 = 1 - al }
	else if (type == "Bandpass") { b0 = al; b1 = 0; b2 = -al; a0 = 1 + al; a1 = -2 * cw; a2 = 1 - al }
	else return 0
	nr = b0 + b1 * cos(w) + b2 * cos(2 * w); ni = -(b1 * sin(w) + b2 * sin(2 * w))
	dr = a0 + a1 * cos(w) + a2 * cos(2 * w); di = -(a1 * sin(w) + a2 * sin(2 * w))
	return 10 * log((nr * nr + ni * ni) / (dr * dr + di * di)) / log(10)
}
function sinh(x) { return (exp(x) - exp(-x)) / 2 }
function first_order(type, f0, g, f,    A2, r) {
	A2 = exp(g / 10 * log(10)); r = (f / f0) * (f / f0)
	if (type == "LowshelfFO") return 10 * log((r + A2) / (r + 1)) / log(10)
	if (type == "HighshelfFO") return 10 * log((A2 * r + 1) / (r + 1)) / log(10)
	if (type == "LowpassFO") return 10 * log(1 / (1 + r)) / log(10)
	if (type == "HighpassFO") return 10 * log(r / (1 + r)) / log(10)
	return 0
}
BEGIN { pi = atan2(0, -1); fs = 48000 }
FNR == NR { hz[++nf] = $1; next }
{ n++; type[n] = $1; f0[n] = $2; g[n] = $3; p[n] = $4; v[n] = $5 }
END {
	for (i = 1; i <= nf; i++) {
		db = 0; w = 2 * pi * hz[i] / fs
		for (k = 1; k <= n; k++) {
			if (type[k] ~ /FO$/) db += first_order(type[k], f0[k], g[k], hz[i])
			else if (type[k] != "Allpass") db += biquad(type[k], f0[k], g[k], p[k], v[k], w)
		}
		printf "%s %.2f\n", hz[i], db
	}
}'

# Frequenze in scala logaritmica da 20 Hz a 20 kHz.
freq_grid() {
	$AWK 'BEGIN { for (i = 0; i <= 150; i++) printf "%.1f\n", 20 * exp(i / 150 * log(1000)) }'
}

do_response() {
	local g
	g=$RUN/correzione.griglia
	mkdir -p "$RUN"
	freq_grid > "$g"
	channel_filters sinistro | $AWK "$RESPONSE_AWK" "$g" - > "$g.sx"
	channel_filters destro | $AWK "$RESPONSE_AWK" "$g" - > "$g.dx"
	# "Hz sinistro destro"
	awk 'FNR == NR { dx[$1] = $2; next } { print $1, $2, dx[$1] }' "$g.dx" "$g.sx"
	rm -f "$g" "$g.sx" "$g.dx"
}

# Massimo analitico di ogni filtro sull'intero spettro: la somma dei massimi
# positivi e' un limite superiore della catena, anche per picchi molto stretti.
# La trasformazione bilineare copre tutto lo spettro: il limite non dipende
# dalla griglia a 48 kHz usata solo per disegnare la curva.
channel_gain_bound() {
	channel_filters "$1" | $AWK '
	function ratio(y, n2,n1,n0,d2,d1,d0) {
		return (n2*y*y+n1*y+n0)/(d2*y*y+d1*y+d0)
	}
	function maximum(n2,n1,n0,d2,d1,d0,    m,c2,c1,c0,disc,y,r,j) {
		m=n0/d0; r=n2/d2; if (r>m) m=r
		c2=n2*d1-n1*d2; c1=2*(n2*d0-n0*d2); c0=n1*d0-n0*d1
		if (c2==0) {
			if (c1==0) return m
			y=-c0/c1
			if (y>=0) { r=ratio(y,n2,n1,n0,d2,d1,d0); if(r>m)m=r }
		} else {
			disc=c1*c1-4*c2*c0
			if (disc>=0) for(j=-1;j<=1;j+=2) {
				y=(-c1+j*sqrt(disc))/(2*c2)
				if (y>=0) { r=ratio(y,n2,n1,n0,d2,d1,d0); if(r>m)m=r }
			}
		}
		return m
	}
	{
		peak=0
		if ($1=="Peaking" || $1 ~ /shelfFO$/) peak=$3
		else if ($1=="Lowpass" || $1=="Highpass") {
			q=$5
			if(q>sqrt(0.5)) peak=20*log(q/sqrt(1-1/(4*q*q)))/log(10)
		} else if ($1=="Lowshelf" || $1=="Highshelf") {
			A=exp($3/40*log(10))
			q=($4=="q" ? $5 : 1/sqrt((A+1/A)*(12/$5-1)+2))
			b=A*(1/(q*q)-2)
			# Shelf alto e basso hanno lo stesso massimo (y -> 1/y).
			peak=10*log(A*A*maximum(1,b,A*A,A*A,b,1))/log(10)
		}
		if(peak>0) sum+=peak
	}
	END { printf "%.9f\n", sum }'
}

# Mezzo dB di margine, arrotondato verso maggiore attenuazione; identico sui
# canali e in modalita' confronto. E' un limite in frequenza, non una garanzia
# contro ogni overshoot nel tempo: verifica i contatori clipping di CamillaDSP.
do_gain() {
	{ channel_gain_bound sinistro; channel_gain_bound destro; } | awk '
		$1 > m { m=$1 }
		END { if (m>0) printf "%.1f\n", -int((m+0.5)*10+0.999999)/10; else print "0.0" }'
}

# --- Configurazione di CamillaDSP e del dispositivo ALSA ---------------------------

# Formato di uscita verso il DAC, il migliore che accetta (nomi di CamillaDSP).
dsp_out_format() {
	local f
	f=" $(dac_formats "$1" 2) "
	case "$f" in
		*" S32_LE "*) echo S32_LE ;;
		*" S24_3LE "*) echo S24_3_LE ;;
		*" S24_LE "*) echo S24_4_RJ_LE ;;
		*" S16_LE "*) echo S16_LE ;;
		*) return 1 ;;
	esac
}

# Filtri attivi: nessuno nel confronto a pari volume o con il solo volume.
active_filters() {
	correction_active || return 0
	[ "$(dsp_mode)" = confronto ] && return 0
	channel_filters "$1"
}

write_filters_yaml() { # prefisso canale
	active_filters "$2" | awk -v pre="$1" '
		{ n++
		  printf "  %s_%d:\n    type: Biquad\n    parameters:\n      type: %s\n      freq: %s\n", pre, n, $1, $2
		  if ($1 ~ /shelf|Peaking/) printf "      gain: %s\n", $3
		  if ($4 != "none") printf "      %s: %s\n", $4, $5 }'
}

filter_names() { # prefisso canale
	active_filters "$2" | awk -v pre="$1" '{ printf "      - %s_%d\n", pre, NR }'
}

write_config() { # scheda
	local card=$1 id dev fmt gain=0.0 ch pre side bits fir="" rate=44100 alsafmt
	id=$(dac_id "$card")
	dev=$(dac_playback_dev "$card") || return 1
	fmt=$(dsp_out_format "$card") || { log "correzione: formato PCM del playback non disponibile"; return 1; }
	correction_active && gain=$(do_gain)
	# Con i FIR CamillaDSP lavora (e suona sul DAC) alla frequenza dei file.
	if fir_in_use; then
		fir=1
		rate=$(fir_rate)
		case "$fmt" in S24_3_LE) alsafmt=S24_3LE ;; S24_4_RJ_LE) alsafmt=S24_LE ;; *) alsafmt=$fmt ;; esac
		if ! printf ' %s ' "$(dac_rates "$card" "$alsafmt" 2 | tr '\n' ' ')" | grep -q " $rate "; then
			log "correzione: il DAC non accetta $rate Hz, la frequenza dei filtri FIR"
			return 1
		fi
		gain=$(awk -v g="$gain" -v m="$(fir_margin)" 'BEGIN { printf "%.1f", g - m }')
	fi
	# Dither TPDF alla risoluzione dell'uscita: CamillaDSP modifica sempre i
	# campioni (attenuazione, filtri o volume), quindi il passaggio da 64 bit
	# all'uscita va fatto con il dither e non con il troncamento: a 16 bit con
	# il DAC a 16 bit, a 24 bit negli altri casi (i DAC "a 32 bit" ne
	# convertono al piu' 24 in modo lineare).
	if [ "$fmt" = S16_LE ]; then
		bits=16
	else
		bits=24
	fi
	{
		echo "---"
		echo "# Generato da Sweetspot (sweetspot-dsp): non modificare."
		echo "# Frequenza, formato e canali in ingresso li passa il plugin cdsp."
		echo "devices:"
		echo "  samplerate: $rate"
		echo "  chunksize: 4096"
		if [ -n "$fir" ]; then
			# La frequenza del brano (dal plugin) diventa quella d'ingresso; se
			# coincide con quella dei FIR il ricampionatore si spegne da solo.
			echo "  resampler:"
			echo "    type: Synchronous"
		fi
		echo "  queuelimit: 1"
		# Il volume non supera mai 0 dB, qualunque comando arrivi.
		echo "  volume_limit: 0.0"
		echo "  capture:"
		echo "    type: Stdin"
		echo "    channels: 2"
		echo "    format: S32_LE"
		echo "  playback:"
		echo "    type: Alsa"
		echo "    channels: 2"
		echo "    device: \"hw:CARD=$id,DEV=$dev\""
		echo "    format: $fmt"
		echo "filters:"
		echo "  attenuazione:"
		echo "    type: Gain"
		echo "    parameters:"
		echo "      gain: $gain"
		write_filters_yaml sx sinistro
		write_filters_yaml dx destro
		if [ -n "$fir" ]; then
			for side in sinistro destro; do
				echo "  fir_$side:"
				echo "    type: Conv"
				echo "    parameters:"
				echo "      type: Wav"
				echo "      filename: \"$(fir_file "$side")\""
				echo "      channel: $(fir_channel "$side")"
			done
		fi
		echo "  dither:"
		echo "    type: Dither"
		echo "    parameters:"
		echo "      type: Flat"
		echo "      bits: $bits"
		echo "      amplitude: 2.0"
		echo "pipeline:"
		for ch in 0 1; do
			if [ $ch = 0 ]; then pre=sx; side=sinistro; else pre=dx; side=destro; fi
			echo "  - type: Filter"
			echo "    channels: [$ch]"
			echo "    names:"
			echo "      - attenuazione"
			filter_names "$pre" "$side"
			[ -n "$fir" ] && [ "$(dsp_mode)" = si ] && echo "      - fir_$side"
			echo "      - dither"
		done
	} > "$DSP_YML.nuovo" && mv "$DSP_YML.nuovo" "$DSP_YML"
}

# Frequenze offerte a squeezelite: quelle del DAC fino a 384 kHz.
dsp_rates() {
	local r fmt out=""
	fmt=$(dsp_out_format "$1") || return 1
	case "$fmt" in S24_3_LE) fmt=S24_3LE ;; S24_4_RJ_LE) fmt=S24_LE ;; esac
	for r in $(dac_rates "$1" "$fmt" 2); do
		case "$r" in 44100|48000|88200|96000|176400|192000|352800|384000) out="$out $r" ;; esac
	done
	[ -n "$out" ] || return 1
	printf '%s' "${out# }"
}

write_asound() { # scheda
	local rates
	rates=$(dsp_rates "$1") || { log "correzione: frequenze PCM del playback non disponibili"; return 1; }
	{
		echo "# Generato da Sweetspot (sweetspot-dsp): correzione ambientale."
		echo "pcm.$DSP_PCM {"
		echo "	type cdsp"
		echo "	cpath \"$CAMILLADSP\""
		echo "	config_out \"$DSP_YML\""
		echo "	config_cdsp 1"
		echo "	channels 2"
		echo "	rates = [ $rates ]"
		# Websocket solo locale: il player ne legge i campioni tagliati.
		echo "	cargs [ -l \"warn\" -o \"/var/log/camilladsp.log\" -p \"$DSP_PORTA\" -a \"127.0.0.1\" ]"
		echo "	vol_file \"$DSP_VOLUME\""
		echo "}"
	} > "$ASOUND.nuovo" && mv "$ASOUND.nuovo" "$ASOUND"
}

do_prepare() { # scheda
	active || return 1
	mkdir -p "$RUN"
	write_config "$1" && write_asound "$1" || return 1
	dsp_state_prepare
	if [ -x "$CAMILLADSP" ] && ! "$CAMILLADSP" -c "$DSP_YML" > "$RUN/camilladsp.verifica" 2>&1; then
		log "correzione: configurazione rifiutata da CamillaDSP: $(tail -n 1 "$RUN/camilladsp.verifica")"
		return 1
	fi
	echo "$DSP_PCM"
}

# --- Salvataggio -------------------------------------------------------------------

# Sulla chiavetta i filtri stanno in una cartella propria, leggibile anche
# dal computer: correzione-ambientale/sinistro.txt e destro.txt, e gli
# impulsi FIR fir-sinistro.wav e fir-destro.wav (copiati dal computer).
STICK_DSP_DIR=correzione-ambientale

do_save() { # file_sinistro file_destro
	local side src tmp
	mkdir -p "$DSP_DIR"
	tmp=$DSP_DIR/.salva
	rm -rf "$tmp"
	mkdir -p "$tmp"
	for side in sinistro destro; do
		if [ "$side" = sinistro ]; then src=$1; else src=$2; fi
		if [ -n "$src" ] && [ -s "$src" ]; then
			tr -d '\r' < "$src" | head -c "$MAX_TEXT" > "$tmp/$side.txt"
		fi
	done
	rm -f "$DSP_DIR/sinistro.txt" "$DSP_DIR/destro.txt"
	cp "$tmp"/*.txt "$DSP_DIR/" 2>/dev/null
	rm -rf "$tmp"
	if stick_mount rw; then
		# Solo i filtri di REW: gli impulsi FIR (fir-*.wav) restano.
		mkdir -p "$STICK_MNT/$STICK_DSP_DIR"
		rm -f "$STICK_MNT/$STICK_DSP_DIR/sinistro.txt" "$STICK_MNT/$STICK_DSP_DIR/destro.txt"
		cp "$DSP_DIR"/sinistro.txt "$DSP_DIR"/destro.txt "$STICK_MNT/$STICK_DSP_DIR/" 2>/dev/null
		stick_umount
		log "correzione: filtri salvati sulla chiavetta"
		return 0
	fi
	return 2
}

[ "${SWEETSPOT_TEST:-}" = 1 ] && return 0

case "$1" in
	leggi) parse_rew "$2" ;;
	attiva) active ;;
	correzione) correction_active ;;
	fir)
		# "FREQUENZA CANALI DESTRO(proprio|sinistro) MARGINE_DB"
		fir_ok || exit 1
		d=sinistro
		[ -s "$DSP_DIR/fir-destro.wav" ] && d=proprio
		echo "$(wav_info "$DSP_DIR/fir-sinistro.wav") $d $(fir_margin)" ;;
	volume) volume_dsp ;;
	stato) dsp_state_write "$2" "$3" ;;
	guadagno) do_gain ;;
	risposta) do_response ;;
	prepara) do_prepare "$2" ;;
	salva) do_save "$2" "$3" ;;
	*) echo "uso: $0 leggi FILE|attiva|guadagno|risposta|prepara SCHEDA|salva SX DX" >&2; exit 1 ;;
esac
