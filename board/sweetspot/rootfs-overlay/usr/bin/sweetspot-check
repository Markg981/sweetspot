#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Sweetspot - verifica del sistema e del percorso del segnale.
#
#   sweetspot-check          elenco leggibile
#   sweetspot-check --dati   righe "ESITO|voce|dettaglio" per la pagina web
#
# ESITO e' OK, ATTENZIONE oppure INFO.

. "${SWEETSPOT_LIB:-/usr/lib/sweetspot}/common.sh"

SQLOG=${SWEETSPOT_SQLOG:-/var/log/squeezelite.log}
OUT=""

emit() { OUT="$OUT$1|$2|$3
"; }

check_kernel() {
	if uname -v | grep -q PREEMPT_RT; then
		emit OK "Kernel real-time" "$(uname -r), PREEMPT_RT attivo"
	else
		emit ATTENZIONE "Kernel real-time" "il kernel in uso non e' real-time"
	fi
}

check_ram_system() {
	local fs
	fs=$(awk '$2=="/" {print $3}' "$PROC/mounts" | tail -n 1)
	case "$fs" in
		rootfs|tmpfs|ramfs) emit OK "Sistema in RAM" "nessun disco usato dal sistema" ;;
		*) emit ATTENZIONE "Sistema in RAM" "radice su $fs" ;;
	esac
	if [ ! -f "$PROC/swaps" ] || [ "$(wc -l < "$PROC/swaps")" -le 1 ]; then
		emit OK "Swap" "assente"
	else
		emit ATTENZIONE "Swap" "presente"
	fi
	if grep -q " $STICK_MNT " "$PROC/mounts"; then
		emit INFO "Chiavetta" "in uso in questo momento"
	else
		emit OK "Chiavetta" "non in uso: si puo' togliere"
	fi
}

check_cpu() {
	local iso smt pol gov min max cur turbo states
	cpu_layout
	iso=$(cat "$SYS/devices/system/cpu/isolated" 2>/dev/null)
	if safe_mode; then
		emit ATTENZIONE "Ottimizzazioni" "disattivate (avvio sicuro o OTTIMIZZAZIONI=no)"
	fi
	if [ -n "$iso" ]; then
		emit OK "Core dedicati" "riproduzione sul core $LAYOUT_AUDIO, interruzioni USB sul core $LAYOUT_IRQ (isolati: $iso)"
	elif [ "$LAYOUT_CORES" -le 1 ]; then
		emit INFO "Core dedicati" "un solo core: solo priorita' real-time"
	else
		emit ATTENZIONE "Core dedicati" "nessun core isolato in questo avvio"
	fi
	smt=$(cpu_smt_state)
	case "$smt" in
		on) emit ATTENZIONE "Hyper-Threading" "attivo" ;;
		off|forceoff) emit OK "Hyper-Threading" "spento" ;;
		*) emit OK "Hyper-Threading" "non presente" ;;
	esac
	for pol in "$SYS"/devices/system/cpu/cpufreq/policy*; do
		[ -d "$pol" ] || continue
		gov=$(cat "$pol/scaling_governor" 2>/dev/null)
		min=$(cat "$pol/scaling_min_freq" 2>/dev/null)
		max=$(cat "$pol/scaling_max_freq" 2>/dev/null)
		cur=$(cat "$pol/scaling_cur_freq" 2>/dev/null)
		break
	done
	if [ -n "$min" ] && [ "$min" = "$max" ]; then
		emit OK "Frequenza CPU" "fissa a $((min / 1000)) MHz (profilo $(cut -d' ' -f1 "$RUN/cpu.stato" 2>/dev/null), governor $gov)"
	elif [ -n "$min" ]; then
		emit ATTENZIONE "Frequenza CPU" "variabile $((min / 1000))-$((max / 1000)) MHz, ora $((cur / 1000)) MHz"
	else
		emit INFO "Frequenza CPU" "non regolabile su questo computer"
	fi
	turbo=""
	[ -f "$SYS/devices/system/cpu/intel_pstate/no_turbo" ] &&
		{ [ "$(cat "$SYS/devices/system/cpu/intel_pstate/no_turbo")" = 1 ] && turbo=off || turbo=on; }
	[ -f "$SYS/devices/system/cpu/cpufreq/boost" ] &&
		{ [ "$(cat "$SYS/devices/system/cpu/cpufreq/boost")" = 0 ] && turbo=off || turbo=on; }
	case "$turbo" in
		off) emit OK "Turbo" "spento" ;;
		on) emit ATTENZIONE "Turbo" "attivo" ;;
	esac
	states=$(cat "$SYS"/devices/system/cpu/cpu0/cpuidle/state*/name 2>/dev/null | tr '\n' ' ')
	if cmdline_has intel_idle.max_cstate || cmdline_has processor.max_cstate; then
		emit OK "Stati di risparmio" "limitati a C1 (disponibili: ${states:-nessuno})"
	else
		emit ATTENZIONE "Stati di risparmio" "non limitati (${states:-nessuno})"
	fi
	if [ -f "$RUN/pmqos.pid" ] && kill -0 "$(cat "$RUN/pmqos.pid")" 2>/dev/null; then
		emit INFO "Core sempre svegli" "attivo (profilo prestazioni)"
	fi
}

check_usb() {
	local a
	a=$(cat "$SYS/module/usbcore/parameters/autosuspend" 2>/dev/null)
	if [ "$a" = "-1" ]; then
		emit OK "Risparmio energetico USB" "spento"
	else
		emit ATTENZIONE "Risparmio energetico USB" "attivo (autosuspend $a s)"
	fi
}

check_dac() {
	local card name usbid fmts rates nat bdf irqs irq aff tid policy prio cpus snapshot st dev sub fmt rate ch buffer period label severity description
	card=$(dac_find)
	if [ -z "$card" ]; then
		emit ATTENZIONE "DAC" "nessun DAC USB trovato: e' acceso e collegato?"
		return
	fi
	name=$(dac_name "$card")
	usbid=$(dac_usbid "$card")
	fmts=$(dac_formats "$card")
	rates=$(dac_rates "$card")
	if [ -n "$usbid" ]; then
		emit OK "DAC" "$name (USB $usbid)"
	else
		emit OK "DAC" "$name (scheda I2S $(conf SCHEDA_I2S))"
	fi
	[ -n "$fmts" ] && emit INFO "Formati del DAC" "$fmts"
	[ -n "$rates" ] && emit INFO "Frequenze del DAC" "$(echo "$rates" | sed 's/ /, /g') Hz"
	nat=$(dac_native_dsd "$card")
	case "$(lower "$(conf DSD auto)")" in
		auto|nativo)
			if [ -n "$nat" ]; then emit OK "DSD" "nativo ($nat)"
			else emit INFO "DSD" "il DAC non dichiara il DSD nativo: lo converte il server"; fi ;;
		dop) emit INFO "DSD" "tramite DoP" ;;
		*) emit INFO "DSD" "convertito dal server" ;;
	esac
	if [ -f "$RUN/dac.controller" ]; then
		bdf=$(cut -d' ' -f1 "$RUN/dac.controller")
		irqs=$(cut -d' ' -f2- "$RUN/dac.controller")
		for irq in $irqs; do
			# Solo i vettori in uso (gli altri non hanno un core assegnato).
			[ -n "$(cat "$PROC/irq/$irq/effective_affinity_list" 2>/dev/null)" ] || continue
			# Il core richiesto: il kernel ci sposta l'interruzione alla
			# prima attivita' USB.
			aff=$(cat "$PROC/irq/$irq/smp_affinity_list" 2>/dev/null)
			if [ "$aff" = "$LAYOUT_IRQ" ] || [ -z "$(cat "$SYS/devices/system/cpu/isolated" 2>/dev/null)" ]; then
				emit OK "Interruzioni USB del DAC" "controller $bdf, IRQ $irq sul core $aff"
			else
				emit ATTENZIONE "Interruzioni USB del DAC" "controller $bdf, IRQ $irq sul core $aff invece del $LAYOUT_IRQ"
			fi
		done
	fi
	if [ -f "$RUN/audio.tid" ]; then
		tid=$(cat "$RUN/audio.tid")
		policy=$(sed 's/.*) //' "$PROC/$tid/stat" 2>/dev/null | cut -d' ' -f39)
		prio=$(sed 's/.*) //' "$PROC/$tid/stat" 2>/dev/null | cut -d' ' -f38)
		cpus=$(sed -n 's/^Cpus_allowed_list:[[:space:]]*//p' "$PROC/$tid/status" 2>/dev/null)
		if [ "$policy" = 1 ]; then
			emit OK "Thread di riproduzione" "real-time priorita' $prio sul core $cpus"
		else
			emit ATTENZIONE "Thread di riproduzione" "non real-time"
		fi
	fi
	snapshot=$(dac_pcm_snapshot "$card")
	IFS='|' read -r dev sub st fmt rate ch buffer period <<EOF
$snapshot
EOF
	label="Uscita audio"; severity=INFO
	case "$st" in
		RUNNING) label="Uscita in corso"; severity=OK; description="riproduzione attiva" ;;
		DRAINING) description="Uscita in svuotamento: i buffer stanno terminando" ;;
		PREPARED) description="uscita preparata, riproduzione non avviata" ;;
		PAUSED) description="uscita in pausa" ;;
		OPEN|SETUP) description="uscita aperta, riproduzione non avviata" ;;
		XRUN) severity=ATTENZIONE; description="interruzione ALSA (buffer esaurito)" ;;
		SUSPENDED) severity=ATTENZIONE; description="uscita sospesa dal sistema" ;;
		DISCONNECTED) severity=ATTENZIONE; description="dispositivo scollegato" ;;
		CLOSED) description="uscita chiusa (nessuna riproduzione)" ;;
		UNAVAILABLE) severity=ATTENZIONE; description="PCM selezionato non disponibile" ;;
		AMBIGUOUS) severity=ATTENZIONE; description="piu' substream aperti: uscita non verificabile" ;;
		*) severity=ATTENZIONE; description="stato o parametri non verificabili" ;;
	esac
	if [ "$st" = RUNNING ] && [ -n "$fmt" ] && [ -n "$rate" ] && [ -n "$ch" ]; then
		emit "$severity" "$label" "DEV=$dev/sub$sub: $fmt, $rate Hz, $ch canali, $st"
	else
		emit "$severity" "$label" "DEV=$dev/sub$sub: $description ($st)"
		[ -n "$fmt" ] && [ -n "$rate" ] && [ -n "$ch" ] &&
			emit INFO "Parametri aperti" "DEV=$dev/sub$sub: $fmt, $rate Hz, $ch canali; non provano la riproduzione"
	fi
	[ -n "$buffer" ] && [ -n "$period" ] &&
		emit INFO "Buffer ALSA" "DEV=$dev/sub$sub: $buffer campioni, periodo $period"

}

check_player() {
	local pid xr recovery counts bufs state vol
	pid=$(cat "$RUN/squeezelite.pid" 2>/dev/null)
	# Il messaggio di output_alsa.c segue il prefisso del logger oppure e' nudo.
	# Confrontare il messaggio intero evita sottostringhe e doppi conteggi.
	counts=$(awk '
		{ message=$0; sub(/^\[[^]]*\][[:space:]]+[[:alnum:]_]+:[0-9]+[[:space:]]+/, "", message) }
		message == "XRUN" { events++ }
		message ~ /^XRUN recover failed: / { recovery++ }
		END { printf "%d %d", events, recovery }
	' "$SQLOG" 2>/dev/null) || counts=""
	xr=${counts% *}; recovery=${counts#* }
	state=$(cat "$RUN/player.stato" 2>/dev/null)
	if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
		emit OK "Player" "$state"
	elif [ "$state" = "in attesa del DAC" ]; then
		emit ATTENZIONE "Player" "$state: collega il DAC e accendilo"
	else
		emit ATTENZIONE "Player" "${state:-non avviato}"
	fi
	xr=${xr:-0}
	if [ ! -f "$SQLOG" ] || [ -z "$counts" ]; then
		emit INFO "XRUN ALSA registrati" "registro non disponibile"
	elif [ "$xr" = 0 ]; then
		emit INFO "XRUN ALSA registrati" "0 nel registro storico; non esclude interruzioni dello stream o del DSP e non misura il jitter del clock"
	else
		emit ATTENZIONE "XRUN ALSA registrati" "$xr nel registro storico; non misura il jitter del clock"
	fi
	if [ ! -f "$SQLOG" ] || [ -z "$counts" ]; then
		emit INFO "Recuperi XRUN falliti" "registro non disponibile"
	elif [ "${recovery:-0}" = 0 ]; then
		emit INFO "Recuperi XRUN falliti" "0 nel registro storico"
	else
		emit ATTENZIONE "Recuperi XRUN falliti" "$recovery nel registro storico"
	fi
	bufs=$(player_buffers)
	emit INFO "Memoria per i brani" "$(( ${bufs%:*} / 1024 )) MB per il file + $(( ${bufs#*:} / 1024 )) MB di campioni decodificati in anticipo"
	vol=$(lower "$(conf VOLUME fisso)")
	if [ "$(mode)" = player ]; then
		emit INFO "Volume" "per un percorso bit-perfect, in Lyrion imposta il volume del player come fisso al 100%"
	elif [ "$vol" = fisso ]; then
		emit OK "Volume" "fisso al 100%, si regola dall'amplificatore (percorso bit-perfect)"
	else
		emit INFO "Volume" "regolabile ($vol): sotto il 100% il segnale non e' piu' bit-perfect"
	fi
	if [ -n "$(conf RICAMPIONAMENTO)" ] && [ "$(lower "$(conf RICAMPIONAMENTO)")" != no ]; then
		emit INFO "Ricampionamento" "attivo ($(lower "$(conf RICAMPIONAMENTO)")): il percorso non e' bit-perfect per scelta"
	fi
	if [ -f "$RUN/correzione.attiva" ]; then
		if [ "$(lower "$(conf CORREZIONE no)")" = confronto ]; then
			emit INFO "Correzione ambientale" "esclusa a pari volume: CamillaDSP applica solo l'attenuazione"
		else
			emit INFO "Correzione ambientale" "attiva (CamillaDSP): il percorso non e' bit-perfect per scelta"
		fi
	elif [ -s "$RUN/correzione.errore" ]; then
		emit ATTENZIONE "Correzione ambientale" "non applicata: $(cat "$RUN/correzione.errore")"
	fi
}

check_library() {
	local r ver songs albums scanning
	r=$(lms_json '' serverstatus 0 0) || { emit ATTENZIONE "Lyrion Music Server" "non risponde (si sta avviando?)"; return; }
	ver=$(printf '%s\n' "$r" | jq -r '.result.version // empty')
	songs=$(printf '%s\n' "$r" | jq -r '.result."info total songs" // 0')
	albums=$(printf '%s\n' "$r" | jq -r '.result."info total albums" // 0')
	scanning=$(printf '%s\n' "$r" | jq -r '.result.rescan // 0')
	emit OK "Lyrion Music Server" "versione $ver"
	if [ "$scanning" = 1 ]; then
		emit INFO "Libreria" "lettura in corso ($songs brani finora)"
	elif [ "$songs" -gt 0 ] 2>/dev/null; then
		emit OK "Libreria" "$songs brani, $albums album"
	else
		emit ATTENZIONE "Libreria" "vuota: collega un disco o aggiungi una cartella di rete in Musica"
	fi
}

check_system() {
	local srv ip disks b t st
	emit INFO "Classe del computer" "$(machine_class) - $(cpu_model) - $(( $(mem_total_kb) / 1024 )) MB di RAM"
	ip=$(net_ipv4)
	if [ -n "$ip" ]; then emit OK "Rete" "indirizzo $ip"; else emit ATTENZIONE "Rete" "nessun indirizzo: il cavo e' collegato?"; fi
	if [ "$(mode)" = player ]; then
		srv=$(lms_server_ip)
		if [ -n "$srv" ]; then emit OK "Server Lyrion" "collegato a $srv"
		else emit ATTENZIONE "Server Lyrion" "non collegato"; fi
	elif [ -n "$ip" ]; then
		emit INFO "Interfaccia" "http://$ip/ oppure http://$(hostname).local/"
	fi
	for b in "$SYS"/block/sd*; do
		[ -d "$b" ] || continue
		[ "$(cat "$b/queue/rotational" 2>/dev/null)" = 1 ] || continue
		[ "$(cat "$b/removable" 2>/dev/null)" = 0 ] || continue
		case "$(readlink -f "$b/device")" in */usb*) continue ;; esac
		st=$(hdparm -C "/dev/${b##*/}" 2>/dev/null | sed -n 's/.*drive state is: *//p')
		disks="$disks ${b##*/}: ${st:-stato sconosciuto}"
	done
	[ -n "$disks" ] && emit INFO "Dischi meccanici" "${disks# }"
	for t in "$SYS"/class/hwmon/hwmon*; do
		case "$(cat "$t/name" 2>/dev/null)" in
			coretemp|k10temp)
				[ -f "$t/temp1_input" ] && emit INFO "Temperatura CPU" "$(( $(cat "$t/temp1_input") / 1000 )) gradi"
				break ;;
		esac
	done
}

check_kernel
check_ram_system
check_cpu
check_usb
check_dac
check_player
[ "$(mode)" = completa ] && check_library
check_system

if [ "$1" = "--dati" ]; then
	printf '%s' "$OUT"
else
	printf '%s' "$OUT" | while IFS='|' read -r esito voce dettaglio; do
		case "$esito" in
			OK) mark="  ok " ;;
			ATTENZIONE) mark=" (!) " ;;
			*) mark="     " ;;
		esac
		printf '%s %-28s %s\n' "$mark" "$voce" "$dettaglio"
	done
fi
