#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Sweetspot - verifica del sistema e del percorso del segnale.
#
#   sweetspot-check          elenco leggibile
#   sweetspot-check --dati   righe "ESITO|voce|dettaglio" per la pagina web
#
# ESITO e' OK, ATTENZIONE oppure INFO.

. "${SWEETSPOT_LIB:-/usr/lib/sweetspot}/common.sh"

SQLOG=${SWEETSPOT_SQLOG:-/var/log/squeezelite.log}
OUT=""

emit() { OUT="$OUT$1|$2|$3
"; }

check_kernel() {
	if uname -v | grep -q PREEMPT_RT; then
		emit OK "Kernel real-time" "$(uname -r), PREEMPT_RT attivo"
	else
		emit ATTENZIONE "Kernel real-time" "il kernel in uso non e' real-time"
	fi
}

check_ram_system() {
	local fs
	fs=$(awk '$2=="/" {print $3}' "$PROC/mounts" | tail -n 1)
	case "$fs" in
		rootfs|tmpfs|ramfs) emit OK "Sistema in RAM" "nessun disco usato dal sistema" ;;
		*) emit ATTENZIONE "Sistema in RAM" "radice su $fs" ;;
	esac
	if [ ! -f "$PROC/swaps" ] || [ "$(wc -l < "$PROC/swaps")" -le 1 ]; then
		emit OK "Swap" "assente"
	else
		emit ATTENZIONE "Swap" "presente"
	fi
	if grep -q " $STICK_MNT " "$PROC/mounts"; then
		emit INFO "Chiavetta" "in uso in questo momento"
	else
		emit OK "Chiavetta" "non in uso: si puo' togliere"
	fi
}

check_cpu() {
	local iso smt pol gov min max cur turbo states
	cpu_layout
	iso=$(cat "$SYS/devices/system/cpu/isolated" 2>/dev/null)
	if safe_mode; then
		emit ATTENZIONE "Ottimizzazioni" "disattivate (avvio sicuro o OTTIMIZZAZIONI=no)"
	fi
	if [ -n "$iso" ]; then
		emit OK "Core dedicati" "riproduzione sul core $LAYOUT_AUDIO, interruzioni USB sul core $LAYOUT_IRQ (isolati: $iso)"
	elif [ "$LAYOUT_CORES" -le 1 ]; then
		emit INFO "Core dedicati" "un solo core: solo priorita' real-time"
	else
		emit ATTENZIONE "Core dedicati" "nessun core isolato in questo avvio"
	fi
	smt=$(cpu_smt_state)
	case "$smt" in
		on) if [ "$(energia)" = conservativo ]; then emit INFO "Hyper-Threading" "attivo (profilo energetico conservativo)"; else emit ATTENZIONE "Hyper-Threading" "attivo"; fi ;;
		off|forceoff) emit OK "Hyper-Threading" "spento" ;;
		*) emit OK "Hyper-Threading" "non presente" ;;
	esac
	for pol in "$SYS"/devices/system/cpu/cpufreq/policy*; do
		[ -d "$pol" ] || continue
		gov=$(cat "$pol/scaling_governor" 2>/dev/null)
		min=$(cat "$pol/scaling_min_freq" 2>/dev/null)
		max=$(cat "$pol/scaling_max_freq" 2>/dev/null)
		cur=$(cat "$pol/scaling_cur_freq" 2>/dev/null)
		break
	done
	if [ -n "$min" ] && [ "$min" = "$max" ]; then
		emit OK "Frequenza CPU" "fissa a $((min / 1000)) MHz (profilo $(cut -d' ' -f1 "$RUN/cpu.stato" 2>/dev/null), governor $gov)"
	elif [ -n "$min" ] && [ "$(energia)" = conservativo ]; then
		emit INFO "Frequenza CPU" "governor $gov, $((min / 1000))-$((max / 1000)) MHz (profilo energetico conservativo)"
	elif [ -n "$min" ]; then
		emit ATTENZIONE "Frequenza CPU" "variabile $((min / 1000))-$((max / 1000)) MHz, ora $((cur / 1000)) MHz"
	else
		emit INFO "Frequenza CPU" "non regolabile su questo computer"
	fi
	turbo=""
	[ -f "$SYS/devices/system/cpu/intel_pstate/no_turbo" ] &&
		{ [ "$(cat "$SYS/devices/system/cpu/intel_pstate/no_turbo")" = 1 ] && turbo=off || turbo=on; }
	[ -f "$SYS/devices/system/cpu/cpufreq/boost" ] &&
		{ [ "$(cat "$SYS/devices/system/cpu/cpufreq/boost")" = 0 ] && turbo=off || turbo=on; }
	case "$turbo" in
		off) emit OK "Turbo" "spento" ;;
		on) emit ATTENZIONE "Turbo" "attivo" ;;
	esac
	states=$(cat "$SYS"/devices/system/cpu/cpu0/cpuidle/state*/name 2>/dev/null | tr '\n' ' ')
	if [ "$(energia)" = conservativo ]; then
		emit INFO "Stati di risparmio" "liberi (profilo energetico conservativo; ${states:-nessuno})"
	elif cmdline_has intel_idle.max_cstate || cmdline_has processor.max_cstate; then
		emit OK "Stati di risparmio" "limitati a C1 (disponibili: ${states:-nessuno})"
	else
		emit ATTENZIONE "Stati di risparmio" "non limitati (${states:-nessuno})"
	fi
	if [ -f "$RUN/pmqos.pid" ] && kill -0 "$(cat "$RUN/pmqos.pid")" 2>/dev/null; then
		emit INFO "Core sempre svegli" "attivo (profilo prestazioni)"
	fi
}

# Attivita' elettrica superflua (sweetspot-silenzio e sweetspot-display).
check_quiet() {
	local l leds=0 lit="" d off="" iso hk c mask=0 cur con st b screens="" pci awake bdf kind rs
	for l in "$SYS"/class/leds/*; do
		[ -d "$l" ] || continue
		case "${l##*/}" in *::capslock|*::numlock|*::scrolllock|*::compose|*::kana) continue ;; esac
		leds=$((leds + 1))
		[ "$(cat "$l/brightness" 2>/dev/null)" = 0 ] || lit="$lit ${l##*/}"
	done
	if [ "$leds" -gt 0 ] && [ -z "$lit" ]; then
		emit OK "LED" "spenti (tranne quelli della tastiera)"
	elif [ -n "$lit" ]; then
		emit INFO "LED" "accesi:$lit"
	fi
	for d in "$SYS"/bus/usb/devices/*; do
		case "${d##*/}" in *:*|usb*) continue ;; esac
		[ "$(cat "$d/authorized" 2>/dev/null)" = 0 ] &&
			off="$off, $(cat "$d/product" 2>/dev/null || echo "${d##*/}")"
	done
	[ -n "$off" ] && emit OK "USB inutilizzate" "scollegate dai driver: ${off#, }"
	# Stato reale dei PCI lasciati a riposo da sweetspot-silenzio.
	if [ -s "$RUN/silenzio.pci" ]; then
		pci="" awake=0
		while IFS='|' read -r bdf kind; do
			rs=$(cat "$SYS/bus/pci/devices/$bdf/power/runtime_status" 2>/dev/null)
			case "$rs" in
				suspended) rs="a riposo" ;;
				*) rs="attivo${rs:+ ($rs)}"; awake=$((awake + 1)) ;;
			esac
			pci="$pci, $kind $bdf $rs"
		done < "$RUN/silenzio.pci"
		if [ "$awake" = 0 ]; then
			emit OK "PCI a riposo" "${pci#, }"
		else
			emit INFO "PCI a riposo" "${pci#, }; un dispositivo senza driver o che non lo supporta resta attivo"
		fi
	fi
	iso=$(expand_list "$(cat "$SYS/devices/system/cpu/isolated" 2>/dev/null)")
	cur=$(cat "$SYS/devices/virtual/workqueue/cpumask" 2>/dev/null | tr -d ',' | sed 's/^0*//')
	if [ -n "$iso" ] && [ -n "$cur" ]; then
		hk=$(subtract "$(cpu_online)" "$iso")
		for c in $hk; do mask=$((mask | (1 << c))); done
		if [ "$cur" = "$(printf '%x' "$mask")" ]; then
			emit OK "Lavoro differito del kernel" "workqueue solo sui core di sistema $(join_list "$hk")"
		else
			emit ATTENZIONE "Lavoro differito del kernel" "workqueue anche sui core isolati (maschera $cur)"
		fi
	fi
	for con in "$SYS"/class/drm/card*-*; do
		[ "$(cat "$con/status" 2>/dev/null)" = connected ] || continue
		st=$(cat "$con/dpms" 2>/dev/null)
		screens="$screens, ${con##*/card[0-9]-} ${st:-?}"
	done
	for b in "$SYS"/class/backlight/*; do
		[ -f "$b/bl_power" ] || continue
		if [ "$(cat "$b/bl_power")" = 0 ]; then
			screens="$screens, retroilluminazione accesa"
		else
			screens="$screens, retroilluminazione spenta"
		fi
	done
	[ -n "$screens" ] &&
		emit INFO "Schermo" "${screens#, }; si spegne dopo $(conf SCHERMO_MINUTI 2) minuti senza tasti (0 = mai)"
}

check_usb() {
	local a
	a=$(cat "$SYS/module/usbcore/parameters/autosuspend" 2>/dev/null)
	if [ "$a" = "-1" ]; then
		emit OK "Risparmio energetico USB" "spento"
	else
		emit ATTENZIONE "Risparmio energetico USB" "attivo (autosuspend $a s)"
	fi
}

check_dac() {
	local card name usbid fmts rates nat bdf irqs irq aff tid policy prio cpus snapshot st dev sub fmt rate ch buffer period label severity description
	card=$(dac_find)
	if [ -z "$card" ]; then
		emit ATTENZIONE "DAC" "nessun DAC USB trovato: e' acceso e collegato?"
		return
	fi
	name=$(dac_name "$card")
	usbid=$(dac_usbid "$card")
	fmts=$(dac_formats "$card")
	rates=$(dac_rates "$card")
	if [ -n "$usbid" ]; then
		emit OK "DAC" "$name (USB $usbid)"
	else
		emit OK "DAC" "$name (scheda I2S $(conf SCHEDA_I2S))"
	fi
	[ -n "$fmts" ] && emit INFO "Formati del DAC" "$fmts"
	[ -n "$rates" ] && emit INFO "Frequenze del DAC" "$(echo "$rates" | sed 's/ /, /g') Hz"
	nat=$(dac_native_dsd "$card")
	case "$(lower "$(conf DSD auto)")" in
		auto|nativo)
			if [ -n "$nat" ]; then emit OK "DSD" "nativo ($nat)"
			else emit INFO "DSD" "il DAC non dichiara il DSD nativo: Squeezelite converte i file DSD in PCM alla frequenza più alta che il DAC accetta, senza DoP (prova DoP nella pagina Audio)"; fi ;;
		dop) emit INFO "DSD" "tramite DoP" ;;
		*) emit INFO "DSD" "convertito in PCM da Squeezelite" ;;
	esac
	emit INFO "Margine DSD → PCM" "$(dsd_margine_db) dB (DSD_PCM_MARGINE_DB): spazio per i DSD che superano 0 dBFS fino a +3 dB; vale solo quando il DSD è convertito in PCM"
	if [ -f "$RUN/dac.controller" ]; then
		bdf=$(cut -d' ' -f1 "$RUN/dac.controller")
		irqs=$(cut -d' ' -f2- "$RUN/dac.controller")
		for irq in $irqs; do
			# Solo i vettori in uso (gli altri non hanno un core assegnato).
			[ -n "$(cat "$PROC/irq/$irq/effective_affinity_list" 2>/dev/null)" ] || continue
			# Il core richiesto: il kernel ci sposta l'interruzione alla
			# prima attivita' USB.
			aff=$(cat "$PROC/irq/$irq/smp_affinity_list" 2>/dev/null)
			if [ "$aff" = "$LAYOUT_IRQ" ] || [ -z "$(cat "$SYS/devices/system/cpu/isolated" 2>/dev/null)" ]; then
				emit OK "Interruzioni USB del DAC" "controller $bdf, IRQ $irq sul core $aff"
			else
				emit ATTENZIONE "Interruzioni USB del DAC" "controller $bdf, IRQ $irq sul core $aff invece del $LAYOUT_IRQ"
			fi
		done
	fi
	if [ -f "$RUN/audio.tid" ]; then
		tid=$(cat "$RUN/audio.tid")
		policy=$(sed 's/.*) //' "$PROC/$tid/stat" 2>/dev/null | cut -d' ' -f39)
		prio=$(sed 's/.*) //' "$PROC/$tid/stat" 2>/dev/null | cut -d' ' -f38)
		cpus=$(sed -n 's/^Cpus_allowed_list:[[:space:]]*//p' "$PROC/$tid/status" 2>/dev/null)
		if [ "$policy" = 1 ]; then
			emit OK "Thread di riproduzione" "real-time priorita' $prio sul core $cpus"
		else
			emit ATTENZIONE "Thread di riproduzione" "non real-time"
		fi
	fi
	snapshot=$(dac_pcm_snapshot "$card")
	IFS='|' read -r dev sub st fmt rate ch buffer period <<EOF
$snapshot
EOF
	label="Uscita audio"; severity=INFO
	case "$st" in
		RUNNING) label="Uscita in corso"; severity=OK; description="riproduzione attiva" ;;
		DRAINING) description="Uscita in svuotamento: i buffer stanno terminando" ;;
		PREPARED) description="uscita preparata, riproduzione non avviata" ;;
		PAUSED) description="uscita in pausa" ;;
		OPEN|SETUP) description="uscita aperta, riproduzione non avviata" ;;
		XRUN) severity=ATTENZIONE; description="interruzione ALSA (buffer esaurito)" ;;
		SUSPENDED) severity=ATTENZIONE; description="uscita sospesa dal sistema" ;;
		DISCONNECTED) severity=ATTENZIONE; description="dispositivo scollegato" ;;
		CLOSED) description="uscita chiusa (nessuna riproduzione)" ;;
		UNAVAILABLE) severity=ATTENZIONE; description="PCM selezionato non disponibile" ;;
		AMBIGUOUS) severity=ATTENZIONE; description="piu' substream aperti: uscita non verificabile" ;;
		*) severity=ATTENZIONE; description="stato o parametri non verificabili" ;;
	esac
	if [ "$st" = RUNNING ] && [ -n "$fmt" ] && [ -n "$rate" ] && [ -n "$ch" ]; then
		emit "$severity" "$label" "DEV=$dev/sub$sub: $fmt, $rate Hz, $ch canali, $st"
	else
		emit "$severity" "$label" "DEV=$dev/sub$sub: $description ($st)"
		[ -n "$fmt" ] && [ -n "$rate" ] && [ -n "$ch" ] &&
			emit INFO "Parametri aperti" "DEV=$dev/sub$sub: $fmt, $rate Hz, $ch canali; non provano la riproduzione"
	fi
	[ -n "$buffer" ] && [ -n "$period" ] &&
		emit INFO "Buffer ALSA" "DEV=$dev/sub$sub: $buffer campioni, periodo $period"

}

# Valore di una riga CHIAVE=VALORE del file della sessione del player.
session_value() { sed -n "s/^$1=//p" "$RUN/sessione" 2>/dev/null; }

# Minuti trascorsi dall'inizio della sessione (almeno 1).
session_minutes() {
	local m
	m=$(( ($(date +%s) - $(session_value inizio)) / 60 ))
	[ "$m" -ge 1 ] || m=1
	echo "$m"
}

# Contatori live della sessione del player (dall'ultimo avvio di Squeezelite).
check_session() {
	local off size counts xr rec mins
	[ -s "$RUN/sessione" ] || return 0
	mins=$(session_minutes)
	off=$(session_value sqlog)
	if [ -f "$SQLOG" ]; then
		size=$(wc -c < "$SQLOG" | tr -d ' ')
		# Registro ricominciato da capo: conta tutto.
		[ "${off:-0}" -le "$size" ] || off=0
		counts=$(xrun_sum "$(xrun_saved "$RUN/sessione.xrun")" "$(tail -c +"$((${off:-0} + 1))" "$SQLOG" | xrun_counts)")
		xr=${counts% *}; rec=${counts#* }
		if [ "$xr" = 0 ] && [ "$rec" = 0 ]; then
			emit OK "XRUN nella sessione" "nessuno in $mins minuti"
		else
			emit ATTENZIONE "XRUN nella sessione" "$xr in $mins minuti (recuperi falliti: $rec)"
		fi
	else
		emit INFO "XRUN nella sessione" "registro non disponibile"
	fi
	check_audio_irqs "$mins"
	check_listening_latency
}

# Interruzioni arrivate sul core della riproduzione durante la sessione:
# quelle dei dispositivi una per una, quelle di sistema (timer, IPI) come
# frequenza media.
check_audio_irqs() { # minuti
	local core res dev sys
	core=$(session_value core)
	[ -n "$core" ] && [ -f "$RUN/sessione.irq" ] || return 0
	res=$(irq_cpu_counts "$core" | awk -v secs="$(( $1 * 60 ))" '
		NR == FNR { old[$1] = $2; next }
		{
			d = $2 - old[$1]
			if (d <= 0) next
			if ($1 ~ /^[0-9]+$/) { dev = dev sep "IRQ " $1 " (" $3 ") " d; sep = ", " }
			else sys += d
		}
		END { printf "%s|%d", dev, sys / secs }
	' "$RUN/sessione.irq" -)
	dev=${res%|*}; sys=${res##*|}
	if [ -z "$dev" ]; then
		emit OK "Interruzioni sul core audio" "nessuna da dispositivi in $1 minuti sul core $core"
	elif [ "$core" = "$LAYOUT_IRQ" ]; then
		emit INFO "Interruzioni sul core audio" "$dev in $1 minuti (un solo core: USB e riproduzione lo condividono)"
	else
		emit ATTENZIONE "Interruzioni sul core audio" "$dev in $1 minuti sul core $core, che dovrebbe restare libero"
	fi
	emit INFO "Interruzioni di sistema sul core audio" "${sys:-0} al secondo (timer e chiamate fra core)"
}

# La prova dell'ascolto puro (sweetspot-ascolto, $RUN/ascolto.io): settori
# letti dai dischi con la musica e byte di rete dall'inizio dell'ascolto in
# corso, o dell'ultimo. Con il precarico finito le letture devono restare a
# zero; la rete serve solo al controllo (browser, app).
check_listening_io() {
	local io=$RUN/ascolto.io start end when secs now disks mb kb rate
	[ -s "$io" ] || return 0
	start=$(sed -n 's/^inizio //p' "$io")
	end=$(sed -n 's/^fine //p' "$io")
	[ -n "$start" ] || return 0
	if [ -n "$end" ]; then
		secs=$((end - start))
		when="nell'ultimo ascolto"
		now=$(sed -n 's/^fine_//p' "$io")
	else
		secs=$(( ${SWEETSPOT_NOW:-$(date +%s)} - start ))
		when="durante l'ascolto in corso"
		now=$(io_counters)
	fi
	[ "$secs" -ge 1 ] || secs=1
	when="$when ($(( (secs + 59) / 60 )) min)"
	# Dischi: somma delle differenze dei settori (512 byte).
	disks=$(printf '%s\n' "$now" | awk -v io="$io" '
		BEGIN { while ((getline l < io) > 0) { split(l, f, " "); if (f[1] == "disco") old[f[2]] = f[3] } }
		$1 == "disco" && ($2 in old) { d = $3 - old[$2]; if (d < 0) d = 0; tot += d; names = names sep $2; sep = ", " }
		END { printf "%d|%s", tot, names }')
	mb=$(( ${disks%|*} / 2048 ))
	if [ -n "${disks#*|}" ]; then
		if [ "${disks%|*}" = 0 ]; then
			emit OK "Letture dal disco durante l'ascolto" "nessuna $when da ${disks#*|}: la musica suona dalla RAM"
		else
			emit INFO "Letture dal disco durante l'ascolto" "$mb MB $when da ${disks#*|} (precarico in corso, file oltre il budget o fuori dal precarico)"
		fi
	fi
	kb=$(printf '%s\n' "$now" | awk -v io="$io" '
		BEGIN { while ((getline l < io) > 0) { split(l, f, " "); if (f[1] == "rete") old = f[2] } }
		$1 == "rete" { d = $2 - old; if (d < 0) d = 0; printf "%d", d / 1024 }')
	rate=$(( ${kb:-0} / secs ))
	if [ "$rate" -lt 2 ]; then
		emit OK "Rete durante l'ascolto" "${kb:-0} KB $when: solo il controllo (browser, app)"
	else
		emit INFO "Rete durante l'ascolto" "${kb:-0} KB $when ($rate KB/s): streaming, cartelle di rete o precarico dalla rete"
	fi
}

# Latenza misurata durante l'ascolto da sweetspot-latenza --ascolto.
check_listening_latency() {
	local max n last
	if [ -s "$RUN/latenza.ascolto" ]; then
		read -r max n last < "$RUN/latenza.ascolto"
		if [ "$max" -le 150 ]; then
			emit OK "Latenza durante l'ascolto" "massima $max us in $n finestre di 30 s (ultima $last us)"
		else
			emit ATTENZIONE "Latenza durante l'ascolto" "massima $max us in $n finestre di 30 s (ultima $last us): prova il profilo 'prestazioni' e le impostazioni del BIOS"
		fi
	elif [ "$(lower "$(conf LATENZA_ASCOLTO no)")" = si ]; then
		emit INFO "Latenza durante l'ascolto" "nessuna misura ancora: servono 30 secondi di riproduzione"
	else
		emit INFO "Latenza durante l'ascolto" "non misurata: LATENZA_ASCOLTO=si la misura, sweetspot-latenza a riproduzione ferma"
	fi
}

# Campioni tagliati da CamillaDSP nella sessione (li somma il player).
check_dsp_clipping() {
	local total
	if [ -s "$RUN/dsp.clip" ]; then
		total=$(cut -d' ' -f3 "$RUN/dsp.clip")
		if [ "${total:-0}" = 0 ]; then
			emit OK "Clipping di CamillaDSP" "nessun campione tagliato nella sessione"
		else
			emit ATTENZIONE "Clipping di CamillaDSP" "$total campioni tagliati nella sessione: l'attenuazione automatica non basta, riduci in REW i filtri che alzano il livello"
		fi
	else
		emit INFO "Clipping di CamillaDSP" "non ancora letto: si conta durante la riproduzione"
	fi
}

# Underrun di CamillaDSP nella sessione (li conta il player dal registro).
check_dsp_underrun() {
	local total
	if [ -s "$RUN/dsp.underrun" ]; then
		total=$(cut -d' ' -f2 "$RUN/dsp.underrun")
		if [ "${total:-0}" = 0 ]; then
			emit OK "Underrun di CamillaDSP" "nessuno nella sessione"
		else
			emit ATTENZIONE "Underrun di CamillaDSP" "$total nella sessione (camilladsp.log): il buffer di uscita si e' svuotato, prova ad alzare BUFFER_ALSA_MS o il profilo 'prestazioni'"
		fi
	else
		emit INFO "Underrun di CamillaDSP" "non ancora letti: si contano durante la riproduzione"
	fi
}

# Picco massimo della sessione per canale (dBFS), da CamillaDSP.
check_dsp_peaks() {
	local pin pout
	pin=$(sed -n 's/^picco_ingresso=//p' "$RUN/dsp.stato" 2>/dev/null)
	pout=$(sed -n 's/^picco_uscita=//p' "$RUN/dsp.stato" 2>/dev/null)
	[ -n "$pin$pout" ] || return 0
	emit INFO "Picco di CamillaDSP" "ingresso ${pin:--} dBFS, uscita ${pout:--} dBFS (massimo della sessione, sinistro e destro)"
}

# Volume attuale del volume a 64 bit, se sweetspot-volume l'ha gia' letto.
volume_dsp_now() {
	local v d m
	[ -s "$RUN/volume.dsp" ] || return 0
	read -r v d m < "$RUN/volume.dsp"
	if [ "$m" = 1 ]; then printf ' (ora in sordina)'; else printf ' (ora %s, %s dB)' "$v" "$d"; fi
}

# Altri DAC come zone (ALTRI_DAC=si, sweetspot-player).
check_zones() {
	local f pid id list="" down=""
	is_yes "$(conf ALTRI_DAC no)" || return 0
	for f in "$RUN"/zone/*; do
		[ -f "$f" ] || continue
		read -r pid id < "$f"
		if kill -0 "$pid" 2>/dev/null; then list="$list, $id"; else down="$down, $id"; fi
	done
	if [ -n "$down" ]; then
		emit ATTENZIONE "Altri DAC (zone)" "player fermo su ${down#, }: riparte entro pochi secondi"
	elif [ -n "$list" ]; then
		emit OK "Altri DAC (zone)" "un player in Lyrion per ${list#, }; si raggruppano da Lyrion"
	else
		emit INFO "Altri DAC (zone)" "nessun altro DAC USB collegato"
	fi
}

# Frequenza rifiutata dal DAC (stallo con -H) o ricampionata perche' non
# supportata: guarda solo le ultime righe del registro di Squeezelite.
check_frequenza() {
	local f id
	check_frequenza_log "$SQLOG" Frequenza
	# Le zone (ALTRI_DAC) hanno il loro registro, con le stesse righe.
	for f in "${SQLOG%/*}"/squeezelite-*.log; do
		[ -r "$f" ] || continue
		id=${f##*/squeezelite-}; id=${id%.log}
		check_frequenza_log "$f" "Frequenza (zona $id)"
	done
}

check_frequenza_log() { # registro voce
	local tl rate n
	[ -r "$1" ] || return 0
	tl=$(tail -n 60 "$1" 2>/dev/null)
	rate=$(printf '%s\n' "$tl" | sed -n 's/.*refuses \([0-9][0-9]*\) Hz.*/\1/p' | tail -n 1)
	if [ -n "$rate" ]; then
		n=$(printf '%s\n' "$tl" | grep -c "refuses $rate Hz")
		if [ "$n" -ge 2 ]; then
			emit ATTENZIONE "$2" "bloccato: frequenza $rate Hz non accettata dal DAC (Squeezelite riprova ogni 5 s): imposta FREQUENZA_NON_SUPPORTATA=ricampiona o correggi FREQUENZA_MAX"
			return 0
		fi
	fi
	rate=$(printf '%s\n' "$tl" | sed -n 's/.*[Rr]esampl[a-z]* from \([0-9][0-9]*\) *\(->\|to\) *\([0-9][0-9]*\).*/\1 -> \3 Hz/p' | tail -n 1)
	if [ -n "$rate" ] && [ "$(lower "$(conf RICAMPIONAMENTO no)")" = no ]; then
		emit ATTENZIONE "$2" "ricampionata ($rate): il DAC non supporta la frequenza originale; il ricampionatore abbassa il segnale di 1 dB"
	fi
}

# Con VOLUME=dac, il controllo hardware indicato con -V non si apre e
# Squeezelite ripiega sul volume software (ma il resto lo chiama "hardware").
volume_dac_ripiego() {
	[ "$(volume_effettivo)" = hardware ] || return 1
	[ -r "$SQLOG" ] || return 1
	tail -n 60 "$SQLOG" 2>/dev/null | grep -q "Initialization of mixer failed, reverting to software volume"
}

# Il DAC riceve solo 16 bit: i brani a 24 bit sono troncati.
dac_solo_16() {
	local card f
	card=$(dac_find) || return 1
	[ -n "$card" ] || return 1
	f=" $(dac_formats "$card") "
	case "$f" in *" S24_LE "*|*" S24_3LE "*|*" S32_LE "*) return 1 ;; *" S16_LE "*) return 0 ;; esac
	return 1
}

# Lyrion ricampiona lato server (sox) i brani sopra MaxSampleRate del player.
check_lyrion_sox() {
	local mac rate top conv n=""
	[ "$(mode)" = completa ] || return 0
	mac=$(cat "$RUN/player.mac" 2>/dev/null)
	[ -n "$mac" ] || return 0
	# La massima del player (HELO MaxSampleRate) e' quella del probe del DAC
	# o di FREQUENZA_MAX, annotata dal player; Lyrion ricampiona con sox (regola
	# con capacita' D, TranscodingHelper) i brani che la superano. Si confronta
	# il brano in riproduzione.
	top=$(cat "$RUN/frequenza.max" 2>/dev/null)
	rate=$(LMS_TIMEOUT=5 lms_get 'if .mode == "play" then .playlist_loop[0].samplerate else empty end' "$mac" status - 1 tags:T | tr -dc '0-9')
	if [ -n "$rate" ] && [ -n "$top" ] && [ "$rate" -gt "$top" ]; then
		emit ATTENZIONE "Lyrion ricampiona" "il brano in riproduzione ($rate Hz) supera la massima dichiarata dal player ($top Hz): Lyrion lo ricampiona lato server con sox prima di Squeezelite; alza FREQUENZA_MAX se il DAC lo permette"
	fi
	for conv in ${SWEETSPOT_LMS_CONVERT:-/opt/lms/convert.conf /var/lib/lms/custom-convert.conf}; do
		[ -r "$conv" ] || continue
		grep -v '^[[:space:]]*#' "$conv" 2>/dev/null | grep -q '\[sox\].*-r[[:space:]]' && n="$n $conv"
	done
	[ -n "$n" ] && emit INFO "Lyrion e sox" "convert.conf ha regole sox con cambio di frequenza (${n# }): ricampionano solo i formati o le frequenze che il player non accetta"
	return 0
}

# Alterazioni del segnale che non sono una scelta esplicita di volume o
# ricampionamento: ogni troncamento o conversione va dichiarato.
check_alterazioni() {
	if [ "$(cat "$RUN/volume.modo" 2>/dev/null)" != dsp ] && { [ "$(conf FORMATO_USCITA auto)" = 16 ] || dac_solo_16; }; then
		emit INFO "Uscita a 16 bit" "i brani a 24 bit si riducono a 16 bit con dither TPDF (rumore di +-1 LSB, patch 0006 di Squeezelite) invece di troncarli: il percorso non e' bit-perfect"
	fi
	check_lyrion_sox
}

check_player() {
	local pid xr recovery counts bufs state vol hist=ATTENZIONE
	pid=$(cat "$RUN/squeezelite.pid" 2>/dev/null)
	counts=$(xrun_total "$SQLOG") || counts=""
	xr=${counts% *}; recovery=${counts#* }
	# Con i contatori della sessione lo storico e' solo un'informazione.
	[ -s "$RUN/sessione" ] && hist=INFO
	state=$(cat "$RUN/player.stato" 2>/dev/null)
	if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
		emit OK "Player" "$state"
	elif [ "$state" = "in attesa del DAC" ]; then
		emit ATTENZIONE "Player" "$state: collega il DAC e accendilo"
	else
		emit ATTENZIONE "Player" "${state:-non avviato}"
	fi
	check_frequenza
	xr=${xr:-0}
	if [ ! -f "$SQLOG" ] || [ -z "$counts" ]; then
		emit INFO "XRUN ALSA registrati" "registro non disponibile"
	elif [ "$xr" = 0 ]; then
		emit INFO "XRUN ALSA registrati" "0 nel registro storico; non esclude interruzioni dello stream o del DSP e non misura il jitter del clock"
	else
		emit "$hist" "XRUN ALSA registrati" "$xr nel registro storico; non misura il jitter del clock"
	fi
	if [ ! -f "$SQLOG" ] || [ -z "$counts" ]; then
		emit INFO "Recuperi XRUN falliti" "registro non disponibile"
	elif [ "${recovery:-0}" = 0 ]; then
		emit INFO "Recuperi XRUN falliti" "0 nel registro storico"
	else
		emit "$hist" "Recuperi XRUN falliti" "$recovery nel registro storico"
	fi
	check_session
	check_listening_io
	check_zones
	ram_quote_calc
	bufs=$RAM_STREAM:$RAM_OUTPUT
	emit INFO "Memoria per i brani" "$(( ${bufs%:*} / 1024 )) MB per il file + $(( ${bufs#*:} / 1024 )) MB di campioni decodificati in anticipo"
		emit INFO "Budget RAM" "sistema $(( RAM_SISTEMA / 1024 )) MB, servizi (Lyrion, catalogo, immagini, snapshot) $(( RAM_SERVIZI / 1024 )) MB, ALSA $(( RAM_ALSA / 1024 )) MB, buffer del player $(( (RAM_STREAM + RAM_OUTPUT) / 1024 )) MB, precarico $(( RAM_PRECARICO / 1024 )) MB (disponibile $(( RAM_AVAIL / 1024 )) MB di $(( RAM_TOTAL / 1024 )) MB)"
	vol=$(lower "$(conf VOLUME fisso)")
	if [ "$vol" = dsp ] && [ "$(cat "$RUN/volume.modo" 2>/dev/null)" = riserva ]; then
		emit ATTENZIONE "Volume" "a 64 bit non disponibile ($(grep . "$RUN/volume.motivo" 2>/dev/null || echo "CamillaDSP non avviato o modalita' player")): in uso il volume software, con dither TPDF di Squeezelite"
	elif [ "$(mode)" = player ] && [ "$vol" != dsp ]; then
		emit INFO "Volume" "per un percorso bit-perfect, in Lyrion imposta il volume del player come fisso al 100%"
	elif [ "$vol" = fisso ]; then
		emit OK "Volume" "fisso al 100%, si regola dall'amplificatore (percorso bit-perfect)"
	elif [ "$vol" = software ]; then
		emit ATTENZIONE "Volume" "dal software: sotto il 100% non e' bit-perfect; Squeezelite arrotonda con dither TPDF a 16 e 24 bit senza troncare, ma il volume fisso o del DAC resta preferibile"
		emit INFO "DSD e volume" "con il volume software i file DSD si convertono in PCM: il volume non agisce sul DSD nativo e un DSF suonerebbe al 100% dopo un brano attenuato"
	elif [ "$vol" = dac ] && [ "$(volume_effettivo)" = fisso ]; then
		emit ATTENZIONE "Volume" "richiesto del DAC, ma il DAC non ha un controllo del volume: in uso il volume fisso al 100%, regola dall'amplificatore"
	elif [ "$vol" = dac ] && volume_dac_ripiego; then
		emit ATTENZIONE "Volume" "richiesto del DAC, ma il controllo hardware non risponde: Squeezelite ripiega sul volume software (con dither TPDF, il DSD si converte in PCM)"
	elif [ "$vol" = dsp ] && [ "$(cat "$RUN/volume.modo" 2>/dev/null)" = dsp ]; then
		emit OK "Volume" "a 64 bit in CamillaDSP con dither all'uscita (anche al 100%), Squeezelite lascia i campioni invariati$(volume_dsp_now); non e' bit-perfect, ma senza troncamenti"
	elif [ "$vol" = dsp ] && [ -f "$RUN/volume.modo" ]; then
		emit ATTENZIONE "Volume" "a 64 bit non disponibile (CamillaDSP non avviato o modalita' player): in uso il volume software, con dither TPDF di Squeezelite"
	else
		emit INFO "Volume" "regolabile ($vol): sotto il 100% il segnale non e' piu' bit-perfect"
	fi
	if [ -n "$(conf RICAMPIONAMENTO)" ] && [ "$(lower "$(conf RICAMPIONAMENTO)")" != no ]; then
		emit INFO "Ricampionamento" "attivo ($(lower "$(conf RICAMPIONAMENTO)")): il percorso non e' bit-perfect per scelta; il ricampionatore abbassa il segnale di 1 dB"
	fi
	check_alterazioni
	if correction_running; then
		if [ "$(lower "$(conf CORREZIONE no)")" = confronto ]; then
			emit INFO "Correzione ambientale" "esclusa a pari volume: CamillaDSP applica solo l'attenuazione"
		else
			emit INFO "Correzione ambientale" "attiva (CamillaDSP): il percorso non e' bit-perfect per scelta"
		fi
	elif [ -s "$RUN/correzione.errore" ]; then
		if grep -q '^percorso=bloccato' "$RUN/dsp.stato" 2>/dev/null; then
			emit ATTENZIONE "Correzione ambientale" "non applicata, riproduzione BLOCCATA: $(cat "$RUN/correzione.errore") (CORREZIONE_SE_ASSENTE=diretto per suonare senza)"
		else
			emit ATTENZIONE "Correzione ambientale" "non applicata, il DAC riceve il segnale senza correzione: $(cat "$RUN/correzione.errore")"
		fi
	fi
	# FIR solo per alcune frequenze: i brani alle altre non suonano (blocca),
	# suonano senza FIR (diretto) o sono ricampionati (FIR_RICAMPIONA=si).
	if [ -f "$RUN/correzione.attiva" ] && [ -s "$RUN/correzione.avviso" ]; then
		emit ATTENZIONE "Filtri FIR per frequenza" "$(cat "$RUN/correzione.avviso")"
	fi
	if [ -f "$RUN/correzione.attiva" ]; then
		check_dsp_threads
		check_dsp_clipping
		check_dsp_underrun
		check_dsp_peaks
	fi
}

# Thread di CamillaDSP: tutti in real-time (SCHED_FIFO), come il player.
# Thread audio di CamillaDSP (come in sweetspot-player): con la nostra
# patch il thread di elaborazione si chiama "Processing"; senza, tutti i
# thread contano come audio.
check_dsp_threads() {
	local p t sched comm named total=0 rt=0 others=0 prios="" cpus="" c pplay="" pproc=""
	p=$(pidof camilladsp 2>/dev/null | cut -d' ' -f1)
	if [ -z "$p" ]; then
		emit INFO "CamillaDSP in real-time" "non in esecuzione: il player la riavvia"
		return
	fi
	named=0
	for t in "$PROC/$p"/task/*; do
		[ "$(cat "$t/comm" 2>/dev/null)" = Processing ] && named=1
	done
	for t in "$PROC/$p"/task/*; do
		[ -d "$t" ] || continue
		comm=$(cat "$t/comm" 2>/dev/null)
		sched=$(sed 's/.*) //' "$t/stat" 2>/dev/null | cut -d' ' -f38,39)
		if [ "$named" = 1 ]; then
			case "$comm" in
				FileCapture|RawFileCapture|Processing|AlsaPlayback|AlsaPlaybackInner) ;;
				*)
					# Un thread non audio in real-time sul core isolato e' un difetto.
					[ "${sched#* }" = 1 ] && others=$((others + 1))
					continue ;;
			esac
		fi
		total=$((total + 1))
		if [ "${sched#* }" = 1 ]; then
			rt=$((rt + 1))
			case "$comm" in
				AlsaPlayback) pplay=${sched% *} ;;
				Processing) pproc=${sched% *} ;;
			esac
			case " $prios " in *" ${sched% *} "*) ;; *) prios="$prios ${sched% *}" ;; esac
		fi
		c=$(sed -n 's/^Cpus_allowed_list:[[:space:]]*//p' "$t/status" 2>/dev/null)
		[ -n "$c" ] && [ -z "$cpus" ] && cpus=$c
	done
	[ -n "$cpus" ] || cpus=$(sed -n 's/^Cpus_allowed_list:[[:space:]]*//p' "$PROC/$p/status" 2>/dev/null)
	if [ -n "$pplay" ] && [ -n "$pproc" ] && [ "$pplay" -lt "$pproc" ]; then
		emit ATTENZIONE "CamillaDSP in real-time" "il thread di riproduzione (priorita' $pplay) e' sotto l'elaborazione ($pproc): sotto carico il DAC puo' andare in underrun; si sistema entro pochi secondi"
	elif [ "$total" -gt 0 ] && [ "$rt" = "$total" ] && [ "$others" = 0 ]; then
		emit OK "CamillaDSP in real-time" "$total thread audio a priorita'${prios} sul core ${cpus:-?}$([ "$named" = 1 ] && echo ', gli altri sui core di sistema')"
	elif [ "$total" -gt 0 ] && [ "$rt" = "$total" ]; then
		emit ATTENZIONE "CamillaDSP in real-time" "$total thread audio a priorita'${prios}, ma $others thread non audio ancora in real-time: si sistemano entro pochi secondi"
	else
		emit ATTENZIONE "CamillaDSP in real-time" "$rt di $total thread audio in real-time: la correzione puo' interrompersi sotto carico"
	fi
}

check_library() {
	local r ver songs albums scanning
	r=$(lms_json '' serverstatus 0 0) || { emit ATTENZIONE "Lyrion Music Server" "non risponde (si sta avviando?)"; return; }
	ver=$(printf '%s\n' "$r" | jq -r '.result.version // empty')
	songs=$(printf '%s\n' "$r" | jq -r '.result."info total songs" // 0')
	albums=$(printf '%s\n' "$r" | jq -r '.result."info total albums" // 0')
	scanning=$(printf '%s\n' "$r" | jq -r '.result.rescan // 0')
	emit OK "Lyrion Music Server" "versione $ver"
	if [ "$scanning" = 1 ]; then
		emit INFO "Libreria" "lettura in corso ($songs brani finora)"
	elif [ "$songs" -gt 0 ] 2>/dev/null; then
		emit OK "Libreria" "$songs brani, $albums album"
	else
		emit ATTENZIONE "Libreria" "vuota: collega un disco o aggiungi una cartella di rete in Musica"
	fi
	check_library_saving
}

# Salvataggio della libreria sulla chiavetta (sweetspot-dati) e cache delle
# copertine in RAM (sweetspot-lms): avvisi scritti da chi li rileva.
check_library_saving() {
	local free need art
	if [ -s "$RUN/dati.spazio" ]; then
		read -r free need _ < "$RUN/dati.spazio"
		emit ATTENZIONE "Salvataggio della libreria" "chiavetta piena: ${free:-?} MB liberi, ne servono ${need:-?}; libreria e impostazioni non vengono salvate (libera spazio sulla chiavetta)"
	fi
	art=$(cat "$RUN/lms.artwork.piena" 2>/dev/null)
	[ -n "$art" ] && emit ATTENZIONE "Copertine in RAM" "cache al ${art}%: le nuove copertine non si salvano fino al prossimo avvio (collega l'archivio musicale per metterle su disco)"
}

# Precarico della coda in RAM (sweetspot-precarico), dal riepilogo che scrive.
# Modalita' ascolto (pagina Sistema) e cosa sta facendo adesso.
check_listening() {
	local kind n=0
	case "$(listening_choice)" in
		no)
			emit INFO "Ascolto" "modalità spenta: lettura della libreria, copie e ripping continuano anche durante la musica"
			return ;;
		puro) kind="ascolto puro (coda in RAM, dischi fermi, lavori di fondo sospesi)" ;;
		*) kind="lavori di fondo sospesi durante la musica" ;;
	esac
	# Sospesi (SIGSTOP) e rallentati (cgroup) contano allo stesso modo.
	[ -s "$RUN/ascolto.fermi" ] && n=$(grep -c . "$RUN/ascolto.fermi")
	[ -s "$RUN/ascolto.lenti" ] && n=$((n + $(grep -c . "$RUN/ascolto.lenti")))
	if dac_playing; then
		emit OK "Ascolto" "$kind: ora $n lavori sospesi"
	else
		emit OK "Ascolto" "$kind: si attiva quando la musica suona"
	fi
}

check_preload() {
	local s stato detail
	s=$(cat "$RUN/precarico.json" 2>/dev/null)
	stato=$(printf '%s' "$s" | jq -r '.stato // empty' 2>/dev/null)
	detail=$(printf '%s' "$s" | jq -r '"\(.caricati) di \(.brani) brani in RAM, \(.mb) MB su \(.budget_mb) MB"
		+ (if .streaming > 0 then ", \(.streaming) in streaming" else "" end)
		+ (if .grandi > 0 then ", \(.grandi) oltre la dimensione massima" else "" end)
		+ (if .oltre > 0 then ", \(.oltre) oltre il budget" else "" end)
		+ (if .mancanti > 0 then ", \(.mancanti) non trovati" else "" end)
		+ (if .errori > 0 then ", \(.errori) non caricati" else "" end)
		+ (if .standby != "" then "; dischi in standby: \(.standby)" else "" end)' 2>/dev/null)
	case "$stato" in
		pronto) emit OK "Precarico in RAM" "coda completa: $detail" ;;
		caricamento) emit INFO "Precarico in RAM" "caricamento: $detail" ;;
		parziale) emit INFO "Precarico in RAM" "parziale, alcuni brani si leggono dal disco: $detail" ;;
		attesa) emit INFO "Precarico in RAM" "nessuna coda in riproduzione" ;;
		spento) emit INFO "Precarico in RAM" "spento (PRECARICO=no)" ;;
		*) emit ATTENZIONE "Precarico in RAM" "stato non disponibile" ;;
	esac
}

# Renderer UPnP/DLNA in entrata (usr/lib/sweetspot/renderer.pl), dal riepilogo
# che scrive. Acceso dalla pagina Sistema; l'audio passa da Lyrion.
check_renderer() {
	local s stato name port detail n
	if ! is_yes "$(conf RENDERER_UPNP no)"; then
		emit INFO "Renderer UPnP/DLNA" "spento (RENDERER_UPNP=no): acceso dalla pagina Sistema compare in BubbleUPnP, JPlay, mconnect"
		return
	fi
	if [ "$(mode)" = player ]; then
		emit ATTENZIONE "Renderer UPnP/DLNA" "serve Lyrion su questo Sweetspot: non funziona in modalità solo player"
		return
	fi
	s=$(cat "$RUN/renderer.json" 2>/dev/null)
	stato=$(printf '%s' "$s" | jq -r '.stato // empty' 2>/dev/null)
	name=$(printf '%s' "$s" | jq -r '.nome // empty' 2>/dev/null)
	port=$(printf '%s' "$s" | jq -r '.porta // empty' 2>/dev/null)
	detail=$(printf '%s' "$s" | jq -r '.dettaglio // empty' 2>/dev/null)
	n=$(printf '%s' "$s" | jq -r '.abbonati // 0' 2>/dev/null)
	case "$stato" in
		attivo) emit OK "Renderer UPnP/DLNA" "acceso come \"$name\" (porta $port, ${n:-0} app collegate): l'audio passa da Lyrion e dal player" ;;
		attesa) emit ATTENZIONE "Renderer UPnP/DLNA" "acceso ma non utilizzabile: ${detail:-in attesa di Lyrion}" ;;
		errore) emit ATTENZIONE "Renderer UPnP/DLNA" "non parte: ${detail:-errore}" ;;
		spento) emit ATTENZIONE "Renderer UPnP/DLNA" "acceso nelle impostazioni, il demone si avvia entro pochi secondi" ;;
		*) emit ATTENZIONE "Renderer UPnP/DLNA" "stato non disponibile: il demone non risponde" ;;
	esac
}

check_system() {
	local srv ip disks b t st wd
	emit INFO "Classe del computer" "$(machine_class) - $(cpu_model) - $(( $(mem_total_kb) / 1024 )) MB di RAM"
	wd=$SYS/class/watchdog/watchdog0
	if ! is_yes "$(conf WATCHDOG si)"; then
		emit INFO "Watchdog" "spento (WATCHDOG=no): un blocco totale richiede di spegnere a mano"
	elif [ "$(cat "$wd/state" 2>/dev/null)" = active ] && pidof watchdog >/dev/null 2>&1; then
		emit OK "Watchdog" "$(cat "$wd/identity" 2>/dev/null): riavvio dopo $(cat "$wd/timeout" 2>/dev/null) secondi di blocco totale"
	else
		emit ATTENZIONE "Watchdog" "non attivo: un blocco totale richiede di spegnere a mano"
	fi
	if [ -s "$RUN/aggiornamento/watchdog.ritorno" ]; then
		emit ATTENZIONE "Riavvii del watchdog" "due di seguito con questa copia: dal prossimo avvio parte la copia $(cat "$RUN/aggiornamento/watchdog.ritorno") (Sistema > aggiornamenti per cambiare)"
	elif [ -s "$RUN/aggiornamento/watchdog.riavvii" ]; then
		emit ATTENZIONE "Riavvii del watchdog" "l'ultimo avvio e' finito con un blocco totale; al secondo di seguito parte l'altra copia"
	fi
	if [ -s "$RUN/aggiornamento/fallita.motivo" ]; then
		m=$(cat "$RUN/aggiornamento/fallita.motivo")
		emit ATTENZIONE "Aggiornamento non confermato" "controllo fallito: ${m%%|*} (${m#*|})"
	fi
	ip=$(net_ipv4)
	if [ -n "$ip" ]; then emit OK "Rete" "indirizzo $ip"; else emit ATTENZIONE "Rete" "nessun indirizzo: il cavo e' collegato?"; fi
	if [ "$(mode)" = player ]; then
		srv=$(lms_server_ip)
		if [ -n "$srv" ]; then emit OK "Server Lyrion" "collegato a $srv"
		else emit ATTENZIONE "Server Lyrion" "non collegato"; fi
	elif [ -n "$ip" ]; then
		emit INFO "Interfaccia" "http://$ip/ oppure http://$(hostname).local/"
	fi
	for b in "$SYS"/block/sd*; do
		[ -d "$b" ] || continue
		[ "$(cat "$b/queue/rotational" 2>/dev/null)" = 1 ] || continue
		[ "$(cat "$b/removable" 2>/dev/null)" = 0 ] || continue
		case "$(readlink -f "$b/device")" in */usb*) continue ;; esac
		st=$(hdparm -C "/dev/${b##*/}" 2>/dev/null | sed -n 's/.*drive state is: *//p')
		disks="$disks ${b##*/}: ${st:-stato sconosciuto}"
	done
	[ -n "$disks" ] && emit INFO "Dischi meccanici" "${disks# }"
	for t in "$SYS"/class/hwmon/hwmon*; do
		case "$(cat "$t/name" 2>/dev/null)" in
			coretemp|k10temp)
				[ -f "$t/temp1_input" ] && emit INFO "Temperatura CPU" "$(( $(cat "$t/temp1_input") / 1000 )) gradi"
				break ;;
		esac
	done
}

# Bluetooth come sorgente: spento di serie; acceso, lo stato scritto dal
# servizio (sweetspot-bluetooth) dice se aspetta, e' in abbinamento o suona.
check_bluetooth() {
	local s
	if ! is_yes "$(conf BLUETOOTH no)"; then
		emit INFO "Bluetooth" "spento (si attiva dalla pagina Bluetooth)"
		return
	fi
	s=$(cat "$RUN/bluetooth.stato" 2>/dev/null)
	case "$s" in
		''|errore*|"non attivo"|nessun*) emit ATTENZIONE "Bluetooth" "${s:-servizio non ancora avviato}" ;;
		in\ ascolto*) emit OK "Bluetooth" "$s (il DAC e' del telefono, il player riprende alla fine)" ;;
		*) emit OK "Bluetooth" "$s" ;;
	esac
}

check_kernel
check_ram_system
check_cpu
check_quiet
check_usb
check_dac
check_player
check_bluetooth
[ "$(mode)" = completa ] && check_library
check_listening
[ "$(mode)" = completa ] && check_preload
check_renderer
check_system

if [ "$1" = "--dati" ]; then
	printf '%s' "$OUT"
else
	printf '%s' "$OUT" | while IFS='|' read -r esito voce dettaglio; do
		case "$esito" in
			OK) mark="  ok " ;;
			ATTENZIONE) mark=" (!) " ;;
			*) mark="     " ;;
		esac
		printf '%s %-28s %s\n' "$mark" "$voce" "$dettaglio"
	done
fi
