#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Sweetspot - modifica le impostazioni in sweetspot.txt sulla chiavetta.
#
#   sweetspot-config imposta CHIAVE VALORE [CHIAVE VALORE...]
#   sweetspot-config rimuovi CHIAVE [CHIAVE...]
#   sweetspot-config leggi CHIAVE
#   sweetspot-config ripristina    torna alle impostazioni iniziali
#
# Il file resta leggibile e modificabile con il Blocco note: le altre righe,
# i commenti e gli a capo in stile Windows vengono conservati.
# Esce con 0 se la modifica e' salvata sulla chiavetta, con 2 se vale solo
# fino al prossimo riavvio (chiavetta assente o in sola lettura).

. "${SWEETSPOT_LIB:-/usr/lib/sweetspot}/common.sh"

usage() { echo "uso: $0 imposta CHIAVE VALORE [CHIAVE VALORE...] | rimuovi CHIAVE... | leggi CHIAVE | ripristina" >&2; exit 1; }

# edit_file OPERAZIONE CHIAVE VALORE < origine > destinazione
edit_file() {
	OP=$1 KEY=$2 VAL=$3 awk '
		BEGIN { k = toupper(ENVIRON["KEY"]); op = ENVIRON["OP"]; done = 0 }
		{
			line = $0
			sub(/\r$/, "", line)
			t = line
			sub(/^[ \t]+/, "", t)
			head = toupper(substr(t, 1, length(k)))
			rest = substr(t, length(k) + 1)
			if (head == k && rest ~ /^[ \t]*=/) {
				if (op == "imposta" && !done) { print k "=" ENVIRON["VAL"] "\r"; done = 1 }
				next
			}
			print line "\r"
		}
		END { if (op == "imposta" && !done) print k "=" ENVIRON["VAL"] "\r" }
	'
}

# encode_value CHIAVE VALORE: stampa il valore come lo rilegge
# config_normalize. Nome e password del Wi-Fi sono letterali (ma gli spazi ai
# bordi vengono tolti alla lettura); gli altri valori perdono " #resto", gli
# spazi ai bordi e una coppia di virgolette: in quei casi li si racchiude fra
# virgolette. Esce con 1 se non e' rappresentabile.
encode_value() {
	local k v=$2 q
	k=$(printf '%s' "$1" | tr 'a-z' 'A-Z')
	case "$k" in
		WIFI_NOME|*PASSWORD)
			case "$v" in [[:space:]]*|*[[:space:]]) return 1 ;; esac
			printf '%s' "$v"; return 0 ;;
	esac
	case "$v" in
		[[:space:]]*|*[[:space:]]|*[[:space:]]'#'*|\"*\"|\'*\') ;;
		*) printf '%s' "$v"; return 0 ;;
	esac
	for q in '"' "'"; do
		case "$v" in *"$q"*) continue ;; esac
		printf '%s%s%s' "$q" "$v" "$q"; return 0
	done
	return 1
}

OP=$1
shift
case "$OP" in
	imposta) [ $# -ge 2 ] && [ $(($# % 2)) -eq 0 ] || usage ;;
	rimuovi) [ $# -ge 1 ] || usage ;;
	leggi) [ $# -eq 1 ] || usage ;;
	ripristina) [ $# -eq 0 ] || usage ;;
	*) usage ;;
esac

# Senza password web (anche per un ripristino o una rimozione solo in RAM) il
# dispositivo torna al primo accesso: codice nuovo su console e chiavetta.
reopen_onboarding() {
	[ -n "$(conf PASSWORD_WEB)" ] && return 0
	sweetspot-accesso avvio > /dev/null 2>&1 || log "primo accesso: codice non generato"
}

# Impostazioni iniziali: il sweetspot.txt dell'immagine sostituisce quello
# della chiavetta (con un rename: mai un file a meta'). Musica, archivio e
# filtri della correzione stanno in altre cartelle e restano.
if [ "$OP" = ripristina ]; then
	tpl=${SWEETSPOT_AVVIO:-/usr/share/sweetspot/avvio}/sweetspot.txt
	[ -f "$tpl" ] || { echo "modello delle impostazioni mancante" >&2; exit 1; }
	mkdir -p "$RUN"
	exec 9> "$RUN/config.lock"
	flock 9
	saved=2
	if stick_mount rw; then
		cp "$tpl" "$STICK_MNT/sweetspot.tmp" && sync && mv "$STICK_MNT/sweetspot.tmp" "$STICK_MNT/sweetspot.txt" && saved=0
		stick_umount
	fi
	cp "$tpl" "$RUN/sweetspot.txt"
	chmod 600 "$RUN/sweetspot.txt" 2>/dev/null
	config_build "$RUN/sweetspot.txt"
	log "impostazioni: ripristinate quelle iniziali"
	reopen_onboarding
	exit $saved
fi

# Controlla tutte le chiavi e i valori prima di cambiare qualcosa.
check_key() {
	case "$1" in
		''|*[!A-Za-z0-9_]*) echo "chiave non valida: $1" >&2; exit 1 ;;
	esac
}
if [ "$OP" = leggi ]; then
	check_key "$1"
	conf "$(printf '%s' "$1" | tr 'a-z' 'A-Z')"
	echo
	exit 0
fi
n=$#
i=0
while [ $i -lt $n ]; do
	check_key "$1"
	if [ "$OP" = imposta ]; then
		valid_value "$2" || { echo "valore non valido" >&2; exit 1; }
		encode_value "$1" "$2" > /dev/null || { echo "valore non rappresentabile in sweetspot.txt: $1" >&2; exit 1; }
		set -- "$@" "$1" "$2"
		shift 2
		i=$((i + 2))
	else
		set -- "$@" "$1"
		shift
		i=$((i + 1))
	fi
done

# Applica le modifiche (argomenti rimasti: coppie o chiavi) a SORGENTE,
# scrivendo DESTINAZIONE.
edit_all() { # sorgente destinazione chiavi/valori...
	local src=$1 dst=$2 key
	shift 2
	cp "$src" "$dst.1" || return 1
	while [ $# -gt 0 ]; do
		key=$(printf '%s' "$1" | tr 'a-z' 'A-Z')
		if [ "$OP" = imposta ]; then
			edit_file "$OP" "$key" "$(encode_value "$key" "$2")" < "$dst.1" > "$dst.2" || return 1
			shift 2
		else
			edit_file "$OP" "$key" "" < "$dst.1" > "$dst.2" || return 1
			shift
		fi
		mv "$dst.2" "$dst.1"
	done
	mv "$dst.1" "$dst"
}

# Un altro file (es. le impostazioni copiate sul disco interno durante
# l'installazione): si modifica solo quello.
if [ -n "${SWEETSPOT_CONFIG_FILE:-}" ]; then
	f=$SWEETSPOT_CONFIG_FILE
	[ -f "$f" ] || : > "$f"
	edit_all "$f" "$f.tmp" "$@" && fat_sostituisci "$f.tmp" "$f"
	exit $?
fi

mkdir -p "$RUN"
saved=2
exec 9> "$RUN/config.lock"
flock 9
if stick_mount rw; then
	src="$STICK_MNT/sweetspot.txt"
	[ -f "$src" ] || : > "$src"
	if edit_all "$src" "$STICK_MNT/sweetspot.tmp" "$@" && fat_sostituisci "$STICK_MNT/sweetspot.tmp" "$src"; then
		cp "$src" "$RUN/sweetspot.txt"
		saved=0
	fi
	rm -f "$STICK_MNT/sweetspot.tmp.1" "$STICK_MNT/sweetspot.tmp.2"
	stick_umount
fi
if [ $saved -ne 0 ]; then
	# Senza chiavetta la modifica vale fino al riavvio.
	[ -f "$RUN/sweetspot.txt" ] || : > "$RUN/sweetspot.txt"
	edit_all "$RUN/sweetspot.txt" "$RUN/sweetspot.tmp" "$@" && mv "$RUN/sweetspot.tmp" "$RUN/sweetspot.txt"
fi
chmod 600 "$RUN/sweetspot.txt" 2>/dev/null # contiene le password: solo root
config_build "$RUN/sweetspot.txt"
reopen_onboarding
while [ $# -gt 0 ]; do
	case "$(printf %s "$1" | tr a-z A-Z)" in
		*PASSWORD*) log "impostazioni: $OP $1" ;;
		*) if [ "$OP" = imposta ]; then log "impostazioni: $OP $1=$2"; else log "impostazioni: $OP $1"; fi ;;
	esac
	if [ "$OP" = imposta ]; then shift 2; else shift; fi
done
exit $saved
