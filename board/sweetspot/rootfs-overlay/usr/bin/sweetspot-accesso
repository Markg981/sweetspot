#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Sweetspot - password delle pagine web (utente "admin").
#
#   sweetspot-accesso applica          scrive la configurazione dell'httpd di
#                                      BusyBox da PASSWORD_WEB e gliela fa
#                                      rileggere (SIGHUP)
#   sweetspot-accesso hash PASSWORD    impronta SHA-512-crypt da salvare
#   sweetspot-accesso verifica [IP]    legge la password dall'ingresso
#                                      standard (non compare tra gli
#                                      argomenti) e risponde 0 se e' quella
#                                      di PASSWORD_WEB, 1 se no (o se ci
#                                      sono stati troppi errori di fila)
#   sweetspot-accesso avvio           all'avvio: senza PASSWORD_WEB prepara
#                                      il primo accesso (codice casuale)
#   sweetspot-accesso primo            legge dall'ingresso standard il codice
#                                      e la password scelta (due righe):
#                                      con il codice giusto salva la password
#
# Primo accesso: non esiste una password predefinita. Se PASSWORD_WEB e'
# vuota, all'avvio si genera un codice casuale di 12 caratteri (unico per
# questo dispositivo, resta lo stesso finche' non si sceglie la password):
# compare sulla console, in /run/sweetspot/primo-accesso.codice (solo root)
# e nel file PRIMO-ACCESSO.txt sulla chiavetta, cosi' lo si legge anche
# senza schermo. Finche' non si sceglie la password (minimo 10 caratteri) le
# pagine mostrano solo "Primo accesso" (/cgi-bin/primo-accesso).
# Con una password, ogni pagina e ogni azione chiedono
# l'accesso (/cgi-bin/accesso, sessione con cookie: vedi web.sh). La
# password si verifica qui, da root: le pagine non leggono l'impronta.
# Non protegge da chi ascolta il traffico (http). In sweetspot.txt si puo'
# scrivere la password in chiaro: all'avvio viene sostituita dalla sua
# impronta; dalle pagine si salva solo l'impronta SHA-512-crypt ($6$...).
# Le vecchie impronte MD5-crypt ($1$...) si recuperano in fretta da chi ha
# la chiavetta in mano: valgono ancora una volta, al primo accesso giusto
# vengono riscritte come SHA-512-crypt. Password dimenticata: togli la
# riga PASSWORD_WEB da sweetspot.txt con il computer: al riavvio il codice
# di primo accesso torna disponibile (stessa chiavetta, stesso codice).
# Lyrion (9000 e CLI 9090) ha credenziali proprie: vedi sweetspot-lms credenziali.
#
# La pagina /cgi-bin/vivo (risponde solo "ok" e la copia in uso) serve a
# sweetspot-aggiorna per confermare che una versione appena installata e'
# partita: con la password avrebbe risposto 401 e ogni aggiornamento sarebbe
# stato annullato. Per quella sola pagina vale anche un utente "sweetspot"
# con una chiave casuale di questo avvio, in $RUN/vivo.chiave (solo root):
# l'httpd di BusyBox applica la regola con il percorso piu' lungo.
#
# Il resto del sito non e' piu' protetto dall'autenticazione Basic dell'httpd
# ma dalla sessione delle pagine: httpd.conf contiene solo la regola di vivo.
#
# L'httpd e le pagine girano come utente "web": httpd.conf e' root:web 0640
# (l'httpd lo rilegge dopo aver lasciato root), la chiave di vivo resta
# 0600 root perche' la legge solo sweetspot-aggiorna.

. "${SWEETSPOT_LIB:-/usr/lib/sweetspot}/common.sh"

HTTPD_CONF=$RUN/httpd.conf
VIVO_KEY=$RUN/vivo.chiave

# Impronta SHA-512-crypt ($6$sale$...), sale casuale scelta da mkpasswd.
# La password passa da stdin (-P 0), mai da argv: /proc/*/cmdline e ps la
# mostrerebbero a tutti.
hash() {
	local h
	h=$(printf '%s\n' "$1" | mkpasswd -m sha512 -P 0 2>/dev/null) || return 1
	case "$h" in
		'$6$'*) printf '%s\n' "$h" ;;
		*) return 1 ;;
	esac
}

random_key() {
	od -An -N16 -tx1 "${SWEETSPOT_URANDOM:-/dev/urandom}" 2>/dev/null | tr -d ' \n'
}

apply() {
	local pw key
	mkdir -p "$RUN"
	pw=$(conf PASSWORD_WEB)
	if [ -z "$pw" ]; then
		: > "$HTTPD_CONF.nuovo"
		rm -f "$VIVO_KEY"
	else
		key=$(random_key)
		[ ${#key} -eq 32 ] || return 1
		# La chiave prima della regola: quando la regola vale, la chiave c'e'.
		printf '%s\n' "$key" > "$VIVO_KEY.nuovo"
		chmod 600 "$VIVO_KEY.nuovo"
		mv "$VIVO_KEY.nuovo" "$VIVO_KEY"
		printf '/cgi-bin/vivo:sweetspot:%s\n' "$key" > "$HTTPD_CONF.nuovo"
	fi
	# L'httpd gira come "web" (httpd -u) e rilegge questo file con SIGHUP:
	# gruppo web in sola lettura. Contiene la chiave di
	# /cgi-bin/vivo, che da sola non apre altro. Senza il gruppo web (test) resta solo di root.
	if chgrp web "$HTTPD_CONF.nuovo" 2>/dev/null; then
		chmod 640 "$HTTPD_CONF.nuovo"
	else
		chmod 600 "$HTTPD_CONF.nuovo"
	fi
	mv "$HTTPD_CONF.nuovo" "$HTTPD_CONF"
	killall -HUP httpd 2>/dev/null
	return 0
}

# crypt_check METODO PREFISSO IMPRONTA PASSWORD: rifa l'impronta con la
# stessa sale e la confronta.
crypt_check() {
	local salt calc
	salt=${3#"$2"}
	salt=${salt%%'$'*}
	calc=$(printf '%s\n' "$4" | mkpasswd -m "$1" -S "$salt" -P 0 2>/dev/null) || return 1
	[ "$calc" = "$3" ]
}

# Password giusta ma salvata in chiaro o come MD5-crypt: si riscrive come
# SHA-512-crypt. L'accesso vale anche se la riscrittura non riesce (si
# riprova al prossimo).
upgrade() {
	local h
	if h=$(hash "$1"); then
		sweetspot-config imposta PASSWORD_WEB "$h" >/dev/null 2>&1
		case $? in
			0|2) log "accesso: password riscritta come SHA-512-crypt"; return 0 ;;
		esac
	fi
	log "accesso: password non riscritta come SHA-512-crypt"
	return 0
}

# Limite dei tentativi tenuto da root, per sorgente (IP del client, argomento
# di "verifica"): un contatore comune permetterebbe a chiunque nella rete di
# bloccare l'amministratore, come web.sh dice di non poter fare. Le pagine
# contano i loro (per indirizzo) in una cartella che l'utente web puo'
# scrivere, e "verifica" si puo' chiamare anche direttamente dall'helper: qui
# le verifiche passano una alla volta (il che frena anche chi cambia sorgente
# a ogni tentativo: una pausa per errore, in tutto), ogni errore costa una
# pausa e, dopo VERIFICA_LIBERI errori di fila dalla stessa sorgente, si
# rifiuta senza guardare la password finche' non passa l'attesa (30 secondi
# per errore in piu', al massimo 15 minuti, come in web.sh). I contatori fermi
# da piu' di VERIFICA_VECCHIO minuti si cancellano.
# L'ambiente lo ripulisce l'helper: le variabili valgono solo per i test.
VERIFICA_ERRORI=$RUN/accesso.errori
VERIFICA_LIBERI=${SWEETSPOT_VERIFICA_LIBERI:-20}
VERIFICA_PAUSA=${SWEETSPOT_VERIFICA_PAUSA:-2}
VERIFICA_VECCHIO=${SWEETSPOT_VERIFICA_VECCHIO:-30}

verify() {
	local pw n last w src file
	# Sorgente: solo caratteri da indirizzo (finisce in un nome di file).
	src=$(printf '%s' "${1:-locale}" | tr -c 'a-zA-Z0-9.:-' '_' | cut -c1-64)
	[ -n "$src" ] || src='locale'
	file=$VERIFICA_ERRORI.$src
	IFS= read -r pw
	mkdir -p "$RUN"
	exec 8> "$RUN/accesso.verifica.lock"
	flock 8
	find "$RUN" -maxdepth 1 -name 'accesso.errori.*' -mmin "+$VERIFICA_VECCHIO" -exec rm -f {} + 2>/dev/null
	n="" last=""
	[ -f "$file" ] && read -r n last < "$file"
	case "$n" in *[!0-9]*|'') n=0 ;; esac
	case "$last" in *[!0-9]*|'') last=0 ;; esac
	if [ "$n" -ge "$VERIFICA_LIBERI" ]; then
		w=$(( (n - VERIFICA_LIBERI + 1) * 30 ))
		[ "$w" -gt 900 ] && w=900
		if [ $((last + w)) -gt "$(date +%s)" ]; then
			sleep "$VERIFICA_PAUSA"
			return 1
		fi
	fi
	if verify_password "$pw"; then
		rm -f "$file"
		return 0
	fi
	printf '%s %s\n' "$((n + 1))" "$(date +%s)" > "$file"
	sleep "$VERIFICA_PAUSA"
	return 1
}

# Password in ingresso contro PASSWORD_WEB: impronta SHA-512-crypt
# ($6$sale$...) o MD5-crypt ($1$sale$..., poi riscritta), rifatta con la
# stessa sale; se in sweetspot.txt e' in chiaro (e l'avvio non l'ha ancora
# trasformata) si confronta com'e' e si riscrive. Altre impronte ($id$...)
# si rifiutano: confrontate in chiaro, l'impronta stessa aprirebbe le pagine.
verify_password() {
	local pw=$1 stored
	stored=$(conf PASSWORD_WEB)
	[ -n "$stored" ] && [ -n "$pw" ] || return 1
	case "$stored" in
		'$6$'*) crypt_check sha512 '$6$' "$stored" "$pw" ;;
		'$1$'*) crypt_check md5 '$1$' "$stored" "$pw" && upgrade "$pw" ;;
		'$'*'$'*'$'*) return 1 ;;
		*) [ "$pw" = "$stored" ] && upgrade "$pw" ;;
	esac
}

# Avvio con la password in chiaro in sweetspot.txt: la si sostituisce subito
# con l'impronta, cosi' non resta leggibile sulla chiavetta.
upgrade_plain() {
	local stored
	stored=$(conf PASSWORD_WEB)
	case "$stored" in
		''|'$'*'$'*'$'*) return 0 ;;
	esac
	upgrade "$stored"
}

PRIMO_CODICE=$RUN/primo-accesso.codice
PRIMO_ATTIVO=$RUN/primo-accesso.attivo
PRIMO_FILE=PRIMO-ACCESSO.txt
PASSWORD_MIN=10

# Codice casuale: 12 caratteri da un alfabeto di 32 senza I, O, 0, 1 (256 e'
# multiplo di 32: nessuna distorsione). Stampato come XXXX-XXXX-XXXX.
new_code() {
	od -An -v -N12 -tu1 "${SWEETSPOT_URANDOM:-/dev/urandom}" 2>/dev/null | awk '
		BEGIN { a = "23456789ABCDEFGHJKLMNPQRSTUVWXYZ"; n = 0 }
		{ for (i = 1; i <= NF; i++) { printf "%s", substr(a, ($i % 32) + 1, 1); if (++n % 4 == 0 && n < 12) printf "-" } }
		END { if (n != 12) exit 1 }'
}

code_norm() { printf '%s' "$1" | tr 'a-z' 'A-Z' | tr -d ' -'; }

valid_code() {
	local n
	n=$(code_norm "$1")
	case "$n" in
		*[!23456789ABCDEFGHJKLMNPQRSTUVWXYZ]*|'') return 1 ;;
	esac
	[ ${#n} -eq 12 ]
}

# Avvio: con password niente da fare (e si toglie il codice rimasto); senza,
# primo accesso attivo con il codice della chiavetta o uno nuovo.
boot_setup() {
	local code="" f
	mkdir -p "$RUN"
	if [ -n "$(conf PASSWORD_WEB)" ]; then
		rm -f "$PRIMO_CODICE" "$PRIMO_ATTIVO"
		upgrade_plain
		return 0
	fi
	if stick_mount rw 2>/dev/null; then
		f=$STICK_MNT/$PRIMO_FILE
		if [ -f "$f" ]; then
			code=$(sed -n 's/^[Cc]odice[^:]*: *//p' "$f" | tr -d '\r' | head -n 1)
			valid_code "$code" || code=""
		fi
		if [ -z "$code" ]; then
			code=$(new_code) || { stick_umount; return 1; }
			printf 'Sweetspot - primo accesso\r\n\r\nCodice: %s\r\n\r\nApri http://sweetspot.local/ (o l indirizzo del dispositivo), inserisci il codice e scegli la password.\r\nIl codice vale solo finche non scegli la password; poi questo file viene cancellato.\r\n' "$code" > "$f.tmp" &&
				sync && mv "$f.tmp" "$f"
		fi
		stick_umount
	fi
	[ -n "$code" ] || code=$(sed -n 1p "$PRIMO_CODICE" 2>/dev/null)
	valid_code "$code" || code=$(new_code) || return 1
	( umask 077; printf '%s\n' "$code" > "$PRIMO_CODICE.nuovo" ) && mv "$PRIMO_CODICE.nuovo" "$PRIMO_CODICE"
	: > "$PRIMO_ATTIVO"
	chmod 644 "$PRIMO_ATTIVO"
	for f in ${SWEETSPOT_CONSOLE-/dev/console /dev/tty1}; do
		[ -w "$f" ] && printf '\nSweetspot - PRIMO ACCESSO\nCodice: %s\nApri le pagine di Sweetspot dal telefono o dal computer e scegli la password.\n\n' "$code" > "$f" 2>/dev/null
	done
	log "primo accesso: codice generato (console e chiavetta)"
	return 0
}

# Codice + password nuova (due righe dall'ingresso). 0 = salvata; 1 = codice
# errato o non in attesa; 2 = password troppo corta o non valida.
first_access() {
	local code pw expected h
	IFS= read -r code
	IFS= read -r pw
	[ -f "$PRIMO_ATTIVO" ] && [ -z "$(conf PASSWORD_WEB)" ] || return 1
	expected=$(sed -n 1p "$PRIMO_CODICE" 2>/dev/null)
	[ -n "$expected" ] && [ "$(code_norm "$code")" = "$(code_norm "$expected")" ] || return 1
	[ ${#pw} -ge "$PASSWORD_MIN" ] && valid_value "$pw" || return 2
	h=$(hash "$pw") && [ -n "$h" ] || return 2
	sweetspot-config imposta PASSWORD_WEB "$h" >/dev/null 2>&1
	[ $? -ne 1 ] || return 2
	rm -f "$PRIMO_CODICE" "$PRIMO_ATTIVO"
	if stick_mount rw 2>/dev/null; then
		rm -f "$STICK_MNT/$PRIMO_FILE"
		sync
		stick_umount
	fi
	apply
	log "primo accesso: password scelta"
	return 0
}

[ "${SWEETSPOT_TEST:-}" = 1 ] && return 0

case "$1" in
	applica) apply ;;
	hash) hash "${2:?password}" ;;
	verifica) verify "${2:-}" ;;
	avvio) boot_setup ;;
	primo) first_access ;;
	*) echo "uso: $0 applica | hash PASSWORD | verifica | avvio | primo" >&2; exit 1 ;;
esac
