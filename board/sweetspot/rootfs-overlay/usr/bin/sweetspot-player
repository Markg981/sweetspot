#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Sweetspot - supervisore della riproduzione: avvia squeezelite sul DAC e
# lo segue (DAC scollegato, ricollegato, cambiato).
#
# Modalita' completa: il server e' Lyrion su questa stessa macchina.
# Modalita' player: il server e' un Lyrion Music Server su un altro computer.
#
# Percorso del segnale:
#   - uscita ALSA diretta sul dispositivo hardware (hw:), mai plug o dmix;
#   - volume fisso al 100% (bit-perfect), salvo scelta diversa;
#   - buffer di ingresso e uscita in RAM per anticipare lettura e decodifica;
#     la dimensione del buffer non garantisce il precaricamento dell'intero brano;
#   - thread di riproduzione in real-time sul core isolato;
#   - interruzioni del controller USB del DAC sul loro core dedicato.

. "${SWEETSPOT_LIB:-/usr/lib/sweetspot}/common.sh"

SQLOG=/var/log/squeezelite.log
DSPLOG=${SWEETSPOT_DSPLOG:-/var/log/camilladsp.log}
CAMILLADSP=${SWEETSPOT_CAMILLADSP:-/usr/bin/camilladsp}
STATE=$RUN/player.stato

# Ritardo prima di riavviare squeezelite terminato da solo: raddoppia
# (2, 4, 8... fino a 60 s) se e' durato meno di STABILE secondi, si azzera dopo
# un periodo di funzionamento stabile.
STABILE=30
backoff_next() { # ritardo precedente, secondi di vita
	if [ "$2" -ge "$STABILE" ]; then echo 0; return; fi
	if [ "$1" -lt 2 ]; then echo 2; return; fi
	if [ "$1" -ge 30 ]; then echo 60; else echo $(( $1 * 2 )); fi
}

say() { echo "$1" > "$STATE"; log "player: $1"; }

is_number() { case "$1" in ''|*[!0-9]*) return 1 ;; esac; return 0; }

num_conf() {
	local v
	v=$(conf "$1" "$2")
	is_number "$v" || v=$2
	printf '%s' "$v"
}

# Core da usare: quelli effettivamente isolati da questo avvio.
setup_layout() {
	ISOLATED=$(expand_list "$(cat "$SYS/devices/system/cpu/isolated" 2>/dev/null)")
	cpu_layout
	if [ -z "$ISOLATED" ] || safe_mode; then
		PIN=0
		HK=$(join_list "$(cpu_online)")
	else
		PIN=1
		HK=$(join_list "$LAYOUT_HK")
	fi
}

# Interruzioni del controller USB del DAC: core dedicato e priorita' alta.
setup_usb_irq() {
	local card=$1 bdf irqs irq target prio p comm usbdev
	usbdev=$(dac_usb_device "$card")
	[ -n "$usbdev" ] && [ -f "$usbdev/power/control" ] && put on "$usbdev/power/control"
	bdf=$(dac_controller "$card")
	[ -n "$bdf" ] || return 0
	irqs=$(pci_irqs "$bdf")
	prio=$(num_conf PRIORITA_IRQ_USB 90)
	if [ "$PIN" = 1 ]; then target=$LAYOUT_IRQ; else target=""; fi
	echo "$bdf $irqs" > "$RUN/dac.controller"
	for irq in $irqs; do
		[ -n "$target" ] && put "$target" "$PROC/irq/$irq/smp_affinity_list"
		for p in "$PROC"/[0-9]*; do
			comm=$(cat "$p/comm" 2>/dev/null) || continue
			case "$comm" in
				"irq/$irq-"*) chrt -f -p "$prio" "${p##*/}" >/dev/null 2>&1 ;;
			esac
		done
	done
	log "player: controller USB $bdf, interruzioni $irqs sul core ${target:-di sistema}"
}

# --- Parametri condivisi fra DAC principale e zone ----------------------------------
#
# Cio' che non dipende dal percorso del segnale (CamillaDSP, volume a 64 bit,
# DSD nativo, core isolato) si calcola qui una volta sola: le zone non possono
# divergere dal DAC principale.

# Buffer ALSA in ms (BUFFER_ALSA_MS, limitato a 20..499).
alsa_buffer_ms() {
	local alsa
	alsa=$(num_conf BUFFER_ALSA_MS 400)
	[ "$alsa" -gt 499 ] && alsa=499
	[ "$alsa" -lt 20 ] && alsa=20
	printf '%s' "$alsa"
}

# Formato di uscita forzato (FORMATO_USCITA) o vuoto per la scelta automatica.
output_format() {
	case "$(conf FORMATO_USCITA auto)" in 16|24|24_3|32) conf FORMATO_USCITA ;; *) printf '' ;; esac
}

# Frequenza massima annunciata a Lyrion (HELO MaxSampleRate, dal -r di
# Squeezelite o dal probe del DAC): sopra, Lyrion ricampiona lato server con
# sox. FREQUENZA_MAX puo' solo abbassarla. Vuota se non nota.
announced_max_rate() { # scheda
	local top maxrate
	maxrate=$(num_conf FREQUENZA_MAX 0)
	top=$(dac_rates "$1" 2>/dev/null | tr ' ' '\n' | grep . | sort -n | tail -n 1)
	if [ "$maxrate" -gt 0 ] && { [ -z "$top" ] || [ "$maxrate" -lt "$top" ]; }; then top=$maxrate; fi
	printf '%s' "$top"
}

# Argomenti di Squeezelite uguali per DAC principale e zone, uno per riga
# (nessuno contiene spazi): buffer di ingresso/uscita, thread real-time,
# registro (decode=info: resample.c scrive "resampling from X -> Y" con questo
# livello, che Stato usa per segnalare il ricampionamento), frequenza massima
# e pausa fra frequenze diverse, ricampionamento facoltativo o di ripiego,
# uscita hw: senza plughw:. Con dsp (solo DAC principale con CamillaDSP)
# niente ripiego ne' -H: il dispositivo ALSA e' quello di CamillaDSP.
common_args() { # scheda registro priorita' buffer_alsa_ms dsp [buffers_nel_registro]
	local rate_ms maxrate rs alsa=$4 dsp=$5
	rate_ms=$(num_conf PAUSA_FREQUENZA_MS 0)
	maxrate=$(num_conf FREQUENZA_MAX 0)
	printf '%s\n' -b "$(PLAYER_BUFFERS_LOG=${6:-0} player_buffers)" -C 30 -p "$3" \
		-d output=info -d decode=info -f "$2"
	# Pausa fra brani a frequenza diversa: Squeezelite svuota il buffer ALSA
	# (patch 0005) prima di riaprire il DAC; la pausa minima e' quanto il
	# buffer reale impiega a uscire, PAUSA_FREQUENZA_MS puo' solo allungarla.
	[ "$rate_ms" -lt "$alsa" ] && rate_ms=$alsa
	if [ "$maxrate" -gt 0 ]; then printf '%s\n' -r "$maxrate:$rate_ms"; else printf '%s\n' -r ":$rate_ms"; fi
	rs=$(resample_args)
	[ -n "$rs" ] && printf '%s\n' -R "$rs"
	# Ricampiona solo se il DAC non puo' (flag E di Squeezelite): le frequenze
	# supportate restano bit-perfect, le altre vanno a una che il DAC accetta
	# invece di bloccarsi con -H. FREQUENZA_NON_SUPPORTATA=blocca mantiene il
	# rifiuto stretto (la pagina Stato mostra lo stallo).
	if [ -z "$rs" ] && [ -z "$dsp" ]; then
		if [ "$(lower "$(conf FREQUENZA_NON_SUPPORTATA ricampiona)")" = blocca ]; then
			log "player: frequenza non supportata dal DAC: rifiuto stretto (FREQUENZA_NON_SUPPORTATA=blocca)"
		else
			printf '%s\n' -R vLE
		fi
	fi
	# Originale (niente ricampionamento, uscita diretta hw:): Squeezelite non
	# deve ripiegare su plughw: se il DAC rifiuta la frequenza, altrimenti ALSA
	# ricampiona di nascosto. Con -H si ferma e scrive l'errore nel registro.
	[ -z "$rs" ] && [ -z "$dsp" ] && printf '%s\n' -H
	return 0
}

# Capacita' di ogni player (principale e zone) in $RUN/capacita/<nome>, righe
# chiave=valore: cosa il percorso fa davvero su quel DAC. Dove la parita' con
# il principale non e' possibile (CamillaDSP, volume a 64 bit, DSD nativo,
# core isolato) lo dice qui; Stato lo mostra.
CAP_DIR=$RUN/capacita

cap_write() { # nome chiave=valore...
	local f=$CAP_DIR/$1
	shift
	mkdir -p "$CAP_DIR"
	printf '%s\n' "$@" > "$f.nuovo" && mv "$f.nuovo" "$f"
}

# Sposta il thread real-time di squeezelite sul core della riproduzione.
# Squeezelite lo crea dopo aver preparato i buffer: si riprova a ogni giro
# di sorveglianza finche' non compare.
pin_output_thread() {
	local pid=$1 t policy
	[ "$PIN" = 1 ] || return 0
	[ -f "$RUN/audio.tid" ] && [ -d "$PROC/$pid/task/$(cat "$RUN/audio.tid")" ] && return 0
	for t in "$PROC/$pid"/task/*; do
		policy=$(sed 's/.*) //' "$t/stat" 2>/dev/null | cut -d' ' -f39)
		if [ "$policy" = 1 ]; then
			taskset -p -c "$LAYOUT_AUDIO" "${t##*/}" >/dev/null 2>&1
			echo "${t##*/}" > "$RUN/audio.tid"
			log "player: thread di riproduzione ${t##*/} sul core $LAYOUT_AUDIO"
			return 0
		fi
	done
	return 1
}

# Priorita' real-time di CamillaDSP: sotto quella del player (che lo
# alimenta) e delle interruzioni USB, mai fuori da 1..98. E' quella del
# thread di riproduzione, il piu' vicino al DAC.
dsp_priority() {
	local p
	p=$(num_conf PRIORITA_DSP 70)
	[ "$p" -ge 1 ] || p=1
	[ "$p" -le 98 ] || p=98
	printf '%s' "$p"
}

# Priorita' di un thread audio di CamillaDSP, per ruolo (con i thread dai
# nomi della nostra patch): la riproduzione sul DAC ha la piu' alta
# (PRIORITA_DSP), l'elaborazione una in meno, la cattura due in meno. Il
# thread di riproduzione non deve mai avere meno di quello che lo alimenta:
# se e' piu' basso, sotto carico l'elaborazione lo affama e il DAC va in
# underrun. Senza i nomi (named=0) tutti i thread hanno PRIORITA_DSP.
dsp_thread_priority() { # comm named
	local p
	p=$(dsp_priority)
	if [ "$2" = 1 ]; then
		case "$1" in
			AlsaPlayback|AlsaPlaybackInner) ;;
			Processing) p=$((p - 1)) ;;
			*) p=$((p - 2)) ;;
		esac
	fi
	[ "$p" -ge 1 ] || p=1
	printf '%s' "$p"
}

# Thread audio di CamillaDSP, dal nome (comm): cattura dallo stdin del
# plugin, elaborazione (nome dato dalla nostra patch), riproduzione ALSA.
# Gli altri (principale, segnali, websocket e le sue connessioni) non
# toccano l'audio.
dsp_audio_thread() { # comm
	case "$1" in FileCapture|RawFileCapture|Processing|AlsaPlayback|AlsaPlaybackInner) return 0 ;; esac
	return 1
}

# Core consentiti a un thread (Cpus_allowed_list) e "PRIORITA' POLITICA".
thread_cpus() { sed -n 's/^Cpus_allowed_list:[[:space:]]*//p' "$1/status" 2>/dev/null; }
thread_sched() { sed 's/.*) //' "$1/stat" 2>/dev/null | cut -d' ' -f38,39; }

# CamillaDSP (correzione ambientale o volume a 64 bit): una sola istanza per
# sessione, avviata da questo supervisore (start_dsp) con i core di sistema.
# Qui i suoi thread audio passano sul core della riproduzione in real-time
# sotto il player (SCHED_FIFO, PRIORITA_DSP e i gradini di
# dsp_thread_priority); gli altri (principale, segnali, websocket,
# connessioni di sweetspot-camilla) restano sui core di sistema con la
# priorita' normale: sul core isolato gira solo l'audio. Senza thread
# "Processing" (CamillaDSP senza la nostra patch) si trattano tutti come
# audio, come prima. Un thread gia' a posto non si tocca; si controlla a
# ogni giro.
pin_dsp() {
	local p t tid prio comm named audio
	[ -f "$RUN/correzione.attiva" ] || return 0
	for p in $(pidof camilladsp 2>/dev/null); do
		oom_adj -1000 "$p"
		named=0
		for t in "$PROC/$p"/task/*; do
			[ "$(cat "$t/comm" 2>/dev/null)" = Processing ] && named=1
		done
		for t in "$PROC/$p"/task/*; do
			[ -d "$t" ] || continue
			tid=${t##*/}
			comm=$(cat "$t/comm" 2>/dev/null)
			if [ "$named" = 1 ] && ! dsp_audio_thread "$comm"; then audio=0; else audio=1; fi
			if [ "$audio" = 1 ]; then
				prio=$(dsp_thread_priority "$comm" "$named")
				[ "$PIN" = 1 ] && [ "$(thread_cpus "$t")" != "$LAYOUT_AUDIO" ] &&
					taskset -p -c "$LAYOUT_AUDIO" "$tid" >/dev/null 2>&1
				[ "$(thread_sched "$t")" = "$prio 1" ] || chrt -f -p "$prio" "$tid" >/dev/null 2>&1
			else
				[ "$PIN" = 1 ] && [ "$(thread_cpus "$t")" != "$HK" ] &&
					taskset -p -c "$HK" "$tid" >/dev/null 2>&1
				[ "$(thread_sched "$t")" = "0 0" ] || chrt -o -p 0 "$tid" >/dev/null 2>&1
			fi
		done
		if [ "$(cat "$RUN/dsp.pid" 2>/dev/null)" != "$p" ]; then
			echo "$p" > "$RUN/dsp.pid"
			if [ "$PIN" = 1 ]; then
				log "player: CamillaDSP $p, thread audio in real-time (priorita' $(dsp_priority), elaborazione e cattura sotto) sul core $LAYOUT_AUDIO, gli altri sui core $HK"
			else
				log "player: CamillaDSP $p, thread audio in real-time (priorita' $(dsp_priority))"
			fi
		fi
	done
}

# Un'unica istanza di CamillaDSP per sessione. La avvia il supervisore (non
# il thread real-time di Squeezelite) sui core di sistema; legge i campioni
# dalla pipe $DSP_FIFO, aperta in lettura e scrittura cosi' non vede mai
# la fine del file tra un brano e l'altro. Il plugin cdsp vi scrive i
# campioni e, a ogni cambio di frequenza, fa caricare al websocket la
# configurazione della nuova frequenza (camilladsp-FREQ.yml): il processo
# resta lo stesso, sul DAC cambia solo la frequenza. Se muore, il
# supervisore lo riavvia.
DSPPROC=""
DSP_RIPROVA=0

# Vivo: il processo esiste e non e' uno zombie (un figlio morto resta
# zombie finche' la shell non lo raccoglie con wait).
dsp_alive() {
	local st
	[ -n "$DSPPROC" ] && kill -0 "$DSPPROC" 2>/dev/null || return 1
	st=$(sed 's/.*) //' "/proc/$DSPPROC/stat" 2>/dev/null | cut -c1)
	[ "$st" != Z ]
}

stop_dsp() {
	local wd
	if [ -n "$DSPPROC" ]; then
		if dsp_alive; then
			kill "$DSPPROC" 2>/dev/null
			# Se non esce entro 4 secondi lo si forza; wait lo raccoglie e
			# il DAC e' libero prima che il prossimo processo lo riapra.
			( sleep 4; kill -9 "$DSPPROC" 2>/dev/null ) &
			wd=$!
			wait "$DSPPROC" 2>/dev/null
			kill "$wd" 2>/dev/null
		else
			wait "$DSPPROC" 2>/dev/null
		fi
	fi
	DSPPROC=""
	rm -f "$DSP_FIFO" "$RUN/dsp.pid"
}

# Ferma Squeezelite e lo raccoglie. Con CamillaDSP fermo (bloccato o in
# SIGSTOP) il plugin resta in una scrittura bloccante sulla FIFO e il
# processo puo' non uscire mai: dopo PLAYER_ATTESA secondi lo si forza,
# cosi' il supervisore non resta appeso al wait e l'audio riparte.
stop_player() { # pid
	local wd
	[ -n "$1" ] || return 0
	kill "$1" 2>/dev/null
	( sleep "${PLAYER_ATTESA:-5}"; kill -9 "$1" 2>/dev/null ) &
	wd=$!
	wait "$1" 2>/dev/null
	kill "$wd" 2>/dev/null
}

start_dsp() {
	local args i=0
	stop_dsp
	args=$(sweetspot-dsp avvio) || { echo "configurazione di CamillaDSP mancante" > "$RUN/correzione.motivo"; return 1; }
	rm -f "$DSP_FIFO"
	mkfifo -m 600 "$DSP_FIFO" || { echo "pipe di CamillaDSP non creata" > "$RUN/correzione.motivo"; return 1; }
	# shellcheck disable=SC2086
	taskset -c "$HK" "$CAMILLADSP" $args <> "$DSP_FIFO" > /dev/null 2>&1 &
	DSPPROC=$!
	# Pronto quando risponde al websocket: se esce prima, non parte.
	while [ "$i" -lt 10 ]; do
		dsp_alive || break
		sweetspot-camilla "$DSP_PORTA" GetState > /dev/null 2>&1 && break
		sleep 1
		i=$((i + 1))
	done
	if ! dsp_alive || ! sweetspot-camilla "$DSP_PORTA" GetState > /dev/null 2>&1; then
		echo "CamillaDSP non si avvia (vedi $DSPLOG)" > "$RUN/correzione.motivo"
		stop_dsp
		return 1
	fi
	oom_adj -1000 "$DSPPROC"
	log "player: CamillaDSP $DSPPROC avviato per la sessione ($args)"
	return 0
}

# Riavvia l'istanza se e' morta (al massimo una volta ogni 10 secondi).
dsp_session_check() {
	[ -f "$RUN/correzione.attiva" ] || return 0
	dsp_alive && return 0
	[ "$(date +%s)" -ge "$DSP_RIPROVA" ] || return 0
	DSP_RIPROVA=$(( $(date +%s) + 10 ))
	log "player: CamillaDSP terminato, riavvio"
	if start_dsp; then
		# La nuova istanza parte dal file di volume: si riallinea al volume
		# richiesto e volume.applicato torna quello confermato dalla nuova istanza.
		[ "$(cat "$RUN/volume.modo" 2>/dev/null)" = dsp ] && sweetspot-volume risincronizza
	else
		log "player: CamillaDSP non riparte: $(cat "$RUN/correzione.motivo" 2>/dev/null)"
	fi
}

# Inizio della sessione del player: da qui si contano XRUN, interruzioni
# sul core della riproduzione, campioni tagliati da CamillaDSP e latenza.
session_start() {
	local size=0
	[ -f "$SQLOG" ] && size=$(wc -c < "$SQLOG" | tr -d ' ')
	printf 'inizio=%s\nsqlog=%s\ncore=%s\n' "$(date +%s)" "${size:-0}" "$LAYOUT_AUDIO" > "$RUN/sessione"
	irq_cpu_counts "$LAYOUT_AUDIO" > "$RUN/sessione.irq"
	rm -f "$RUN/dsp.clip" "$RUN/latenza.ascolto" "$RUN/sessione.xrun"
	# Underrun di CamillaDSP: si contano dal registro da questo punto in poi.
	size=0
	[ -f "$DSPLOG" ] && size=$(wc -c < "$DSPLOG" | tr -d ' ')
	echo "${size:-0} 0" > "$RUN/dsp.underrun"
}

# Underrun di CamillaDSP nella sessione. CamillaDSP li scrive solo nel
# registro (-o, livello warn: "buffer underrun") e non ha un contatore nel
# websocket: a ogni giro si contano le righe nuove dall'ultima posizione
# letta. Il registro puo' ricominciare da capo (nuovo processo, rotazione):
# se e' piu' corto della posizione si riparte da zero. Riga: POSIZIONE TOTALE.
dsp_underrun_poll() {
	local off=0 total=0 size n
	[ -f "$RUN/correzione.attiva" ] || return 0
	[ -f "$DSPLOG" ] || return 0
	[ -s "$RUN/dsp.underrun" ] && read -r off total < "$RUN/dsp.underrun"
	size=$(wc -c < "$DSPLOG" | tr -d ' ')
	[ "${off:-0}" -le "$size" ] || off=0
	n=$(tail -c +"$((off + 1))" "$DSPLOG" | head -c "$((size - off))" | awk 'tolower($0) ~ /underrun/ { n++ } END { print n + 0 }')
	echo "$size $((${total:-0} + n))" > "$RUN/dsp.underrun"
}

# Campioni tagliati da CamillaDSP nella sessione. Il suo contatore riparte
# con ogni processo (il plugin cdsp lo riavvia quando cambia il formato):
# a ogni giro di sorveglianza si somma la crescita. Riga: PID ULTIMO TOTALE.
dsp_clip_poll() {
	local p v old="" last=0 total=0
	[ -f "$RUN/correzione.attiva" ] || return 0
	p=$(pidof camilladsp 2>/dev/null | cut -d' ' -f1)
	[ -n "$p" ] || return 0
	v=$(sweetspot-camilla "$DSP_PORTA" GetClippedSamples 2>/dev/null | sed -n 's/.*"value":\([0-9]*\).*/\1/p')
	[ -n "$v" ] || return 0
	[ -s "$RUN/dsp.clip" ] && read -r old last total < "$RUN/dsp.clip"
	if [ "$old" = "$p" ] && [ "$v" -ge "$last" ]; then
		total=$((total + v - last))
	else
		total=$((total + v))
	fi
	echo "$p $v $total" > "$RUN/dsp.clip"
}

# Stato del percorso trasformativo, leggibile da pagina web e diagnostica:
# $RUN/dsp.stato (chiave=valore). Dice se la correzione e' in uso, la
# politica scelta se non si e' potuta preparare, lo stato effettivo del
# processo CamillaDSP, i picchi per canale (dBFS; massimo della sessione)
# e i campioni tagliati. Picchi e stato vengono da CamillaDSP (websocket).
dsp_picco() { # comando campo-precedente -> "a,b" massimo per canale
	local v
	v=$(sweetspot-camilla "$DSP_PORTA" "$1" 2>/dev/null | sed -n 's/.*"value":\[\([^]]*\)\].*/\1/p')
	[ -n "$v" ] || { printf '%s' "$2"; return 0; }
	printf '%s\n%s\n' "$2" "$v" | awk -F, 'NF { for (i = 1; i <= NF; i++) if (!(i in m) || $i + 0 > m[i] + 0) m[i] = $i }
		END { n = 0; for (i in m) n++; for (i = 1; i <= n; i++) printf "%s%s", (i > 1 ? "," : ""), m[i] }'
}

dsp_stato_poll() {
	local p st clip="" pin pout via pol err und=0
	p=$(pidof camilladsp 2>/dev/null | cut -d' ' -f1)
	pol=$(dsp_politica)
	if [ -f "$RUN/correzione.attiva" ]; then via=camilladsp
	elif [ -s "$RUN/correzione.errore" ] && [ "$pol" = blocca ]; then via=bloccato
	elif [ -s "$RUN/correzione.errore" ]; then via=diretto-senza-correzione
	else via=diretto; fi
	err=$(cat "$RUN/correzione.errore" 2>/dev/null)
	st=assente
	pin=""; pout=""
	if [ -n "$p" ] && [ -f "$RUN/correzione.attiva" ]; then
		st=$(sweetspot-camilla "$DSP_PORTA" GetState 2>/dev/null | sed -n 's/.*"value":"\([A-Za-z]*\)".*/\1/p')
		[ -n "$st" ] || st=non-risponde
		pin=$(sed -n 's/^picco_ingresso=//p' "$RUN/dsp.stato" 2>/dev/null)
		pout=$(sed -n 's/^picco_uscita=//p' "$RUN/dsp.stato" 2>/dev/null)
		pin=$(dsp_picco GetCaptureSignalPeak "$pin")
		pout=$(dsp_picco GetPlaybackSignalPeak "$pout")
		[ -s "$RUN/dsp.clip" ] && read -r _ _ clip < "$RUN/dsp.clip"
		[ -s "$RUN/dsp.underrun" ] && read -r _ und < "$RUN/dsp.underrun"
	fi
	{
		printf 'percorso=%s\npolitica=%s\nerrore=%s\nprocesso=%s\nstato=%s\n' "$via" "$pol" "$err" "${p:-}" "$st"
		printf 'picco_ingresso=%s\npicco_uscita=%s\ncampioni_tagliati=%s\naggiornato=%s\n' "$pin" "$pout" "${clip:-0}" "$(date +%s)"
		printf 'underrun=%s\navviso=%s\n' "${und:-0}" "$(cat "$RUN/correzione.avviso" 2>/dev/null)"
	} > "$RUN/dsp.stato.tmp" && mv "$RUN/dsp.stato.tmp" "$RUN/dsp.stato"
}

# Cosa fare se la correzione richiesta non si puo' preparare:
# blocca (predefinito): il player non suona, niente segnale non corretto;
# diretto: suona sul DAC senza correzione, con avviso visibile.
dsp_politica() {
	case "$(lower "$(conf CORREZIONE_SE_ASSENTE blocca)")" in
	diretto) echo diretto ;;
	*) echo blocca ;;
	esac
}

# Latenza durante l'ascolto (facoltativa, LATENZA_ASCOLTO=si): una misura
# leggera sul core della riproduzione per tutta la sessione.
# I sorveglianti (volume, latenza) partono in un gruppo di processi
# proprio (setsid): fermandoli si fermano anche i loro figli (nc, pipeline).
start_volume_watch() {
	VOLPID=""
	[ "$(cat "$RUN/volume.modo" 2>/dev/null)" = dsp ] || return 0
	taskset -c "$HK" setsid sweetspot-volume segui "$PLAYER_MAC" &
	VOLPID=$!
}

# Sorveglia i sorveglianti: se il follower del volume o la misura di latenza
# muoiono, si riavviano (al massimo WATCH_MAX volte per sessione, per non
# entrare in un ciclo stretto) e l'evento va nel log. Solo con la shell:
# kill -0 e' un builtin.
WATCH_MAX=5
WATCH_N=0
watch_check() {
	if [ -n "$VOLPID" ] && ! kill -0 "$VOLPID" 2>/dev/null; then
		if [ "$WATCH_N" -lt "$WATCH_MAX" ]; then
			WATCH_N=$((WATCH_N + 1))
			log "player: il follower del volume e' morto, lo riavvio ($WATCH_N/$WATCH_MAX)"
			start_volume_watch
		else
			log "player: il follower del volume e' morto, troppi riavvii: lo lascio fermo"
			VOLPID=""
		fi
	fi
	if [ -n "$LATPID" ] && ! kill -0 "$LATPID" 2>/dev/null; then
		if [ "$WATCH_N" -lt "$WATCH_MAX" ]; then
			WATCH_N=$((WATCH_N + 1))
			log "player: la misura di latenza e' morta, la riavvio ($WATCH_N/$WATCH_MAX)"
			start_latency_watch
		else
			log "player: la misura di latenza e' morta, troppi riavvii: la lascio ferma"
			LATPID=""
		fi
	fi
}

stop_watch() { # pid
	[ -n "$1" ] || return 0
	kill -- "-$1" 2>/dev/null || kill "$1" 2>/dev/null
}

# --- Altri DAC (zone) ---------------------------------------------------------------
#
# ALTRI_DAC=si: ogni altro DAC USB con un'uscita ha il suo Squeezelite, cioe'
# un player separato in Lyrion ("Sweetspot - nome del DAC"); le zone si
# raggruppano e si sincronizzano da Lyrion. Il DAC principale resta com'e'
# (core isolato, correzione, volume a 64 bit); gli altri suonano sui core di
# sistema, con priorita' real-time un po' piu' bassa, uscita diretta,
# mixer del DAC a 0 dB e volume regolabile da Lyrion. Si avviano e si
# fermano da soli quando un DAC viene collegato o staccato, anche mentre il
# DAC principale manca.
#
# Il DAC principale e' quello indicato da DAC oppure, con DAC=auto, quello
# scelto la prima volta in questo avvio (annotato in $RUN/dac.principale):
# se viene staccato, il player principale lo aspetta e non passa a una zona
# (che intanto continua a suonare); al ritorno riprende lui.
ZONE_DIR=$RUN/zone

remember_main_dac() { # scheda
	is_yes "$(conf ALTRI_DAC no)" || return 0
	printf '%s\n' "$(dac_identity "$1")" > "$RUN/dac.principale.nuovo" &&
		mv "$RUN/dac.principale.nuovo" "$RUN/dac.principale"
}

other_dacs() { # scheda del DAC principale (vuota se manca)
	local d idx
	for d in "$PROC"/asound/card[0-9]*; do
		[ -d "$d" ] || continue
		idx=${d##*card}
		[ -f "$d/usbid" ] || continue
		[ -n "$(dac_playback_dev "$idx")" ] || continue
		if [ -n "$1" ]; then
			[ "$idx" = "$1" ] && continue
		else
			# Il DAC principale manca: quando torna non deve diventare
			# una zona, lo riprende il player principale.
			dac_wanted "$idx" && continue
		fi
		echo "$idx"
	done
}

# MAC stabile per ogni DAC (indirizzo locale, 02:...): Lyrion ricorda il
# player e le sue impostazioni anche se la porta USB o l'ordine di
# collegamento cambiano. Dall'identificativo USB e dal numero di serie
# (due DAC uguali: serie diverse); senza numero di serie, dal nome ALSA.
zone_mac() { # scheda
	local serial
	serial=$(dac_usb_serial "$1")
	[ -n "$serial" ] || serial=$(dac_id "$1")
	printf '%s %s' "$(dac_usbid "$1")" "$serial" | md5sum | awk '{ s = $1; printf "02:%s:%s:%s:%s:%s", substr(s, 1, 2), substr(s, 3, 2), substr(s, 5, 2), substr(s, 7, 2), substr(s, 9, 2) }'
}

# Parita' con il DAC principale: buffer, frequenza massima annunciata e pausa
# fra frequenze, ricampionamento (anche di ripiego), -H, registro con
# decode=info, formato di uscita, MAC stabile, preferenze di fedelta' in
# Lyrion, supervisione con ritardo crescente, rotazione del registro, OOM e
# diagnostica (argomenti e capacita' in $RUN/capacita). Non e' possibile sulle
# zone, e lo dice il file delle capacita': CamillaDSP e volume a 64 bit (un
# solo processo, sul principale), DSD nativo/DoP (volume software di Lyrion),
# core isolato e interruzioni USB dedicate (restano al principale).
ZONE_RIAVVIO=$RUN/zone-riavvio
SYNC_DIR=$RUN/sync
ZONE_LOGDIR=${SQLOG%/*}

# Il MAC dei due punti non e' un nome di file comodo.
mac_key() { printf '%s' "$1" | tr ':' '_'; }

zone_start() { # scheda [numero di zone]
	local card=$1 nz=${2:-1} id dev name server prio alsa periods outfmt mac dsdfmt top rs pid
	id=$(dac_id "$card")
	dev=$(dac_playback_dev "$card") || return 1
	name="$(conf NOME_PLAYER Sweetspot) - $(dac_name "$card")"
	if [ "$(mode)" = completa ]; then server=127.0.0.1; else server=$(conf SERVER); fi
	prio=$(( $(num_conf PRIORITA_AUDIO 80) - 5 ))
	alsa=$(alsa_buffer_ms)
	periods=$(num_conf PERIODI_ALSA 4)
	outfmt=$(output_format)
	mac=$(zone_mac "$card")
	set -- -o "hw:CARD=$id,DEV=$dev" -a "$alsa:$periods:$outfmt:1" -n "$name" -M Sweetspot -m "$mac"
	# Gli stessi argomenti comuni del principale; i buffer in RAM si dividono
	# fra le zone (PLAYER_BUFFERS_DIV).
	# shellcheck disable=SC2046  # un argomento per riga, nessuno con spazi
	set -- "$@" $(PLAYER_BUFFERS_DIV=$((nz * 2)) common_args "$card" "$ZONE_LOGDIR/squeezelite-$id.log" "$prio" "$alsa" "")
	[ -n "$server" ] && set -- "$@" -s "$server"
	# Niente DSD nativo ne' DoP sulle zone: il volume della zona e' software
	# (Lyrion) e Squeezelite non lo applica al DSD, che suonerebbe al 100%
	# dopo un brano PCM attenuato. Il DSD si converte in PCM, attenuabile.
	mkdir -p "$ZONE_DIR" "$ZONE_RIAVVIO" "$SYNC_DIR" "$CAP_DIR"
	# Il volume della zona lo fa Lyrion (software): il mixer del DAC a 0 dB.
	dac_unity_gain "$card"
	SWEETSPOT_DSD_MARGINE_DB=$(dsd_margine_db) taskset -c "$HK" squeezelite "$@" &
	pid=$!
	echo "$pid $id" > "$ZONE_DIR/$card"
	oom_adj -1000 "$pid"
	# MAC della zona per i controlli funzionali di sweetspot-stato (connessa a
	# Lyrion, tempo che avanza). In una cartella a parte: ZONE_DIR ha un file
	# per scheda e lo leggono altri.
	mkdir -p "$RUN/zone.mac"
	echo "$mac" > "$RUN/zone.mac/$card"
	# Diagnostica: argomenti e capacita' di questa zona.
	printf '%s ' "$@" > "$CAP_DIR/zona-$id.args"
	dsdfmt=$(dac_native_dsd "$card")
	top=$(announced_max_rate "$card")
	rs=$(resample_args)
	cap_write "zona-$id" tipo=zona "dac=$id" "nome=$name" "mac=$mac" "frequenza_max=$top" \
		"formati=$(dac_formats "$card")" "dsd_dac=${dsdfmt:-no}" dsd=pcm volume=software \
		volume_64bit=no correzione=no "priorita=$prio" "core=$HK" "buffer_alsa_ms=$alsa" \
		"periodi=$periods" "formato_uscita=${outfmt:-auto}" "ricampionamento=${rs:-no}" irq_usb=sistema
	# Dopo un riavvio Lyrion puo' non rimettere la zona nel suo gruppo: si
	# riapplicano le preferenze e il gruppo ricordato (vedi sync_poll).
	: > "$SYNC_DIR/$(mac_key "$mac").pendente"
	rm -f "$SYNC_DIR/$(mac_key "$mac").visto"
	echo "$(date +%s) $(cat "$ZONE_RIAVVIO/$card.ritardo" 2>/dev/null || echo 0)" > "$ZONE_RIAVVIO/$card.avvio"
	log "player: zona \"$name\" sul DAC $id"
}

# Una zona terminata da sola si riavvia con il ritardo crescente del
# principale (backoff_next): senza, un DAC che fa cadere Squeezelite subito
# lo rilancerebbe a ogni giro.
zone_note_exit() { # scheda
	local card=$1 t0 prev delay now
	now=$(date +%s)
	[ -f "$ZONE_RIAVVIO/$card.avvio" ] && read -r t0 prev < "$ZONE_RIAVVIO/$card.avvio"
	delay=$(backoff_next "${prev:-0}" $(( now - ${t0:-$now} )))
	echo "$delay" > "$ZONE_RIAVVIO/$card.ritardo"
	echo $(( now + delay )) > "$ZONE_RIAVVIO/$card.fino"
	# Conta il riavvio fra quelli del player (restart_conta, via evento).
	evento player riavvio-zona "zona sul DAC $card terminata"
	[ "$delay" -gt 0 ] && log "player: zona sul DAC $card terminata subito, nuovo tentativo tra $delay s"
}

zone_ready() { # scheda
	local fino
	fino=$(cat "$ZONE_RIAVVIO/$1.fino" 2>/dev/null)
	[ -z "$fino" ] || [ "$(date +%s)" -ge "$fino" ]
}

# Sincronizzazione multiroom. Le zone si annunciano a Lyrion con MAC stabile
# (zone_mac), nome e modello e restano nello stesso gruppo se Lyrion le
# ricorda. Qui si ricorda il gruppo (a regime, ogni PREFS_OGNI secondi) e,
# dopo l'avvio di un player, quando e' tornato collegato da qualche secondo e
# Lyrion non l'ha rimesso da solo nel gruppo, lo si risincronizza con un
# membro collegato. Un gruppo sciolto da Lyrion si dimentica.
sync_poll() { # mac
	local mac=$1 key cur now last visto p LMS_HOST=$LMS_HOST srv pend=0
	if [ "$(mode)" != completa ]; then
		srv=$(conf SERVER)
		[ -n "$srv" ] || return 0
		LMS_HOST=${srv%%:*}
	fi
	key=$(mac_key "$mac")
	mkdir -p "$SYNC_DIR"
	now=$(date +%s)
	[ -f "$SYNC_DIR/$key.pendente" ] && pend=1
	last=$(cat "$SYNC_DIR/$key.t" 2>/dev/null)
	if [ "$pend" = 0 ] && [ $(( now - ${last:-0} )) -lt "$PREFS_OGNI" ]; then return 0; fi
	echo "$now" > "$SYNC_DIR/$key.t"
	[ "$(LMS_TIMEOUT=5 lms_get '._connected' "$mac" connected '?')" = 1 ] || return 0
	cur=$(LMS_TIMEOUT=5 lms_get '(._sync | if type == "array" then join(",") else . end)' "$mac" sync '?')
	if [ "$pend" = 1 ]; then
		visto=$(cat "$SYNC_DIR/$key.visto" 2>/dev/null)
		if [ -z "$visto" ]; then echo "$now" > "$SYNC_DIR/$key.visto"; return 0; fi
		[ $(( now - visto )) -ge 5 ] || return 0
		rm -f "$SYNC_DIR/$key.pendente" "$SYNC_DIR/$key.visto"
		if [ "$cur" = "-" ] && [ -s "$SYNC_DIR/$key.gruppo" ]; then
			for p in $(cat "$SYNC_DIR/$key.gruppo"); do
				[ "$p" = "$mac" ] && continue
				[ "$(LMS_TIMEOUT=5 lms_get '._connected' "$p" connected '?')" = 1 ] || continue
				if lms_json "$mac" sync "$p" > /dev/null; then
					log "player: $mac rimesso nel gruppo di sincronizzazione di $p"
					return 0
				fi
			done
			log "player: gruppo di sincronizzazione di $mac non ripristinabile (nessun membro collegato)"
		fi
		return 0
	fi
	case "$cur" in
		-) rm -f "$SYNC_DIR/$key.gruppo" ;;
		'') ;;
		*) printf '%s\n' "$cur" | tr ',' '\n' | grep -vi "^$mac\$" | tr '\n' ' ' > "$SYNC_DIR/$key.gruppo" ;;
	esac
}

# Preferenze di fedelta' di una zona in Lyrion (come apply_player_prefs per il
# principale): volume digitale acceso, niente ReplayGain, dissolvenze o limite
# di bitrate. Si rileggono ogni PREFS_OGNI secondi e si reimpostano se divergono.
zone_prefs_poll() { # mac
	local mac=$1 key now last dig LMS_HOST=$LMS_HOST srv
	if [ "$(mode)" != completa ]; then
		srv=$(conf SERVER)
		[ -n "$srv" ] || return 0
		LMS_HOST=${srv%%:*}
	fi
	key=$(mac_key "$mac")
	now=$(date +%s)
	last=$(cat "$SYNC_DIR/$key.prefs" 2>/dev/null)
	[ $(( now - ${last:-0} )) -ge "$PREFS_OGNI" ] || return 0
	echo "$now" > "$SYNC_DIR/$key.prefs"
	[ "$(LMS_TIMEOUT=5 lms_get '._connected' "$mac" connected '?')" = 1 ] || return 0
	# Modalita' volume delle zone: sempre software (vedi volume_modo_calcola).
	dig=$(volume_prefs software | cut -d' ' -f1)
	[ -z "$(prefs_divergenti "$dig" "$mac")" ] && return 0
	lms_json "$mac" playerpref digitalVolumeControl "$dig" > /dev/null || return 0
	lms_json "$mac" playerpref replayGainMode 0 > /dev/null || return 0
	lms_json "$mac" playerpref transitionType 0 > /dev/null || return 0
	lms_json "$mac" playerpref maxBitrate 0 > /dev/null || return 0
	log "player: preferenze di fedelta' riapplicate alla zona $mac"
}

# Allinea le zone ai DAC collegati: ferma quelle di DAC staccati (o diventati
# il principale, o con ALTRI_DAC=no), riavvia quelle cadute (con ritardo
# crescente), avvia le nuove e sorveglia le altre (registro, Lyrion).
zones_sync() { # scheda del DAC principale (vuota se manca)
	local f card pid id want=0 cards nz mac
	is_yes "$(conf ALTRI_DAC no)" && want=1
	for f in "$ZONE_DIR"/*; do
		[ -f "$f" ] || continue
		card=${f##*/}
		read -r pid id < "$f"
		if [ "$want" = 0 ] || [ "$card" = "$1" ] || [ "$(dac_id "$card")" != "$id" ]; then
			kill "$pid" 2>/dev/null
			rm -f "$f" "$ZONE_RIAVVIO/$card".* "$CAP_DIR/zona-$id" "$CAP_DIR/zona-$id.args"
			log "player: zona sul DAC $id fermata"
		elif ! kill -0 "$pid" 2>/dev/null; then
			rm -f "$f"
			zone_note_exit "$card"
			log "player: zona sul DAC $id fermata"
		fi
	done
	[ "$want" = 1 ] || return 0
	cards=$(other_dacs "$1")
	nz=$(count_words "$cards")
	for card in $cards; do
		if [ -f "$ZONE_DIR/$card" ]; then
			read -r _ id < "$ZONE_DIR/$card"
			mac=$(sed -n 's/^mac=//p' "$CAP_DIR/zona-$id" 2>/dev/null)
			if [ -n "$mac" ]; then
				zone_prefs_poll "$mac"
				sync_poll "$mac"
			fi
		elif zone_ready "$card"; then
			zone_start "$card" "$nz"
		fi
	done
}

start_latency_watch() {
	LATPID=""
	[ "$(lower "$(conf LATENZA_ASCOLTO no)")" = si ] || return 0
	taskset -c "$HK" setsid sweetspot-latenza --ascolto "$LAYOUT_AUDIO" &
	LATPID=$!
}

# Indirizzo del player (MAC) fisso: quello della prima scheda di rete, cosi'
# Lyrion lo riconosce sempre e ne conserva le impostazioni.
player_mac() {
	local f m
	for f in "$SYS"/class/net/*/address; do
		case "$f" in */lo/address) continue ;; esac
		m=$(cat "$f" 2>/dev/null)
		case "$m" in ''|00:00:00:00:00:00) continue ;; esac
		printf '%s' "$m"
		return 0
	done
	printf '02:53:57:45:45:54'
}

# Controllo del volume hardware del DAC (per VOLUME=dac): quello indicato
# in VOLUME_CONTROLLO o il primo con regolazione di riproduzione.
dac_volume_control() {
	local want line n=""
	want=$(conf VOLUME_CONTROLLO)
	if [ -n "$want" ]; then printf '%s' "$want"; return 0; fi
	amixer -c "$1" scontents 2>/dev/null | while IFS= read -r line; do
		case "$line" in
			"Simple mixer control '"*)
				n=${line#"Simple mixer control '"}
				n=${n%"',"*} ;;
			*Capabilities:*pvolume*)
				[ -n "$n" ] && { printf '%s' "$n"; break; } ;;
		esac
	done
}

# Controlli di volume della riproduzione del DAC (nomi, uno per riga).
dac_volume_controls() {
	local line n=""
	amixer -c "$1" scontents 2>/dev/null | while IFS= read -r line; do
		case "$line" in
			"Simple mixer control '"*)
				n=${line#"Simple mixer control '"}
				n=${n%"',"*} ;;
			*Capabilities:*pvolume*|*Capabilities:*pswitch*)
				[ -n "$n" ] && printf '%s\n' "$n"
				n="" ;;
		esac
	done
}

# Volume fisso: ogni controllo di volume del DAC a 0 dB (nessuna
# attenuazione) e senza muto, come su Daphile con il volume spento. Molti
# DAC USB espongono un volume proprio che, se non e' al massimo, abbassa il
# segnale dentro il DAC.
dac_unity_gain() {
	local card=$1 ctl
	dac_volume_controls "$card" | while IFS= read -r ctl; do
		amixer -q -c "$card" sset "$ctl" 0dB unmute 2>/dev/null ||
			amixer -q -c "$card" sset "$ctl" 100% unmute 2>/dev/null
		log "player: controllo '$ctl' del DAC a 0 dB"
	done
}

# Parametri di squeezelite per il ricampionamento facoltativo (spento di
# serie: bit-perfect). RICAMPIONAMENTO=sincrono porta ogni brano alla
# frequenza piu' alta della sua famiglia (44,1 -> 176,4/352,8 kHz, 48 ->
# 192/384 kHz); asincrono porta tutto alla frequenza massima del DAC.
# FILTRO: lineare (predefinito), intermedio, minimo.
resample_args() {
	local mode recipe phase
	mode=$(lower "$(conf RICAMPIONAMENTO no)")
	case "$mode" in sincrono|asincrono) ;; *) return 0 ;; esac
	case "$(lower "$(conf FILTRO lineare)")" in
		intermedio) phase=I ;;
		minimo) phase=M ;;
		*) phase=L ;;
	esac
	recipe="v$phase"
	[ "$mode" = asincrono ] && recipe="${recipe}X"
	printf '%s' "$recipe"
}

# Correzione chiesta ma non applicabile: il motivo va in correzione.errore
# (Stato). Con blocca il player non parte (esce con 1); con diretto suona
# senza correzione, con l'avviso nel registro e in Stato.
correzione_non_applicabile() { # motivo
	echo "$1" > "$RUN/correzione.errore"
	if [ "$(dsp_politica)" = blocca ]; then
		log "player: correzione ambientale non applicabile ($1), riproduzione bloccata (CORREZIONE_SE_ASSENTE=diretto per suonare senza)"
		dsp_stato_poll
		return 1
	fi
	log "player: ATTENZIONE correzione ambientale non applicabile ($1), uscita diretta sul DAC senza correzione (CORREZIONE_SE_ASSENTE=diretto)"
	dsp_stato_poll
	return 0
}

run_player() {
	local problema card=$1 id dev name server alsa periods prio dsd fmt pausa outfmt vol ctl dsp top a
	id=$(dac_id "$card")
	dev=$(dac_playback_dev "$card") || return 1
	name=$(conf NOME_PLAYER Sweetspot)
	if [ "$(mode)" = completa ]; then server=127.0.0.1; else server=$(conf SERVER); fi
	alsa=$(alsa_buffer_ms)
	periods=$(num_conf PERIODI_ALSA 4)
	prio=$(num_conf PRIORITA_AUDIO 80)
	pausa=$(num_conf PAUSA_DSD_MS 500)
	outfmt=$(output_format)
	PLAYER_MAC=$(player_mac)
	echo "$PLAYER_MAC" > "$RUN/player.mac"

	# Correzione ambientale (facoltativa): squeezelite suona sul dispositivo
	# della correzione, che passa ogni brano a CamillaDSP; altrimenti
	# direttamente sul DAC.
	# Con VOLUME=dsp CamillaDSP c'e' anche senza correzione, per il volume.
	# correzione.attiva: CamillaDSP e' nel percorso; correzione.filtri: con i
	# filtri della stanza; volume.modo: dsp (volume a 64 bit) o riserva.
	dsp=""
	rm -f "$RUN/correzione.attiva" "$RUN/correzione.filtri" "$RUN/correzione.errore" "$RUN/correzione.motivo" "$RUN/volume.modo" "$RUN/volume.motivo"
	stop_dsp
	# Correzione chiesta ma file mancanti, illeggibili, malformati o
	# incoerenti: errore visibile in Stato e, con la politica blocca, niente
	# riproduzione. Mai suono senza correzione in silenzio.
	problema=$(sweetspot-dsp problema)
	if [ -n "$problema" ]; then
		correzione_non_applicabile "$problema" || return 1
	elif sweetspot-dsp attiva; then
		if dsp=$(sweetspot-dsp prepara "$card") && start_dsp; then
			echo "$dsp" > "$RUN/correzione.attiva"
			if sweetspot-dsp correzione; then
				touch "$RUN/correzione.filtri"
				log "player: correzione ambientale attiva (CamillaDSP, attenuazione $(sweetspot-dsp guadagno) dB)"
			fi
			if sweetspot-dsp volume; then
				echo dsp > "$RUN/volume.modo"
				log "player: volume a 64 bit con dither (CamillaDSP)"
			fi
		else
			dsp=""
			stop_dsp
			if sweetspot-dsp richiesta; then
				problema=$(cat "$RUN/correzione.motivo" 2>/dev/null)
				correzione_non_applicabile "${problema:-preparazione di CamillaDSP non riuscita}" || return 1
			fi
		fi
	fi
	# Volume a 64 bit chiesto ma CamillaDSP non disponibile (o modalita'
	# player): il volume resta regolabile dal software, mai fisso al massimo.
	if [ "$(lower "$(conf VOLUME fisso)")" = dsp ] && [ ! -f "$RUN/volume.modo" ]; then
		echo riserva > "$RUN/volume.modo"
		# Il perche' va in Stato e nella pagina Audio, oltre che nel registro.
		if [ "$(mode)" != completa ] && [ -z "$(conf SERVER)" ]; then
			problema="modalita' player senza SERVER: il volume si legge da Lyrion e il suo indirizzo non e' noto (indica SERVER)"
		elif [ -s "$RUN/correzione.motivo" ]; then
			problema="CamillaDSP non preparato: $(cat "$RUN/correzione.motivo")"
		else
			problema="CamillaDSP non disponibile"
		fi
		echo "$problema" > "$RUN/volume.motivo"
		log "player: volume a 64 bit non disponibile ($problema), uso il volume software"
	fi
	if [ -n "$dsp" ]; then
		set -- -o "$dsp" -O "hw:CARD=$id" -a "$alsa:$periods::0"
	else
		set -- -o "hw:CARD=$id,DEV=$dev" -a "$alsa:$periods:$outfmt:1"
	fi
	# Argomenti comuni a DAC principale e zone (buffer, priorita', registro,
	# frequenza massima e pausa, ricampionamento, -H): vedi common_args.
	set -- "$@" -n "$name" -M Sweetspot -m "$PLAYER_MAC"
	# shellcheck disable=SC2046  # un argomento per riga, nessuno con spazi
	set -- "$@" $(common_args "$card" "$SQLOG" "$prio" "$alsa" "$dsp" 1)
	[ -n "$server" ] && set -- "$@" -s "$server"

	# Frequenza massima annunciata a Lyrion (HELO MaxSampleRate). Annotata per
	# la pagina Stato (check_lyrion_sox); MaxSampleRate non e' una preferenza
	# di Lyrion, non si imposta da qui.
	top=$(announced_max_rate "$card")
	rm -f "$RUN/frequenza.max"
	[ -n "$top" ] && echo "$top" > "$RUN/frequenza.max"
	# Modalita' effettiva del volume, calcolata una volta (hardware, fisso,
	# digitale) e condivisa con Lyrion e con l'interfaccia web.
	# Una sola funzione decide la modalita' (volume_modo_calcola, common.sh) e
	# da lei derivano argomenti, preferenze di Lyrion e diagnostica.
	ctl=""
	[ "$(lower "$(conf VOLUME fisso)")" = dac ] && ctl=$(dac_volume_control "$card")
	vol=$(volume_modo_calcola "$ctl")
	VOL_MODO=${vol%%|*}
	VOL_MOTIVO=${vol#*|}
	[ -n "$VOL_MOTIVO" ] && log "player: volume $(lower "$(conf VOLUME fisso)") non applicabile ($VOL_MOTIVO), modalita' effettiva: $VOL_MODO"
	# Fisso e a 64 bit: Squeezelite ignora il guadagno (-F) e i campioni
	# escono invariati, qualunque cosa mandi Lyrion (anche remoto, dove le
	# preferenze possono non essere imponibili). Con dsp Lyrion tiene il
	# controllo digitale (cosi' Material mostra il cursore) e il volume lo
	# applica CamillaDSP (sweetspot-volume segue il cursore).
	while IFS= read -r a; do
		[ -n "$a" ] && set -- "$@" "$a"
	done <<EOF
$(volume_args "$VOL_MODO" "$ctl")
EOF
	# Con il volume fisso anche il mixer del DAC va a 0 dB (garanzia locale);
	# VOLUME=dac che ripiega su fisso (niente mixer) comprende questo caso.
	[ "$VOL_MODO" = dac ] || dac_unity_gain "$card"

	dsd=$(lower "$(conf DSD auto)")
	fmt=$(dac_native_dsd "$card")
	# Con la correzione il DSD si converte in PCM (i filtri lavorano sul PCM).
	[ -n "$dsp" ] && dsd=pcm
	# Volume software: Squeezelite non lo applica al DSD nativo o DoP (output.c),
	# quindi dopo un brano PCM attenuato un DSF suonerebbe al 100% (+30 dB).
	# Per orecchie e diffusori il DSD si converte sempre in PCM, che il volume
	# attenua; il DSD nativo resta con volume fisso, del DAC o a 64 bit.
	rm -f "$RUN/dsd.volume"
	if [ "$VOL_MODO" = software ] && [ "$dsd" != pcm ]; then
		dsd=pcm
		echo pcm > "$RUN/dsd.volume"
		log "player: volume software: il DSD si converte in PCM (il volume non agisce sul DSD nativo)"
	fi
	# Squeezelite non esclude mai il DSD: Lyrion non sa convertire DSF/DFF in
	# PCM (non ha regole dsf/dff -> pcm), quindi i file arrivano interi e li
	# decodifica Squeezelite. Nativo o DoP solo con -D; altrimenti (e quando
	# il DAC non regge la frequenza del DSD) li converte in PCM da solo, alla
	# frequenza piu' alta che il DAC accetta (patch 0004).
	case "$dsd" in
		auto|nativo)
			if [ -n "$fmt" ]; then
				set -- "$@" -D "$pausa:$fmt"
			else
				[ "$dsd" = nativo ] && log "player: DSD nativo richiesto ma non dichiarato dal DAC"
			fi ;;
		dop) set -- "$@" -D "$pausa:dop" ;;
		*) ;;
	esac

	printf '%s ' "$@" > "$RUN/player.args"
	cap_write principale tipo=principale "dac=$id" "nome=$name" "mac=$PLAYER_MAC" "frequenza_max=$top" \
		"formati=$(dac_formats "$card")" "dsd_dac=${fmt:-no}" "dsd=$dsd" "volume=$(volume_effettivo)" \
		"volume_64bit=$([ "$(cat "$RUN/volume.modo" 2>/dev/null)" = dsp ] && echo si || echo no)" \
		"correzione=$([ -n "$dsp" ] && echo si || echo no)" "priorita=$prio" \
		"core=$([ "$PIN" = 1 ] && echo "$LAYOUT_AUDIO" || echo "$HK")" "buffer_alsa_ms=$alsa" \
		"periodi=$periods" "formato_uscita=${outfmt:-auto}" "ricampionamento=$(resample_args | grep . || echo no)" \
		"irq_usb=$([ "$PIN" = 1 ] && echo "$LAYOUT_IRQ" || echo sistema)"
	# Dopo un riavvio del principale: gruppo di sincronizzazione (sync_poll).
	mkdir -p "$SYNC_DIR"
	: > "$SYNC_DIR/$(mac_key "$PLAYER_MAC").pendente"
	rm -f "$SYNC_DIR/$(mac_key "$PLAYER_MAC").visto"
	# Stato per Stato/Audio, con la verifica sugli argomenti reali.
	volume_stato_scrivi "$VOL_MODO" "$VOL_MOTIVO"
	session_start
	# Da volume fisso a software/dsp Squeezelite ripartirebbe con il guadagno
	# di Lyrion ancora a 100: si abbassa prima, se Lyrion conosce gia' il
	# player; altrimenti resta la riduzione alla connessione (apply_player_prefs).
	if [ "$VOL_MODO" = software ] || [ "$VOL_MODO" = dsp ]; then volume_sicuro_prima; fi
	SWEETSPOT_DSD_MARGINE_DB=$(dsd_margine_db) taskset -c "$HK" squeezelite "$@" &
	PID=$!
	echo "$PID" > "$RUN/squeezelite.pid"
	# Mai ucciso dall'OOM killer: senza swap, sotto pressione di memoria
	# cadrebbero prima gli altri (vedi oom_adj in common.sh).
	oom_adj -1000 "$PID"
	PREFS_SET=0
}

# Impostazioni del player in Lyrion, appena il player e' collegato e poi a
# ogni cambio o riconnessione: volume fisso al 100% (bit-perfect) o
# regolabile, niente ReplayGain, niente dissolvenze tra i brani, nessun
# limite di bitrate (i file arrivano al player cosi' come sono).
# Con Lyrion locale le impone; con un server esterno (SERVER) le chiede via
# JSON-RPC se raggiungibile. Ogni PREFS_OGNI secondi rilegge i valori: se
# divergono li reimposta e, se non ci riesce, lo scrive in
# $RUN/fedelta.stato e nel log (una volta per cambio di stato).
PREFS_OGNI=${SWEETSPOT_PREFS_OGNI:-15}
PREFS_ATTIVO=$PREFS_OGNI

prefs_stato() { # testo
	[ "$(cat "$RUN/fedelta.stato" 2>/dev/null)" = "$1" ] && return 0
	printf '%s\n' "$1" > "$RUN/fedelta.stato.nuovo" && mv "$RUN/fedelta.stato.nuovo" "$RUN/fedelta.stato"
	log "player: preferenze di fedelta': $1"
}

# Stampa le preferenze la cui lettura non coincide con quella richiesta.
prefs_divergenti() { # digitale [mac]
	local nome valore got out="" mac=${2:-$PLAYER_MAC}
	for nome in digitalVolumeControl:$1 replayGainMode:0 transitionType:0 maxBitrate:0; do
		valore=${nome#*:}
		nome=${nome%%:*}
		got=$(LMS_TIMEOUT=5 lms_get '._p2' "$mac" playerpref "$nome" '?')
		[ "$got" = "$valore" ] || out="$out${out:+ }$nome=${got:-?}(richiesto $valore)"
	done
	printf '%s' "$out"
}

# Tipo di volume applicato l'ultima volta, su disco (come i dati di Lyrion):
# $RUN e' tmpfs e dopo un riavvio del dispositivo il marcatore volume.fisso
# non c'e' piu', mentre Lyrion ricorda il 100 del volume fisso.
VOLTIPO_FILE=$LMS_DATA/sweetspot-volume.tipo

volume_era_fisso() {
	[ -f "$RUN/volume.fisso" ] || [ "$(cat "$VOLTIPO_FILE" 2>/dev/null)" = fisso ]
}

volume_tipo_scrivi() { # fisso|altro
	[ "$(cat "$VOLTIPO_FILE" 2>/dev/null)" = "$1" ] && return 0
	[ -d "$LMS_DATA" ] && [ -w "$LMS_DATA" ] || return 0
	printf '%s\n' "$1" > "$VOLTIPO_FILE.nuovo" && mv "$VOLTIPO_FILE.nuovo" "$VOLTIPO_FILE"
}

# Prima di riavviare Squeezelite dal volume fisso: volume sicuro in Lyrion e
# controllo digitale acceso, cosi' alla connessione non arriva il 100. Best
# effort: se Lyrion non risponde, apply_player_prefs riduce alla connessione.
volume_sicuro_prima() {
	local sicuro
	volume_era_fisso || return 0
	[ "$(mode)" = completa ] || [ -n "$(conf SERVER)" ] || return 0
	sicuro=$(conf VOLUME_SICURO 25)
	case "$sicuro" in ''|*[!0-9]*) sicuro=25 ;; esac
	LMS_TIMEOUT=5 lms_json "$PLAYER_MAC" mixer volume "$sicuro" > /dev/null || return 0
	lms_json "$PLAYER_MAC" playerpref digitalVolumeControl 1 > /dev/null || return 0
	log "player: passaggio dal volume fisso a $VOL_MODO: volume di Lyrion portato a $sicuro prima di riavviare"
}

apply_player_prefs() {
	local digital=0 vol_dsp=0 sig now div srv prefs sicuro cur LMS_HOST=$LMS_HOST
	if [ "$(mode)" != completa ]; then
		# Server esterno: raggiungibile solo se indicato (SERVER); con la
		# ricerca automatica non si sa dove sia.
		srv=$(conf SERVER)
		if [ -z "$srv" ]; then
			prefs_stato "non verificabili (server esterno non indicato; guadagno locale $(cat "$RUN/volume.locale" 2>/dev/null || echo "non verificato"), modalita' $(volume_modalita))"
			return 0
		fi
		LMS_HOST=${srv%%:*}
	fi
	# Volume a 64 bit: il controllo digitale del volume resta acceso in
	# Lyrion (senza, Material e le app mostrano il player a volume fisso e
	# nascondono il cursore); Squeezelite lo ignora (-F) e il cursore lo
	# segue sweetspot-volume. Se CamillaDSP manca, volume software.
	# Preferenze derivate dalla stessa modalita' effettiva degli argomenti.
	prefs=$(volume_prefs "$(volume_modalita)")
	digital=${prefs% *}
	[ "$(volume_modalita)" = dsp ] && vol_dsp=1
	sig="$digital$vol_dsp$LMS_HOST"
	now=$(date +%s)
	if [ "$PREFS_SET" = 1 ] && [ "${PREFS_SIG:-}" = "$sig" ] && [ $(( now - ${PREFS_T:-0} )) -lt "$PREFS_OGNI" ]; then
		return 0
	fi
	PREFS_T=$now
	if [ "$(LMS_TIMEOUT=5 lms_get '._connected' "$PLAYER_MAC" connected '?')" != 1 ]; then
		# Player non collegato o server irraggiungibile: alla
		# riconnessione le preferenze si riapplicano.
		PREFS_SET=0
		[ "$(mode)" = completa ] || prefs_stato "non verificabili (server esterno non raggiungibile o player non collegato)"
		return 1
	fi
	# Gia' applicate e invariate: basta rileggerle; se divergono, di nuovo.
	if [ "$PREFS_SET" = 1 ] && [ "${PREFS_SIG:-}" = "$sig" ] && [ -z "$(prefs_divergenti "$digital")" ]; then
		prefs_stato "applicate (volume $(volume_effettivo))"
		return 0
	fi
	# Passaggio a caldo da volume fisso a software o dsp: in fisso Lyrion e'
	# tenuto a 100, e con il controllo digitale acceso quel 100 diventerebbe
	# il volume reale (picco). Prima di accenderlo si riporta a un valore
	# sicuro, se il volume attuale lo supera.
	if [ "$digital" = 1 ] && volume_era_fisso; then
		sicuro=$(conf VOLUME_SICURO 25)
		case "$sicuro" in ''|*[!0-9]*) sicuro=25 ;; esac
		cur=$(LMS_TIMEOUT=5 lms_get '._volume' "$PLAYER_MAC" mixer volume '?')
		case "$cur" in ''|*[!0-9]*) cur=100 ;; esac
		if [ "$cur" -gt "$sicuro" ]; then
			lms_json "$PLAYER_MAC" mixer volume "$sicuro" > /dev/null || return 1
			log "player: passaggio dal volume fisso a $(volume_modalita): volume riportato da $cur a $sicuro"
		fi
	fi
	lms_json "$PLAYER_MAC" playerpref digitalVolumeControl "$digital" > /dev/null || return 1
	lms_json "$PLAYER_MAC" playerpref replayGainMode 0 > /dev/null || return 1
	lms_json "$PLAYER_MAC" playerpref transitionType 0 > /dev/null || return 1
	lms_json "$PLAYER_MAC" playerpref maxBitrate 0 > /dev/null || return 1
	if [ "$digital" = 0 ] && [ "$vol_dsp" = 0 ]; then
		lms_json "$PLAYER_MAC" mixer volume 100 > /dev/null || return 1
	fi
	PREFS_SET=1
	PREFS_SIG=$sig
	# Ricorda se il volume e' fisso (Lyrion a 100) per il prossimo cambio di modo.
	# Il marcatore sta in $RUN (non in una variabile): sopravvive al riavvio del
	# supervisore. Si toglie solo dopo la verifica del volume in software/dsp.
	if [ "$digital" = 0 ]; then
		: > "$RUN/volume.fisso"
		volume_tipo_scrivi fisso
	else
		rm -f "$RUN/volume.fisso"
		volume_tipo_scrivi altro
	fi
	div=$(prefs_divergenti "$digital")
	if [ -n "$div" ]; then
		prefs_stato "divergenti, non imponibili: $div"
	else
		prefs_stato "applicate (volume $(volume_effettivo))"
	fi
}

# Istanza del DAC senza processi: id ALSA e, per USB, busnum:devnum del
# dispositivo (come dac_instance, ma con la sola shell; il percorso USB si
# ricava una volta per sessione con inst_fast_start).
inst_fast_start() { # scheda
	INSTP=$(dac_usb_device "$1" 2>/dev/null)
	inst_fast "$1"
}
inst_fast() { # scheda
	local id='' bus='' dev=''
	read -r id < "$PROC/asound/card$1/id" 2>/dev/null
	if [ -n "$INSTP" ] && [ -f "$INSTP/devnum" ]; then
		read -r bus < "$INSTP/busnum" 2>/dev/null
		read -r dev < "$INSTP/devnum" 2>/dev/null
	fi
	IFAST="$id $bus:$dev"
}
SORVEGLIA_LUNGO=${SWEETSPOT_SORVEGLIA_LUNGO:-60}
SORVEGLIA_RIPOSO=${SWEETSPOT_SORVEGLIA_RIPOSO:-300}

player_loop() {
	BACKOFF=0
	while true; do
		# DAC in uso dal Bluetooth: nessuno riapre Squeezelite finche' non lo restituisce.
		if bt_dac_busy; then
			[ "$(cat "$STATE" 2>/dev/null)" = "DAC in uso dal Bluetooth" ] || say "DAC in uso dal Bluetooth"
			nap 2
			continue
		fi
		card=$(dac_find)
		if [ -z "$card" ]; then
			[ "$(cat "$STATE" 2>/dev/null)" = "in attesa del DAC" ] || say "in attesa del DAC"
			# Le zone continuano anche senza il DAC principale.
			zones_sync ""
			nap 3
			continue
		fi
		remember_main_dac "$card"
		setup_usb_irq "$card"
		run_player "$card" || {
			if [ -s "$RUN/correzione.errore" ] && [ "$(dsp_politica)" = blocca ]; then
				[ "$(cat "$STATE" 2>/dev/null)" = "bloccato: correzione non disponibile" ] || say "bloccato: correzione non disponibile"
				nap 10
			else
				nap 2
			fi
			continue
		}
		dsp_stato_poll
		t0=$(date +%s)
		LOST=0
		say "attivo su $(dac_name "$card")"
		WATCH_N=0
		start_latency_watch
		start_volume_watch
		# Sorveglia: se il DAC sparisce si ferma il player e si ricomincia.
		rm -f "$RUN/audio.tid"
		# Il DAC e la sua istanza si guardano a ogni giro con la sola shell
		# (nessun processo); il resto (zone, preferenze, rotazione del
		# registro, stato di CamillaDSP) a riposo ogni SORVEGLIA_LUNGO s: a
		# ogni giro costava decine di processi, la fonte principale dei fork
		# a riposo. Con la correzione attiva, o finche' il thread audio non
		# e' agganciato, il giro completo resta ogni 2 s.
		inst_fast_start "$card"
		inst_ref=$IFAST
		prossimo=0
		ripr=0
		read -r ini_s _ < /proc/uptime
		ini_s=${ini_s%%.*}
		while kill -0 "$PID" 2>/dev/null; do
			# Con CamillaDSP nel percorso si guarda piu' spesso: ogni nuovo
			# processo nasce con la priorita' del player e va sistemato.
			# A riposo (nessuna riproduzione sul DAC) il giro e' sempre lento.
			if dac_playing; then
				if [ "$ripr" = 0 ]; then ripr=1; prossimo=0; fi
				if [ -f "$RUN/audio.tid" ] && [ ! -f "$RUN/correzione.attiva" ]; then nap 5; else nap 2; fi
			else
				ripr=0
				nap 5
			fi
			inst_fast "$card"
			if [ ! -d "$PROC/asound/card$card" ] || [ "$IFAST" != "$inst_ref" ]; then
				log "player: DAC scollegato o ricollegato"
				LOST=1
				kill "$PID" 2>/dev/null
				break
			fi
			watch_check
			read -r adesso_s _ < /proc/uptime
			adesso_s=${adesso_s%%.*}
			# Giro completo ogni 2 s solo mentre il DAC riproduce (correzione
			# attiva o thread audio non agganciato); a riposo ogni SORVEGLIA_LUNGO.
			# Nei primi 30 s un gruppo di sincronizzazione da ripristinare si guarda ogni 5 s.
			pend=0
			if [ "$adesso_s" -lt $((ini_s + 30)) ]; then
				for f in "$SYNC_DIR"/*.pendente; do [ -f "$f" ] && pend=1; done
			fi
			if [ "$adesso_s" -ge "$prossimo" ] || [ "$pend" = 1 ] || { [ "$ripr" = 1 ] && { [ -f "$RUN/correzione.attiva" ] || [ ! -f "$RUN/audio.tid" ]; }; }; then
				if [ "$ripr" = 1 ]; then
					prossimo=$((adesso_s + SORVEGLIA_LUNGO))
					PREFS_OGNI=$PREFS_ATTIVO
					pin_output_thread "$PID"
					pin_dsp
					dsp_clip_poll
					dsp_underrun_poll
				else
					# A riposo (nessuna riproduzione) contano solo le cose che
					# non dipendono dal flusso: il giro costa decine di
					# processi (jq, wget, sottoshell) e si fa raramente.
					prossimo=$((adesso_s + SORVEGLIA_RIPOSO))
					PREFS_OGNI=$SORVEGLIA_RIPOSO
				fi
				dsp_session_check
				dsp_stato_poll
				sqlog_rotate "$SQLOG"
				log_quota_tick
				zones_sync "$card"
				apply_player_prefs
				sync_poll "$PLAYER_MAC"
			fi
		done
		stop_player "$PID"
		stop_watch "$LATPID"
		stop_watch "$VOLPID"
		stop_dsp
		rm -f "$RUN/audio.tid"
		if [ "$LOST" = 1 ]; then
			BACKOFF=0
			say "riavvio del player"
			nap 2
		else
			BACKOFF=$(backoff_next "$BACKOFF" $(( $(date +%s) - t0 )))
			if [ "$BACKOFF" -gt 0 ]; then
				say "squeezelite terminato subito, nuovo tentativo tra $BACKOFF s"
				nap "$BACKOFF"
			else
				say "riavvio del player"
				nap 2
			fi
		fi
	done
}

# I test includono questo file per provare le singole funzioni.
[ "${SWEETSPOT_TEST:-}" = 1 ] && return 0

mkdir -p "$RUN" /var/log
nap_init
# Supervisore appena partito: il DAC principale si sceglie di nuovo e le
# zone rimaste senza processo (fermate con il supervisore) non contano.
rm -f "$RUN/dac.principale"
# Un CamillaDSP rimasto da un supervisore finito male terrebbe occupato il DAC.
killall camilladsp 2>/dev/null
for f in "$ZONE_DIR"/*; do
	[ -f "$f" ] || continue
	read -r zpid _ < "$f"
	kill -0 "$zpid" 2>/dev/null || rm -f "$f"
done
setup_layout
log "player: modalita' $(mode), core di sistema $HK, riproduzione ${LAYOUT_AUDIO}, interruzioni USB ${LAYOUT_IRQ} (isolamento: $PIN)"
player_loop
