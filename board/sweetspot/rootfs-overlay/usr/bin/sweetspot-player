#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Sweetspot - supervisore della riproduzione: avvia squeezelite sul DAC e
# lo segue (DAC scollegato, ricollegato, cambiato).
#
# Modalita' completa: il server e' Lyrion su questa stessa macchina.
# Modalita' player: il server e' un Lyrion Music Server su un altro computer.
#
# Percorso del segnale:
#   - uscita ALSA diretta sul dispositivo hardware (hw:), mai plug o dmix;
#   - volume fisso al 100% (bit-perfect), salvo scelta diversa;
#   - buffer di ingresso e uscita in RAM per anticipare lettura e decodifica;
#     la dimensione del buffer non garantisce il precaricamento dell'intero brano;
#   - thread di riproduzione in real-time sul core isolato;
#   - interruzioni del controller USB del DAC sul loro core dedicato.

. "${SWEETSPOT_LIB:-/usr/lib/sweetspot}/common.sh"

SQLOG=/var/log/squeezelite.log
DSPLOG=${SWEETSPOT_DSPLOG:-/var/log/camilladsp.log}
STATE=$RUN/player.stato

# Ritardo prima di riavviare squeezelite terminato da solo: raddoppia
# (2, 4, 8... fino a 60 s) se e' durato meno di STABILE secondi, si azzera dopo
# un periodo di funzionamento stabile.
STABILE=30
backoff_next() { # ritardo precedente, secondi di vita
	if [ "$2" -ge "$STABILE" ]; then echo 0; return; fi
	if [ "$1" -lt 2 ]; then echo 2; return; fi
	if [ "$1" -ge 30 ]; then echo 60; else echo $(( $1 * 2 )); fi
}

say() { echo "$1" > "$STATE"; log "player: $1"; }

is_number() { case "$1" in ''|*[!0-9]*) return 1 ;; esac; return 0; }

num_conf() {
	local v
	v=$(conf "$1" "$2")
	is_number "$v" || v=$2
	printf '%s' "$v"
}

# Core da usare: quelli effettivamente isolati da questo avvio.
setup_layout() {
	ISOLATED=$(expand_list "$(cat "$SYS/devices/system/cpu/isolated" 2>/dev/null)")
	cpu_layout
	if [ -z "$ISOLATED" ] || safe_mode; then
		PIN=0
		HK=$(join_list "$(cpu_online)")
	else
		PIN=1
		HK=$(join_list "$LAYOUT_HK")
	fi
}

# Interruzioni del controller USB del DAC: core dedicato e priorita' alta.
setup_usb_irq() {
	local card=$1 bdf irqs irq target prio p comm usbdev
	usbdev=$(dac_usb_device "$card")
	[ -n "$usbdev" ] && [ -f "$usbdev/power/control" ] && put on "$usbdev/power/control"
	bdf=$(dac_controller "$card")
	[ -n "$bdf" ] || return 0
	irqs=$(pci_irqs "$bdf")
	prio=$(num_conf PRIORITA_IRQ_USB 90)
	if [ "$PIN" = 1 ]; then target=$LAYOUT_IRQ; else target=""; fi
	echo "$bdf $irqs" > "$RUN/dac.controller"
	for irq in $irqs; do
		[ -n "$target" ] && put "$target" "$PROC/irq/$irq/smp_affinity_list"
		for p in "$PROC"/[0-9]*; do
			comm=$(cat "$p/comm" 2>/dev/null) || continue
			case "$comm" in
				"irq/$irq-"*) chrt -f -p "$prio" "${p##*/}" >/dev/null 2>&1 ;;
			esac
		done
	done
	log "player: controller USB $bdf, interruzioni $irqs sul core ${target:-di sistema}"
}

# Sposta il thread real-time di squeezelite sul core della riproduzione.
# Squeezelite lo crea dopo aver preparato i buffer: si riprova a ogni giro
# di sorveglianza finche' non compare.
pin_output_thread() {
	local pid=$1 t policy
	[ "$PIN" = 1 ] || return 0
	[ -f "$RUN/audio.tid" ] && [ -d "$PROC/$pid/task/$(cat "$RUN/audio.tid")" ] && return 0
	for t in "$PROC/$pid"/task/*; do
		policy=$(sed 's/.*) //' "$t/stat" 2>/dev/null | cut -d' ' -f39)
		if [ "$policy" = 1 ]; then
			taskset -p -c "$LAYOUT_AUDIO" "${t##*/}" >/dev/null 2>&1
			echo "${t##*/}" > "$RUN/audio.tid"
			log "player: thread di riproduzione ${t##*/} sul core $LAYOUT_AUDIO"
			return 0
		fi
	done
	return 1
}

# Priorita' real-time di CamillaDSP: sotto quella del player (che lo
# alimenta) e delle interruzioni USB, mai fuori da 1..98.
dsp_priority() {
	local p
	p=$(num_conf PRIORITA_DSP 70)
	[ "$p" -ge 1 ] || p=1
	[ "$p" -le 98 ] || p=98
	printf '%s' "$p"
}

# Thread audio di CamillaDSP, dal nome (comm): cattura dallo stdin del
# plugin, elaborazione (nome dato dalla nostra patch), riproduzione ALSA.
# Gli altri (principale, segnali, websocket e le sue connessioni) non
# toccano l'audio.
dsp_audio_thread() { # comm
	case "$1" in FileCapture|RawFileCapture|Processing|AlsaPlayback|AlsaPlaybackInner) return 0 ;; esac
	return 1
}

# Core consentiti a un thread (Cpus_allowed_list) e "PRIORITA' POLITICA".
thread_cpus() { sed -n 's/^Cpus_allowed_list:[[:space:]]*//p' "$1/status" 2>/dev/null; }
thread_sched() { sed 's/.*) //' "$1/stat" 2>/dev/null | cut -d' ' -f38,39; }

# CamillaDSP (correzione ambientale o volume a 64 bit): lo avvia il plugin
# ALSA a ogni brano, dal thread real-time di Squeezelite, quindi nasce con
# la sua priorita' (80) sul core della riproduzione. I suoi thread audio
# restano li', in real-time sotto il player (SCHED_FIFO, PRIORITA_DSP); gli
# altri (principale, segnali, websocket, connessioni di sweetspot-camilla)
# vanno sui core di sistema con la priorita' normale: sul core isolato
# gira solo l'audio. Senza thread "Processing" (CamillaDSP senza la nostra
# patch) si trattano tutti come audio, come prima. Un thread gia' a posto
# non si tocca; si controlla a ogni giro.
pin_dsp() {
	local p t tid prio comm named audio
	[ -f "$RUN/correzione.attiva" ] || return 0
	prio=$(dsp_priority)
	for p in $(pidof camilladsp 2>/dev/null); do
		oom_adj -1000 "$p"
		named=0
		for t in "$PROC/$p"/task/*; do
			[ "$(cat "$t/comm" 2>/dev/null)" = Processing ] && named=1
		done
		for t in "$PROC/$p"/task/*; do
			[ -d "$t" ] || continue
			tid=${t##*/}
			comm=$(cat "$t/comm" 2>/dev/null)
			if [ "$named" = 1 ] && ! dsp_audio_thread "$comm"; then audio=0; else audio=1; fi
			if [ "$audio" = 1 ]; then
				[ "$PIN" = 1 ] && [ "$(thread_cpus "$t")" != "$LAYOUT_AUDIO" ] &&
					taskset -p -c "$LAYOUT_AUDIO" "$tid" >/dev/null 2>&1
				[ "$(thread_sched "$t")" = "$prio 1" ] || chrt -f -p "$prio" "$tid" >/dev/null 2>&1
			else
				[ "$PIN" = 1 ] && [ "$(thread_cpus "$t")" != "$HK" ] &&
					taskset -p -c "$HK" "$tid" >/dev/null 2>&1
				[ "$(thread_sched "$t")" = "0 0" ] || chrt -o -p 0 "$tid" >/dev/null 2>&1
			fi
		done
		if [ "$(cat "$RUN/dsp.pid" 2>/dev/null)" != "$p" ]; then
			echo "$p" > "$RUN/dsp.pid"
			if [ "$PIN" = 1 ]; then
				log "player: CamillaDSP $p, thread audio in real-time (priorita' $prio) sul core $LAYOUT_AUDIO, gli altri sui core $HK"
			else
				log "player: CamillaDSP $p, thread audio in real-time (priorita' $prio)"
			fi
		fi
	done
}

# Inizio della sessione del player: da qui si contano XRUN, interruzioni
# sul core della riproduzione, campioni tagliati da CamillaDSP e latenza.
session_start() {
	local size=0
	[ -f "$SQLOG" ] && size=$(wc -c < "$SQLOG" | tr -d ' ')
	printf 'inizio=%s\nsqlog=%s\ncore=%s\n' "$(date +%s)" "${size:-0}" "$LAYOUT_AUDIO" > "$RUN/sessione"
	irq_cpu_counts "$LAYOUT_AUDIO" > "$RUN/sessione.irq"
	rm -f "$RUN/dsp.clip" "$RUN/latenza.ascolto" "$RUN/sessione.xrun"
	# Underrun di CamillaDSP: si contano dal registro da questo punto in poi.
	size=0
	[ -f "$DSPLOG" ] && size=$(wc -c < "$DSPLOG" | tr -d ' ')
	echo "${size:-0} 0" > "$RUN/dsp.underrun"
}

# Underrun di CamillaDSP nella sessione. CamillaDSP li scrive solo nel
# registro (-o, livello warn: "buffer underrun") e non ha un contatore nel
# websocket: a ogni giro si contano le righe nuove dall'ultima posizione
# letta. Il registro puo' ricominciare da capo (nuovo processo, rotazione):
# se e' piu' corto della posizione si riparte da zero. Riga: POSIZIONE TOTALE.
dsp_underrun_poll() {
	local off=0 total=0 size n
	[ -f "$RUN/correzione.attiva" ] || return 0
	[ -f "$DSPLOG" ] || return 0
	[ -s "$RUN/dsp.underrun" ] && read -r off total < "$RUN/dsp.underrun"
	size=$(wc -c < "$DSPLOG" | tr -d ' ')
	[ "${off:-0}" -le "$size" ] || off=0
	n=$(tail -c +"$((off + 1))" "$DSPLOG" | head -c "$((size - off))" | awk 'tolower($0) ~ /underrun/ { n++ } END { print n + 0 }')
	echo "$size $((${total:-0} + n))" > "$RUN/dsp.underrun"
}

# Campioni tagliati da CamillaDSP nella sessione. Il suo contatore riparte
# con ogni processo (il plugin cdsp lo riavvia quando cambia il formato):
# a ogni giro di sorveglianza si somma la crescita. Riga: PID ULTIMO TOTALE.
dsp_clip_poll() {
	local p v old="" last=0 total=0
	[ -f "$RUN/correzione.attiva" ] || return 0
	p=$(pidof camilladsp 2>/dev/null | cut -d' ' -f1)
	[ -n "$p" ] || return 0
	v=$(sweetspot-camilla "$DSP_PORTA" GetClippedSamples 2>/dev/null | sed -n 's/.*"value":\([0-9]*\).*/\1/p')
	[ -n "$v" ] || return 0
	[ -s "$RUN/dsp.clip" ] && read -r old last total < "$RUN/dsp.clip"
	if [ "$old" = "$p" ] && [ "$v" -ge "$last" ]; then
		total=$((total + v - last))
	else
		total=$((total + v))
	fi
	echo "$p $v $total" > "$RUN/dsp.clip"
}

# Stato del percorso trasformativo, leggibile da pagina web e diagnostica:
# $RUN/dsp.stato (chiave=valore). Dice se la correzione e' in uso, la
# politica scelta se non si e' potuta preparare, lo stato effettivo del
# processo CamillaDSP, i picchi per canale (dBFS; massimo della sessione)
# e i campioni tagliati. Picchi e stato vengono da CamillaDSP (websocket).
dsp_picco() { # comando campo-precedente -> "a,b" massimo per canale
	local v
	v=$(sweetspot-camilla "$DSP_PORTA" "$1" 2>/dev/null | sed -n 's/.*"value":\[\([^]]*\)\].*/\1/p')
	[ -n "$v" ] || { printf '%s' "$2"; return 0; }
	printf '%s\n%s\n' "$2" "$v" | awk -F, 'NF { for (i = 1; i <= NF; i++) if (!(i in m) || $i + 0 > m[i] + 0) m[i] = $i }
		END { n = 0; for (i in m) n++; for (i = 1; i <= n; i++) printf "%s%s", (i > 1 ? "," : ""), m[i] }'
}

dsp_stato_poll() {
	local p st clip="" pin pout via pol err und=0
	p=$(pidof camilladsp 2>/dev/null | cut -d' ' -f1)
	pol=$(dsp_politica)
	if [ -f "$RUN/correzione.attiva" ]; then via=camilladsp
	elif [ -s "$RUN/correzione.errore" ] && [ "$pol" = blocca ]; then via=bloccato
	elif [ -s "$RUN/correzione.errore" ]; then via=diretto-senza-correzione
	else via=diretto; fi
	err=$(cat "$RUN/correzione.errore" 2>/dev/null)
	st=assente
	pin=""; pout=""
	if [ -n "$p" ] && [ -f "$RUN/correzione.attiva" ]; then
		st=$(sweetspot-camilla "$DSP_PORTA" GetState 2>/dev/null | sed -n 's/.*"value":"\([A-Za-z]*\)".*/\1/p')
		[ -n "$st" ] || st=non-risponde
		pin=$(sed -n 's/^picco_ingresso=//p' "$RUN/dsp.stato" 2>/dev/null)
		pout=$(sed -n 's/^picco_uscita=//p' "$RUN/dsp.stato" 2>/dev/null)
		pin=$(dsp_picco GetCaptureSignalPeak "$pin")
		pout=$(dsp_picco GetPlaybackSignalPeak "$pout")
		[ -s "$RUN/dsp.clip" ] && read -r _ _ clip < "$RUN/dsp.clip"
		[ -s "$RUN/dsp.underrun" ] && read -r _ und < "$RUN/dsp.underrun"
	fi
	{
		printf 'percorso=%s\npolitica=%s\nerrore=%s\nprocesso=%s\nstato=%s\n' "$via" "$pol" "$err" "${p:-}" "$st"
		printf 'picco_ingresso=%s\npicco_uscita=%s\ncampioni_tagliati=%s\naggiornato=%s\n' "$pin" "$pout" "${clip:-0}" "$(date +%s)"
		printf 'underrun=%s\n' "${und:-0}"
	} > "$RUN/dsp.stato.tmp" && mv "$RUN/dsp.stato.tmp" "$RUN/dsp.stato"
}

# Cosa fare se la correzione richiesta non si puo' preparare:
# blocca (predefinito): il player non suona, niente segnale non corretto;
# diretto: suona sul DAC senza correzione, con avviso visibile.
dsp_politica() {
	case "$(lower "$(conf CORREZIONE_SE_ASSENTE blocca)")" in
	diretto) echo diretto ;;
	*) echo blocca ;;
	esac
}

# Latenza durante l'ascolto (facoltativa, LATENZA_ASCOLTO=si): una misura
# leggera sul core della riproduzione per tutta la sessione.
# I sorveglianti (volume, latenza) partono in un gruppo di processi
# proprio (setsid): fermandoli si fermano anche i loro figli (nc, pipeline).
start_volume_watch() {
	VOLPID=""
	[ "$(cat "$RUN/volume.modo" 2>/dev/null)" = dsp ] || return 0
	taskset -c "$HK" setsid sweetspot-volume segui "$PLAYER_MAC" &
	VOLPID=$!
}

stop_watch() { # pid
	[ -n "$1" ] || return 0
	kill -- "-$1" 2>/dev/null || kill "$1" 2>/dev/null
}

# --- Altri DAC (zone) ---------------------------------------------------------------
#
# ALTRI_DAC=si: ogni altro DAC USB con un'uscita ha il suo Squeezelite, cioe'
# un player separato in Lyrion ("Sweetspot - nome del DAC"); le zone si
# raggruppano e si sincronizzano da Lyrion. Il DAC principale resta com'e'
# (core isolato, correzione, volume a 64 bit); gli altri suonano sui core di
# sistema, con priorita' real-time un po' piu' bassa, uscita diretta,
# mixer del DAC a 0 dB e volume regolabile da Lyrion. Si avviano e si
# fermano da soli quando un DAC viene collegato o staccato, anche mentre il
# DAC principale manca.
#
# Il DAC principale e' quello indicato da DAC oppure, con DAC=auto, quello
# scelto la prima volta in questo avvio (annotato in $RUN/dac.principale):
# se viene staccato, il player principale lo aspetta e non passa a una zona
# (che intanto continua a suonare); al ritorno riprende lui.
ZONE_DIR=$RUN/zone

remember_main_dac() { # scheda
	is_yes "$(conf ALTRI_DAC no)" || return 0
	printf '%s\n' "$(dac_identity "$1")" > "$RUN/dac.principale.nuovo" &&
		mv "$RUN/dac.principale.nuovo" "$RUN/dac.principale"
}

other_dacs() { # scheda del DAC principale (vuota se manca)
	local d idx
	for d in "$PROC"/asound/card[0-9]*; do
		[ -d "$d" ] || continue
		idx=${d##*card}
		[ -f "$d/usbid" ] || continue
		[ -n "$(dac_playback_dev "$idx")" ] || continue
		if [ -n "$1" ]; then
			[ "$idx" = "$1" ] && continue
		else
			# Il DAC principale manca: quando torna non deve diventare
			# una zona, lo riprende il player principale.
			dac_wanted "$idx" && continue
		fi
		echo "$idx"
	done
}

# MAC stabile per ogni DAC (indirizzo locale, 02:...): Lyrion ricorda il
# player e le sue impostazioni anche se la porta USB o l'ordine di
# collegamento cambiano. Dall'identificativo USB e dal numero di serie
# (due DAC uguali: serie diverse); senza numero di serie, dal nome ALSA.
zone_mac() { # scheda
	local serial
	serial=$(dac_usb_serial "$1")
	[ -n "$serial" ] || serial=$(dac_id "$1")
	printf '%s %s' "$(dac_usbid "$1")" "$serial" | md5sum | awk '{ s = $1; printf "02:%s:%s:%s:%s:%s", substr(s, 1, 2), substr(s, 3, 2), substr(s, 5, 2), substr(s, 7, 2), substr(s, 9, 2) }'
}

zone_start() { # scheda
	local card=$1 id dev name server prio
	id=$(dac_id "$card")
	dev=$(dac_playback_dev "$card") || return 1
	name="$(conf NOME_PLAYER Sweetspot) - $(dac_name "$card")"
	if [ "$(mode)" = completa ]; then server=127.0.0.1; else server=$(conf SERVER); fi
	prio=$(( $(num_conf PRIORITA_AUDIO 80) - 5 ))
	set -- -o "hw:CARD=$id,DEV=$dev" -a "$(num_conf BUFFER_ALSA_MS 400):$(num_conf PERIODI_ALSA 4)::1" \
		-n "$name" -M Sweetspot -m "$(zone_mac "$card")" -C 30 -p "$prio" \
		-d output=info -d decode=info -f "/var/log/squeezelite-$id.log"
	[ -n "$server" ] && set -- "$@" -s "$server"
	# Niente DSD nativo ne' DoP sulle zone: il volume della zona e' software
	# (Lyrion) e Squeezelite non lo applica al DSD, che suonerebbe al 100%
	# dopo un brano PCM attenuato. Il DSD si converte in PCM, attenuabile.
	# Le zone non ricampionano mai: niente ripiego su plughw: (vedi run_player).
	set -- "$@" -H
	mkdir -p "$ZONE_DIR"
	# Il volume della zona lo fa Lyrion (software): il mixer del DAC a 0 dB.
	dac_unity_gain "$card"
	SWEETSPOT_DSD_MARGINE_DB=$(dsd_margine_db) taskset -c "$HK" squeezelite "$@" &
	echo "$! $id" > "$ZONE_DIR/$card"
	log "player: zona \"$name\" sul DAC $id"
}

# Allinea le zone ai DAC collegati: ferma quelle di DAC staccati (o diventati
# il principale, o con ALTRI_DAC=no), riavvia quelle cadute, avvia le nuove.
zones_sync() { # scheda del DAC principale (vuota se manca)
	local f card pid id want=0
	is_yes "$(conf ALTRI_DAC no)" && want=1
	for f in "$ZONE_DIR"/*; do
		[ -f "$f" ] || continue
		card=${f##*/}
		read -r pid id < "$f"
		if [ "$want" = 0 ] || [ "$card" = "$1" ] || [ "$(dac_id "$card")" != "$id" ] || ! kill -0 "$pid" 2>/dev/null; then
			kill "$pid" 2>/dev/null
			rm -f "$f"
			log "player: zona sul DAC $id fermata"
		fi
	done
	[ "$want" = 1 ] || return 0
	for card in $(other_dacs "$1"); do
		[ -f "$ZONE_DIR/$card" ] || zone_start "$card"
	done
}

start_latency_watch() {
	LATPID=""
	[ "$(lower "$(conf LATENZA_ASCOLTO no)")" = si ] || return 0
	taskset -c "$HK" setsid sweetspot-latenza --ascolto "$LAYOUT_AUDIO" &
	LATPID=$!
}

# Indirizzo del player (MAC) fisso: quello della prima scheda di rete, cosi'
# Lyrion lo riconosce sempre e ne conserva le impostazioni.
player_mac() {
	local f m
	for f in "$SYS"/class/net/*/address; do
		case "$f" in */lo/address) continue ;; esac
		m=$(cat "$f" 2>/dev/null)
		case "$m" in ''|00:00:00:00:00:00) continue ;; esac
		printf '%s' "$m"
		return 0
	done
	printf '02:53:57:45:45:54'
}

# Controllo del volume hardware del DAC (per VOLUME=dac): quello indicato
# in VOLUME_CONTROLLO o il primo con regolazione di riproduzione.
dac_volume_control() {
	local want line n=""
	want=$(conf VOLUME_CONTROLLO)
	if [ -n "$want" ]; then printf '%s' "$want"; return 0; fi
	amixer -c "$1" scontents 2>/dev/null | while IFS= read -r line; do
		case "$line" in
			"Simple mixer control '"*)
				n=${line#"Simple mixer control '"}
				n=${n%"',"*} ;;
			*Capabilities:*pvolume*)
				[ -n "$n" ] && { printf '%s' "$n"; break; } ;;
		esac
	done
}

# Controlli di volume della riproduzione del DAC (nomi, uno per riga).
dac_volume_controls() {
	local line n=""
	amixer -c "$1" scontents 2>/dev/null | while IFS= read -r line; do
		case "$line" in
			"Simple mixer control '"*)
				n=${line#"Simple mixer control '"}
				n=${n%"',"*} ;;
			*Capabilities:*pvolume*|*Capabilities:*pswitch*)
				[ -n "$n" ] && printf '%s\n' "$n"
				n="" ;;
		esac
	done
}

# Volume fisso: ogni controllo di volume del DAC a 0 dB (nessuna
# attenuazione) e senza muto, come su Daphile con il volume spento. Molti
# DAC USB espongono un volume proprio che, se non e' al massimo, abbassa il
# segnale dentro il DAC.
dac_unity_gain() {
	local card=$1 ctl
	dac_volume_controls "$card" | while IFS= read -r ctl; do
		amixer -q -c "$card" sset "$ctl" 0dB unmute 2>/dev/null ||
			amixer -q -c "$card" sset "$ctl" 100% unmute 2>/dev/null
		log "player: controllo '$ctl' del DAC a 0 dB"
	done
}

# Parametri di squeezelite per il ricampionamento facoltativo (spento di
# serie: bit-perfect). RICAMPIONAMENTO=sincrono porta ogni brano alla
# frequenza piu' alta della sua famiglia (44,1 -> 176,4/352,8 kHz, 48 ->
# 192/384 kHz); asincrono porta tutto alla frequenza massima del DAC.
# FILTRO: lineare (predefinito), intermedio, minimo.
resample_args() {
	local mode recipe phase
	mode=$(lower "$(conf RICAMPIONAMENTO no)")
	case "$mode" in sincrono|asincrono) ;; *) return 0 ;; esac
	case "$(lower "$(conf FILTRO lineare)")" in
		intermedio) phase=I ;;
		minimo) phase=M ;;
		*) phase=L ;;
	esac
	recipe="v$phase"
	[ "$mode" = asincrono ] && recipe="${recipe}X"
	printf '%s' "$recipe"
}

# Correzione chiesta ma non applicabile: il motivo va in correzione.errore
# (Stato). Con blocca il player non parte (esce con 1); con diretto suona
# senza correzione, con l'avviso nel registro e in Stato.
correzione_non_applicabile() { # motivo
	echo "$1" > "$RUN/correzione.errore"
	if [ "$(dsp_politica)" = blocca ]; then
		log "player: correzione ambientale non applicabile ($1), riproduzione bloccata (CORREZIONE_SE_ASSENTE=diretto per suonare senza)"
		dsp_stato_poll
		return 1
	fi
	log "player: ATTENZIONE correzione ambientale non applicabile ($1), uscita diretta sul DAC senza correzione (CORREZIONE_SE_ASSENTE=diretto)"
	dsp_stato_poll
	return 0
}

run_player() {
	local problema card=$1 id dev name server alsa periods prio dsd fmt pausa rate_ms maxrate outfmt vol ctl rs dsp top a
	id=$(dac_id "$card")
	dev=$(dac_playback_dev "$card") || return 1
	name=$(conf NOME_PLAYER Sweetspot)
	if [ "$(mode)" = completa ]; then server=127.0.0.1; else server=$(conf SERVER); fi
	alsa=$(num_conf BUFFER_ALSA_MS 400)
	[ "$alsa" -gt 499 ] && alsa=499
	[ "$alsa" -lt 20 ] && alsa=20
	periods=$(num_conf PERIODI_ALSA 4)
	prio=$(num_conf PRIORITA_AUDIO 80)
	pausa=$(num_conf PAUSA_DSD_MS 500)
	rate_ms=$(num_conf PAUSA_FREQUENZA_MS 0)
	maxrate=$(num_conf FREQUENZA_MAX 0)
	case "$(conf FORMATO_USCITA auto)" in 16|24|24_3|32) outfmt=$(conf FORMATO_USCITA) ;; *) outfmt="" ;; esac
	PLAYER_MAC=$(player_mac)
	echo "$PLAYER_MAC" > "$RUN/player.mac"

	# Correzione ambientale (facoltativa): squeezelite suona sul dispositivo
	# della correzione, che passa ogni brano a CamillaDSP; altrimenti
	# direttamente sul DAC.
	# Con VOLUME=dsp CamillaDSP c'e' anche senza correzione, per il volume.
	# correzione.attiva: CamillaDSP e' nel percorso; correzione.filtri: con i
	# filtri della stanza; volume.modo: dsp (volume a 64 bit) o riserva.
	dsp=""
	rm -f "$RUN/correzione.attiva" "$RUN/correzione.filtri" "$RUN/correzione.errore" "$RUN/correzione.motivo" "$RUN/volume.modo"
	# Correzione chiesta ma file mancanti, illeggibili, malformati o
	# incoerenti: errore visibile in Stato e, con la politica blocca, niente
	# riproduzione. Mai suono senza correzione in silenzio.
	problema=$(sweetspot-dsp problema)
	if [ -n "$problema" ]; then
		correzione_non_applicabile "$problema" || return 1
	elif sweetspot-dsp attiva; then
		if dsp=$(sweetspot-dsp prepara "$card"); then
			echo "$dsp" > "$RUN/correzione.attiva"
			if sweetspot-dsp correzione; then
				touch "$RUN/correzione.filtri"
				log "player: correzione ambientale attiva (CamillaDSP, attenuazione $(sweetspot-dsp guadagno) dB)"
			fi
			if sweetspot-dsp volume; then
				echo dsp > "$RUN/volume.modo"
				log "player: volume a 64 bit con dither (CamillaDSP)"
			fi
		else
			dsp=""
			if sweetspot-dsp richiesta; then
				problema=$(cat "$RUN/correzione.motivo" 2>/dev/null)
				correzione_non_applicabile "${problema:-preparazione di CamillaDSP non riuscita}" || return 1
			fi
		fi
	fi
	# Volume a 64 bit chiesto ma CamillaDSP non disponibile (o modalita'
	# player): il volume resta regolabile dal software, mai fisso al massimo.
	if [ "$(lower "$(conf VOLUME fisso)")" = dsp ] && [ ! -f "$RUN/volume.modo" ]; then
		echo riserva > "$RUN/volume.modo"
		log "player: volume a 64 bit non disponibile, uso il volume software"
	fi
	if [ -n "$dsp" ]; then
		set -- -o "$dsp" -O "hw:CARD=$id" -a "$alsa:$periods::0"
	else
		set -- -o "hw:CARD=$id,DEV=$dev" -a "$alsa:$periods:$outfmt:1"
	fi
	# decode=info: resample.c scrive "resampling from X -> Y" con il livello di
	# decode, che la pagina Stato usa per segnalare il ricampionamento.
	set -- "$@" -n "$name" -M Sweetspot -m "$PLAYER_MAC" \
		-b "$(PLAYER_BUFFERS_LOG=1 player_buffers)" -C 30 -p "$prio" \
		-d output=info -d decode=info -f "$SQLOG"
	[ -n "$server" ] && set -- "$@" -s "$server"
	# Pausa fra brani a frequenza diversa: Squeezelite svuota il buffer ALSA
	# (patch 0005) prima di riaprire il DAC; la pausa minima e' quanto il
	# buffer reale impiega a uscire, PAUSA_FREQUENZA_MS puo' solo allungarla.
	[ "$rate_ms" -lt "$alsa" ] && rate_ms=$alsa
	if [ "$maxrate" -gt 0 ]; then
		set -- "$@" -r "$maxrate:$rate_ms"
	else
		set -- "$@" -r ":$rate_ms"
	fi
	rs=$(resample_args)
	[ -n "$rs" ] && set -- "$@" -R "$rs"
	# Ricampiona solo se il DAC non puo' (flag E di Squeezelite): le frequenze
	# supportate restano bit-perfect, le altre vanno a una che il DAC accetta
	# invece di bloccarsi con -H. FREQUENZA_NON_SUPPORTATA=blocca mantiene il
	# rifiuto stretto (la pagina Stato mostra lo stallo).
	if [ -z "$rs" ] && [ -z "$dsp" ]; then
		if [ "$(lower "$(conf FREQUENZA_NON_SUPPORTATA ricampiona)")" = blocca ]; then
			log "player: frequenza non supportata dal DAC: rifiuto stretto (FREQUENZA_NON_SUPPORTATA=blocca)"
		else
			set -- "$@" -R "vLE"
		fi
	fi
	# Originale (niente ricampionamento, uscita diretta hw:): Squeezelite non
	# deve ripiegare su plughw: se il DAC rifiuta la frequenza, altrimenti ALSA
	# ricampiona di nascosto. Con -H si ferma e scrive l'errore nel registro.
	[ -z "$rs" ] && [ -z "$dsp" ] && set -- "$@" -H

	# Frequenza massima che il player dichiara a Lyrion (HELO MaxSampleRate,
	# dal -r di Squeezelite o dal probe del DAC): sopra, Lyrion ricampiona lato
	# server con sox. Annotata per la pagina Stato (check_lyrion_sox);
	# MaxSampleRate non e' una preferenza di Lyrion, non si imposta da qui.
	top=$(dac_rates "$card" 2>/dev/null | tr ' ' '\n' | grep . | sort -n | tail -n 1)
	if [ "$maxrate" -gt 0 ] && { [ -z "$top" ] || [ "$maxrate" -lt "$top" ]; }; then top=$maxrate; fi
	rm -f "$RUN/frequenza.max"
	[ -n "$top" ] && echo "$top" > "$RUN/frequenza.max"
	# Modalita' effettiva del volume, calcolata una volta (hardware, fisso,
	# digitale) e condivisa con Lyrion e con l'interfaccia web.
	# Una sola funzione decide la modalita' (volume_modo_calcola, common.sh) e
	# da lei derivano argomenti, preferenze di Lyrion e diagnostica.
	ctl=""
	[ "$(lower "$(conf VOLUME fisso)")" = dac ] && ctl=$(dac_volume_control "$card")
	vol=$(volume_modo_calcola "$ctl")
	VOL_MODO=${vol%%|*}
	VOL_MOTIVO=${vol#*|}
	[ -n "$VOL_MOTIVO" ] && log "player: volume $(lower "$(conf VOLUME fisso)") non applicabile ($VOL_MOTIVO), modalita' effettiva: $VOL_MODO"
	# Fisso e a 64 bit: Squeezelite ignora il guadagno (-F) e i campioni
	# escono invariati, qualunque cosa mandi Lyrion (anche remoto, dove le
	# preferenze possono non essere imponibili). Con dsp Lyrion tiene il
	# controllo digitale (cosi' Material mostra il cursore) e il volume lo
	# applica CamillaDSP (sweetspot-volume segue il cursore).
	while IFS= read -r a; do
		[ -n "$a" ] && set -- "$@" "$a"
	done <<EOF
$(volume_args "$VOL_MODO" "$ctl")
EOF
	# Con il volume fisso anche il mixer del DAC va a 0 dB (garanzia locale);
	# VOLUME=dac che ripiega su fisso (niente mixer) comprende questo caso.
	[ "$VOL_MODO" = dac ] || dac_unity_gain "$card"

	dsd=$(lower "$(conf DSD auto)")
	fmt=$(dac_native_dsd "$card")
	# Con la correzione il DSD si converte in PCM (i filtri lavorano sul PCM).
	[ -n "$dsp" ] && dsd=pcm
	# Volume software: Squeezelite non lo applica al DSD nativo o DoP (output.c),
	# quindi dopo un brano PCM attenuato un DSF suonerebbe al 100% (+30 dB).
	# Per orecchie e diffusori il DSD si converte sempre in PCM, che il volume
	# attenua; il DSD nativo resta con volume fisso, del DAC o a 64 bit.
	rm -f "$RUN/dsd.volume"
	if [ "$VOL_MODO" = software ] && [ "$dsd" != pcm ]; then
		dsd=pcm
		echo pcm > "$RUN/dsd.volume"
		log "player: volume software: il DSD si converte in PCM (il volume non agisce sul DSD nativo)"
	fi
	# Squeezelite non esclude mai il DSD: Lyrion non sa convertire DSF/DFF in
	# PCM (non ha regole dsf/dff -> pcm), quindi i file arrivano interi e li
	# decodifica Squeezelite. Nativo o DoP solo con -D; altrimenti (e quando
	# il DAC non regge la frequenza del DSD) li converte in PCM da solo, alla
	# frequenza piu' alta che il DAC accetta (patch 0004).
	case "$dsd" in
		auto|nativo)
			if [ -n "$fmt" ]; then
				set -- "$@" -D "$pausa:$fmt"
			else
				[ "$dsd" = nativo ] && log "player: DSD nativo richiesto ma non dichiarato dal DAC"
			fi ;;
		dop) set -- "$@" -D "$pausa:dop" ;;
		*) ;;
	esac

	printf '%s ' "$@" > "$RUN/player.args"
	# Stato per Stato/Audio, con la verifica sugli argomenti reali.
	volume_stato_scrivi "$VOL_MODO" "$VOL_MOTIVO"
	session_start
	taskset -c "$HK" squeezelite "$@" &
	PID=$!
	echo "$PID" > "$RUN/squeezelite.pid"
	# Mai ucciso dall'OOM killer: senza swap, sotto pressione di memoria
	# cadrebbero prima gli altri (vedi oom_adj in common.sh).
	oom_adj -1000 "$PID"
	PREFS_SET=0
}

# Impostazioni del player in Lyrion, appena il player e' collegato e poi a
# ogni cambio o riconnessione: volume fisso al 100% (bit-perfect) o
# regolabile, niente ReplayGain, niente dissolvenze tra i brani, nessun
# limite di bitrate (i file arrivano al player cosi' come sono).
# Con Lyrion locale le impone; con un server esterno (SERVER) le chiede via
# JSON-RPC se raggiungibile. Ogni PREFS_OGNI secondi rilegge i valori: se
# divergono li reimposta e, se non ci riesce, lo scrive in
# $RUN/fedelta.stato e nel log (una volta per cambio di stato).
PREFS_OGNI=${SWEETSPOT_PREFS_OGNI:-15}

prefs_stato() { # testo
	[ "$(cat "$RUN/fedelta.stato" 2>/dev/null)" = "$1" ] && return 0
	printf '%s\n' "$1" > "$RUN/fedelta.stato.nuovo" && mv "$RUN/fedelta.stato.nuovo" "$RUN/fedelta.stato"
	log "player: preferenze di fedelta': $1"
}

# Stampa le preferenze la cui lettura non coincide con quella richiesta.
prefs_divergenti() { # digitale
	local nome valore got out=""
	for nome in digitalVolumeControl:$1 replayGainMode:0 transitionType:0 maxBitrate:0; do
		valore=${nome#*:}
		nome=${nome%%:*}
		got=$(LMS_TIMEOUT=5 lms_get '._p2' "$PLAYER_MAC" playerpref "$nome" '?')
		[ "$got" = "$valore" ] || out="$out${out:+ }$nome=${got:-?}(richiesto $valore)"
	done
	printf '%s' "$out"
}

apply_player_prefs() {
	local digital=0 vol_dsp=0 sig now div srv prefs LMS_HOST=$LMS_HOST
	if [ "$(mode)" != completa ]; then
		# Server esterno: raggiungibile solo se indicato (SERVER); con la
		# ricerca automatica non si sa dove sia.
		srv=$(conf SERVER)
		if [ -z "$srv" ]; then
			prefs_stato "non verificabili (server esterno non indicato; guadagno locale $(cat "$RUN/volume.locale" 2>/dev/null || echo "non verificato"), modalita' $(volume_modalita))"
			return 0
		fi
		LMS_HOST=${srv%%:*}
	fi
	# Volume a 64 bit: il controllo digitale del volume resta acceso in
	# Lyrion (senza, Material e le app mostrano il player a volume fisso e
	# nascondono il cursore); Squeezelite lo ignora (-F) e il cursore lo
	# segue sweetspot-volume. Se CamillaDSP manca, volume software.
	# Preferenze derivate dalla stessa modalita' effettiva degli argomenti.
	prefs=$(volume_prefs "$(volume_modalita)")
	digital=${prefs% *}
	[ "$(volume_modalita)" = dsp ] && vol_dsp=1
	sig="$digital$vol_dsp$LMS_HOST"
	now=$(date +%s)
	if [ "$PREFS_SET" = 1 ] && [ "${PREFS_SIG:-}" = "$sig" ] && [ $(( now - ${PREFS_T:-0} )) -lt "$PREFS_OGNI" ]; then
		return 0
	fi
	PREFS_T=$now
	if [ "$(LMS_TIMEOUT=5 lms_get '._connected' "$PLAYER_MAC" connected '?')" != 1 ]; then
		# Player non collegato o server irraggiungibile: alla
		# riconnessione le preferenze si riapplicano.
		PREFS_SET=0
		[ "$(mode)" = completa ] || prefs_stato "non verificabili (server esterno non raggiungibile o player non collegato)"
		return 1
	fi
	# Gia' applicate e invariate: basta rileggerle; se divergono, di nuovo.
	if [ "$PREFS_SET" = 1 ] && [ "${PREFS_SIG:-}" = "$sig" ] && [ -z "$(prefs_divergenti "$digital")" ]; then
		prefs_stato "applicate (volume $(volume_effettivo))"
		return 0
	fi
	lms_json "$PLAYER_MAC" playerpref digitalVolumeControl "$digital" > /dev/null || return 1
	lms_json "$PLAYER_MAC" playerpref replayGainMode 0 > /dev/null || return 1
	lms_json "$PLAYER_MAC" playerpref transitionType 0 > /dev/null || return 1
	lms_json "$PLAYER_MAC" playerpref maxBitrate 0 > /dev/null || return 1
	if [ "$digital" = 0 ] && [ "$vol_dsp" = 0 ]; then
		lms_json "$PLAYER_MAC" mixer volume 100 > /dev/null || return 1
	fi
	PREFS_SET=1
	PREFS_SIG=$sig
	div=$(prefs_divergenti "$digital")
	if [ -n "$div" ]; then
		prefs_stato "divergenti, non imponibili: $div"
	else
		prefs_stato "applicate (volume $(volume_effettivo))"
	fi
}

player_loop() {
	BACKOFF=0
	while true; do
		# DAC in uso dal Bluetooth: nessuno riapre Squeezelite finche' non lo restituisce.
		if bt_dac_busy; then
			[ "$(cat "$STATE" 2>/dev/null)" = "DAC in uso dal Bluetooth" ] || say "DAC in uso dal Bluetooth"
			sleep 2
			continue
		fi
		card=$(dac_find)
		if [ -z "$card" ]; then
			[ "$(cat "$STATE" 2>/dev/null)" = "in attesa del DAC" ] || say "in attesa del DAC"
			# Le zone continuano anche senza il DAC principale.
			zones_sync ""
			sleep 3
			continue
		fi
		inst=$(dac_instance "$card")
		remember_main_dac "$card"
		setup_usb_irq "$card"
		run_player "$card" || {
			if [ -s "$RUN/correzione.errore" ] && [ "$(dsp_politica)" = blocca ]; then
				[ "$(cat "$STATE" 2>/dev/null)" = "bloccato: correzione non disponibile" ] || say "bloccato: correzione non disponibile"
				sleep 10
			else
				sleep 2
			fi
			continue
		}
		dsp_stato_poll
		t0=$(date +%s)
		LOST=0
		say "attivo su $(dac_name "$card")"
		start_latency_watch
		start_volume_watch
		# Sorveglia: se il DAC sparisce si ferma il player e si ricomincia.
		rm -f "$RUN/audio.tid"
		while kill -0 "$PID" 2>/dev/null; do
			# Con CamillaDSP nel percorso si guarda piu' spesso: ogni nuovo
			# processo nasce con la priorita' del player e va sistemato.
			if [ -f "$RUN/audio.tid" ] && [ ! -f "$RUN/correzione.attiva" ]; then sleep 5; else sleep 2; fi
			pin_output_thread "$PID"
			pin_dsp
			dsp_clip_poll
			dsp_underrun_poll
			dsp_stato_poll
			sqlog_rotate "$SQLOG"
			log_quota_tick
			zones_sync "$card"
			apply_player_prefs
			if [ ! -d "$PROC/asound/card$card" ] || [ "$(dac_instance "$card")" != "$inst" ]; then
				log "player: DAC scollegato o ricollegato"
				LOST=1
				kill "$PID" 2>/dev/null
			fi
		done
		wait "$PID" 2>/dev/null
		stop_watch "$LATPID"
		stop_watch "$VOLPID"
		rm -f "$RUN/audio.tid"
		if [ "$LOST" = 1 ]; then
			BACKOFF=0
			say "riavvio del player"
			sleep 2
		else
			BACKOFF=$(backoff_next "$BACKOFF" $(( $(date +%s) - t0 )))
			if [ "$BACKOFF" -gt 0 ]; then
				say "squeezelite terminato subito, nuovo tentativo tra $BACKOFF s"
				sleep "$BACKOFF"
			else
				say "riavvio del player"
				sleep 2
			fi
		fi
	done
}

# I test includono questo file per provare le singole funzioni.
[ "${SWEETSPOT_TEST:-}" = 1 ] && return 0

mkdir -p "$RUN" /var/log
# Supervisore appena partito: il DAC principale si sceglie di nuovo e le
# zone rimaste senza processo (fermate con il supervisore) non contano.
rm -f "$RUN/dac.principale"
for f in "$ZONE_DIR"/*; do
	[ -f "$f" ] || continue
	read -r zpid _ < "$f"
	kill -0 "$zpid" 2>/dev/null || rm -f "$f"
done
setup_layout
log "player: modalita' $(mode), core di sistema $HK, riproduzione ${LAYOUT_AUDIO}, interruzioni USB ${LAYOUT_IRQ} (isolamento: $PIN)"
player_loop
