#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Sweetspot - conserva sulla chiavetta, nella cartella sweetspot-dati, cio'
# che Lyrion costruisce o che l'utente sceglie: impostazioni, plugin
# installati, playlist, libreria (database) e statistiche di ascolto.
#
#   sweetspot-dati ripristina [cartella]   all'avvio: chiavetta -> RAM
#   sweetspot-dati salva                   RAM -> chiavetta (subito)
#   sweetspot-dati checkpoint              solo i database, a bassa priorita',
#                                          anche durante ascolto e scansione
#   sweetspot-dati sorveglia               salva da solo quando qualcosa
#                                          cambia: tutto a sistema fermo,
#                                          un checkpoint dei database durante
#                                          l'ascolto o la lettura della libreria
#
# Il sistema gira in RAM: senza questo salvataggio libreria, plugin e
# impostazioni andrebbero rifatti a ogni accensione.
#
# Sulla chiavetta (FAT32, che non conserva permessi e collegamenti):
#   lyrion.tar     preferenze, plugin installati, playlist
#   library.db     libreria
#   persist.db     valutazioni e statistiche di ascolto
# I database si copiano con il backup di SQLite, sicuro anche mentre
# Lyrion li usa. Il checkpoint sostituisce solo i database della generazione
# gia' salvata, uno alla volta (file nuovo, controllo, rinomina), scrivendo
# direttamente sulla chiavetta: niente copia in RAM, I/O idle, core di sistema.
# Prima di scrivere si controlla lo spazio: chiavetta piena = nessun
# tentativo ogni minuto, un avviso in Stato e un nuovo tentativo piu' tardi.
# Le copertine ridimensionate non si salvano: Lyrion le
# rifa' quando servono.

. "${SWEETSPOT_LIB:-/usr/lib/sweetspot}/common.sh"

CACHE=$LMS_DATA/cache
KEEP="prefs playlists cache/InstalledPlugins"
DBS="library.db persist.db"
STAMP=$RUN/dati.impronta
LOCK_WAIT=${SWEETSPOT_DATI_ATTESA:-300}
# Secondi tra due checkpoint durante ascolto o scansione, e tra due tentativi
# dopo "chiavetta piena"; margine di spazio libero richiesto in KB.
CHECKPOINT_MIN=${SWEETSPOT_DATI_CHECKPOINT:-900}
SPACE_RETRY=${SWEETSPOT_DATI_RITENTA:-1800}
SPACE_MARGIN_KB=${SWEETSPOT_DATI_MARGINE_KB:-8192}
CHECKPOINT_STAMP=$RUN/dati.checkpoint
# Da quando ci sono modifiche non ancora sulla chiavetta (secondi epoch).
DIRTY_SINCE=$RUN/dati.sporco
SPACE_FLAG=$RUN/dati.spazio

fingerprint() {
	# Un solo stat per gruppo di file (find -exec ... +), non uno per file: la
	# prova a ogni minuto costava un processo per ogni file di Lyrion (centinaia).
	{
		for d in $KEEP; do find "$LMS_DATA/$d" -type f -exec stat -c '%n %s %Y' {} + 2>/dev/null; done
		for f in $DBS; do
			stat -c '%n %s %Y' "$CACHE/$f" "$CACHE/$f-wal" 2>/dev/null
		done
	} | sort | md5sum | cut -d' ' -f1
}

do_restore() {
	local src="$1" f
	[ -d "$src" ] || [ -d "$src.vecchio" ] || return 0
	# Interruzione fra le due rinomine: la generazione precedente resta valida.
	if ! generation_valid "$src"; then
		if generation_valid "$src.vecchio"; then src=$src.vecchio
		else log "dati: nessuna generazione valida da ripristinare"; return 1; fi
	fi
	[ -d "$src" ] || return 0
	mkdir -p "$CACHE" || return 1
	if [ -f "$src/lyrion.tar" ]; then
		tar -xf "$src/lyrion.tar" -C "$LMS_DATA" 2>/dev/null || return 1
	fi
	for f in $DBS; do
		if [ -f "$src/$f" ]; then cp "$src/$f" "$CACHE/$f" || return 1; fi
	done
	chown -R lms:lms "$LMS_DATA" 2>/dev/null
	log "dati: impostazioni, plugin e libreria ripristinati dalla chiavetta"
}

# Copia coerente di un database SQLite in uso.
db_copy() {
	# Copiare il solo file principale dopo un errore perderebbe le transazioni
	# presenti nel WAL: senza un backup SQLite riuscito non si pubblica nulla.
	command -v sqlite3 > /dev/null || return 1
	sqlite3 "$1" ".timeout 10000" ".backup '$2'" 2>/dev/null || return 1
	snapshot_valid "$2"
}

snapshot_valid() {
	local uri
	# .backup include anche le transazioni commesse nel WAL, ma puo' lasciare
	# l'header in modalita' WAL. La copia e' autosufficiente: immutable evita
	# di creare -wal/-shm sulla chiavetta montata in sola lettura all'avvio.
	# Non usare immutable sul database live, il cui WAL deve essere letto.
	uri=$(printf '%s' "$1" | sed 's/%/%25/g; s/?/%3F/g; s/#/%23/g')
	[ "$(sqlite3 -readonly "file:$uri?immutable=1" 'PRAGMA quick_check;' 2>/dev/null)" = ok ]
}

generation_valid() {
	local src="$1" f found=0
	[ -d "$src" ] || return 1
	if [ -f "$src/lyrion.tar" ]; then
		tar -tf "$src/lyrion.tar" > /dev/null 2>&1 || return 1
		found=1
	fi
	for f in $DBS; do
		[ -f "$src/$f" ] || continue
		snapshot_valid "$src/$f" || return 1
		found=1
	done
	[ "$found" = 1 ]
}

save_failed() { # temporaneo destinazione [montata]
	rm -rf "$1"
	[ -n "$2" ] && rm -rf "$2.nuovo"
	[ "${3:-}" = 1 ] && stick_umount
	log "dati: salvataggio non riuscito, la generazione precedente e' conservata"
	return 1
}

# Il blocco vale per un solo salvataggio: "sorveglia" resta in vita e, se lo
# tenesse, il salvataggio chiamato al riavvio del player resterebbe in attesa.
# BusyBox flock non ha -w: si riprova ogni secondo fino al limite.
do_save() {
	local rc n=0 before after
	[ -d "$LMS_DATA" ] || return 0
	exec 8> "$RUN/dati.lock" || return 1
	while ! flock -n 8; do
		if [ "$n" -ge "$LOCK_WAIT" ]; then
			exec 8>&-
			log "dati: un altro salvataggio non termina da ${LOCK_WAIT}s, salvataggio rimandato"
			return 1
		fi
		sleep 1
		n=$((n + 1))
	done
	# Impronta presa prima della copia: cio' che cambia durante il salvataggio
	# potrebbe non essere nella copia, e va risalvato al prossimo controllo.
	before=$(fingerprint)
	save_generation; rc=$?
	if [ "$rc" -eq 0 ]; then
		# Si registra l'impronta della copia scritta, mai quella dello stato
		# live dopo la scrittura. Se nel frattempo e' cambiato qualcosa lo
		# stato "da salvare" resta (e l'eta' dei dati non salvati non riparte).
		echo "$before" > "$STAMP"
		after=$(fingerprint)
		if [ "$after" = "$before" ]; then
			rm -f "$DIRTY_SINCE"
		else
			date +%s > "$DIRTY_SINCE"
			log "dati: modifiche durante il salvataggio, verranno salvate al prossimo controllo"
		fi
	fi
	flock -u 8
	exec 8>&-
	return "$rc"
}

save_generation() {
	local dst tmp d f list="" found=0
	# Spazio sulla chiavetta prima di copiare nulla: i database vivi, il tar
	# (stimato 2 MB) e la generazione nuova accanto alla vecchia.
	space_ok $(( $(live_db_kb) + 2048 )) || return 1
	# Copia in RAM prima: la chiavetta resta montata il meno possibile.
	tmp=$RUN/dati.salva
	rm -rf "$tmp"
	mkdir -p "$tmp" || return 1
	for d in $KEEP; do [ -e "$LMS_DATA/$d" ] && list="$list $d"; done
	# shellcheck disable=SC2086
	if [ -n "$list" ]; then
		tar -cf "$tmp/lyrion.tar" -C "$LMS_DATA" $list || { save_failed "$tmp" ""; return 1; }
		found=1
	fi
	for f in $DBS; do
		[ -f "$CACHE/$f" ] || continue
		db_copy "$CACHE/$f" "$tmp/$f" || { save_failed "$tmp" ""; return 1; }
		found=1
	done
	[ "$found" = 1 ] || { rm -rf "$tmp"; return 0; }
	generation_valid "$tmp" || { save_failed "$tmp" ""; return 1; }
	if ! stick_mount rw; then
		rm -rf "$tmp"
		log "dati: chiavetta non trovata, salvataggio rimandato"
		return 1
	fi
	dst="$STICK_MNT/$DATA_DIR_NAME"
	# Recupera la vecchia copia prima di rimuoverla: un precedente riavvio
	# potrebbe essere avvenuto dopo dst -> dst.vecchio.
	if [ -d "$dst.vecchio" ]; then
		if [ ! -d "$dst" ] || { ! generation_valid "$dst" && generation_valid "$dst.vecchio"; }; then
			rm -rf "$dst" || { save_failed "$tmp" "$dst" 1; return 1; }
			mv "$dst.vecchio" "$dst" || { save_failed "$tmp" "$dst" 1; return 1; }
		fi
	fi
	rm -rf "$dst.nuovo"
	mkdir -p "$dst.nuovo" || { save_failed "$tmp" "$dst" 1; return 1; }
	for f in "$tmp"/*; do
		cp "$f" "$dst.nuovo/" 2>/dev/null || { save_failed "$tmp" "$dst" 1; return 1; }
		cmp -s "$f" "$dst.nuovo/${f##*/}" || { save_failed "$tmp" "$dst" 1; return 1; }
	done
	if ! generation_valid "$dst.nuovo" || ! sync; then save_failed "$tmp" "$dst" 1; return 1; fi
	rm -rf "$dst.vecchio" || { save_failed "$tmp" "$dst" 1; return 1; }
	if [ -d "$dst" ]; then
		mv "$dst" "$dst.vecchio" || { save_failed "$tmp" "$dst" 1; return 1; }
	fi
	if ! mv "$dst.nuovo" "$dst"; then
		[ -d "$dst.vecchio" ] && mv "$dst.vecchio" "$dst"
		save_failed "$tmp" "$dst" 1
		return 1
	fi
	# Sincronizza la rinomina prima di eliminare la generazione precedente.
	sync || { save_failed "$tmp" "$dst" 1; return 1; }
	rm -rf "$dst.vecchio"
	stick_umount
	rm -rf "$tmp"
	log "dati: salvati sulla chiavetta"
}

# KB occupati dai database vivi (file principale e WAL).
live_db_kb() {
	local f t=0 b
	for f in $DBS; do
		b=$(stat -c %s "$CACHE/$f" 2>/dev/null || echo 0)
		t=$((t + b / 1024))
		b=$(stat -c %s "$CACHE/$f-wal" 2>/dev/null || echo 0)
		t=$((t + b / 1024))
	done
	echo "$t"
}

# KB liberi sulla chiavetta (da montare).
stick_free_kb() {
	df -P -k "$STICK_MNT" 2>/dev/null | awk 'NR == 2 { print $4 }'
}

# C'e' spazio per scrivere $1 KB (piu' il margine)? Se manca lo scrive nel
# segnale letto da Stato e nel registro (una volta sola per episodio).
# Monta la chiavetta in sola lettura quando serve e la lascia come l'ha
# trovata.
space_ok() {
	local need=$(($1 + SPACE_MARGIN_KB)) free
	if ! stick_mount ro; then return 0; fi
	free=$(stick_free_kb)
	stick_umount
	case "$free" in ''|*[!0-9]*) return 0 ;; esac
	if [ "$free" -ge "$need" ]; then
		rm -f "$SPACE_FLAG"
		return 0
	fi
	if [ ! -f "$SPACE_FLAG" ]; then
		log "dati: chiavetta piena, servono $((need / 1024)) MB e ne restano $((free / 1024)): libreria non salvata"
	fi
	echo "$((free / 1024)) $((need / 1024)) $(date +%s)" > "$SPACE_FLAG"
	return 1
}

# Dopo "chiavetta piena" si riprova solo dopo SPACE_RETRY secondi.
space_wait() {
	local t
	[ -f "$SPACE_FLAG" ] || return 1
	t=$(awk '{ print $3 }' "$SPACE_FLAG" 2>/dev/null)
	case "$t" in ''|*[!0-9]*) return 1 ;; esac
	[ $(( $(date +%s) - t )) -lt "$SPACE_RETRY" ]
}

# Checkpoint dei database durante ascolto o scansione: nessun blocco sul
# salvataggio completo che in quel momento non puo' partire, nessuna copia
# in RAM. Il lavoro gira in una subshell a bassa priorita'.
do_checkpoint() {
	local rc=0
	[ -d "$LMS_DATA" ] || return 0
	exec 8> "$RUN/dati.lock" || return 1
	if ! flock -n 8; then exec 8>&-; return 1; fi
	( bg_self sweetspot-dati; checkpoint_dbs ) || rc=1
	flock -u 8
	exec 8>&-
	[ "$rc" -eq 0 ] && date +%s > "$CHECKPOINT_STAMP"
	return "$rc"
}

checkpoint_dbs() {
	local dst f n="" done_any=0
	command -v sqlite3 > /dev/null || return 1
	for f in $DBS; do [ -f "$CACHE/$f" ] && n="$n $f"; done
	[ -n "$n" ] || return 0
	space_ok "$(live_db_kb)" || return 1
	stick_mount rw || { log "dati: chiavetta non trovata, checkpoint rimandato"; return 1; }
	dst="$STICK_MNT/$DATA_DIR_NAME"
	# Una generazione interrotta (solo .vecchio) la sistema il salvataggio
	# completo: qui creare "dst" nasconderebbe la copia buona.
	if [ ! -d "$dst" ] && [ -d "$dst.vecchio" ]; then stick_umount; return 1; fi
	mkdir -p "$dst" || { stick_umount; return 1; }
	for f in $n; do
		rm -f "$dst/$f.nuovo"
		if sqlite3 "$CACHE/$f" ".timeout 10000" ".backup '$dst/$f.nuovo'" 2> /dev/null &&
			snapshot_valid "$dst/$f.nuovo" && sync && mv -f "$dst/$f.nuovo" "$dst/$f"; then
			done_any=1
		else
			rm -f "$dst/$f.nuovo"
			stick_umount
			log "dati: checkpoint di $f non riuscito, la copia precedente e' conservata"
			return 1
		fi
	done
	sync
	stick_umount
	[ "$done_any" = 1 ] && log "dati: checkpoint della libreria sulla chiavetta"
	return 0
}

checkpoint_due() {
	local t
	t=$(cat "$CHECKPOINT_STAMP" 2>/dev/null)
	case "$t" in ''|*[!0-9]*) return 0 ;; esac
	[ $(( $(date +%s) - t )) -ge "$CHECKPOINT_MIN" ]
}

# Eta' massima (minuti) dei dati non persistiti durante ascolto o scansione;
# 0 = nessun limite. Oltre questa eta' si salva comunque, a bassa priorita'.
eta_max_s() {
	local m
	m=$(conf DATI_ETA_MAX_MIN 30)
	case "$m" in ''|*[!0-9]*) m=30 ;; esac
	echo $((m * 60))
}

# Registra da quando i dati sono da salvare (solo la prima volta).
mark_dirty() {
	[ -s "$DIRTY_SINCE" ] || date +%s > "$DIRTY_SINCE"
}

# Vero se i dati non persistiti sono piu' vecchi del limite.
dirty_too_old() {
	local t lim
	lim=$(eta_max_s)
	[ "$lim" -gt 0 ] || return 1
	t=$(cat "$DIRTY_SINCE" 2>/dev/null)
	case "$t" in ''|*[!0-9]*) return 1 ;; esac
	[ $(( $(date +%s) - t )) -ge "$lim" ]
}

# Salvataggio completo forzato durante l'ascolto: subshell a bassa priorita'
# (I/O idle, nice 19, core di sistema) per non disturbare l'audio.
do_save_low() {
	( bg_self sweetspot-dati; do_save )
}

do_watch() {
	[ -f "$STAMP" ] || fingerprint > "$STAMP"
	while true; do
		sleep 60
		[ -n "$(stick_device)" ] || continue
		if [ "$(fingerprint)" = "$(cat "$STAMP" 2>/dev/null)" ]; then
			rm -f "$DIRTY_SINCE"
			continue
		fi
		mark_dirty
		space_wait && continue
		# Ascolto o lettura della libreria in corso: il salvataggio completo
		# aspetta, ma i database non restano senza copia fino a fine ascolto
		# e oltre l'eta' massima si salva comunque tutto, a bassa priorita'.
		if dac_playing || lms_scanning; then
			if dirty_too_old; then
				log "dati: dati non salvati da oltre il limite, salvataggio a bassa priorita'"
				do_save_low
			else
				checkpoint_due && do_checkpoint
			fi
			continue
		fi
		do_save
	done
}

[ "${SWEETSPOT_TEST:-}" = 1 ] && return 0

case "$1" in
	ripristina)
		# Chiamato con la chiavetta gia' montata dallo script di avvio.
		do_restore "${2:-$STICK_MNT/$DATA_DIR_NAME}"
		;;
	salva) do_save ;;
	checkpoint) do_checkpoint ;;
	sorveglia) do_watch ;;
	*) echo "uso: $0 ripristina|salva|checkpoint|sorveglia" >&2; exit 1 ;;
esac
