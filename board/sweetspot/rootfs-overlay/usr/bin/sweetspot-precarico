#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Sweetspot - precarico in RAM della coda di ascolto. I buffer del player
# coprono pochi secondi: qui i file della coda, dal brano in corso alla
# fine, vengono letti e bloccati in RAM (sweetspot-precarica) entro un
# budget di memoria; quando tutta la coda e' in RAM i dischi meccanici che
# la contengono vanno in standby. Lo streaming non si precarica.
#
#   PRECARICO=si|no              (predefinito si)
#   PRECARICO_MB=auto|N          memoria massima; auto: la quota di precarico del
#                                budget RAM unico (common.sh, ram_quote_calc:
#                                memoria libera meno sistema, servizi, ALSA e
#                                buffer del player); sempre 256 MB al sistema
#   PRECARICO_FILE_MAX_MB=N      file piu' grandi esclusi (predefinito 1024)
#   PRECARICO_STANDBY=si|no      dischi in standby a coda caricata
#
# Stato per la pagina Stato in $RUN/precarico.json. Solo in modalita'
# completa: in modalita' player la musica arriva da un server in rete.

. "${SWEETSPOT_LIB:-/usr/lib/sweetspot}/common.sh"

LIST=$RUN/precarico.elenco
STATE=$RUN/precarico.stato
SUMMARY=$RUN/precarico.json
HOLDER_PID=$RUN/precarico.tieni.pid
PLAN=$RUN/precarico.piano
SLEPT=$RUN/precarico.standby
URLS=$RUN/precarico.coda

# Limite dei file in KB (PRECARICO_FILE_MAX_MB, solo cifre).
file_max_kb() {
	local mb
	mb=$(conf PRECARICO_FILE_MAX_MB 1024)
	case "$mb" in ''|*[!0-9]*) mb=1024 ;; esac
	echo $((mb * 1024))
}

# KB che il precarico tiene gia' in RAM (non piu' contati come liberi).
held_kb() {
	precarico_tenuto_kb
}

# Memoria per il precarico in KB, dal budget RAM unico (common.sh): la quota
# che resta dopo sistema (256 MB sempre liberi), servizi, ALSA e buffer del
# player. La memoria gia' bloccata dal precarico e quella gia' occupata dal
# player contano nel capitale, altrimenti il budget si ridurrebbe dopo ogni
# caricamento. PRECARICO_MB puo' solo abbassare la quota, mai superarla; in
# auto si usa l'intera quota. Si rivaluta a ogni giro.
preload_budget_kb() {
	local mb
	ram_quote_calc
	mb=$(conf PRECARICO_MB auto)
	case "$mb" in
		''|auto|*[!0-9]*) echo "$RAM_PRECARICO" ;;
		*) [ $((mb * 1024)) -lt "$RAM_PRECARICO" ] && echo $((mb * 1024)) || echo "$RAM_PRECARICO" ;;
	esac
}

# Pressione di memoria del kernel (PSI): media a 10 s di "some", in centesimi
# di punto percentuale (0 se /proc/pressure/memory manca).
psi_memoria() {
	awk '$1 == "some" { for (i = 2; i <= NF; i++) if ($i ~ /^avg10=/) { split($i, a, "="); printf "%d", a[2] * 100; exit } }' \
		"$PROC/pressure/memory" 2>/dev/null
}

# PSI oltre la soglia (PRECARICO_PSI_MAX, % predefinita 10): il sistema fa
# fatica a trovare memoria, il precarico deve cedere.
psi_alta() {
	local max v
	max=$(conf PRECARICO_PSI_MAX 10)
	case "$max" in ''|*[!0-9]*) max=10 ;; esac
	v=$(psi_memoria)
	[ -n "$v" ] && [ "$v" -ge $((max * 100)) ]
}

# Percorso locale di un URL file:// di Lyrion (%XX decodificati); fallisce
# per gli altri URL (streaming, servizi in rete). Un brano di un file CUE ha
# l'URL del file seguito da #inizio-fine: il file da leggere e' sempre
# l'intero file, il frammento si scarta (un # nel nome e' scritto %23).
url_path() {
	local u
	case "$1" in
		file://*) ;;
		*) return 1 ;;
	esac
	u=${1#file://}
	u=${u%%#*}
	printf '%s' "$u" | LC_ALL=C awk '
		function hex(h,  i, n) { n = 0; h = toupper(h)
			for (i = 1; i <= 2; i++) n = n * 16 + index("0123456789ABCDEF", substr(h, i, 1)) - 1
			return n }
		{ s = $0; out = ""
		  while (match(s, /%[0-9A-Fa-f][0-9A-Fa-f]/)) {
			out = out substr(s, 1, RSTART - 1) sprintf("%c", hex(substr(s, RSTART + 1, 2)))
			s = substr(s, RSTART + 3) }
		  printf "%s", out s }'
}

# URL della coda dal brano in corso alla fine, uno per riga (vuoto se il
# player e' fermo o non c'e'). La coda si legge a pagine: una sola richiesta
# da 1000 brani tagliava le code piu' lunghe.
QUEUE_PAGE=500
QUEUE_MAX=${SWEETSPOT_PRECARICO_CODA_MAX:-100000}

queue_urls() {
	local mac head cur total start page
	mac=$(cat "$RUN/player.mac" 2>/dev/null) || return 1
	[ -n "$mac" ] || return 1
	head=$(lms_json "$mac" status 0 1 2>/dev/null | jq -r '.result
		| select(.mode == "play" or .mode == "pause")
		| "\((.playlist_cur_index // "0") | tonumber) \((.playlist_tracks // 0) | tonumber)"' 2>/dev/null) || return 1
	[ -n "$head" ] || return 1
	cur=${head% *} total=${head#* }
	[ "$total" -le "$QUEUE_MAX" ] || total=$QUEUE_MAX
	start=$cur
	while [ "$start" -lt "$total" ]; do
		page=$(lms_json "$mac" status "$start" "$QUEUE_PAGE" tags:u 2>/dev/null | jq -r '.result.playlist_loop[]? | .url // empty' 2>/dev/null) || return 1
		[ -n "$page" ] || break
		printf '%s\n' "$page"
		start=$((start + QUEUE_PAGE))
	done
}

# Piano del precarico dagli URL su stdin, in ordine di coda:
#   SI dimensione percorso | STREAM url | GRANDE dimensione percorso
#   OLTRE dimensione percorso | MANCA percorso
# Si ferma al primo file oltre il budget: i successivi aspetterebbero
# comunque quello, e il budget resta per i brani piu' vicini.
preload_plan() { # budget_kb file_max_kb
	local budget=$1 max=$2 used=0 url path kb full=0
	# Piu' brani dello stesso file (CUE, brano ripetuto): un solo carico.
	sed '/^file:\/\//s/#.*//' | awk '!visto[$0]++' | while IFS= read -r url; do
		[ -n "$url" ] || continue
		if ! path=$(url_path "$url"); then
			echo "STREAM $url"
			continue
		fi
		if [ ! -f "$path" ]; then
			echo "MANCA $path"
			continue
		fi
		kb=$(( ($(stat -c %s "$path") + 1023) / 1024 ))
		if [ "$kb" -gt "$max" ]; then
			echo "GRANDE $kb $path"
		elif [ "$full" = 1 ] || [ $((used + kb)) -gt "$budget" ]; then
			full=1
			echo "OLTRE $kb $path"
		else
			used=$((used + kb))
			echo "SI $kb $path"
		fi
	done
}

holder_running() {
	local pid
	pid=$(cat "$HOLDER_PID" 2>/dev/null) || return 1
	[ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

# Tutti i file da precaricare del piano sono gia' bloccati, senza nuove
# esclusioni (un file escluso o mancante richiede un nuovo verdetto)?
plan_held() { # piano
	local wanted
	wanted=$(printf '%s\n' "$1" | sed -n 's/^SI [0-9]* //p')
	if [ -n "$wanted" ]; then
		printf '%s\n' "$wanted" | grep -F -x -v -f "$LIST" -q && return 1
	fi
	! printf '%s\n' "$1" | grep -q -E '^(GRANDE|OLTRE|MANCA) '
}

# Rilascia (munlock/munmap nel demone) l'ultimo brano del piano, il piu'
# lontano nella coda, se il tenuto supera il budget o c'e' pressione di
# memoria. Riesce (0) solo se ne ha rilasciato uno.
shed_farthest() {
	local held budget last kb path pid
	held=$(held_kb)
	[ "$held" -gt 0 ] || return 1
	budget=$(preload_budget_kb)
	if [ "$held" -le "$budget" ] && ! psi_alta; then
		return 1
	fi
	last=$(grep -n '^SI ' "$PLAN" | tail -n 1)
	[ -n "$last" ] || return 1
	kb=${last#*:SI }; kb=${kb%% *}
	path=${last#*:SI $kb }
	awk -v n="${last%%:*}" -v kb="$kb" 'NR == n { sub(/^SI /, "OLTRE ") } { print }' "$PLAN" > "$PLAN.tmp" && mv "$PLAN.tmp" "$PLAN"
	sed -n 's/^SI [0-9]* //p' "$PLAN" > "$LIST"
	pid=$(cat "$HOLDER_PID" 2>/dev/null)
	[ -n "$pid" ] && kill -USR1 "$pid" 2>/dev/null
	log "precarico: memoria sotto la riserva (tenuti $((held / 1024)) MB, budget $((budget / 1024)) MB), rilasciato $path"
	return 0
}

release() {
	local pid
	pid=$(cat "$HOLDER_PID" 2>/dev/null)
	[ -n "$pid" ] && kill "$pid" 2>/dev/null
	rm -f "$HOLDER_PID" "$LIST" "$STATE" "$PLAN" "$SLEPT" "$SLEPT.t" "$URLS"
}

# Disco intero che contiene un file: /dev/sdb1 -> sdb.
file_disk() {
	local dev
	dev=$(df -P "$1" 2>/dev/null | awk 'NR == 2 { print $1 }')
	case "$dev" in /dev/*) part_disk "${dev#/dev/}" ;; *) return 1 ;; esac
}

HDPARM=${SWEETSPOT_HDPARM:-hdparm}

# Il disco e' davvero in standby? (hdparm -C non lo sveglia)
disk_in_standby() { # disco
	"$HDPARM" -C "/dev/$1" 2>/dev/null | grep -q 'standby'
}

# Dischi meccanici che contengono i file del piano.
plan_disks() {
	sed -n 's/^SI [0-9]* //p' "$PLAN" | while IFS= read -r path; do file_disk "$path"; done | sort -u |
		while IFS= read -r disk; do
			[ "$(cat "$SYS/block/$disk/queue/rotational" 2>/dev/null)" = 1 ] && echo "$disk"
		done
}

# Coda tutta in RAM: i dischi meccanici che la contengono vanno in standby.
# Lo stato scritto e' quello vero (hdparm -C): un disco svegliato da altro
# (Lyrion, la cartella condivisa) sparisce dall'elenco e si riprova a
# fermarlo non prima di un minuto, senza fare a gara con chi lo usa.
standby_disks() {
	local disk sleeping="" now last=0 retry=0
	is_yes "$(conf PRECARICO_STANDBY si)" || return 0
	now=$(date +%s)
	[ -f "$SLEPT.t" ] && last=$(cat "$SLEPT.t")
	[ $((now - last)) -ge 60 ] && retry=1
	for disk in $(plan_disks); do
		if disk_in_standby "$disk"; then
			sleeping="$sleeping $disk"
			continue
		fi
		if grep -q -w "$disk" "$SLEPT" 2>/dev/null; then
			log "precarico: disco $disk svegliato da altro"
		fi
		[ "$retry" = 1 ] || continue
		"$HDPARM" -y "/dev/$disk" >/dev/null 2>&1 || continue
		sleeping="$sleeping $disk"
		log "precarico: disco $disk in standby, coda in RAM"
	done
	[ "$retry" = 1 ] && echo "$now" > "$SLEPT.t"
	echo "${sleeping# }" > "$SLEPT"
}

# Righe di FILE che iniziano con PREFISSO (0 se il file manca).
count() { # prefisso file
	local n
	n=$(grep -c "^$1" "$2" 2>/dev/null)
	echo "${n:-0}"
}

# File da precaricare del piano con l'esito indicato nello stato (ok|errore).
planned_with() { # esito
	[ -f "$PLAN" ] && [ -f "$STATE" ] || { echo 0; return; }
	awk -F '\t' -v want="$1" 'NR == FNR { if ($1 == "file" && index($3, want) == 1) seen[$4] = 1; next }
		/^SI / { p = $0; sub(/^SI [0-9]+ /, "", p); if (p in seen) n++ } END { print n + 0 }' "$STATE" "$PLAN"
}

write_summary() { # stato
	local kb=0 sleeping=""
	kb=$(held_kb)
	[ -f "$SLEPT" ] && sleeping=$(cat "$SLEPT")
	jq -n --arg stato "$1" --argjson brani "$(count '' "$PLAN")" \
		--argjson caricati "$(planned_with ok)" \
		--argjson errori "$(planned_with errore)" --argjson mb $((kb / 1024)) \
		--argjson budget_mb $(( $(preload_budget_kb) / 1024 )) \
		--argjson ram "$(ram_quote_json)" \
		--argjson streaming "$(count 'STREAM ' "$PLAN")" --argjson grandi "$(count 'GRANDE ' "$PLAN")" \
		--argjson oltre "$(count 'OLTRE ' "$PLAN")" --argjson mancanti "$(count 'MANCA ' "$PLAN")" \
		--arg standby "$sleeping" \
		'{stato: $stato, brani: $brani, caricati: $caricati, errori: $errori, mb: $mb,
		  budget_mb: $budget_mb, ram_mb: $ram, streaming: $streaming, grandi: $grandi, oltre: $oltre,
		  mancanti: $mancanti, standby: $standby}' > "$SUMMARY.tmp" && mv "$SUMMARY.tmp" "$SUMMARY"
}

step() {
	local urls plan
	if [ "$(mode)" != completa ] || ! is_yes "$(conf PRECARICO si)"; then
		release
		write_summary spento
		return
	fi
	urls=$(queue_urls) || urls=""
	if [ -z "$urls" ]; then
		release
		write_summary attesa
		return
	fi
	# Il budget si rivaluta a ogni giro: se la memoria scende sotto la riserva
	# (o il kernel segnala pressione) si rilascia un brano per giro, il piu'
	# lontano, finche' il tenuto rientra nel budget.
	if holder_running && [ -f "$PLAN" ] && shed_farthest; then
		write_summary caricamento
		return
	fi
	# Con la coda uguale e il caricamento in corso o finito il piano resta:
	# niente stat dei file (sulle cartelle di rete e' traffico) a ogni giro.
	if [ "$urls" = "$(cat "$URLS" 2>/dev/null)" ] && holder_running && [ -f "$PLAN" ]; then
		plan=$(cat "$PLAN")
	else
		plan=$(printf '%s\n' "$urls" | preload_plan "$(preload_budget_kb)" "$(file_max_kb)")
		printf '%s\n' "$urls" > "$URLS"
	fi
	if [ "$plan" != "$(cat "$PLAN" 2>/dev/null)" ] && holder_running && plan_held "$plan"; then
		# Un brano finito esce dalla coda: gli altri sono gia' in RAM e i
		# dischi possono restare fermi.
		printf '%s\n' "$plan" > "$PLAN"
	elif [ "$plan" != "$(cat "$PLAN" 2>/dev/null)" ] || ! holder_running; then
		release
		printf '%s\n' "$plan" > "$PLAN"
		printf '%s\n' "$plan" | sed -n 's/^SI [0-9]* //p' > "$LIST"
		# Lettura in secondo piano, dietro a tutti (nice, ionice idle): il
		# brano in corso lo serve gia' il buffer del player.
		if command -v ionice >/dev/null 2>&1; then
			nice -n 19 ionice -c 3 /usr/sbin/sweetspot-precarica tieni "$LIST" "$STATE" &
		else
			nice -n 19 /usr/sbin/sweetspot-precarica tieni "$LIST" "$STATE" &
		fi
		echo $! > "$HOLDER_PID"
		# Le pagine bloccate non si liberano: sotto pressione di memoria
		# il precarico cade prima del player.
		oom_adj 500 $!
		log "precarico: $(grep -c . "$LIST") file della coda in caricamento"
	fi
	if grep -q '^stato	pronto' "$STATE" 2>/dev/null; then
		# Standby solo se tutta la coda locale e' in RAM: un file escluso
		# o non caricato farebbe ripartire il disco.
		if ! grep -q -E '^(GRANDE|OLTRE|MANCA) ' "$PLAN" &&
			[ "$(planned_with ok)" -eq "$(count 'SI ' "$PLAN")" ]; then
			standby_disks
			write_summary pronto
		else
			write_summary parziale
		fi
	else
		write_summary caricamento
	fi
}

[ "${SWEETSPOT_TEST:-}" = 1 ] && return 0

mkdir -p "$RUN"
trap 'release; write_summary spento; exit 0' TERM INT
while true; do
	step
	sleep 5
done
