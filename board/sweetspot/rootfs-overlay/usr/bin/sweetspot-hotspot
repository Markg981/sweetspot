#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Sweetspot - hotspot di configurazione per il primo avvio senza cavo.
#
#   sweetspot-hotspot sorveglia    (lanciato da S40sweetspot-net, in secondo piano)
#   sweetspot-hotspot scansiona    cerca le reti Wi-Fi e aggiorna l'elenco
#   sweetspot-hotspot collega      (dalle pagine) collega subito la rete salvata
#   sweetspot-hotspot stato        scrive il nome della scheda se l'hotspot e' acceso
#   sweetspot-hotspot richiesta    (dalle pagine) prova la rete Wi-Fi appena salvata
#
# Se dopo HOTSPOT_ATTESA secondi dall'avvio non c'e' nessuna connessione
# (nessun cavo con collegamento, nessun indirizzo, Wi-Fi non configurato o non
# connesso) e c'e' un adattatore Wi-Fi capace di fare da access point, accende
# la rete "Sweetspot-XXXX" (WPA2). Il telefono, collegato li', apre la pagina
# Rete (http://192.168.4.1/), sceglie la rete di casa e ne scrive la password:
# l'hotspot si spegne e Sweetspot si collega. Se la rete salvata non si collega
# entro HOTSPOT_PROVA secondi l'hotspot riparte. Con la rete funzionante l'hotspot
# non e' mai acceso: se arriva un cavo, si spegne.
#
# Con l'hotspot spento la pagina Rete cerca le reti con "scansiona" (su qualsiasi
# scheda Wi-Fi) e si collega a quella scelta con "collega": se non risponde e non
# c'e' altra connessione riparte la sorveglianza, quindi l'hotspot.

. "${SWEETSPOT_LIB:-/usr/lib/sweetspot}/common.sh"

AP_IP=192.168.4.1
AP_PID=$RUN/hotspot
LIST=$RUN/wifi-scan.list
RICHIESTA=$RUN/hotspot.richiesta
ATTESA=$RUN/hotspot.attesa
NET_INIT=${SWEETSPOT_NET_INIT:-/etc/init.d/S40sweetspot-net}
# Sostituibili nei test: la shell di BusyBox preferisce le sue applet al PATH.
IW=${SWEETSPOT_IW:-iw}
IPC=${SWEETSPOT_IP:-ip}
HOSTAPD=${SWEETSPOT_HOSTAPD:-hostapd}
UDHCPD=${SWEETSPOT_UDHCPD:-udhcpd}
DNSD=${SWEETSPOT_DNSD:-dnsd}
SLEEP=${SWEETSPOT_SLEEP:-sleep}
QRENCODE=${SWEETSPOT_QRENCODE:-qrencode}
# Sulla partizione di avvio (FAT, leggibile da un PC): nome, password e codice QR.
INFO_TXT=sweetspot-hotspot.txt
INFO_SVG=sweetspot-hotspot.svg

# Scheda Wi-Fi che sa fare da access point (prima trovata), altrimenti niente.
ap_iface() {
	local n i phy
	for n in "$SYS"/class/net/*; do
		i=${n##*/}
		[ -d "$n/wireless" ] || [ -d "$n/phy80211" ] || continue
		phy=$(cat "$n/phy80211/name" 2>/dev/null)
		[ -n "$phy" ] || continue
		if "$IW" phy "$phy" info 2>/dev/null | grep -q '^[[:space:]]*\* AP$'; then
			printf '%s' "$i"
			return 0
		fi
	done
	return 1
}

# Prima scheda Wi-Fi vera (anche senza modalita' access point).
wifi_iface() {
	local n
	for n in "$SYS"/class/net/*; do
		[ -e "$n/device" ] || continue
		[ -d "$n/wireless" ] || [ -d "$n/phy80211" ] || continue
		printf '%s' "${n##*/}"
		return 0
	done
	return 1
}

# C'e' una connessione che non e' l'hotspot? Un cavo con collegamento, oppure un
# indirizzo IPv4 su una scheda Wi-Fi diversa da $1 (quella dell'hotspot).
connected() {
	local n i
	for n in "$SYS"/class/net/*; do
		i=${n##*/}
		[ -e "$n/device" ] || continue
		[ "$(cat "$n/type" 2>/dev/null)" = 1 ] || continue
		[ "$i" = "${1:-}" ] && continue
		if [ -d "$n/wireless" ] || [ -d "$n/phy80211" ]; then
			[ -n "$("$IPC" -4 -o addr show scope global dev "$i" 2>/dev/null)" ] && return 0
		else
			[ "$(cat "$n/carrier" 2>/dev/null)" = 1 ] && return 0
		fi
	done
	return 1
}

# Solo i cavi, per spegnere l'hotspot quando ne arriva uno.
wired_up() {
	local n
	for n in "$SYS"/class/net/*; do
		[ -e "$n/device" ] || continue
		[ "$(cat "$n/type" 2>/dev/null)" = 1 ] || continue
		if [ -d "$n/wireless" ] || [ -d "$n/phy80211" ]; then continue; fi
		[ "$(cat "$n/carrier" 2>/dev/null)" = 1 ] && return 0
	done
	return 1
}

# Accende la radio e la scheda (S20sweetspot-tune le tiene spente).
radio_on() { # scheda
	local r
	for r in "$SYS"/class/rfkill/rfkill*; do
		[ -d "$r" ] || continue
		[ "$(cat "$r/type" 2>/dev/null)" = wlan ] && put 0 "$r/soft"
	done
	put on "$SYS/class/net/$1/device/power/control"
	return 0
}

# A hotspot spento, senza WIFI_NOME le radio tornano spente come all'avvio.
radio_off() {
	local r
	[ -n "$(conf WIFI_NOME)" ] && return 0
	for r in "$SYS"/class/rfkill/rfkill*; do
		[ -d "$r" ] || continue
		[ "$(cat "$r/type" 2>/dev/null)" = wlan ] && put 1 "$r/soft"
	done
	return 0
}

# Elenco delle reti vicine, "percentuale|nome", dalla piu' forte.
scan() { # scheda
	local out
	out=$("$IW" dev "$1" scan 2>/dev/null | awk '
		/^BSS /      { sig = 0 }
		/signal:/    { sig = $2 + 0 }
		/^[ \t]*SSID:/ {
			s = $0; sub(/^[ \t]*SSID: ?/, "", s)
			if (s == "" || s ~ /\\x00/) next
			p = int(2 * (sig + 100)); if (p < 0) p = 0; if (p > 100) p = 100
			print p "|" s
		}' | sort -t'|' -k1,1nr | awk '!seen[substr($0, index($0, "|") + 1)]++')
	[ -n "$out" ] || return 1
	# iw scrive i byte non stampabili (UTF-8, emoji) come \xNN e il backslash
	# raddoppiato: li riporta ai caratteri veri; scarta nomi con controlli.
	out=$(printf '%s\n' "$out" | while IFS= read -r l; do
		n=$(printf '%b' "${l#*|}")
		[ -n "$n" ] && valid_value "$n" && printf '%s|%s\n' "${l%%|*}" "$n"
	done)
	[ -n "$out" ] || return 1
	mkdir -p "$RUN"
	printf '%s\n' "$out" > "$LIST.tmp" && mv "$LIST.tmp" "$LIST"
}

# Password: HOTSPOT_PASSWORD (8-63 caratteri) se scritta in sweetspot.txt;
# altrimenti quella gia' scritta in sweetspot-hotspot.txt sulla partizione di
# avvio (stessa a ogni accensione, cosi' si legge da un PC senza schermo);
# altrimenti una nuova casuale (che ap_start salva li').
pass_ok() { [ "${#1}" -ge 8 ] && [ "${#1}" -le 63 ] && valid_value "$1"; }
ap_pass() {
	local p
	p=$(conf HOTSPOT_PASSWORD)
	if pass_ok "$p"; then
		printf '%s' "$p"
		return 0
	fi
	if stick_mount ro; then
		p=$(sed -n 's/^Password: //p' "$STICK_MNT/$INFO_TXT" 2>/dev/null | head -n 1 | tr -d '\r')
		stick_umount
		pass_ok "$p" && { printf '%s' "$p"; return 0; }
	fi
	tr -dc 'a-km-np-z2-9' < /dev/urandom 2>/dev/null | head -c 10
}

# Valore per il codice QR del Wi-Fi: \ ; , : " si proteggono con la barra.
qr_esc() { printf '%s' "$1" | sed 's/[\\;,:"]/\\&/g'; }

# Scrive sulla partizione di avvio nome, password e codice QR (SVG), cosi' si
# collega il telefono anche senza schermo. Il QR si copia anche in $RUN.
ap_info() { # nome password
	local qr
	qr="WIFI:T:WPA;S:$(qr_esc "$1");P:$(qr_esc "$2");;"
	"$QRENCODE" -t SVG -m 2 -o "$RUN/hotspot-qr.svg" "$qr" 2>/dev/null || rm -f "$RUN/hotspot-qr.svg"
	stick_mount rw || return 0
	{
		echo "SWEETSPOT - rete Wi-Fi di configurazione (hotspot)"
		echo
		echo "Rete Wi-Fi: $1"
		echo "Password: $2"
		echo "Poi apri http://$AP_IP/ (la pagina si apre da sola sulla maggior parte dei telefoni)."
		echo
		echo "Codice QR per collegare il telefono: $INFO_SVG (aprilo con il browser del PC)."
		echo "Per cambiare la password scrivi HOTSPOT_PASSWORD in sweetspot.txt."
	} > "$STICK_MNT/$INFO_TXT.tmp" && mv "$STICK_MNT/$INFO_TXT.tmp" "$STICK_MNT/$INFO_TXT"
	if [ -s "$RUN/hotspot-qr.svg" ]; then
		cp "$RUN/hotspot-qr.svg" "$STICK_MNT/$INFO_SVG.tmp" && mv "$STICK_MNT/$INFO_SVG.tmp" "$STICK_MNT/$INFO_SVG"
	fi
	sync
	stick_umount
	return 0
}

# La password si legge sullo schermo del player (nel registro non compare),
# con il codice QR in caratteri se qrencode c'e'.
#
# Con la schermata grafica (sweetspot-display) nome, password e QR sono gia'
# li': il testo sulle console del monitor ci finirebbe sopra.
announce() { # nome password
	local msg t qr a='' con=${SWEETSPOT_CONSOLE:-/dev/console} tty=${SWEETSPOT_TTY:-/dev/tty1}
	if [ -f "$RUN/schermo.grafico" ]; then
		tty=''
		read -r a < "$SYS/class/tty/console/active" 2>/dev/null
		case " $a" in *" tty"[0-9]*) con='' ;; esac
	fi
	msg=$(printf '\n=== Sweetspot: configurazione Wi-Fi ===\nCollega il telefono alla rete Wi-Fi: %s\nPassword: %s\nPoi apri http://%s/\n' "$1" "$2" "$AP_IP")
	qr=$("$QRENCODE" -t UTF8 -m 1 "WIFI:T:WPA;S:$(qr_esc "$1");P:$(qr_esc "$2");;" 2>/dev/null)
	[ -n "$qr" ] && msg=$(printf '%s\nOppure inquadra il codice:\n%s\n' "$msg" "$qr")
	for t in "$con" "$tty"; do
		[ -n "$t" ] && [ -w "$t" ] && printf '%s\n' "$msg" > "$t" 2>/dev/null
	done
	return 0
}

# La schermata si ridisegna subito, senza aspettare il suo giro di 20 s.
schermo_sveglia() {
	local p=''
	read -r p < "$RUN/schermo.pid" 2>/dev/null
	[ -n "$p" ] && kill -USR1 "$p" 2>/dev/null
	return 0
}

ap_start() { # scheda
	local i=$1 mac ssid pass h
	mac=$(tr -d ':' < "$SYS/class/net/$i/address" 2>/dev/null | tr 'a-f' 'A-F')
	ssid="Sweetspot-$(printf '%s' "${mac:-0000}" | tail -c 4)"
	pass=$(ap_pass)
	[ -n "$pass" ] || return 1
	mkdir -p "$RUN"
	radio_on "$i"
	# Nessun collegamento Wi-Fi precedente resta in piedi.
	[ -f "/run/udhcpc.$i.pid" ] && kill "$(cat "/run/udhcpc.$i.pid")" 2>/dev/null
	killall wpa_supplicant 2>/dev/null
	"$IPC" link set "$i" up
	# L'elenco delle reti si fa prima di diventare access point.
	scan "$i"
	"$IPC" addr flush dev "$i" 2>/dev/null
	"$IPC" addr add "$AP_IP/24" dev "$i" || return 1
	(
		umask 077
		cat > "$AP_PID.conf" <<HOSTAPD
interface=$i
driver=nl80211
ssid=$ssid
hw_mode=g
channel=6
ieee80211n=1
wmm_enabled=1
auth_algs=1
wpa=2
wpa_key_mgmt=WPA-PSK
rsn_pairwise=CCMP
wpa_passphrase=$pass
HOSTAPD
	)
	if ! "$HOSTAPD" -B -P "$AP_PID.hostapd.pid" "$AP_PID.conf" >/dev/null 2>&1; then
		"$IPC" addr flush dev "$i" 2>/dev/null
		rm -f "$AP_PID.conf"
		return 1
	fi
	rm -f "$AP_PID.conf"
	cat > "$AP_PID.udhcpd.conf" <<UDHCPD
start 192.168.4.10
end 192.168.4.50
interface $i
pidfile $AP_PID.udhcpd.pid
lease_file $AP_PID.leases
opt router $AP_IP
opt dns $AP_IP
opt subnet 255.255.255.0
opt lease 3600
UDHCPD
	: > "$AP_PID.leases"
	"$UDHCPD" "$AP_PID.udhcpd.conf" >/dev/null 2>&1
	# DNS minimo: i nomi di Sweetspot e le prove "portale" dei telefoni portano qui.
	{
		echo "sweetspot $AP_IP"
		echo "sweetspot.local $AP_IP"
		echo "$(lower "$(conf NOME_RETE sweetspot)").local $AP_IP"
		for h in connectivitycheck.gstatic.com clients3.google.com www.google.com www.gstatic.com captive.apple.com www.apple.com \
			www.msftconnecttest.com www.msftncsi.com detectportal.firefox.com connectivity-check.ubuntu.com nmcheck.gnome.org; do
			echo "$h $AP_IP"
		done
	} > "$AP_PID.dns.conf"
	"$DNSD" -c "$AP_PID.dns.conf" -i "$AP_IP" -p 53 >/dev/null 2>&1 &
	echo $! > "$AP_PID.dnsd.pid"
	echo "$i" > "$RUN/hotspot.attivo"
	echo "$ssid" > "$RUN/hotspot.ssid"
	# Per la schermata grafica (sweetspot-display).
	( umask 077; printf '%s\n' "$pass" > "$RUN/hotspot.password" )
	log "hotspot: acceso su $i, rete $ssid"
	schermo_sveglia
	announce "$ssid" "$pass"
	ap_info "$ssid" "$pass"
}

ap_stop() {
	local f p i
	i=$(cat "$RUN/hotspot.attivo" 2>/dev/null)
	for f in "$AP_PID".hostapd.pid "$AP_PID".udhcpd.pid "$AP_PID".dnsd.pid; do
		p=$(cat "$f" 2>/dev/null)
		[ -n "$p" ] && kill "$p" 2>/dev/null
		rm -f "$f"
	done
	rm -f "$AP_PID".dns.conf "$AP_PID".udhcpd.conf "$AP_PID".leases "$RUN/hotspot.attivo" "$RUN/hotspot.ssid" "$RUN/hotspot.password"
	if [ -n "$i" ]; then
		"$IPC" addr flush dev "$i" 2>/dev/null
		log "hotspot: spento"
		schermo_sveglia
	fi
	return 0
}

# Attende fino a $2 secondi un indirizzo IPv4 sulla scheda $1.
wait_ip() {
	local t=0
	while [ $t -lt "$2" ]; do
		[ -n "$("$IPC" -4 -o addr show scope global dev "$1" 2>/dev/null)" ] && return 0
		"$SLEEP" 2
		t=$((t + 2))
	done
	return 1
}

# Per la schermata (sweetspot-display): secondo di /proc/uptime entro cui si
# accende l'hotspot (avvio) o finisce la prova della rete scelta (prova).
attesa_scrivi() { # secondi avvio|prova
	local up=''
	read -r up _ < "$PROC/uptime" 2>/dev/null
	up=${up%%.*}
	echo "$(( ${up:-0} + $1 )) $2" > "$ATTESA"
	schermo_sveglia
}

# Collega subito la scheda $1 alla rete di WIFI_NOME, scelta dalla pagina Rete
# con l'hotspot spento. Se non risponde entro HOTSPOT_PROVA secondi e non c'e'
# altra connessione, riparte la sorveglianza (e dopo l'attesa l'hotspot).
prova_rete() { # scheda
	local i=$1 prova
	prova=$(conf HOTSPOT_PROVA 40)
	case "$prova" in ''|*[!0-9]*) prova=40 ;; esac
	"$SLEEP" 4	# il tempo di consegnare la risposta alla pagina
	[ -f "/run/udhcpc.$i.pid" ] && kill "$(cat "/run/udhcpc.$i.pid")" 2>/dev/null
	killall wpa_supplicant 2>/dev/null
	"$IPC" addr flush dev "$i" 2>/dev/null
	log "rete: collego il Wi-Fi scelto dalla pagina su $i"
	"$NET_INIT" wifi "$i"
	if wait_ip "$i" "$prova"; then
		log "rete: collegato alla rete Wi-Fi scelta"
		return 0
	fi
	log "rete: la rete Wi-Fi scelta non risponde"
	connected && return 0
	sorveglia
}

sorveglia() {
	local attesa prova i t=0 step=3
	is_yes "$(conf HOTSPOT si)" || exit 0
	if ! command -v "$IW" >/dev/null 2>&1 || ! command -v "$HOSTAPD" >/dev/null 2>&1; then exit 0; fi
	mkdir -p "$RUN"
	exec 9> "$RUN/hotspot.lock"
	flock -n 9 || exit 0
	attesa=$(conf HOTSPOT_ATTESA 60)
	case "$attesa" in ''|*[!0-9]*) attesa=60 ;; esac
	prova=$(conf HOTSPOT_PROVA 40)
	case "$prova" in ''|*[!0-9]*) prova=40 ;; esac

	# 1. Attesa: appena c'e' una connessione non serve altro.
	trap 'rm -f "$ATTESA"' EXIT
	attesa_scrivi "$attesa" avvio
	while [ $t -lt "$attesa" ]; do
		connected && exit 0
		"$SLEEP" $step
		t=$((t + step))
	done
	connected && exit 0
	i=$(ap_iface) || { log "hotspot: nessun adattatore Wi-Fi capace di fare da access point"; exit 0; }

	# 2. Hotspot acceso finche' non arriva una connessione.
	rm -f "$RICHIESTA" "$ATTESA"
	ap_start "$i" || { log "hotspot: avvio non riuscito su $i"; ap_stop; radio_off; exit 0; }
	while :; do
		if wired_up; then
			log "hotspot: arrivato il cavo, spengo"
			ap_stop
			radio_off
			exit 0
		fi
		if [ -f "$RICHIESTA" ]; then
			rm -f "$RICHIESTA"
			"$SLEEP" 4	# il tempo di consegnare la risposta al telefono
			ap_stop
			log "hotspot: provo la rete Wi-Fi salvata"
			attesa_scrivi "$prova" prova
			"$NET_INIT" wifi "$i"
			if wait_ip "$i" "$prova"; then
				log "hotspot: collegato alla rete Wi-Fi"
				exit 0
			fi
			rm -f "$ATTESA"
			log "hotspot: la rete Wi-Fi non risponde, riaccendo l'hotspot"
			ap_start "$i" || { ap_stop; exit 0; }
		fi
		"$SLEEP" 2
	done
}

case "$1" in
	sorveglia) sorveglia ;;
	scansiona)
		i=$(cat "$RUN/hotspot.attivo" 2>/dev/null)
		if [ -z "$i" ]; then
			# Senza hotspot: radio accesa per la ricerca, poi come prima.
			i=$(wifi_iface) || exit 1
			radio_on "$i"
			"$IPC" link set "$i" up
			# Appena accesa la scheda puo' non essere ancora pronta.
			scan "$i" || { "$SLEEP" 2; scan "$i"; }
			rc=$?
			radio_off
			exit $rc
		fi
		scan "$i" ;;
	stato) cat "$RUN/hotspot.attivo" 2>/dev/null ;;
	# La pagina gira come "web" e non scrive in $RUN: passa da sweetspot-priv.
	richiesta) [ -s "$RUN/hotspot.attivo" ] && : > "$RICHIESTA" ;;
	# Con l'hotspot acceso si passa da "richiesta".
	collega)
		[ -s "$RUN/hotspot.attivo" ] && exit 1
		[ -n "$(conf WIFI_NOME)" ] || exit 1
		i=$(wifi_iface) || exit 1
		if [ "${SWEETSPOT_TEST:-}" = 1 ]; then
			prova_rete "$i"
		else
			setsid "$0" prova "$i" > /dev/null 2>&1 < /dev/null &
		fi ;;
	prova) [ -n "$2" ] && prova_rete "$2" ;;
	*) echo "uso: $0 sorveglia|scansiona|stato|richiesta|collega" >&2; exit 1 ;;
esac
