#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# Sweetspot - chiamato da udev quando una scheda audio compare o sparisce.
# Sveglia il supervisore (sweetspot-player), che gestisce anche tutte le zone.
# Non aspetta nulla: udev non deve restare bloccato.

pid=$(cat /run/sweetspot/player.pid 2>/dev/null)
case "$pid" in ''|*[!0-9]*) exit 0 ;; esac
kill -USR1 "$pid" 2>/dev/null
exit 0
