#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Sweetspot - schermata sul monitor del computer: indirizzo da aprire dal
# telefono, QR code e stato. Si aggiorna solo quando qualcosa cambia e lo
# schermo si spegne dopo SCHERMO_MINUTI (un tasto lo riaccende).
#
# La disegna sweetspot-schermo sul framebuffer con i testi preparati qui
# ($RUN/schermo.testi, poi SIGHUP). Senza framebuffer resta il testo.

. "${SWEETSPOT_LIB:-/usr/lib/sweetspot}/common.sh"

TTY=/dev/tty1
TESTI=$RUN/schermo.testi
PRIMO_ATTIVO=$RUN/primo-accesso.attivo
PRIMO_CODICE=$RUN/primo-accesso.codice

# Codice di primo accesso finche' non c'e' la password (sweetspot-accesso):
# deve restare sullo schermo, le pagine lo chiedono. Lo mette in $codice
# senza processi in piu' (gira nel ciclo): il segnale lo toglie
# sweetspot-accesso quando si sceglie la password.
primo_codice() {
	codice=''
	[ -f "$PRIMO_ATTIVO" ] && read -r codice < "$PRIMO_CODICE" 2>/dev/null
	return 0
}

# Hotspot di configurazione (sweetspot-hotspot) acceso: nome e password in
# $hs_ssid e $hs_pass, anche questi senza processi in piu'.
hotspot_rete() {
	hs_ssid='' hs_pass=''
	[ -f "$RUN/hotspot.attivo" ] || return 0
	IFS= read -r hs_ssid < "$RUN/hotspot.ssid" 2>/dev/null
	IFS= read -r hs_pass < "$RUN/hotspot.password" 2>/dev/null
	return 0
}

# Hotspot in arrivo (sweetspot-hotspot): $hs_fase "avvio" o "prova" e $hs_tra,
# i secondi che mancano arrotondati a 10 (il ciclo gira ogni 20 s).
hotspot_attesa() {
	local entro='' up=''
	hs_fase='' hs_tra=''
	read -r entro hs_fase < "$RUN/hotspot.attesa" 2>/dev/null
	case "$entro" in ''|*[!0-9]*) hs_fase=''; return 0 ;; esac
	read -r up _ < "$PROC/uptime" 2>/dev/null
	up=${up%%.*}
	hs_tra=$(( (entro - ${up:-0} + 9) / 10 * 10 ))
	[ "$hs_tra" -gt 0 ] || hs_tra=0
	return 0
}
tra_circa() { if [ "$hs_tra" -gt 0 ]; then echo "tra circa $hs_tra secondi"; else echo "tra pochi secondi"; fi; }

# C'e' una scheda Wi-Fi (per dire che senza cavo arriva l'hotspot)?
ha_wifi() {
	local n
	is_yes "$(conf HOTSPOT si)" || return 1
	for n in "$SYS"/class/net/*; do
		[ -d "$n/wireless" ] || [ -d "$n/phy80211" ] && return 0
	done
	return 1
}

# Valore per il codice QR del Wi-Fi: \ ; , : " si proteggono con la barra.
qr_esc() { printf '%s' "$1" | sed 's/[\\;,:"]/\\&/g'; }

# Testi della schermata grafica, CHIAVE=VALORE (vedi sweetspot-schermo).
testi() {
	local ip=$1 srv host pst tipo codice
	host=$(cat "$PROC/sys/kernel/hostname" 2>/dev/null)
	pst=$(cat "$RUN/player.stato" 2>/dev/null)
	primo_codice
	hotspot_rete
	hotspot_attesa
	if [ -n "$hs_ssid" ]; then
		echo "occhiello=COLLEGA IL TELEFONO A QUESTA RETE WI-FI"
		echo "titolo=$hs_ssid"
		echo "alt_etichetta=password"
		echo "alt=$hs_pass"
		echo "qr=WIFI:T:WPA;S:$(qr_esc "$hs_ssid");P:$(qr_esc "$hs_pass");;"
		echo "qr_nota=Inquadra per collegarti"
		echo "riga1=Poi apri http://192.168.4.1/ e scegli la rete di casa."
		echo "riga2=Con il cavo di rete collegato questa rete si spegne da sola."
	elif [ -z "$ip" ] && [ "$hs_fase" = avvio ]; then
		# Il tempo sta nel titolo: con il codice riga1 e riga2 non si vedono.
		echo "occhiello=SENZA CAVO ARRIVA LA RETE WI-FI SWEETSPOT"
		echo "titolo=Wi-Fi $(tra_circa)"
		echo "riga1=Qui compariranno nome, password e QR per il telefono."
		echo "riga2=Con il cavo di rete collegato Sweetspot si collega da solo."
	elif [ -z "$ip" ] && [ "$hs_fase" = prova ]; then
		echo "occhiello=PROVO LA RETE WI-FI SCELTA"
		echo "titolo=Risposta $(tra_circa)"
		echo "riga1=Se si collega, qui compare l'indirizzo da aprire."
		echo "riga2=Altrimenti la rete Wi-Fi Sweetspot si riaccende da sola."
	elif [ -z "$ip" ]; then
		echo "occhiello=IN ATTESA DELLA RETE"
		echo "titolo=Rete non collegata"
		if ha_wifi; then
			echo "riga1=Collega il cavo, oppure attendi la rete Wi-Fi Sweetspot."
			echo "riga2=Senza cavo si accende entro un paio di minuti dall'avvio."
		else
			echo "riga1=Controlla il cavo di rete."
			echo "riga2=La schermata si aggiorna da sola appena c'è la connessione."
		fi
	else
		echo "titolo_prefisso=http://"
		echo "titolo=$host.local"
		echo "alt_etichetta=oppure"
		echo "alt=$ip"
		echo "qr=http://$ip/"
		echo "qr_nota=Inquadra con la fotocamera"
		if [ "$(mode)" = completa ]; then
			echo "occhiello=DAL TELEFONO O DAL COMPUTER"
			echo "riga1=Musica, plugin e impostazioni sono tutti lì."
			echo "riga2=Funzionano anche le app per Lyrion: iPeng, Squeezer, Material."
		else
			echo "occhiello=STATO E IMPOSTAZIONI"
			srv=$(lms_server_ip)
			if [ -n "$srv" ]; then
				echo "riga1=Musica: apri http://$srv:9000/"
				echo "riga2=oppure la tua app Lyrion (iPeng, Squeezer, Material)."
			fi
		fi
	fi
	if [ -n "$codice" ]; then
		echo "codice_etichetta=CODICE DI PRIMO ACCESSO"
		echo "codice=$codice"
		if [ -n "$hs_ssid" ]; then
			# Il codice prende il posto di riga1 e riga2: l'indirizzo va qui.
			echo "codice_nota=Dal telefono apri http://192.168.4.1/: lo chiede per la password."
		elif [ -z "$ip" ] && [ "$hs_fase" = avvio ]; then
			echo "codice_nota=Dal telefono, collegato alla rete Wi-Fi, apri http://192.168.4.1/: lo chiede."
		elif [ -z "$ip" ] && [ "$hs_fase" = prova ]; then
			echo "codice_nota=Se non si collega torna la rete Wi-Fi Sweetspot: riprova da lì."
		else
			[ -n "$ip" ] && echo "occhiello=PRIMO ACCESSO: APRI L'INDIRIZZO"
			echo "codice_nota=Le pagine lo chiedono una volta sola, per scegliere la password."
		fi
	fi
	case "$pst" in
		attivo*) tipo=ok ;;
		''|bloccato*|*terminato*) tipo=errore ;;
		*) tipo=attesa ;;
	esac
	echo "stato=Player ${pst:-non avviato}"
	echo "stato_tipo=$tipo"
	echo "tasto=Alt+F2"
	echo "tasto_nota=per il terminale"
}

# Ripiego in solo testo (nessun framebuffer o caratteri mancanti).
draw() {
	local ip=$1 srv host codice
	host=$(cat "$PROC/sys/kernel/hostname" 2>/dev/null)
	printf '\033[2J\033[H'
	echo
	echo "   SWEETSPOT"
	echo "   ---------"
	echo
	hotspot_rete
	hotspot_attesa
	if [ -n "$hs_ssid" ]; then
		echo "   Collega il telefono alla rete Wi-Fi:   $hs_ssid"
		echo "   Password:   $hs_pass"
		echo
		echo "   Poi apri http://192.168.4.1/ e scegli la rete di casa."
		echo
		qrencode -t ANSI -m 2 "WIFI:T:WPA;S:$(qr_esc "$hs_ssid");P:$(qr_esc "$hs_pass");;" 2>/dev/null | sed 's/^/   /'
	elif [ -z "$ip" ] && [ "$hs_fase" = avvio ]; then
		echo "   Senza cavo arriva la rete Wi-Fi Sweetspot, $(tra_circa):"
		echo "   qui compariranno nome, password e QR per il telefono."
	elif [ -z "$ip" ] && [ "$hs_fase" = prova ]; then
		echo "   Provo la rete Wi-Fi scelta, risposta $(tra_circa)."
	elif [ -z "$ip" ]; then
		echo "   Rete non collegata: controlla il cavo."
	elif [ "$(mode)" = completa ]; then
		echo "   Dal telefono o dal computer apri:"
		echo
		echo "     http://$host.local/     oppure     http://$ip/"
		echo
		echo "   Musica, plugin e impostazioni sono tutti li'."
		echo "   Funzionano anche le app per Lyrion (iPeng, Squeezer, Material)."
		echo
		qrencode -t ANSI -m 2 "http://$ip/" 2>/dev/null | sed 's/^/   /'
	else
		echo "   Stato e impostazioni:   http://$host.local/   oppure   http://$ip/"
		echo
		qrencode -t ANSI -m 2 "http://$ip/" 2>/dev/null | sed 's/^/   /'
		srv=$(lms_server_ip)
		[ -n "$srv" ] && echo "   Musica: apri http://$srv:9000/ o la tua app Lyrion"
	fi
	primo_codice
	if [ -n "$codice" ]; then
		echo
		echo "   PRIMO ACCESSO - codice: $codice"
		echo "   Le pagine lo chiedono una volta sola, per scegliere la password."
	fi
	echo
	echo "   Player: $(cat "$RUN/player.stato" 2>/dev/null)"
	echo
	echo "   Alt+F2 per il terminale."
}

[ "${SWEETSPOT_TEST:-}" = 1 ] && return 0

# USR1 (sweetspot-hotspot) interrompe l'attesa del ciclo: si ridisegna subito.
trap : USR1
min=$(conf SCHERMO_MINUTI 2)
case "$min" in ''|*[!0-9]*) min=2 ;; esac
# Spegnimento del monitor gestito dalla console: un tasto lo riaccende.
{ printf '\033[9;%s]\033[14;%s]' "$min" "$min" > "$TTY"; } 2>/dev/null

mkdir -p "$RUN" 2>/dev/null
rm -f "$RUN/schermo.grafico"
net_ipv4_v
testi "$IPV4" > "$TESTI" 2>/dev/null
pittore=""
if command -v sweetspot-schermo >/dev/null 2>&1; then
	# Esce subito se non c'e' il framebuffer: dopo un secondo si sa.
	sweetspot-schermo "$TESTI" "$TTY" 2>"$RUN/schermo.err" &
	pittore=$!
	sleep 1
	if kill -0 "$pittore" 2>/dev/null; then
		# sweetspot-hotspot non scrive sulla console del monitor finche' c'e'.
		echo "$pittore" > "$RUN/schermo.grafico"
	else
		pittore=""
		log "schermata grafica non disponibile, resta il testo: $(head -n 1 "$RUN/schermo.err" 2>/dev/null)"
	fi
fi

last=""
nap_init
while true; do
	net_ipv4_v; ip=$IPV4
	pst=''
	read -r pst < "$RUN/player.stato" 2>/dev/null
	# Anche il framebuffer: quando arriva il driver grafico (i915,
	# amdgpu...) la console ridisegna il suo testo sopra la schermata.
	fbn='' fbd=''
	read -r fbn < "$SYS/class/graphics/fb0/name" 2>/dev/null
	read -r fbd < "$SYS/class/graphics/fb0/virtual_size" 2>/dev/null
	primo_codice
	hotspot_rete
	hotspot_attesa
	now="$ip|$pst|$(lms_server_ip)|$fbn $fbd|$codice|$hs_ssid|$hs_fase $hs_tra"
	if [ -n "$pittore" ] && ! kill -0 "$pittore" 2>/dev/null; then
		pittore=""
		last=""
		rm -f "$RUN/schermo.grafico"
	fi
	if [ "$now" != "$last" ]; then
		if [ -n "$pittore" ]; then
			testi "$ip" > "$TESTI.nuovo" 2>/dev/null && mv -f "$TESTI.nuovo" "$TESTI"
			kill -HUP "$pittore" 2>/dev/null
		else
			{ draw "$ip" > "$TTY"; } 2>/dev/null
		fi
		last=$now
	fi
	# Il testo cambia di rado (rete, stato del player): ogni 20 s bastano.
	nap 20
done
