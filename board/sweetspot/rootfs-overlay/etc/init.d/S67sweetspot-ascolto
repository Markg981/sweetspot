#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# Sweetspot - modalita' ascolto (solo in modalita' completa).

. "${SWEETSPOT_LIB:-/usr/lib/sweetspot}/common.sh"

PIDFILE=$RUN/ascolto.pid

case "$1" in
	start)
		[ "$(mode)" = completa ] || exit 0
		start-stop-daemon -S -b -m -p "$PIDFILE" -x /usr/bin/sweetspot-ascolto
		;;
	stop)
		start-stop-daemon -K -s TERM -p "$PIDFILE" 2>/dev/null
		rm -f "$PIDFILE"
		;;
	*) echo "uso: $0 start|stop" ;;
esac
