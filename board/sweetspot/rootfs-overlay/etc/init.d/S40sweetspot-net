#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Sweetspot - rete: cavo (anche adattatori USB) con DHCP o indirizzo fisso,
# Wi-Fi solo se configurato. Il risparmio energetico della scheda (EEE)
# viene spento.

. "${SWEETSPOT_LIB:-/usr/lib/sweetspot}/common.sh"

# Nome in rete (http://NOME.local): lettere minuscole, cifre e trattini.
HOST=$(lower "$(conf NOME_RETE sweetspot)" | tr -c 'a-z0-9-' '-' | sed 's/^-*//; s/-*$//' | cut -c1-32)
[ -n "$HOST" ] || HOST=sweetspot

wifi_conf() {
	local ssid pass
	# Il nome va in esadecimale (ssid=<hex>, senza virgolette): #, virgolette,
	# backslash, UTF-8 ed emoji arrivano a wpa_supplicant byte per byte.
	ssid=$(conf WIFI_NOME | od -An -v -tx1 | tr -d ' \n')
	# Tra virgolette wpa_supplicant NON interpreta escape: la password va
	# scritta cruda. Con 64 cifre esadecimali e' invece la chiave gia' derivata.
	pass=$(conf WIFI_PASSWORD)
	{
		echo "ctrl_interface=/run/wpa_supplicant"
		echo "network={"
		echo "	ssid=$ssid"
		if [ -z "$pass" ]; then
			echo "	key_mgmt=NONE"
		elif [ "${#pass}" -eq 64 ] && [ -z "$(printf '%s' "$pass" | tr -d '0-9a-fA-F')" ]; then
			echo "	psk=$pass"
		else
			echo "	psk=\"$pass\""
		fi
		echo "}"
	} > "$RUN/wpa.conf"
	chmod 600 "$RUN/wpa.conf"
}

# Collega la scheda Wi-Fi $1 alla rete di WIFI_NOME.
wifi_up() {
	rfkill_wlan_on
	wifi_conf
	ip link set "$1" up
	wpa_supplicant -B -i "$1" -c "$RUN/wpa.conf" >/dev/null 2>&1
	start_dhcp "$1"
	log "rete: Wi-Fi su $1"
}

# Radio Wi-Fi accese (S20sweetspot-tune le spegne se non c'e' WIFI_NOME).
rfkill_wlan_on() {
	local r
	for r in "$SYS"/class/rfkill/rfkill*; do
		[ -d "$r" ] || continue
		[ "$(cat "$r/type" 2>/dev/null)" = wlan ] && put 0 "$r/soft"
	done
	return 0
}

# Il collegamento del cavo puo' richiedere qualche secondo dopo
# l'accensione della scheda: si attende e poi si chiede l'indirizzo,
# riprovando ogni 5 secondi finche' non arriva.
start_dhcp() {
	local i=0
	while [ $i -lt 10 ] && [ "$(cat "$SYS/class/net/$1/carrier" 2>/dev/null)" != 1 ]; do
		usleep 500000
		i=$((i + 1))
	done
	udhcpc -b -S -t 4 -T 3 -A 5 -i "$1" -x "hostname:$HOST" -p "/run/udhcpc.$1.pid" >/dev/null 2>&1
}

# Indirizzo fisso (IP_FISSO=192.168.1.50/24, GATEWAY, DNS facoltativo):
# solo sulla prima scheda via cavo.
static_ip() {
	local dns
	ip addr add "$(conf IP_FISSO)" dev "$1" || return 1
	ip route add default via "$(conf GATEWAY)" dev "$1" 2>/dev/null
	dns=$(conf DNS "$(conf GATEWAY)")
	echo "nameserver $dns" > /etc/resolv.conf
	log "rete: indirizzo fisso $(conf IP_FISSO) su $1"
}

case "$1" in
	start)
		static_done=""
		hostname "$HOST"
		echo "$HOST" > /etc/hostname
		ip link set lo up
		for n in "$SYS"/class/net/*; do
			i=${n##*/}
			# Solo schede vere (anche USB): niente interfacce virtuali.
			[ -e "$n/device" ] || continue
			[ "$(cat "$n/type" 2>/dev/null)" = 1 ] || continue
			if [ -d "$n/wireless" ] || [ -d "$n/phy80211" ]; then
				[ -n "$(conf WIFI_NOME)" ] || continue
				wifi_up "$i"
			else
				ip link set "$i" up
				if ! is_yes "$(conf RISPARMIO_RETE no)"; then
					ethtool --set-eee "$i" eee off >/dev/null 2>&1
				fi
				if [ -n "$(conf IP_FISSO)" ] && [ -z "$static_done" ] && static_ip "$i"; then
					static_done=1
				else
					start_dhcp "$i"
				fi
				log "rete: cavo su $i"
			fi
		done
		# Orologio sincronizzato una volta sola, poi nessun traffico.
		(sleep 10; ntpd -n -q -p pool.ntp.org >/dev/null 2>&1) &
		# Schede di rete rimaste senza cavo a riposo (ora che sono su).
		sweetspot-silenzio rete &
		# Primo avvio senza cavo: se resta senza rete, hotspot di configurazione.
		sweetspot-hotspot sorveglia &
		;;
	wifi)
		# Chiamato dall'hotspot dopo che la rete e' stata scelta dalla pagina Rete.
		[ -n "$2" ] && [ -n "$(conf WIFI_NOME)" ] && wifi_up "$2"
		;;
	stop)
		killall udhcpc wpa_supplicant 2>/dev/null
		;;
	*) echo "uso: $0 start|stop|wifi SCHEDA" ;;
esac
