#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# Sweetspot - avvia il supervisore della riproduzione.

. "${SWEETSPOT_LIB:-/usr/lib/sweetspot}/common.sh"

PIDFILE=/run/sweetspot/supervisore.pid

case "$1" in
	start)
		mkdir -p /run/sweetspot
		start-stop-daemon -S -b -m -p "$PIDFILE" -x /usr/bin/sweetspot-player
		;;
	stop)
		start-stop-daemon -K -p "$PIDFILE" 2>/dev/null
		if [ -f "$RUN/mpd.pid" ]; then
			pid=$(cat "$RUN/mpd.pid")
			kill "$pid" 2>/dev/null
			i=0
			while [ $i -lt 20 ] && kill -0 "$pid" 2>/dev/null; do
				usleep 500000
				i=$((i + 1))
			done
		fi
		killall squeezelite 2>/dev/null
		# Libreria e playlist sulla chiavetta prima di spegnere.
		[ "$(mode)" = completa ] && /usr/bin/sweetspot-dati salva
		;;
	restart) "$0" stop; sleep 1; "$0" start ;;
	*) echo "uso: $0 start|stop|restart" ;;
esac
