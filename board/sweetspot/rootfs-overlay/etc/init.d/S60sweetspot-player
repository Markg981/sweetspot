#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# Sweetspot - avvia il supervisore della riproduzione.

. "${SWEETSPOT_LIB:-/usr/lib/sweetspot}/common.sh"

PIDFILE=/run/sweetspot/supervisore.pid

case "$1" in
	start)
		mkdir -p /run/sweetspot
		start-stop-daemon -S -b -m -p "$PIDFILE" -x /usr/bin/sweetspot-player
		;;
	stop)
		start-stop-daemon -K -p "$PIDFILE" 2>/dev/null
		killall squeezelite 2>/dev/null
		# Libreria, plugin e impostazioni sulla chiavetta prima di spegnere
		# (Lyrion e' gia' fermo: si ferma prima del player).
		# Con "restart" (Salva e applica) Lyrion resta in funzione e il
		# sorvegliante dei dati continua a salvare da solo: niente copia
		# completa del database a ogni riavvio del solo player.
		[ "${SWEETSPOT_SENZA_SALVATAGGIO:-}" = 1 ] && exit 0
		[ "$(mode)" = completa ] && "${SWEETSPOT_DATI:-/usr/bin/sweetspot-dati}" salva
		;;
	restart) SWEETSPOT_SENZA_SALVATAGGIO=1 "$0" stop; sleep 1; "$0" start ;;
	*) echo "uso: $0 start|stop|restart" ;;
esac
