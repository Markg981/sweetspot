#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# Sweetspot - accesso SSH per l'assistenza, solo se attivato in sweetspot.txt
# e con una password impostata.

. "${SWEETSPOT_LIB:-/usr/lib/sweetspot}/common.sh"

case "$1" in
	start)
		is_yes "$(conf SSH no)" || exit 0
		pass=$(conf SSH_PASSWORD)
		if [ -z "$pass" ]; then
			log "ssh: attivato senza password, non avviato"
			exit 0
		fi
		# Utente dell'accesso: "root" (predefinito, come prima) oppure
		# "assistenza", senza privilegi. Qualunque altro valore vale root solo
		# se e' proprio "root": un nome inventato non deve dare un login.
		user=$(lower "$(conf SSH_UTENTE root)")
		case "$user" in
			root|assistenza) ;;
			*) log "ssh: utente $user non ammesso, non avviato"; exit 0 ;;
		esac
		# La password arriva a chpasswd dall'ingresso standard, mai nella riga di comando.
		printf '%s:%s\n' "$user" "$pass" | chpasswd >/dev/null 2>&1
		if [ "$user" = root ]; then
			opts="-R"
		else
			# Con l'utente di assistenza il login di root e' disattivato (-w).
			opts="-R -w"
		fi
		# In Buildroot /etc/dropbear e' un collegamento a /var/run/dropbear,
		# che dopo l'avvio non esiste: le chiavi vanno nella cartella puntata.
		if [ -L /etc/dropbear ]; then
			(cd /etc && mkdir -p "$(readlink dropbear)")
		else
			mkdir -p /etc/dropbear
		fi
		# shellcheck disable=SC2086
		dropbear $opts -p 22
		log "ssh: attivo (utente $user)"
		;;
	stop) killall dropbear 2>/dev/null ;;
	*) echo "uso: $0 start|stop" ;;
esac
