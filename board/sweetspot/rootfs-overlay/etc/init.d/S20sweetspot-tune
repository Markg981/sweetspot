#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Sweetspot - ottimizzazioni dopo il riconoscimento dell'hardware:
# parametri di avvio adattati al computer, frequenza fissa della CPU,
# radio spente, USB sempre alimentato,
# LED e periferiche USB e PCI inutilizzate spenti (sweetspot-silenzio; le
# schede di rete le decide S40sweetspot-net, a rete su).

. "${SWEETSPOT_LIB:-/usr/lib/sweetspot}/common.sh"

radios_off() {
	local r type
	for r in "$SYS"/class/rfkill/rfkill*; do
		[ -d "$r" ] || continue
		type=$(cat "$r/type" 2>/dev/null)
		case "$type" in
			wlan) [ -n "$(conf WIFI_NOME)" ] && continue ;;
		esac
		put 1 "$r/soft"
	done
}

usb_power_on() {
	local c
	for c in "$SYS"/bus/usb/devices/*/power/control; do
		put on "$c"
	done
}

case "$1" in
	start)
		# Attende che udev abbia riconosciuto le periferiche (DAC compreso).
		udevadm settle --timeout=10 2>/dev/null
		sweetspot-autotune --applica
		sweetspot-cpu
		radios_off
		usb_power_on
		sweetspot-silenzio applica
		;;
	stop) ;;
	*) echo "uso: $0 start" ;;
esac
