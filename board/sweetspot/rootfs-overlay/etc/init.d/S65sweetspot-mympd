#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Sweetspot - interfaccia web del player (myMPD) su http://sweetspot.local
# Solo in modalita' completa.

. "${SWEETSPOT_LIB:-/usr/lib/sweetspot}/common.sh"

WORK=/var/lib/mympd
CACHE=/var/cache/mympd
PIDFILE=$RUN/mympd.pid

case "$1" in
	start)
		[ "$(mode)" = completa ] || exit 0
		mkdir -p "$WORK/config" "$WORK/state" "$CACHE"
		# Porta 80 senza certificati: nessun avviso del browser in casa.
		printf '80' > "$WORK/config/http_port"
		printf 'false' > "$WORK/config/ssl"
		printf '%s' "$MPD_SOCKET" > "$WORK/state/mpd_host"
		# Attende MPD (al massimo 30 secondi).
		i=0
		while [ $i -lt 60 ] && [ ! -S "$MPD_SOCKET" ]; do
			usleep 500000
			i=$((i + 1))
		done
		MPD_HOST=$MPD_SOCKET MYMPD_HTTP_PORT=80 MYMPD_SSL=false MYMPD_LOGLEVEL=4 \
			start-stop-daemon -S -b -m -p "$PIDFILE" -x /usr/bin/mympd -- -w "$WORK" -a "$CACHE"
		log "interfaccia web avviata"
		;;
	stop) start-stop-daemon -K -p "$PIDFILE" 2>/dev/null ;;
	*) echo "uso: $0 start|stop" ;;
esac
