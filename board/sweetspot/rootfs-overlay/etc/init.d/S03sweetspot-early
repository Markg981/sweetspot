#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Sweetspot - primo avvio: legge le impostazioni dalla chiavetta, decide
# quali moduli del kernel non caricare e imposta i parametri di sistema.
# Gira prima di udev, cosi' i moduli esclusi non vengono mai caricati.

. "${SWEETSPOT_LIB:-/usr/lib/sweetspot}/common.sh"

write_blacklist() {
	{
		echo "# Generato all'avvio da Sweetspot."
		# Mai necessari a un player: Bluetooth, webcam, lettori di schede,
		# altoparlante di sistema.
		for m in bluetooth btusb uvcvideo pcspkr rtsx_pci rtsx_usb joydev; do
			echo "blacklist $m"
		done
		# Il watchdog hardware del chipset serve a S21sweetspot-watchdog;
		# con WATCHDOG=no resta fuori.
		if ! is_yes "$(conf WATCHDOG si)"; then
			for m in iTCO_wdt sp5100_tco; do
				echo "blacklist $m"
			done
		fi
		if ! is_yes "$(conf USCITA_INTEGRATA no)"; then
			echo "blacklist snd_hda_intel"
		fi
		# Wi-Fi dei PC e del Raspberry Pi (brcmfmac): serve anche senza
		# WIFI_NOME, all'hotspot di primo accesso (sweetspot-hotspot).
		if [ -z "$(conf WIFI_NOME)" ] && ! is_yes "$(conf HOTSPOT si)"; then
			for m in iwlwifi iwlmvm iwlmld iwldvm ath9k mt7921e brcmfmac brcmfmac_wcc brcmutil; do
				echo "blacklist $m"
			done
		fi
	} > "${SWEETSPOT_MODPROBE_D:-/etc/modprobe.d}/sweetspot-run.conf"
}

tune_sysctl() {
	# Nessun limite al tempo dei thread real-time: il thread audio non
	# deve mai essere sospeso dal kernel.
	put -1 /proc/sys/kernel/sched_rt_runtime_us
	put 0 /proc/sys/vm/swappiness
	put 0 /proc/sys/kernel/nmi_watchdog
	put 0 /proc/sys/kernel/watchdog
	# Statistiche della memoria aggiornate di rado: meno risvegli periodici.
	put 10 /proc/sys/vm/stat_interval
}

[ "${SWEETSPOT_TEST:-}" = 1 ] && return 0

case "$1" in
	start)
		mkdir -p "$RUN" /var/log /etc/modprobe.d
		# cgroup v2 per sweetspot-ascolto (rallenta i lavori di fondo senza
		# congelarli); se il kernel non lo ha, l'ascolto ripiega su SIGSTOP.
		if [ -d /sys/fs/cgroup ] && ! grep -q ' /sys/fs/cgroup cgroup2 ' /proc/mounts 2>/dev/null; then
			mount -t cgroup2 none /sys/fs/cgroup 2>/dev/null || true
		fi
		# Dati di Lyrion (database della libreria, preferenze, cache) in un
		# tmpfs con tetto: senza, la RAM e' l'unico limite e una cache che
		# cresce porta all'OOM. Prima del ripristino dalla chiavetta.
		if ! grep -q " $LMS_DATA tmpfs " /proc/mounts 2>/dev/null; then
			mkdir -p "$LMS_DATA"
			mount -t tmpfs -o "size=${SWEETSPOT_LMS_DATA_RAM:-45%},mode=0755,nosuid,nodev" tmpfs "$LMS_DATA" 2>/dev/null ||
				log "dati di Lyrion: tmpfs con tetto non montato, si usa la radice"
		fi
		printf 'Sweetspot: lettura impostazioni... '
		# La chiavetta puo' impiegare qualche secondo a comparire.
		i=0
		while [ $i -lt 20 ] && [ -z "$(stick_device)" ]; do
			usleep 500000
			i=$((i + 1))
		done
		if stick_mount ro; then
			cp "$STICK_MNT/sweetspot.txt" "$RUN/sweetspot.txt" 2>/dev/null
			cp "$STICK_MNT/boot/grub/auto.cfg" "$RUN/auto.cfg" 2>/dev/null
			# Impostazioni, plugin e libreria di Lyrion salvati.
			sweetspot-dati ripristina "$STICK_MNT/$DATA_DIR_NAME" ||
				log "dati: ripristino non riuscito, salvataggio bloccato fino a intervento"
			# Filtri della correzione ambientale (REW) e impulsi FIR.
			sweetspot-dsp ripristina "$STICK_MNT/correzione-ambientale" ||
				log "correzione: ripristino dei filtri non riuscito"
			stick_umount
			log "impostazioni lette dalla chiavetta"
			echo "fatto"
		else
			# Lyrion parte senza la libreria salvata: niente salvataggi sopra
			# la copia della chiavetta se compare piu' tardi.
			sweetspot-dati assente
			log "chiavetta non trovata: impostazioni predefinite"
			echo "chiavetta non trovata, uso i valori predefiniti"
		fi
		chmod 600 "$RUN/sweetspot.txt" 2>/dev/null # password in chiaro: solo root
		config_build "$RUN/sweetspot.txt"
		write_blacklist
		tune_sysctl
		# Impostazioni e stato di Sweetspot sulla porta 80 (Lyrion e' sulla 9000).
		# Con PASSWORD_WEB le pagine chiedono utente e password (sweetspot-accesso).
		sweetspot-accesso applica
		# Senza password: codice di primo accesso (console e chiavetta).
		sweetspot-accesso avvio || log "primo accesso: preparazione non riuscita"
		# Cartella scrivibile dalle pagine (utente "web"): bozze dei filtri e
		# stato della prova DoP. Il segreto dei gettoni anti-CSRF lo crea root:
		# le pagine lo leggono soltanto (mai nelle pagine, solo derivati).
		mkdir -p "$RUN/web/correzione"
		chown -R web:web "$RUN/web" 2>/dev/null
		chmod 700 "$RUN/web" "$RUN/web/correzione"
		head -c 16 /dev/urandom | md5sum | cut -c1-24 > "$RUN/web.token"
		chown root:web "$RUN/web.token" 2>/dev/null
		chmod 640 "$RUN/web.token"
		mkdir -p /etc/default
		echo 'HTTPD_ARGS="-p 80 -u web:web -h /usr/share/sweetspot/www -c /run/sweetspot/httpd.conf"' > /etc/default/httpd
		;;
	stop) ;;
	*) echo "uso: $0 start" ;;
esac
