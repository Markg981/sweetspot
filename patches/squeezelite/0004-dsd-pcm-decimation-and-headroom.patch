--- /dev/null
+++ b/dsd_decim.h
@@ -0,0 +1,171 @@
+/*
+ *  Squeezelite - lightweight headless squeezebox emulator
+ *
+ *  Extra decimation stages for the DSD to PCM conversion (Sweetspot).
+ *
+ *  dsd2pcm always produces one PCM sample per 8 DSD bits, i.e. DSD rate / 8
+ *  (352.8 kHz for DSD64). DACs that stop at 192 kHz or less refuse that rate.
+ *  Each stage here halves the rate, so the PCM rate can be brought down to one
+ *  the device accepts: 176.4 kHz for DSD64 and DSD128, down to 44.1 kHz.
+ *
+ *  Every stage is a linear phase low pass (Kaiser windowed sinc) designed for
+ *  the rate it receives: flat (well under 0.001 dB) up to 20 kHz, and at least
+ *  100 dB down from the new Nyquist frequency (a quarter of the input rate) to
+ *  the old one, so nothing folds back into the audio band however many stages
+ *  are cascaded. The first stages run at the highest rates and have a wide
+ *  transition band (about 30 taps); only the last one towards 44.1 kHz is
+ *  steep (about 300 taps) and runs at the lowest rate. Costs, per channel, for
+ *  DSD512 down to 44.1 kHz: about 52 million multiply-adds per second.
+ *
+ *  Headroom: DSD masters may peak above digital full scale ("over", up to
+ *  +3 dB, i.e. 50% of modulation beyond the standard). The conversion to
+ *  32 bit is scaled by a margin in dB (0 or negative, -3 by default, key
+ *  DSD_PCM_MARGINE_DB passed in SWEETSPOT_DSD_MARGINE_DB) so they are not
+ *  clipped.
+ *
+ *  This program is free software: you can redistribute it and/or modify
+ *  it under the terms of the GNU General Public License as published by
+ *  the Free Software Foundation, either version 3 of the License, or
+ *  (at your option) any later version.
+ */
+
+#ifndef DSD_DECIM_H
+#define DSD_DECIM_H
+
+#include <math.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define DSD_DECIM_MAX_TAPS 511
+#define DSD_DECIM_MAX_STAGES 8
+#define DSD_DECIM_PASS_HZ 20000.0 // flat up to here
+#define DSD_DECIM_STOP_DB 110.0   // design attenuation (>= 100 dB measured)
+
+#define DSD_PCM_MARGIN_DEFAULT_DB (-3.0)
+#define DSD_PCM_MARGIN_MIN_DB (-24.0)
+
+static double dsd_pcm_margin_db = DSD_PCM_MARGIN_DEFAULT_DB;
+static double dsd_pcm_fullscale = 2147483647.0 * 0.70794578438413791;
+#define DSD_PCM_FULLSCALE dsd_pcm_fullscale
+
+// Margin in dB from text (NULL, empty or not a number: default). Above 0 dB
+// it would amplify and clip: 0. Below the minimum: the minimum.
+static void dsd_pcm_set_margin(const char *text) {
+	double db = DSD_PCM_MARGIN_DEFAULT_DB;
+	char *end = NULL;
+
+	if (text && *text) {
+		double v = strtod(text, &end);
+		if (end != text && *end == '\0' && v == v) db = v;
+	}
+	if (db > 0) db = 0;
+	if (db < DSD_PCM_MARGIN_MIN_DB) db = DSD_PCM_MARGIN_MIN_DB;
+	dsd_pcm_margin_db = db;
+	dsd_pcm_fullscale = 2147483647.0 * pow(10.0, db / 20.0);
+}
+
+typedef struct {
+	float ring[2 * DSD_DECIM_MAX_TAPS]; // every sample is stored twice: contiguous window
+	unsigned pos;
+	unsigned phase;
+} dsd_decim_stage;
+
+typedef struct {
+	unsigned stages;
+	unsigned taps[DSD_DECIM_MAX_STAGES];                           // length of each (odd) filter
+	float coef[DSD_DECIM_MAX_STAGES][(DSD_DECIM_MAX_TAPS + 1) / 2]; // first half + centre (symmetric)
+	dsd_decim_stage st[2][DSD_DECIM_MAX_STAGES];                   // [channel][stage]
+} dsd_decim;
+
+static double dsd_decim_i0(double x) { // modified Bessel function of order 0
+	double sum = 1, term = 1;
+	int k;
+
+	for (k = 1; k < 200; k++) {
+		term *= (x / (2.0 * k)) * (x / (2.0 * k));
+		sum += term;
+		if (term < 1e-17 * sum) break;
+	}
+	return sum;
+}
+
+// Low pass for a stage that receives rate_in and gives rate_in / 2.
+static void dsd_decim_design(dsd_decim *c, unsigned s, double rate_in) {
+	const double pi = 3.14159265358979323846;
+	double stop = rate_in / 4, pass = DSD_DECIM_PASS_HZ, cut, beta, sum = 0;
+	double h[DSD_DECIM_MAX_TAPS];
+	unsigned n, m, k;
+
+	if (pass > 0.907 * stop) pass = 0.907 * stop; // rates below 88.2 kHz: keep a transition band
+	n = (unsigned)ceil((DSD_DECIM_STOP_DB - 7.95) / (2.285 * 2 * pi * (stop - pass) / rate_in)) + 1;
+	if (!(n & 1)) n++;
+	if (n > DSD_DECIM_MAX_TAPS) n = DSD_DECIM_MAX_TAPS;
+	m = (n - 1) / 2;
+	cut = (pass + stop) / 2 / rate_in; // cycles per sample, middle of the transition
+	beta = 0.1102 * (DSD_DECIM_STOP_DB - 8.7);
+	for (k = 0; k < n; k++) {
+		double x = (double)k - m, r = m ? x / m : 0;
+		double sinc = (k == m) ? 2 * cut : sin(2 * pi * cut * x) / (pi * x);
+		h[k] = sinc * dsd_decim_i0(beta * sqrt(1 - r * r)) / dsd_decim_i0(beta);
+		sum += h[k];
+	}
+	c->taps[s] = n;
+	for (k = 0; k <= m; k++) c->coef[s][k] = (float)(h[k] / sum); // unity gain at DC
+}
+
+// Number of halvings (0 = none) bringing base_rate to a rate in rates[]
+// (zero terminated). 0 as well when no halving gets there: the caller then
+// keeps the old behaviour.
+static unsigned dsd_decim_stages_for(unsigned base_rate, const unsigned *rates) {
+	unsigned s, i;
+
+	for (s = 0; s <= DSD_DECIM_MAX_STAGES && (base_rate >> s) > 0; s++) {
+		if (s && (base_rate & ((1u << s) - 1))) break; // must stay an integer rate
+		for (i = 0; i < MAX_SUPPORTED_SAMPLERATES && rates[i]; i++) {
+			if (rates[i] == (base_rate >> s)) return s;
+		}
+	}
+	return 0;
+}
+
+static void dsd_decim_reset(dsd_decim *c, unsigned base_rate, unsigned stages) {
+	unsigned s;
+
+	memset(c, 0, sizeof(*c));
+	if (stages > DSD_DECIM_MAX_STAGES) stages = DSD_DECIM_MAX_STAGES;
+	c->stages = stages;
+	for (s = 0; s < stages; s++) dsd_decim_design(c, s, (double)(base_rate >> s));
+}
+
+// In place; returns the number of samples left in buf.
+static unsigned dsd_decim_run(dsd_decim *c, unsigned ch, float *buf, unsigned n) {
+	unsigned s, i, k, m;
+
+	for (s = 0; s < c->stages; s++) {
+		dsd_decim_stage *t = &c->st[ch][s];
+		const float *h = c->coef[s];
+		const unsigned taps = c->taps[s], mid = (taps - 1) / 2;
+		m = 0;
+		for (i = 0; i < n; i++) {
+			const float *w;
+			float acc;
+			t->ring[t->pos] = t->ring[t->pos + taps] = buf[i];
+			if (++t->pos == taps) t->pos = 0;
+			if (t->phase++ & 1) continue;
+			w = &t->ring[t->pos]; // oldest sample first; the taps are symmetric
+			acc = h[mid] * w[mid];
+			for (k = 0; k < mid; k++) acc += h[k] * (w[k] + w[taps - 1 - k]);
+			buf[m++] = acc;
+		}
+		n = m;
+	}
+	return n;
+}
+
+static unsigned dsd_decim_stereo(dsd_decim *c, float *l, float *r, unsigned n) {
+	unsigned out = dsd_decim_run(c, 0, l, n);
+	dsd_decim_run(c, 1, r, n);
+	return out;
+}
+
+#endif
