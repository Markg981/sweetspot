--- /dev/null
+++ b/dsd_decim.h
@@ -0,0 +1,115 @@
+/*
+ *  Squeezelite - lightweight headless squeezebox emulator
+ *
+ *  Extra decimation stages for the DSD to PCM conversion (Sweetspot).
+ *
+ *  dsd2pcm always produces one PCM sample per 8 DSD bits, i.e. DSD rate / 8
+ *  (352.8 kHz for DSD64). DACs that stop at 192 kHz or less refuse that rate.
+ *  Each stage here halves the rate with a 63 tap Blackman windowed sinc low
+ *  pass (cut-off at a quarter of the input rate), so the PCM rate can be
+ *  brought down to one the device accepts: 176.4 kHz for DSD64 and DSD128.
+ *
+ *  This program is free software: you can redistribute it and/or modify
+ *  it under the terms of the GNU General Public License as published by
+ *  the Free Software Foundation, either version 3 of the License, or
+ *  (at your option) any later version.
+ */
+
+#ifndef DSD_DECIM_H
+#define DSD_DECIM_H
+
+#include <math.h>
+#include <string.h>
+
+#define DSD_DECIM_TAPS 63
+#define DSD_DECIM_MAX_STAGES 8
+
+// -3 dB: DSD streams may peak above digital full scale ("over" masters);
+// without headroom the 32 bit conversion clips them.
+#define DSD_PCM_HEADROOM 0.70794578438413791
+#define DSD_PCM_FULLSCALE (2147483647.0 * DSD_PCM_HEADROOM)
+
+typedef struct {
+	float ring[2 * DSD_DECIM_TAPS]; // every sample is stored twice: contiguous window
+	unsigned pos;
+	unsigned phase;
+} dsd_decim_stage;
+
+typedef struct {
+	unsigned stages;
+	dsd_decim_stage st[2][DSD_DECIM_MAX_STAGES]; // [channel][stage]
+} dsd_decim;
+
+static float dsd_decim_taps[DSD_DECIM_TAPS];
+static int dsd_decim_designed;
+
+static void dsd_decim_design(void) {
+	const double pi = 3.14159265358979323846;
+	const int m = (DSD_DECIM_TAPS - 1) / 2;
+	double sum = 0, h[DSD_DECIM_TAPS];
+	int k;
+
+	for (k = 0; k < DSD_DECIM_TAPS; k++) {
+		double x = (k - m) / 2.0; // sinc of half the sample distance: cut-off fs/4
+		double s = (k == m) ? 1.0 : sin(pi * x) / (pi * x);
+		double w = 0.42 - 0.5 * cos(2 * pi * k / (DSD_DECIM_TAPS - 1))
+		                + 0.08 * cos(4 * pi * k / (DSD_DECIM_TAPS - 1));
+		h[k] = 0.5 * s * w;
+		sum += h[k];
+	}
+	for (k = 0; k < DSD_DECIM_TAPS; k++) {
+		dsd_decim_taps[k] = (float)(h[k] / sum); // unity gain at DC
+	}
+	dsd_decim_designed = 1;
+}
+
+// Number of halvings (0 = none) bringing base_rate to a rate in rates[]
+// (zero terminated). 0 as well when no halving gets there: the caller then
+// keeps the old behaviour.
+static unsigned dsd_decim_stages_for(unsigned base_rate, const unsigned *rates) {
+	unsigned s, i;
+
+	for (s = 0; s <= DSD_DECIM_MAX_STAGES && (base_rate >> s) > 0; s++) {
+		if (s && (base_rate & ((1u << s) - 1))) break; // must stay an integer rate
+		for (i = 0; i < MAX_SUPPORTED_SAMPLERATES && rates[i]; i++) {
+			if (rates[i] == (base_rate >> s)) return s;
+		}
+	}
+	return 0;
+}
+
+static void dsd_decim_reset(dsd_decim *c, unsigned stages) {
+	memset(c, 0, sizeof(*c));
+	c->stages = stages;
+	if (!dsd_decim_designed) dsd_decim_design();
+}
+
+// In place; returns the number of samples left in buf.
+static unsigned dsd_decim_run(dsd_decim *c, unsigned ch, float *buf, unsigned n) {
+	unsigned s, i, k, m;
+
+	for (s = 0; s < c->stages; s++) {
+		dsd_decim_stage *t = &c->st[ch][s];
+		m = 0;
+		for (i = 0; i < n; i++) {
+			const float *w;
+			float acc = 0;
+			t->ring[t->pos] = t->ring[t->pos + DSD_DECIM_TAPS] = buf[i];
+			if (++t->pos == DSD_DECIM_TAPS) t->pos = 0;
+			if (t->phase++ & 1) continue;
+			w = &t->ring[t->pos]; // oldest sample first; the taps are symmetric
+			for (k = 0; k < DSD_DECIM_TAPS; k++) acc += w[k] * dsd_decim_taps[k];
+			buf[m++] = acc;
+		}
+		n = m;
+	}
+	return n;
+}
+
+static unsigned dsd_decim_stereo(dsd_decim *c, float *l, float *r, unsigned n) {
+	unsigned out = dsd_decim_run(c, 0, l, n);
+	dsd_decim_run(c, 1, r, n);
+	return out;
+}
+
+#endif
