config BR2_PACKAGE_ALSA_CDSP
	bool "alsa-cdsp"
	select BR2_PACKAGE_ALSA_LIB
	select BR2_PACKAGE_ALSA_LIB_PCM
	help
	  Plugin ALSA che passa l'audio a CamillaDSP. Con la patch di
	  Sweetspot lavora su un'unica istanza della sessione (pipe) e a
	  ogni cambio di frequenza le fa caricare la configurazione
	  giusta dal websocket, senza riavviarla.

	  https://github.com/scripple/alsa_cdsp
